<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG-ONLY manifest additions. Nothing here is merged into a release build.

  It registers FocusTestActivity, the bare host the instrumented D-pad focus tests need
  (FocusPreservingListUpdateTest). The activity has to live in the app process — declaring it in
  the androidTest manifest instead puts it in `com.debridxtream.tv.test`, and ActivityScenario
  then fails with "Intent in process com.debridxtream.tv resolved to different process".
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name="com.tvonnet.debridxtreamiptv.utils.FocusTestActivity"
            android:exported="false" />
    </application>

</manifest>
