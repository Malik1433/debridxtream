<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Phase 3.2: Advanced TV Features - Picture-in-Picture Support -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Phase 5: MANAGE_EXTERNAL_STORAGE removed — it was declared but never used (the only
         file write, the update APK, goes to cacheDir via FileProvider). It triggers an automatic
         Play-Store policy rejection, so dropping it is a pure win. CAMERA (QR scan) and
         RECORD_AUDIO (voice search) are kept — they ARE used. -->

    <!-- In-app auto-update: hand the downloaded APK to the package installer -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".MainApplication"
        android:allowBackup="false"
        android:localeConfig="@xml/locales_config"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:taskAffinity="${applicationId}"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="31">
        
        <!-- Week 13: Disable default WorkManager initialization (using custom Configuration.Provider) -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Auto-update: exposes the downloaded APK to the package installer -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>
        
        <activity
            android:name=".ui.companion.CompanionSetupActivity"
            android:label="Connect Companion App"
            android:theme="@style/AppTheme"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!--
          `unspecified`, because this screen decides its own orientation in code — and on a fresh
          install it is the FIRST thing a customer ever sees. Declared landscape here, the window
          was built landscape and then swung to portrait a moment later: the app's opening frame
          was a rotation. Same cause as the debrid detail screens, and this was the last activity
          left with it.
        -->
        <activity
            android:name=".ui.licensing.ActivationActivity"
            android:screenOrientation="unspecified"
            android:label="@string/app_name"
            android:theme="@style/AppTheme"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|density" />

        <activity
            android:name=".ui.trailer.TrailerActivity"
            android:label="Trailer Player"
            android:theme="@style/Theme.AppCompat.NoActionBar"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- configChanges: survive the display-mode switches (frame-rate matching)
             the video player triggers, so the Live TV guide behind it isn't
             destroyed/recreated and the shared-player hand-back keeps working. -->
        <!-- M13: orientation/screenSize/screenLayout deliberately NOT in configChanges.
             Proven by a UI dump: sidebar_panel measured [0,844][2400,1017] (full width)
             because the activity was created in portrait, inflated the portrait layout, and
             then the landscape request arrived as a config change these flags swallowed, so
             nothing re-inflated. The phone is locked to landscape, so the recreate happens
             once at most and never again. -->
        <activity
            android:name=".ui.MainActivity"
            android:screenOrientation="unspecified"
            android:banner="@drawable/tv_banner"
            android:label="@string/app_name"
            android:configChanges="keyboardHidden|uiMode|density"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        
        <activity
            android:name=".player.stabilized.PlayerActivity"
            android:screenOrientation="sensorLandscape"
            android:label="Player"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode"
            android:exported="false"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:launchMode="singleTop"
            android:taskAffinity="${applicationId}" />
        
        <!--
          `unspecified`, like MainActivity, because these two decide their own orientation in code.

          They asked for portrait in onCreate — before super.onCreate, which is as early as code can
          run — and it was still too late: a manifest orientation is applied by the system when the
          activity record is created, so the window was BUILT landscape and the customer watched it
          swing round to portrait a moment later. Opening a debrid movie or series flashed the wide
          layout every single time.

          Unspecified lets `usePortraitOnTouchDevices()` be the first and only answer on a phone. On
          a television it is a no-op and the display is landscape anyway, so nothing there changes.

          The PLAYER keeps its sensorLandscape — video is meant to be wide, and it never flips.
        -->
        <activity
            android:name=".ui.vod.MovieDetailActivity"
            android:screenOrientation="unspecified"
            android:label="Movie Details"
            android:theme="@style/AppTheme"
            android:exported="false" />

        <activity
            android:name=".ui.series.SeriesDetailActivity"
            android:screenOrientation="unspecified"
            android:label="Series Details"
            android:theme="@style/AppTheme"
            android:exported="false" />



        <activity
            android:name=".ui.debrid.search.DebridSearchActivity"
            android:screenOrientation="sensorLandscape"
            android:label="Search Debrid Content"
            android:theme="@style/AppTheme"
            android:exported="false"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <activity
            android:name=".ui.debrid.discover.DebridDiscoverActivity"
            android:label="Discover"
            android:theme="@style/AppTheme"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!--
          `unspecified`, like the two detail activities, because this screen decides its own
          orientation in code. It has a portrait phone layout now (the 10-foot one moved to
          layout-television/), and a manifest orientation is applied when the activity record is
          created — declared landscape here, the window would be BUILT landscape and then swung to
          portrait a moment later, which is the flash those two already documented.
        -->
        <activity
            android:name=".ui.debrid.seeall.DebridSeeAllActivity"
            android:label="See All"
            android:theme="@style/AppTheme"
            android:exported="false"
            android:screenOrientation="unspecified" />



        <activity
            android:name=".ui.recovery.RecoveryActivity"
            android:screenOrientation="unspecified"
            android:label="Recovery Mode"
            android:theme="@style/AppTheme"
            android:exported="false" />
    </application>

</manifest>
