<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Phase 3.2: Advanced TV Features - Picture-in-Picture Support -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Phase 5: MANAGE_EXTERNAL_STORAGE removed — it was declared but never used (the only
         file write, the update APK, goes to cacheDir via FileProvider). It triggers an automatic
         Play-Store policy rejection, so dropping it is a pure win. CAMERA (QR scan) and
         RECORD_AUDIO (voice search) are kept — they ARE used. -->

    <!-- In-app auto-update: hand the downloaded APK to the package installer -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".MainApplication"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:icon="@drawable/app_logo"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:taskAffinity="${applicationId}"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="31">
        
        <!-- Week 13: Disable default WorkManager initialization (using custom Configuration.Provider) -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Auto-update: exposes the downloaded APK to the package installer -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>
        
        <activity
            android:name=".ui.companion.CompanionSetupActivity"
            android:label="Connect Companion App"
            android:theme="@style/AppTheme"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".ui.licensing.ActivationActivity"
            android:label="@string/app_name"
            android:theme="@style/AppTheme"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|density" />

        <activity
            android:name=".ui.trailer.TrailerActivity"
            android:label="Trailer Player"
            android:theme="@style/Theme.AppCompat.NoActionBar"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- configChanges: survive the display-mode switches (frame-rate matching)
             the video player triggers, so the Live TV guide behind it isn't
             destroyed/recreated and the shared-player hand-back keeps working. -->
        <!-- M13: orientation/screenSize/screenLayout deliberately NOT in configChanges.
             Proven by a UI dump: sidebar_panel measured [0,844][2400,1017] (full width)
             because the activity was created in portrait, inflated the portrait layout, and
             then the landscape request arrived as a config change these flags swallowed, so
             nothing re-inflated. The phone is locked to landscape, so the recreate happens
             once at most and never again. -->
        <activity
            android:name=".ui.MainActivity"
            android:banner="@drawable/tv_banner"
            android:label="@string/app_name"
            android:configChanges="keyboardHidden|uiMode|density"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        
        <activity
            android:name=".player.stabilized.PlayerActivity"
            android:label="Player"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode"
            android:exported="false"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:launchMode="singleTop"
            android:taskAffinity="${applicationId}" />
        
        <activity
            android:name=".ui.vod.MovieDetailActivity"
            android:label="Movie Details"
            android:theme="@style/AppTheme"
            android:exported="false" />
        
        <activity
            android:name=".ui.series.SeriesDetailActivity"
            android:label="Series Details"
            android:theme="@style/AppTheme"
            android:exported="false" />



        <activity
            android:name=".ui.debrid.search.DebridSearchActivity"
            android:label="Search Debrid Content"
            android:theme="@style/AppTheme"
            android:exported="false"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <activity
            android:name=".ui.debrid.discover.DebridDiscoverActivity"
            android:label="Discover"
            android:theme="@style/AppTheme"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".ui.debrid.seeall.DebridSeeAllActivity"
            android:label="See All"
            android:theme="@style/AppTheme"
            android:exported="false"
            android:screenOrientation="landscape" />



        <activity
            android:name=".ui.settings.MediaFusionConfigActivity"
            android:label="Connect Stremio Addons"
            android:theme="@style/AppTheme"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
            
        <activity
            android:name=".ui.recovery.RecoveryActivity"
            android:label="Recovery Mode"
            android:theme="@style/AppTheme"
            android:exported="false" />
    </application>

</manifest>
