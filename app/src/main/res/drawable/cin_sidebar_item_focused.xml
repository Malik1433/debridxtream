<?xml version="1.0" encoding="utf-8"?>
<!--
  Focused sidebar item (D-pad focus): brighter gold pill with a soft outer ring.
  Stacks: outer glow halo, gold-tint fill + ring, left indicator.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer glow halo (8% gold, slightly larger) -->
    <item
        android:left="-2dp"
        android:right="-2dp"
        android:top="-2dp"
        android:bottom="-2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/cin_gold_glow_15" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Pill fill + bright gold ring -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#33D4AF37"
                android:endColor="#10D4AF37"
                android:type="linear" />
            <stroke android:width="1.5dp" android:color="@color/cin_gold_500" />
            <corners android:radius="14dp" />
        </shape>
    </item>

    <!-- Left indicator bar: brighter gold tip on focus -->
    <item
        android:width="4dp"
        android:height="32dp"
        android:gravity="start|center_vertical">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/cin_gold_50"
                android:endColor="@color/cin_gold_300"
                android:type="linear" />
            <corners android:radius="2dp" />
        </shape>
    </item>

</layer-list>
