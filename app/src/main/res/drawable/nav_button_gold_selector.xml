<?xml version="1.0" encoding="utf-8"?>
<!-- Gold Navigation Button Selector -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Selected State - Gold Gradient -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="#FFD700"
                android:endColor="#FFA500"
                android:type="linear" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#FFFFFF" />
        </shape>
    </item>
    
    <!-- Focused State - White Border with Gold Glow -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#33FFD700" /> <!-- Semi-transparent gold -->
            <corners android:radius="24dp" />
            <stroke android:width="2dp" android:color="#FFD700" />
        </shape>
    </item>
    
    <!-- Default State - Glassy Transparent -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1AFFFFFF" /> <!-- 10% White -->
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
        </shape>
    </item>
</selector>
