<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused State: Intense Gold Gradient -->
    <item android:state_focused="true">
        <layer-list>
            <!-- Outer Glow -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#66FFD700" />
                    <padding android:bottom="6dp" android:left="6dp" android:right="6dp" android:top="6dp" />
                </shape>
            </item>
            <!-- Main Body -->
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:angle="45"
                        android:startColor="#FDB931"
                        android:centerColor="#FFD700"
                        android:endColor="#FDB931"
                        android:type="linear" />
                    <stroke android:width="2dp" android:color="#FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Pressed State -->
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#CCFFD700" />
        </shape>
    </item>

    <!-- Default State: Solid Gold/White mix -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#E6FFD700" /> <!-- High Opacity Gold -->
                    <stroke android:width="1dp" android:color="#FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
