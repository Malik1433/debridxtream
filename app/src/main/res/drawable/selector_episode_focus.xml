<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused State -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#33FFD700" /> <!-- 20% Gold Tint -->
            <stroke
                android:width="3dp"
                android:color="@color/gold_primary" /> <!-- Gold Border -->
        </shape>
    </item>
    
    <!-- Selected State (Active Episode) -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#1AFFD700" />
            <stroke
                android:width="1dp"
                android:color="@color/gold_secondary" />
        </shape>
    </item>

    <!-- Default State -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#00000000" />
        </shape>
    </item>
</selector>
