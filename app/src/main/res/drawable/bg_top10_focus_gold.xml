<?xml version="1.0" encoding="utf-8"?>
<!-- Cinematic gold focus ring for top-10 trending cards. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cin_gold_glow_15" />
            <stroke android:width="3dp" android:color="@color/cin_gold_500" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="0dp" android:color="@android:color/transparent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
