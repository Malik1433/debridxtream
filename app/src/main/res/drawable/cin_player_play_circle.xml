<?xml version="1.0" encoding="utf-8"?>
<!-- Center play/pause circle (gold) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Glow halo -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#33C9A961" />
        </shape>
    </item>

    <item android:left="8dp" android:top="8dp" android:right="8dp" android:bottom="8dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="60dp"
                android:centerX="0.5"
                android:centerY="0.45"
                android:startColor="#FFE9D7A8"
                android:endColor="#FFB48A4A" />
            <stroke android:width="1dp" android:color="#33000000" />
        </shape>
    </item>

</layer-list>
