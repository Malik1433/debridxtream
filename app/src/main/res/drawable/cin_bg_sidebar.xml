<?xml version="1.0" encoding="utf-8"?>
<!--
  Modernized sidebar background.
  3-stop vertical gradient (deeper at top, fades into app bg at bottom),
  subtle gold-tinted hairline at right edge for a premium glass-on-ink feel.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base gradient (deep ink, vertical) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#10131C"
                android:centerColor="#0A0D14"
                android:endColor="#06080E"
                android:type="linear" />
        </shape>
    </item>

    <!-- Soft gold wash at the very top (warmth bleeding from the brand) -->
    <item android:height="320dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/cin_gold_glow_08"
                android:endColor="@android:color/transparent"
                android:type="linear" />
        </shape>
    </item>

    <!-- Right edge: 1dp gold-tint hairline -->
    <item android:width="1dp" android:gravity="end">
        <shape android:shape="rectangle">
            <solid android:color="#1FD4AF37" />
        </shape>
    </item>

</layer-list>
