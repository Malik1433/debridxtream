<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: Glowing Gold -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFC107"
                android:endColor="#FFD54F"
                android:angle="0" />
            <corners android:radius="12dp" />
            <stroke
                android:width="2dp"
                android:color="#FFFFFF" />
        </shape>
    </item>
    
    <!-- Pressed: Darker Gold -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#AA8A2E" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    
    <!-- Default: Premium Gold Gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#D4AF37"
                android:endColor="#AA8A2E"
                android:angle="45" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
