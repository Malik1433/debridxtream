<!-- Active (selected) nav item: Soft emerald pill background + vertical indicator -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft pill background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sidebar_emerald_soft_bg" />
            <corners android:radius="@dimen/sidebar_item_radius" />
        </shape>
    </item>
    
    <!-- Left emerald accent bar (Vertical Indicator) -->
    <item
        android:width="@dimen/sidebar_indicator_width"
        android:height="@dimen/sidebar_indicator_height"
        android:gravity="start|center_vertical"
        android:start="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/sidebar_active_emerald" />
            <corners 
                android:topLeftRadius="2dp"
                android:bottomLeftRadius="2dp"
                android:topRightRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>
</layer-list>
