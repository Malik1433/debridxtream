<!-- Pixel-Perfect Inverted Tab Sidebar Navigation Button -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- FOCUSED STATE: Layered Negative Space Design -->
    <item android:state_focused="true">
        <layer-list>
            <!-- Top Concave Wing (Bleeds upwards) -->
            <item android:top="-48dp" android:height="48dp" android:drawable="@drawable/ic_sidebar_curve_top" />
            
            <!-- Bottom Concave Wing (Bleeds downwards) -->
            <item android:bottom="-48dp" android:height="48dp" android:drawable="@drawable/ic_sidebar_curve_bottom" />

            <!-- Main Active Tab Body (Merged with Content area) -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/slate_active_tab" />
                    <!-- Right side is pill-shaped (28dp radius for 56dp height) -->
                    <corners android:topRightRadius="28dp" android:bottomRightRadius="28dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- SELECTED STATE (Active tab, not focused) -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/slate_active_tab" />
            <corners android:topRightRadius="28dp" android:bottomRightRadius="28dp" />
        </shape>
    </item>
    
    <!-- DEFAULT STATE: Transparent -->
    <item android:drawable="@android:color/transparent" />
</selector>
