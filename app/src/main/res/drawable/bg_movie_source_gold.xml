<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: Premium Gold Gradient + Glowing Border -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#4DFFD700"
                android:centerColor="#26FFD700"
                android:endColor="#0DFFD700"
                android:angle="45"
                android:type="linear"/>
            <corners android:radius="14dp" />
            <stroke 
                android:width="2.5dp" 
                android:color="#FFD700" /> <!-- Solid Gold Border -->
            <padding 
                android:bottom="2dp" 
                android:top="2dp" 
                android:left="2dp" 
                android:right="2dp"/>
        </shape>
    </item>
    
    <!-- Selected state: Subtle Gold Glow -->
    <item android:state_selected="true">
         <shape android:shape="rectangle">
            <solid android:color="#33FFD700" />
            <corners android:radius="14dp" />
            <stroke 
                android:width="1.5dp" 
                android:color="#80FFD700" />
        </shape>
    </item>
    
    <!-- Normal state: Glass-morphic surface (Subtle White Alpha) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1AFFFFFF" /> <!-- 10% White Glass -->
            <corners android:radius="14dp" />
            <stroke 
                android:width="1dp" 
                android:color="#16FFFFFF" /> <!-- Subtle white border -->
        </shape>
    </item>
</selector>
