<?xml version="1.0" encoding="utf-8"?>
<!-- Cinema Red Border Selector -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Focused State: Red Border -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#00FFFFFF" />
            <corners android:radius="12dp" />
            <stroke android:width="3dp" android:color="@color/cin_gold_500" />
        </shape>
    </item>
    
    <!-- Selected State: Silver Tint -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#1AE0E0E0" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="#E0E0E0" />
        </shape>
    </item>
    
    <!-- Default State: Transparent -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00FFFFFF" />
            <corners android:radius="12dp" />
            <stroke android:width="0dp" android:color="#00000000" />
        </shape>
    </item>
</selector>
