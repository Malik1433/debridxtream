<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer subtle border (glass edge) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1AFFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <!-- Inner dark fill with 1dp inset (creates border effect) -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#E60D1117" />
            <corners android:radius="19dp" />
        </shape>
    </item>
</layer-list>
