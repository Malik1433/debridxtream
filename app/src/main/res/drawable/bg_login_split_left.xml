<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base: deep navy-to-black cinematic gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#0A0E1A"
                android:centerColor="#101830"
                android:endColor="#1A0A28"
                android:type="linear" />
        </shape>
    </item>
    <!-- Subtle radial glow (warm emerald hint, very low opacity) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.3"
                android:centerY="0.6"
                android:gradientRadius="400dp"
                android:startColor="#0C22C55E"
                android:endColor="#00000000"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
