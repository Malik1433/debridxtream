<?xml version="1.0" encoding="utf-8"?>
<!-- Settings row background with focus state -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cin_gold_glow_15" />
            <stroke android:width="1.5dp" android:color="@color/cin_gold_500" />
            <corners android:radius="@dimen/cin_radius_md" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cin_gold_glow_15" />
            <corners android:radius="@dimen/cin_radius_md" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cin_glass_06" />
            <stroke android:width="1dp" android:color="@color/cin_stroke_subtle" />
            <corners android:radius="@dimen/cin_radius_md" />
        </shape>
    </item>
</selector>
