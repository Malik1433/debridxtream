<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/glass_card_bg_light" />
            <corners android:radius="12dp" />
            <stroke
                android:width="2dp"
                android:color="@color/brand_cyan" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/glass_card_bg_light" />
            <corners android:radius="12dp" />
            <stroke
                android:width="2dp"
                android:color="@color/brand_cyan" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/glass_card_bg" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_card_border" />
        </shape>
    </item>
</selector>
