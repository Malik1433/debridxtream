<?xml version="1.0" encoding="utf-8"?>
<!-- Channel Logo Card Background - Square 120dp -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Focused State - Blue border -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/card_border_focus" />
                    <corners android:radius="@dimen/channel_card_corner_radius" />
                </shape>
            </item>
            <item 
                android:top="@dimen/channel_card_border_width" 
                android:left="@dimen/channel_card_border_width" 
                android:right="@dimen/channel_card_border_width" 
                android:bottom="@dimen/channel_card_border_width">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ds_background_secondary" />
                    <corners android:radius="@dimen/channel_card_corner_radius" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- Selected State -->
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/card_border_focus" />
                    <corners android:radius="@dimen/channel_card_corner_radius" />
                </shape>
            </item>
            <item 
                android:top="@dimen/channel_card_border_width" 
                android:left="@dimen/channel_card_border_width" 
                android:right="@dimen/channel_card_border_width" 
                android:bottom="@dimen/channel_card_border_width">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ds_background_secondary" />
                    <corners android:radius="@dimen/channel_card_corner_radius" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- Default State -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_background_secondary" />
            <corners android:radius="@dimen/channel_card_corner_radius" />
        </shape>
    </item>
    
</selector>

