<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom up gradient (Dark at bottom) -->
    <item>
        <shape>
            <gradient
                android:angle="90"
                android:startColor="#FF000000"
                android:centerColor="#80000000"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>
    
    <!-- Left to Right gradient (Dark at left for text area) -->
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:startColor="#CC000000"
                android:centerColor="#4D000000"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
