<?xml version="1.0" encoding="utf-8"?>
<!-- Gold focus glow ring for poster cards. Soft outer halo + inner stroke. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#33D4AF37" />
        </shape>
    </item>
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="@color/cin_gold_500" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
