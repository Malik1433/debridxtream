<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/gold_primary" />
            <corners android:radius="50dp" /> <!-- Circle/Pill shape -->
            <stroke android:width="2dp" android:color="@color/gold_secondary" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#33D4AF37" />
            <corners android:radius="50dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="50dp" />
            <!-- <stroke android:width="1dp" android:color="#33FFFFFF" /> Optional border on idle -->
        </shape>
    </item>
</selector>
