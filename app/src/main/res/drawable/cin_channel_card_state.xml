<?xml version="1.0" encoding="utf-8"?>
<!-- Channel card surface (used by item_channel_horizontal/card) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Focused: bright gold border + gold halo -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#3DC9A961" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#FF1A1F2A"
                        android:endColor="#FF12161E"
                        android:angle="225" />
                    <corners android:radius="18dp" />
                    <stroke android:width="2dp" android:color="#FFC9A961" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Selected (currently-tuned channel): gold edge -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FF1A1F2A"
                android:endColor="#FF12161E"
                android:angle="225" />
            <corners android:radius="18dp" />
            <stroke android:width="1.5dp" android:color="#FFC9A961" />
        </shape>
    </item>

    <!-- Default: glass card -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#1FFFFFFF"
                android:endColor="#0AFFFFFF"
                android:angle="225" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
        </shape>
    </item>

</selector>
