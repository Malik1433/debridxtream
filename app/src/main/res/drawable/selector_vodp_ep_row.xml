<?xml version="1.0" encoding="utf-8"?>
<!-- 88dp episode row. Rest: subtle fill+stroke, radius 14; Focus: cyan .08 + 1px #00F0FF -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/vodp_ep_row_focus_bg" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/neon_cyan" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/vodp_ep_row_focus_bg" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/vodp_panel_border" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/vodp_ep_row_bg" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/vodp_ep_row_stroke" />
        </shape>
    </item>
</selector>
