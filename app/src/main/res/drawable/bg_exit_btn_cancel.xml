<?xml version="1.0" encoding="utf-8"?>
<!--
    Safe action. Focused state is a 2dp cyan ring plus a lifted fill so it is unmistakable from
    ten feet; pressed exists for touch, since the same layout serves the landscape phone.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2600F0FF" />
            <stroke android:width="2dp" android:color="#00F0FF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#2600F0FF" />
            <stroke android:width="1dp" android:color="#8000F0FF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <stroke android:width="1dp" android:color="#2EFFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
