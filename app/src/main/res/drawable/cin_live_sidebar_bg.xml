<?xml version="1.0" encoding="utf-8"?>
<!-- Live TV sidebar background (column with categories) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FF0B0E13"
                android:endColor="#FF0A0C10"
                android:angle="270" />
        </shape>
    </item>

    <!-- Right-edge gold hairline -->
    <item android:left="0dp" android:top="0dp" android:right="-1dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#1FC9A961" />
        </shape>
    </item>

</layer-list>
