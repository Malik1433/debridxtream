<?xml version="1.0" encoding="utf-8"?>
<!-- Glass card: subtle inner gradient + hairline stroke -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/cin_glass_15"
                android:endColor="@color/cin_glass_06" />
            <stroke android:width="1dp" android:color="@color/cin_stroke_subtle" />
            <corners android:radius="@dimen/cin_radius_lg" />
        </shape>
    </item>
</layer-list>
