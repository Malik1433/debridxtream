<?xml version="1.0" encoding="utf-8"?>
<!-- EPG fragment program-card (focused / now-playing / default) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#33C9A961" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#FF1A1F2A"
                        android:endColor="#FF12161E"
                        android:angle="225" />
                    <corners android:radius="14dp" />
                    <stroke android:width="2dp" android:color="#FFC9A961" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#1FFFFFFF"
                android:endColor="#0AFFFFFF"
                android:angle="225" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#1FFFFFFF" />
        </shape>
    </item>

</selector>
