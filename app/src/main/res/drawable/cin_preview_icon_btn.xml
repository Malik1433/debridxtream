<?xml version="1.0" encoding="utf-8"?>
<!-- Glass icon button (preview top bar - search/profile/fullscreen) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#33C9A961" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="oval">
                    <solid android:color="#33FFFFFF" />
                    <stroke android:width="2dp" android:color="#FFC9A961" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#33FFFFFF" />
        </shape>
    </item>

    <item>
        <shape android:shape="oval">
            <solid android:color="#1FFFFFFF" />
            <stroke android:width="1dp" android:color="#1FFFFFFF" />
        </shape>
    </item>

</selector>
