<?xml version="1.0" encoding="utf-8"?>
<!-- The row whose channel is in the dock: a 2dp cyan left edge over a faint cyan wash. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1200F0FF" />
        </shape>
    </item>
    <item android:width="2dp" android:gravity="start|fill_vertical">
        <shape android:shape="rectangle">
            <solid android:color="@color/phone_cyan" />
        </shape>
    </item>
</layer-list>
