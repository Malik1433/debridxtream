<?xml version="1.0" encoding="utf-8"?>
<!-- Sidebar Item Background with Selection State -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected State: Highlighted -->
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#33000000" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:inset="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/tv_sidebar_item_selected" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/tv_border_focus" />
                    <corners android:radius="9dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- Focused State: Light highlight -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#33000000" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:inset="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/tv_sidebar_item_hover" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/tv_border_focus" />
                    <corners android:radius="9dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- Normal State: Transparent -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#22000000" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:inset="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/tv_sidebar_item_normal" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/tv_border_subtle" />
                    <corners android:radius="9dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
