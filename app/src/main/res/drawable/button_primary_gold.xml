<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/gold_secondary"
                android:endColor="@color/gold_primary"
                android:angle="90" />
            <corners android:radius="6dp" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/gold_primary"
                android:endColor="@color/gold_secondary"
                android:angle="90" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
