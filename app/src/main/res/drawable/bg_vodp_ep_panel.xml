<?xml version="1.0" encoding="utf-8"?>
<!-- Episodes floating panel: diagonal gradient + 1px cyan edge, rounded (centered card stack).
     NOTE: gradient angle must be a multiple of 45. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/vodp_panel_grad_top"
                android:endColor="@color/vodp_panel_grad_bottom"
                android:type="linear" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/vodp_panel_border" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
