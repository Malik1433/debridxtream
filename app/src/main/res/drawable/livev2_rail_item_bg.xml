<?xml version="1.0" encoding="utf-8"?>
<!-- Rail nav item. Focused reuses Home's cyan capsule; selected (= current section) gets the
     design's faint cyan resting wash; default is transparent. Radius 16px/2. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true" android:drawable="@drawable/bg_nav_item_focused" />

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#1200F0FF" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#3300F0FF" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="8dp" />
        </shape>
    </item>

</selector>
