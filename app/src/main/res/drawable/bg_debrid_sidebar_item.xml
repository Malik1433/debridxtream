<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/sidebar_emerald_soft_bg" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <!-- Left accent line -->
            <item android:gravity="start" android:width="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/sidebar_active_emerald" />
                    <corners android:topLeftRadius="12dp" android:bottomLeftRadius="12dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
