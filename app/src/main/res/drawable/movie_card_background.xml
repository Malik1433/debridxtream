<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Drop shadow for depth -->
    <item android:bottom="8dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:startColor="#26000000"
                android:endColor="#00000000"
                android:angle="90" />
        </shape>
    </item>

    <!-- Soft ambient glow -->
    <item android:bottom="4dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#1AFFFFFF" />
        </shape>
    </item>

    <!-- Main card surface with subtle vertical gradient -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:startColor="#FF2E3143"
                android:centerColor="#FF232536"
                android:endColor="#FF1A1B29"
                android:angle="270" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>

</layer-list>

