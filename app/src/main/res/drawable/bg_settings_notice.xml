<?xml version="1.0" encoding="utf-8"?>
<!-- The amber strip's ground: tinted, not filled, so it reads as a note on the panel (G4). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1AFFAA00" />
    <stroke
        android:width="1dp"
        android:color="#4DFFAA00" />
    <corners android:radius="12dp" />
</shape>
