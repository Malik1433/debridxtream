<?xml version="1.0" encoding="utf-8"?>
<!-- Circular Background for Category Icons/Flags -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#33000000" />
                </shape>
            </item>
            <item android:inset="1dp">
                <shape android:shape="oval">
                    <solid android:color="@color/tv_bg_card_selected" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/tv_border_focus" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#33000000" />
                </shape>
            </item>
            <item android:inset="1dp">
                <shape android:shape="oval">
                    <solid android:color="@color/tv_bg_card_hover" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/tv_border_focus" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#22000000" />
                </shape>
            </item>
            <item android:inset="1dp">
                <shape android:shape="oval">
                    <solid android:color="@color/tv_bg_card" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/tv_border_subtle" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
