<?xml version="1.0" encoding="utf-8"?>
<!-- Stream row: transparent by default, cyan-tinted with a glow border on focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="#1000F0FF" />
            <stroke android:width="1dp" android:color="#8000F0FF" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="#0A00F0FF" />
            <stroke android:width="1dp" android:color="#4000F0FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="#00000000" />
        </shape>
    </item>
</selector>
