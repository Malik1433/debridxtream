<?xml version="1.0" encoding="utf-8"?>
<!-- Flat glass button active/pressed -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="180"
                android:startColor="#2374F8"
                android:centerColor="#1F6DE9"
                android:endColor="#1B5ED0" />
            <stroke android:width="1.6dp" android:color="#6EC6FF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#29FFFFFF"
                android:centerColor="#0EFFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
