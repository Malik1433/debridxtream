    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/cin_radius_xl" />
            <solid android:color="@color/cin_ink_500" />
            <stroke android:width="1dp" android:color="@color/cin_stroke_subtle" />
        </shape>
    </item>
</layer-list>
