<?xml version="1.0" encoding="utf-8"?>
<!-- Every episode row reserves the 2dp left border transparently, so the NEXT UP row can colour
     it without shifting the whole list sideways. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item android:width="2dp" android:gravity="start|fill_vertical">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
