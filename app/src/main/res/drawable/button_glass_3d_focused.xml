<?xml version="1.0" encoding="utf-8"?>
<!-- Flat glass button focused -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="180"
                android:startColor="#1F6DE9"
                android:centerColor="#1A5BD0"
                android:endColor="#154FAA" />
            <stroke android:width="1.6dp" android:color="#6ABEF8" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#28FFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
