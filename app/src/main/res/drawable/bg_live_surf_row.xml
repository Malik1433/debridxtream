<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A00F0FF" />
            <stroke android:width="1dp" android:color="@color/neon_cyan" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <!-- Currently playing row -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#1400F0FF" />
            <stroke android:width="1dp" android:color="#4700F0FF" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#05FFFFFF" />
            <stroke android:width="1dp" android:color="#0DFFFFFF" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
