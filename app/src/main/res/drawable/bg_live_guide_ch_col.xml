<?xml version="1.0" encoding="utf-8"?>
<!-- TV-Guide channel column: faint tint + 1dp right divider (Live Player v2). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0AFFFFFF" />
        </shape>
    </item>
    <item
        android:width="1dp"
        android:gravity="end">
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
        </shape>
    </item>
</layer-list>
