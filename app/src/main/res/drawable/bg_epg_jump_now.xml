<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/epg_focus_bg" />
            <corners android:radius="23dp" />
            <stroke android:width="1dp" android:color="@color/epg_cyan" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E60B1019" />
            <corners android:radius="23dp" />
            <stroke android:width="1dp" android:color="#66FF3355" />
        </shape>
    </item>
</selector>
