<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" /> <!-- 20% white -->
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="#4A90E2" /> <!-- Focus color -->
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1AFFFFFF" /> <!-- 10% white -->
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#0DFFFFFF" /> <!-- 5% white border -->
        </shape>
    </item>
</selector>
