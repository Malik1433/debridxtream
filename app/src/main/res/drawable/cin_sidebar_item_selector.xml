<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:drawable="@drawable/cin_sidebar_item_focused" />
    <item android:state_pressed="true" android:drawable="@drawable/cin_sidebar_item_focused" />
    <item android:state_selected="true" android:drawable="@drawable/cin_sidebar_item_active" />
    <item android:state_activated="true" android:drawable="@drawable/cin_sidebar_item_active" />
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/cin_radius_md" />
        </shape>
    </item>
</selector>
