<?xml version="1.0" encoding="utf-8"?>
<!-- Sidebar category row (default / focused / selected) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Selected + focused: gold pill with bright outline -->
    <item android:state_selected="true" android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#33C9A961" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#FFC9A961"
                        android:endColor="#FFB48A4A"
                        android:angle="225" />
                    <corners android:radius="12dp" />
                    <stroke android:width="2dp" android:color="#FFFAEFCB" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Selected only: solid gold pill -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFC9A961"
                android:endColor="#FFB48A4A"
                android:angle="225" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#33000000" />
        </shape>
    </item>

    <!-- Focused only (D-pad on non-selected row) -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#33C9A961" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#1FFFFFFF" />
                    <corners android:radius="12dp" />
                    <stroke android:width="2dp" android:color="#FFC9A961" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Pressed -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Default -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="12dp" />
        </shape>
    </item>

</selector>
