<?xml version="1.0" encoding="utf-8"?>
<!-- Gold Border Selector for Cinematic Cards -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Focused State: Gold Border + Glow Effect -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#00FFFFFF" /> <!-- Transparent fill -->
            <corners android:radius="12dp" />
            <stroke android:width="3dp" android:color="#FFD700" /> <!-- Gold Border -->
        </shape>
    </item>
    
    <!-- Selected State -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#1AFFD700" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="#FFD700" />
        </shape>
    </item>
    
    <!-- Default State: Transparent/No Border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00FFFFFF" />
            <corners android:radius="12dp" />
            <stroke android:width="0dp" android:color="#00000000" />
        </shape>
    </item>
</selector>
