<?xml version="1.0" encoding="utf-8"?>
<!-- 64x40 channel logo tile. Logos are wide, transparent and often missing, so the tile is a
     surface the bitmap sits INSIDE rather than a frame it fills. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="4dp" />
    <solid android:color="#0DFFFFFF" />
    <stroke android:width="1dp" android:color="#12FFFFFF" />
</shape>
