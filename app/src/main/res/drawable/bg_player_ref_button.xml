<?xml version="1.0" encoding="utf-8"?>
<!-- VOD Player redesign: 72dp glass control button. Rest: rgba(12,17,27,.55)+1px white .08; Focus: cyan .10 + 1px #00F0FF -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/vodp_ctl_focus_bg" />
            <corners android:radius="7dp" />
            <stroke android:width="1dp" android:color="@color/neon_cyan" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/vodp_ctl_focus_bg" />
            <corners android:radius="7dp" />
            <stroke android:width="1dp" android:color="@color/neon_cyan" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/vodp_ctl_bg" />
            <corners android:radius="7dp" />
            <stroke android:width="1dp" android:color="@color/vodp_ctl_stroke" />
        </shape>
    </item>
</selector>
