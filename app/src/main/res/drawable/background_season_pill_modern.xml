<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- FOCUSED State (D-PAD Navigation) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#FFFFFF" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
        </shape>
    </item>

    <!-- SELECTED State (Current Season) -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:startColor="#E50914"
                android:endColor="#B81D24"
                android:angle="45" />
            <stroke android:width="0dp" android:color="@android:color/transparent" />
        </shape>
    </item>

    <!-- DEFAULT State -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#33FFFFFF" /> <!-- Semi-transparent glass effect -->
            <stroke android:width="1dp" android:color="#66FFFFFF" />
        </shape>
    </item>
</selector>
