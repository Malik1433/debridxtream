<?xml version="1.0" encoding="utf-8"?>
<!-- Navigation Button Selector - Professional Design System -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Selected/Active State - Red background with gold indicator -->
    <item android:state_selected="true">
        <layer-list>
            <!-- Background -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/nav_button_active_bg" />
                    <corners android:radius="@dimen/nav_button_corner_radius" />
                </shape>
            </item>
            <!-- Gold indicator line at bottom -->
            <item android:bottom="0dp" android:top="45dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/nav_indicator_color" />
                    <size android:height="@dimen/nav_indicator_height" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- Focused State - Blue border with hover background -->
    <item android:state_focused="true">
        <layer-list>
            <!-- Blue focus border -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/focus_border_color" />
                    <corners android:radius="@dimen/nav_button_corner_radius" />
                </shape>
            </item>
            <!-- Inner hover background -->
            <item 
                android:top="@dimen/content_card_border_width_hover" 
                android:left="@dimen/content_card_border_width_hover" 
                android:right="@dimen/content_card_border_width_hover" 
                android:bottom="@dimen/content_card_border_width_hover">
                <shape android:shape="rectangle">
                    <solid android:color="@color/nav_button_hover_bg" />
                    <corners android:radius="@dimen/nav_button_corner_radius" />
                </shape>
            </item>
        </layer-list>
    </item>
    
    <!-- Default State -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/nav_button_default_bg" />
            <corners android:radius="@dimen/nav_button_corner_radius" />
        </shape>
    </item>
    
</selector>

