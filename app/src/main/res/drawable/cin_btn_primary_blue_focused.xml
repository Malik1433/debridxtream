<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow halo (Blue) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#403B82F6" />
            <corners android:radius="@dimen/cin_radius_lg" />
        </shape>
    </item>
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
            android:angle="270"
            android:startColor="#F0F7FF"
            android:centerColor="#DBEAFE"
            android:endColor="#BFDBFE" />
            <corners android:radius="@dimen/cin_radius_md" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>
