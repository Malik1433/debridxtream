<?xml version="1.0" encoding="utf-8"?>
<!-- "NOW" EPG card - gold gradient surface, dark text -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFD9A75A"
                android:endColor="#FFC9A961"
                android:angle="225" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#33000000" />
        </shape>
    </item>

    <!-- Top-edge highlight -->
    <item android:bottom="44dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#33FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270" />
            <corners android:radius="14dp" />
        </shape>
    </item>

</layer-list>
