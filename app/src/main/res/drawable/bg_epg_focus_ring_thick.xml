<?xml version="1.0" encoding="utf-8"?>
<!-- Focus ring for the (scaled-down) persistent video bridge: drawn at ~0.3x
     scale in mini mode, so the stroke is thick to stay clearly visible. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <corners android:radius="24dp" />
    <stroke android:width="9dp" android:color="@color/epg_cyan" />
</shape>
