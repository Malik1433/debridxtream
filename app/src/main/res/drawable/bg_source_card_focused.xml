<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2000BCD4" /> <!-- 12% opacity Cyan tint -->
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="#00BCD4" /> <!-- Neon Cyan Border -->
            <padding android:bottom="4dp" android:top="4dp" android:left="4dp" android:right="4dp"/>
        </shape>
    </item>
    <item android:state_selected="true">
         <shape android:shape="rectangle">
            <solid android:color="#2000BCD4" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#8000BCD4" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1AFFFFFF" /> <!-- Glassy background -->
            <corners android:radius="12dp" />
            <stroke android:width="0dp" android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
