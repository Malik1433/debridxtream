<?xml version="1.0" encoding="utf-8"?>
<!-- Emerald green floating focus pill with glow effect and left accent strip -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow layer (soft emerald glow) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/sidebar_emerald_glow" />
        </shape>
    </item>

    <!-- Solid pill layer (inset for glow effect) -->
    <item android:left="8dp" android:right="8dp" android:top="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/sidebar_emerald_soft_bg" />
            <stroke android:width="1dp" android:color="@color/sidebar_active_emerald" />
        </shape>
    </item>

    <!-- Left accent bar (emerald green) -->
    <item android:width="3dp" android:left="8dp" android:top="14dp" android:bottom="14dp">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="@color/sidebar_active_emerald" />
        </shape>
    </item>
</layer-list>
