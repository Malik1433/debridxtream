<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Main Glow / Background Layer -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/sidebar_pill_glow" />
        </shape>
    </item>
    
    <!-- Solid Pill Layer (Slightly smaller to create soft glow effect if needed, but here we use a solid capsule) -->
    <item android:left="8dp" android:right="8dp" android:top="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/sidebar_pill_base" />
        </shape>
    </item>

    <!-- Left Accent Line -->
    <item android:width="4dp" android:left="8dp" android:top="14dp" android:bottom="14dp">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="@color/sidebar_accent_line" />
        </shape>
    </item>
</layer-list>
