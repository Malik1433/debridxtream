<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Focused State: Gold Glow with White Stroke -->
    <item android:state_focused="true">
        <layer-list>
            <!-- Gold Outline -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#FFD700" />
                    <corners android:radius="50dp"/>
                </shape>
            </item>
            <!-- White Stroke Highlighting -->
            <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="oval">
                    <solid android:color="#2A2A2A" /> <!-- Dark bg for icon -->
                    <stroke android:width="2dp" android:color="@android:color/white"/>
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Pressed State -->
    <item android:state_pressed="true">
        <shape android:shape="oval">
             <solid android:color="#40FFFFFF" />
        </shape>
    </item>
    
    <!-- Default State: Transparent/Subtle -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#1AFFFFFF" /> <!-- Subtle glass background -->
        </shape>
    </item>
</selector>
