<?xml version="1.0" encoding="utf-8"?>
<!--
    Player info bar surface - used by EPG overlay + VOD overlay.
    Glass surface with hairline gold border + outer shadow.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer shadow -->
    <item android:left="6dp" android:top="8dp" android:right="6dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#80000000" />
            <corners android:radius="22dp" />
        </shape>
    </item>

    <!-- Glass surface with subtle gradient -->
    <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#F00F1014"
                android:endColor="#E812151B"
                android:angle="270" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#1AC9A961" />
        </shape>
    </item>

    <!-- Top hairline highlight -->
    <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#1AFFFFFF"
                android:endColor="#00000000"
                android:angle="270" />
            <corners android:radius="22dp" />
        </shape>
    </item>

</layer-list>
