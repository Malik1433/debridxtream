<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Left vertical bar indicator (4dp wide) -->
    <item android:left="0dp" android:width="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_accent_red" />
        </shape>
    </item>
    <!-- Background -->
    <item android:left="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_background_tertiary" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>

