<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <!-- Focus Border -->
            <stroke android:width="3dp" android:color="@color/mc_focus_border" />
            <corners android:radius="12dp" />
            <!-- Inner Glow (Simulated with solid fill for now, actual glow needs elevation/shadow) -->
            <solid android:color="@color/mc_glass_surface" /> 
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <converted-corners android:radius="12dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
