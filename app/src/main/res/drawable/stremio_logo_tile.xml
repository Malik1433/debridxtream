<?xml version="1.0" encoding="utf-8"?>
<!-- Logo tile 48px/2=24dp, radius 13px/2=6.5dp, gradient 135deg blue->cyan -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="6.5dp" />
    <gradient
        android:angle="315"
        android:startColor="#0077FF"
        android:endColor="#00F0FF"
        android:type="linear" />
</shape>
