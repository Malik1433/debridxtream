<?xml version="1.0" encoding="utf-8"?>
<!--
  G4: the filled button on a destructive confirmation.

  Flat danger red rather than the cyan gradient the primary button wears — the two must never be
  mistaken for each other at a glance, and a gradient reads as "the friendly one".
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="10dp" />
    <solid android:color="@color/phone_red" />
</shape>
