<?xml version="1.0" encoding="utf-8"?>
<!-- Channel row. Focused = rgba(0,240,255,0.08) + cyan border; selected (= previewing)
     keeps a dim cyan edge; default = rgba(12,17,27,0.7) + faint border. Radius 16px/2. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Focused: a layered cyan "glow" that stays inside the row bounds (an outer elevation
         shadow would be clipped by the list). Outer soft ring + bright inner border + wash. -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#2600F0FF" />
                    <corners android:radius="11dp" />
                    <stroke android:width="2dp" android:color="#5C00F0FF" />
                </shape>
            </item>
            <item android:left="1.5dp" android:top="1.5dp" android:right="1.5dp" android:bottom="1.5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="9dp" />
                    <stroke android:width="1dp" android:color="@color/stremio_cyan" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#0D00F0FF" />
            <corners android:radius="11dp" />
            <stroke android:width="1dp" android:color="#4D00F0FF" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#B30C111B" />
            <corners android:radius="11dp" />
            <stroke android:width="1dp" android:color="#0FFFFFFF" />
        </shape>
    </item>

</selector>
