<?xml version="1.0" encoding="utf-8"?>
<!-- Search pill: focused/activated (open) = cyan; default matches the category chips. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2600F0FF" />
            <corners android:radius="15dp" />
            <stroke android:width="1dp" android:color="@color/stremio_cyan" />
        </shape>
    </item>

    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A00F0FF" />
            <corners android:radius="15dp" />
            <stroke android:width="1dp" android:color="#6600F0FF" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#08FFFFFF" />
            <corners android:radius="15dp" />
            <stroke android:width="1dp" android:color="#0FFFFFFF" />
        </shape>
    </item>

</selector>
