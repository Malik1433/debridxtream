<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#F6DD8A"
                android:centerColor="#E8B94A"
                android:endColor="#B8851D"
                android:angle="135" />
            <corners android:radius="10dp" />
            <padding android:left="22dp" android:right="22dp" android:top="10dp" android:bottom="10dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1AE8B94A" />
            <stroke android:width="2dp" android:color="#E8B94A" />
            <corners android:radius="10dp" />
            <padding android:left="22dp" android:right="22dp" android:top="10dp" android:bottom="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0AFFFFFF" />
            <stroke android:width="1dp" android:color="#14FFFFFF" />
            <corners android:radius="10dp" />
            <padding android:left="22dp" android:right="22dp" android:top="10dp" android:bottom="10dp" />
        </shape>
    </item>
</selector>
