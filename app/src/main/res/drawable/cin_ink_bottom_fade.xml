<?xml version="1.0" encoding="utf-8"?>
<!--
  Bottom fade — pure ink at the bottom, transparent at the top.
  Lets the rails read as sitting on solid ground while the hero image fades smoothly.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="@color/cin_ink_900"
        android:centerColor="#A6050608"
        android:endColor="@android:color/transparent"
        android:type="linear" />
</shape>
