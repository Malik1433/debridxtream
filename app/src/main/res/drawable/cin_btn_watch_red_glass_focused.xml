<?xml version="1.0" encoding="utf-8"?>
<!-- Premium Cinema Red Glass — Focused State -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Crimson Glow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#40E53935" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Main Button -->
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FF5252"
                android:centerColor="#F44336"
                android:endColor="#D32F2F"
                android:type="linear" />
            <corners android:radius="12dp" />
            <stroke android:width="1.5dp" android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>
