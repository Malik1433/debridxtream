<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused State: Gold Glow Ring with Gradient Center -->
    <item android:state_focused="true">
        <layer-list>
            <!-- Outer Glow -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#4DFFD700" /> <!-- 30% Gold -->
                    <padding android:bottom="8dp" android:left="8dp" android:right="8dp" android:top="8dp" />
                </shape>
            </item>
            <!-- Border Ring -->
            <item>
                <shape android:shape="oval">
                    <stroke android:width="2dp" android:color="#FFD700" />
                    <solid android:color="#33000000" />
                </shape>
            </item>
            <!-- Icon Tint handled in Layout or via separate drawable -->
        </layer-list>
    </item>

    <!-- Pressed State -->
    <item android:state_pressed="true">
         <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#80FFD700" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Default State: Transparent with White Border -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#4D000000" /> <!-- Semi-transparent black -->
                    <stroke android:width="1dp" android:color="#4DFFFFFF" /> <!-- 30% White -->
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
