<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary CW action chip (Remove) — outlined cyan glass, brightens on focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2600F0FF" />
            <stroke android:width="1dp" android:color="#00F0FF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#2600F0FF" />
            <stroke android:width="1dp" android:color="#00F0FF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14E9F6FF" />
            <stroke android:width="1dp" android:color="#3DBFE9FF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>
