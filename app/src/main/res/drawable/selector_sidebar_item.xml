<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <!-- Selected state handled by internal indicator view, but icons will tint -->
            <solid android:color="#1A00BCD4" /> <!-- 10% Cyan backdrop for selected -->
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_focused="true" android:drawable="@drawable/bg_sidebar_item_focused" />
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
