<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#24E8B94A" />
            <stroke android:width="1dp" android:color="#66E8B94A" />
            <corners android:radius="9dp" />
            <padding android:left="14dp" android:right="14dp" android:top="6dp" android:bottom="6dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1AE8B94A" />
            <stroke android:width="2dp" android:color="#E8B94A" />
            <corners android:radius="9dp" />
            <padding android:left="14dp" android:right="14dp" android:top="6dp" android:bottom="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0AFFFFFF" />
            <stroke android:width="1dp" android:color="#14FFFFFF" />
            <corners android:radius="9dp" />
            <padding android:left="14dp" android:right="14dp" android:top="6dp" android:bottom="6dp" />
        </shape>
    </item>
</selector>
