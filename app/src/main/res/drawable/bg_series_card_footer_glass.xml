<?xml version="1.0" encoding="utf-8"?>
<!-- Glass footer overlaid inside the poster bottom.
     Design: linear-gradient(to top,
        rgba(6,9,14,0.98) 0%, rgba(6,9,14,0.82) 55%, transparent 100%).
     angle=90 => start color anchored at the bottom. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#FA06090E"
        android:centerColor="#D106090E"
        android:endColor="#0006090E"
        android:centerY="0.45"
        android:angle="90" />
</shape>
