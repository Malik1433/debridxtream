<?xml version="1.0" encoding="utf-8"?>
<!-- Profile avatar 36px/2=18dp, radius 9px/2=4.5dp, gradient 135deg purple->purple-light -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="4.5dp" />
    <gradient
        android:angle="315"
        android:startColor="#7C3AED"
        android:endColor="#A78BFA"
        android:type="linear" />
</shape>
