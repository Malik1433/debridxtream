<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    
    <!-- IPTV Data Category -->
    <PreferenceCategory
        android:title="📡 IPTV Data"
        android:key="category_iptv_data">
        
        <Preference
            android:key="refresh_now"
            android:title="Refresh Now"
            android:summary="Update all IPTV data (channels, movies, series)"
            app:iconSpaceReserved="false" />
        
        <ListPreference
            android:key="refresh_interval"
            android:title="Update Interval"
            android:summary="How often to check for updates"
            android:entries="@array/refresh_interval_entries"
            android:entryValues="@array/refresh_interval_values"
            android:defaultValue="24"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />
        
    </PreferenceCategory>
    
    <!-- EPG Settings Category -->
    <PreferenceCategory
        android:title="📅 EPG Settings"
        android:key="category_epg_settings">
        
        <SwitchPreferenceCompat
            android:key="epg_auto_sync"
            android:title="Auto EPG Sync"
            android:summary="Automatically refresh EPG in background"
            android:defaultValue="true"
            app:iconSpaceReserved="false" />
        
        <ListPreference
            android:key="epg_sync_interval"
            android:title="EPG Sync Interval"
            android:summary="How often to refresh EPG data"
            android:entries="@array/epg_sync_interval_entries"
            android:entryValues="@array/epg_sync_interval_values"
            android:defaultValue="6"
            android:dependency="epg_auto_sync"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />
        
        <SwitchPreferenceCompat
            android:key="epg_network_only"
            android:title="WiFi Only"
            android:summary="Sync EPG only when connected to WiFi"
            android:defaultValue="true"
            android:dependency="epg_auto_sync"
            app:iconSpaceReserved="false" />
        
        <SwitchPreferenceCompat
            android:key="epg_battery_saver"
            android:title="Battery Saver"
            android:summary="Skip sync when battery is low"
            android:defaultValue="true"
            android:dependency="epg_auto_sync"
            app:iconSpaceReserved="false" />
        
        <Preference
            android:key="epg_sync_now"
            android:title="Sync EPG Now"
            android:summary="Manually fetch EPG data"
            app:iconSpaceReserved="false" />
        
        <Preference
            android:key="epg_last_sync"
            android:title="Last Sync"
            android:summary="Never synced"
            android:selectable="false"
            app:iconSpaceReserved="false" />
        
        <Preference
            android:key="epg_sync_status"
            android:title="Sync Status"
            android:summary="Checking..."
            android:selectable="false"
            app:iconSpaceReserved="false" />
        
    </PreferenceCategory>
    
    <!-- Performance Category -->
    <PreferenceCategory
        android:title="⚡ Performance"
        android:key="category_performance">
        
        <Preference
            android:key="clear_cache"
            android:title="Clear Cache"
            android:summary="Clear all cached data"
            app:iconSpaceReserved="false" />
        
        <SwitchPreferenceCompat
            android:key="performance_monitoring"
            android:title="Performance Monitoring"
            android:summary="Track performance metrics (for debugging)"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />
        
    </PreferenceCategory>
    
    <!-- Developer Options Category -->
    <PreferenceCategory
        android:title="👨‍💻 Developer Options"
        android:key="category_developer_options">

        <SwitchPreferenceCompat
            android:key="enable_series_v2_engine"
            android:title="Enable Series V2 Engine"
            android:summary="Use the new high-performance series engine (Requires Restart)"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <!-- Account Category -->
    <PreferenceCategory
        android:title="Account"
        android:key="category_account">

        <Preference
            android:key="logout"
            android:title="Logout"
            android:summary="Sign out of this account"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <!-- About Category -->
    <PreferenceCategory
        android:title="ℹ️ About"
        android:key="category_about">
        
        <Preference
            android:key="app_version"
            android:title="App Version"
            android:summary="1.0.0 (Week 14)"
            android:selectable="false"
            app:iconSpaceReserved="false" />
        
        <Preference
            android:key="app_info"
            android:title="Application"
            android:summary="Debrid Xtream IPTV Player"
            android:selectable="false"
            app:iconSpaceReserved="false" />
        
    </PreferenceCategory>
    
</PreferenceScreen>

