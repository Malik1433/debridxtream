<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    
    <!-- EPG Sync Settings Category -->
    <PreferenceCategory
        android:title="EPG Background Sync"
        android:key="category_epg_sync">
        
        <!-- Sync Enable/Disable -->
        <SwitchPreferenceCompat
            android:key="epg_sync_enabled"
            android:title="Auto EPG Sync"
            android:summary="Automatically refresh EPG data in background"
            android:defaultValue="true"
            app:iconSpaceReserved="false" />
        
        <!-- Sync Interval -->
        <ListPreference
            android:key="epg_sync_interval"
            android:title="Sync Interval"
            android:summary="How often to refresh EPG data"
            android:entries="@array/epg_sync_interval_entries"
            android:entryValues="@array/epg_sync_interval_values"
            android:defaultValue="6"
            android:dependency="epg_sync_enabled"
            app:iconSpaceReserved="false" />
        
        <!-- Network Only -->
        <SwitchPreferenceCompat
            android:key="epg_sync_network_only"
            android:title="Network Required"
            android:summary="Sync only when connected to network"
            android:defaultValue="true"
            android:dependency="epg_sync_enabled"
            app:iconSpaceReserved="false" />
        
        <!-- Battery Optimization -->
        <SwitchPreferenceCompat
            android:key="epg_sync_battery_saver"
            android:title="Battery Saver"
            android:summary="Skip sync when battery is low"
            android:defaultValue="true"
            android:dependency="epg_sync_enabled"
            app:iconSpaceReserved="false" />
        
        <!-- Manual Sync Button -->
        <Preference
            android:key="epg_sync_now"
            android:title="Sync Now"
            android:summary="Manually trigger EPG refresh"
            app:iconSpaceReserved="false" />
        
        <!-- Last Sync Time (read-only) -->
        <Preference
            android:key="epg_last_sync"
            android:title="Last Sync"
            android:summary="Never synced"
            android:selectable="false"
            app:iconSpaceReserved="false" />
        
        <!-- Sync Status (read-only) -->
        <Preference
            android:key="epg_sync_status"
            android:title="Status"
            android:summary="Checking..."
            android:selectable="false"
            app:iconSpaceReserved="false" />
        
    </PreferenceCategory>
    
    <!-- Performance Settings Category -->
    <PreferenceCategory
        android:title="Performance"
        android:key="category_performance">
        
        <!-- Cache Settings -->
        <Preference
            android:key="clear_cache"
            android:title="Clear Cache"
            android:summary="Clear all cached data (EPG, thumbnails, etc.)"
            app:iconSpaceReserved="false" />
        
        <!-- Performance Monitoring -->
        <SwitchPreferenceCompat
            android:key="performance_monitoring"
            android:title="Performance Monitoring"
            android:summary="Track app performance metrics (for debugging)"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />
        
    </PreferenceCategory>
    
    <!-- About Category -->
    <PreferenceCategory
        android:title="About"
        android:key="category_about">
        
        <Preference
            android:key="app_version"
            android:title="App Version"
            android:summary="1.0.0 (Week 14)"
            android:selectable="false"
            app:iconSpaceReserved="false" />
        
        <Preference
            android:key="app_info"
            android:title="Application Info"
            android:summary="Debrid Xtream IPTV Player"
            android:selectable="false"
            app:iconSpaceReserved="false" />
        
    </PreferenceCategory>
    
</PreferenceScreen>

