<?xml version="1.0" encoding="utf-8"?>
<!--
  The languages this app ships. Android 13+ reads this to offer DebridXtream in its own
  per-app language screen; the app's Settings → Home Screen → App Language does the same job
  on every version, which is what a Fire TV needs.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="de" />
    <locale android:name="fr" />
    <locale android:name="es" />
    <locale android:name="it" />
    <locale android:name="pt" />
</locale-config>
