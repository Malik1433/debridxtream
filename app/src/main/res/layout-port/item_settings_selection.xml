<?xml version="1.0" encoding="utf-8"?>
<!--
  M6: a Settings value row on the PHONE.

  The landscape row puts the title and its current value side by side. That works across a TV,
  but at 411dp the value ("English (EN)" in 16sp mono) plus the chevron and their margins leave
  the title so little room that it ellipsised to "Preferred Audi…" and "Seconda…" — a setting
  whose name you cannot read is not a setting.

  So here it stacks the way Android settings do: title, then the current value underneath it,
  then the explanation. The title gets the full width and two lines. Same six ids at their
  landscape kinds and default visibilities, so SettingsDetailAdapter binds unchanged.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="@bool/rows_focusable_in_touch_mode"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginEnd="14dp"
        android:padding="8dp"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/outfit_semibold"
            android:maxLines="2"
            android:textColor="#F1F5F9"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/share_tech_mono"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:textColor="#94A3B8"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="@font/inter_regular"
            android:maxLines="2"
            android:textColor="#64748B"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/iv_chevron"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginStart="10dp"
        android:src="@drawable/ic_arrow_right"
        app:tint="#475569" />
</LinearLayout>
