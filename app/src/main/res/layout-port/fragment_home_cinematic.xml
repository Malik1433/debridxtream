<?xml version="1.0" encoding="utf-8"?>
<!--
  M2 (MOBILE_DUAL_MODE_PLAN): the PHONE home.

  Carries every id HomeFragment and its managers bind, so the whole home stays on the
  existing code path — hero rotation, Continue Watching, Top 10 rails, the device-key
  status line, the nav flyout. TV activities are landscape-locked, so this file cannot
  load there.

  Shape differences, all deliberate:
   - the left nav rail becomes a BOTTOM BAR (see layout-port/view_home_sidebar.xml);
     the scroll area is padded so the last rail is never hidden behind it;
   - the hero is a 16:9 backdrop with the text UNDER it, not text over a full-bleed
     image — at phone width the overlay style eats the poster and the title both;
   - phone-legible type (22sp hero title, 13sp body) instead of the px/2 TV scale;
   - 48dp+ touch targets on the hero buttons;
   - the D-pad hint bar is dropped (nothing to hint at on a touch screen), and the
     status strip moves to the top as a compact line.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:clipChildren="false"
    android:clipToPadding="false">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="60dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <!-- ══ Status strip ══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/tv_status_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    tools:text="9:41 AM" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tv_device_key"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:fontFamily="monospace"
                    android:textColor="#475569"
                    android:textSize="11sp"
                    tools:text="DZ5D-WKV7" />

                <TextView
                    android:id="@+id/tv_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="#00F0FF"
                    android:textSize="11sp"
                    tools:text="DEBRID" />

                <LinearLayout
                    android:id="@+id/ll_iptv_expiry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:id="@+id/iv_iptv_icon"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_live_tv"
                        android:tint="#FFAA00" />

                    <TextView
                        android:id="@+id/tv_iptv_expiry"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="monospace"
                        android:textColor="#FFAA00"
                        android:textSize="11sp"
                        tools:text="12 AUG 2026" />
                </LinearLayout>
            </LinearLayout>

            <!-- ══ Hero ══ -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/iv_hero_background"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:background="@drawable/gradient_hero_lr" />

                <!-- Page dots sit on the artwork. -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/dot_hero_0"
                        android:layout_width="18dp"
                        android:layout_height="3dp"
                        android:background="@drawable/bg_hero_dot_active" />

                    <View
                        android:id="@+id/dot_hero_1"
                        android:layout_width="6dp"
                        android:layout_height="3dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_hero_dot" />

                    <View
                        android:id="@+id/dot_hero_2"
                        android:layout_width="6dp"
                        android:layout_height="3dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_hero_dot" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/hero_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp">

                <TextView
                    android:id="@+id/tv_hero_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.03"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="#F1F5F9"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="Spider-Man: Brand New Day" />

                <TextView
                    android:id="@+id/tv_hero_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="monospace"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    tools:text="8.0 ★ · 2026 · Sci-Fi" />

                <TextView
                    android:id="@+id/tv_hero_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter"
                    android:maxLines="3"
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    tools:text="Fighting crime full-time as Spider-Man in a world that doesn't remember him." />

                <!-- Hero actions. The glow views keep their ids (the focus animator writes
                     to them) but are inert under touch. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <View
                            android:id="@+id/glow_hero_watch"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:alpha="0"
                            android:visibility="invisible" />

                        <LinearLayout
                            android:id="@+id/btn_hero_watch"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@drawable/bg_hero_play_gradient"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_play"
                                android:tint="#041014" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Play Now"
                                android:textColor="#041014"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1">

                        <View
                            android:id="@+id/glow_hero_details"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:alpha="0"
                            android:visibility="invisible" />

                        <LinearLayout
                            android:id="@+id/btn_hero_details"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@drawable/bg_hero_glass_btn"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="More Info"
                                android:textColor="#F1F5F9"
                                android:textSize="15sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp">

                        <View
                            android:id="@+id/glow_hero_fav"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:alpha="0"
                            android:visibility="invisible" />

                        <FrameLayout
                            android:id="@+id/btn_hero_fav"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:background="@drawable/bg_hero_glass_btn"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="Add to favourites"
                                android:src="@drawable/ic_favorite_border"
                                android:tint="#F1F5F9" />
                        </FrameLayout>
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ══ Continue Watching ══ -->
            <LinearLayout
                android:id="@+id/section_continue_watching"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="16dp"
                        android:background="@drawable/bg_login_accent_bar" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Continue Watching"
                        android:textColor="#F1F5F9"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_count_continue_watching"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="monospace"
                        android:textColor="#475569"
                        android:textSize="11sp"
                        tools:text="7 TITLES" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_continue_watching"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingHorizontal="16dp" />
            </LinearLayout>

            <!-- ══ Top 10 Movies ══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="16dp"
                        android:background="@drawable/bg_login_accent_bar" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Trending Movies"
                        android:textColor="#F1F5F9"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_count_top_10_movies"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="monospace"
                        android:textColor="#475569"
                        android:textSize="11sp"
                        tools:text="10 TITLES" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_top_10_movies"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingHorizontal="16dp" />
            </LinearLayout>

            <!-- ══ Top 10 Series ══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="16dp"
                        android:background="@drawable/bg_login_accent_bar" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Trending Series"
                        android:textColor="#F1F5F9"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_count_top_10_series"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="monospace"
                        android:textColor="#475569"
                        android:textSize="11sp"
                        tools:text="10 TITLES" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_top_10_series"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingHorizontal="16dp" />
            </LinearLayout>

            <!-- ══ Recent Live ══ -->
            <LinearLayout
                android:id="@+id/section_recent_live"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="24dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="16dp"
                        android:background="@drawable/bg_login_accent_bar" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Recent Channels"
                        android:textColor="#F1F5F9"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_count_recent_live"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="monospace"
                        android:textColor="#475569"
                        android:textSize="11sp"
                        tools:text="6 CHANNELS" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_recent_live_channels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingHorizontal="16dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ══ Bottom nav (the TV's left rail, re-laid) ══ -->
    <include
        android:id="@+id/sidebar_panel"
        layout="@layout/view_home_sidebar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom" />

    <!-- Flyout label for the focused nav item. Inert under touch (the bar shows labels),
         but the id must exist because HomeSidebarManager writes to it. -->
    <LinearLayout
        android:id="@+id/nav_flyout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="68dp"
        android:background="@drawable/bg_nav_flyout"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/nav_flyout_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plus_jakarta_sans"
            android:textColor="#F1F5F9"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Movies" />

        <TextView
            android:id="@+id/nav_flyout_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#64748B"
            android:textSize="10sp"
            tools:text="VOD" />
    </LinearLayout>
</FrameLayout>
