<?xml version="1.0" encoding="utf-8"?>
<!--
  M8: one programme in the phone's day guide.

  The landscape card is a TILE in a horizontal strip — `wrap_content` wide, full height. Laid
  out vertically that is the M2b/M3 trap in reverse: it would shrink to its text and leave the
  row ragged. Here it is a full-width ROW: the time on the left in a fixed column so every
  start time lines up down the page, the title beside it, and the ON AIR pill and progress bar
  where the adapter already puts them.

  All five ids at their landscape kinds and default visibilities — `tv_epg_card_onair` and
  `pb_epg_card_progress` start `gone`, and LiveEpgStripAdapter reveals them for the programme
  that is on now.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/livev2_epg_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/livev2_epg_card_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/tv_epg_card_time"
        android:layout_width="76dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/share_tech_mono"
        android:letterSpacing="0.02"
        android:maxLines="1"
        android:textColor="@color/stremio_text_secondary"
        android:textSize="13sp"
        tools:text="17:30" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_epg_card_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/outfit_semibold"
            android:maxLines="2"
            android:textColor="@color/stremio_text_muted"
            android:textSize="14sp"
            tools:text="Football : Coupe du monde" />

        <ProgressBar
            android:id="@+id/pb_epg_card_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="7dp"
            android:progressDrawable="@drawable/livev2_progress_cyan"
            android:visibility="gone"
            tools:progress="45"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_epg_card_onair"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:background="@drawable/livev2_onair_pill"
        android:fontFamily="@font/share_tech_mono"
        android:letterSpacing="0.08"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:text="@string/livev2_on_air"
        android:textSize="9sp"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
