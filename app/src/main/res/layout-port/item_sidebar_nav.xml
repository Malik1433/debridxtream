<?xml version="1.0" encoding="utf-8"?>
<!--
  M2b: the nav item for the PHONE bottom bar.

  The landscape item is `match_parent` wide because it sits in a vertical rail — under a
  horizontal LayoutManager that made ONE item swallow the whole bar (measured: a single
  796px cell). Here it is a fixed-width column instead.

  It also SHOWS its label. On TV the title is hidden and the name appears in the shared
  nav_flyout on focus; a touch bar has no focus to hang that on, so the label belongs
  under the icon — which is what every phone bottom bar does anyway.

  Same root type (ConstraintLayout) and same ids as the landscape item: data binding
  requires an id to be the same kind in every configuration of a layout.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_container"
    android:layout_width="64dp"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Active indicator: a top edge marker rather than the rail's left-edge dot. -->
    <View
        android:id="@+id/view_selection_indicator"
        android:layout_width="22dp"
        android:layout_height="2.5dp"
        android:background="@color/brand_cyan"
        android:elevation="3dp"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginTop="9dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@android:drawable/ic_menu_search" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:fontFamily="@font/plus_jakarta_sans"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#94A3B8"
        android:textSize="10sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_icon"
        tools:text="Home" />
</androidx.constraintlayout.widget.ConstraintLayout>
