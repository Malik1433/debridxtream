<?xml version="1.0" encoding="utf-8"?>
<!--
  M4b (MOBILE_DUAL_MODE_PLAN): the series detail the PHONE reaches.

  All 55 ids at their landscape KINDS with their landscape default visibilities — the
  fragment toggles nearly every one of them, so a changed default would show empty
  chrome or hide something it never turns on.

  Shape: one scrolling column (backdrop → header → plot → actions → credits → seasons
  and episodes). The TV's 410dp right-hand `panel_streams` becomes a BOTTOM SHEET: full
  width, anchored to the bottom, ~72% tall — a side panel is unusable at 411dp.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#06090E"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="24dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="210dp">

                <ImageView
                    android:id="@+id/iv_backdrop"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/gradient_cinematic_bottom" />

                <TextView
                    android:id="@+id/tv_session_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_login_chip"
                    android:fontFamily="monospace"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    tools:text="IPTV" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/container_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp">

                <TextView
                    android:id="@+id/tv_content_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.16"
                    android:textColor="#A855F7"
                    android:textSize="11sp"
                    tools:text="SERIES" />

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:textColor="#F1F5F9"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    tools:text="House of the Dragon" />

                <com.google.android.flexbox.FlexboxLayout
                    android:id="@+id/layout_metadata"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:alignItems="center"
                    app:flexWrap="wrap">

                    <LinearLayout
                        android:id="@+id/layout_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_login_chip"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/tv_rating_percentage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:textColor="#A855F7"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="8.4 ★" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/badge_imdb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_login_chip"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/tv_imdb_rating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textColor="#FFAA00"
                            android:textSize="12sp"
                            tools:text="IMDb 8.4" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/badge_rt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_login_chip"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/tv_rt_rating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textColor="#FF3355"
                            android:textSize="12sp"
                            tools:text="93%" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_year"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:textColor="#94A3B8"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:text="2024"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tv_dot_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="6dp"
                        android:text="·"
                        android:textColor="#475569"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tv_season_episode_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:textColor="#94A3B8"
                        android:textSize="13sp"
                        tools:text="2 Seasons" />

                    <TextView
                        android:id="@+id/tv_dot_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="6dp"
                        android:text="·"
                        android:textColor="#475569"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tv_genre"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:textColor="#94A3B8"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:text="Drama, Fantasy"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tv_runtime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/inter"
                        android:textColor="#94A3B8"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:text="58 MIN"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tv_age_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_login_chip"
                        android:fontFamily="monospace"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="2dp"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:visibility="gone"
                        tools:text="TV-MA"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tv_quality_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_login_chip"
                        android:fontFamily="monospace"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="2dp"
                        android:textColor="#A855F7"
                        android:textSize="11sp"
                        android:visibility="gone"
                        tools:text="4K"
                        tools:visibility="visible" />
                </com.google.android.flexbox.FlexboxLayout>

                <LinearLayout
                    android:id="@+id/layout_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_login_chip"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="9dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tv_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textColor="#00FF88"
                        android:textSize="12sp"
                        tools:text="12 SOURCES · 12 CACHED" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_plot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/inter"
                    android:lineSpacingExtra="4dp"
                    android:textColor="#94A3B8"
                    android:textSize="14sp"
                    tools:text="An internal succession war within House Targaryen…" />

                <com.google.android.flexbox.FlexboxLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:alignItems="center"
                    app:flexWrap="wrap">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_play"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/sel_login_btn_primary"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:paddingHorizontal="24dp"
                        android:text="Watch Now"
                        android:textAllCaps="false"
                        android:textColor="#041014"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_trailer"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/sel_login_btn_secondary"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:paddingHorizontal="18dp"
                        android:text="Trailer"
                        android:textAllCaps="false"
                        android:textColor="#F1F5F9"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btn_favorite"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/sel_login_btn_secondary"
                        android:contentDescription="Favourite"
                        android:padding="14dp"
                        android:src="@drawable/ic_favorite_border"
                        android:tint="#F1F5F9" />
                </com.google.android.flexbox.FlexboxLayout>

                <LinearLayout
                    android:id="@+id/layout_credits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:id="@+id/layout_director"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/tv_director_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.14"
                            android:textColor="#475569"
                            android:textSize="11sp"
                            tools:text="CREATED BY" />

                        <TextView
                            android:id="@+id/tv_director"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="@font/inter"
                            android:textColor="#F1F5F9"
                            android:textSize="14sp"
                            tools:text="Ryan Condal" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_cast"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.14"
                            android:text="CAST"
                            android:textColor="#475569"
                            android:textSize="11sp" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_cast"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:clipToPadding="false"
                            android:overScrollMode="never" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ── Seasons + episodes ── -->
            <LinearLayout
                android:id="@+id/section_episodes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_season_selector"
                        android:layout_width="wrap_content"
                        android:layout_height="46dp"
                        android:background="@drawable/sel_login_btn_secondary"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:paddingHorizontal="18dp"
                        android:text="Season 1"
                        android:textAllCaps="false"
                        android:textColor="#F1F5F9"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_season_progress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        tools:text="3 / 10 WATCHED" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_seasons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tv_episode_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="10 EPISODES"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tv_empty_episodes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/inter"
                    android:gravity="center"
                    android:textColor="#64748B"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:text="No episodes found"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/ll_episodes_loading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ProgressBar
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:indeterminateTint="#A855F7" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/inter"
                        android:text="Loading episodes…"
                        android:textColor="#94A3B8"
                        android:textSize="13sp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_episodes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

                <!-- Touch device: kept for id parity, no D-pad legend to show. -->
                <LinearLayout
                    android:id="@+id/layout_hint_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:id="@+id/layout_skeleton"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#06090E"
        android:visibility="gone" />

    <View
        android:id="@+id/view_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:visibility="gone" />

    <!-- ── Streams: a BOTTOM SHEET on the phone (410dp side panel on TV) ── -->
    <LinearLayout
        android:id="@+id/panel_streams"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:layout_marginTop="150dp"
        android:background="#0B1018"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tv_scan_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.14"
            android:textColor="#475569"
            android:textSize="10sp"
            tools:text="SCANNING…" />

        <TextView
            android:id="@+id/tv_episode_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/plus_jakarta_sans"
            android:maxLines="1"
            android:textColor="#F1F5F9"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="S01E01 · The Heirs of the Dragon" />

        <com.google.android.flexbox.FlexboxLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:alignItems="center"
            app:flexWrap="wrap">

            <TextView
                android:id="@+id/chip_quality"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/sel_login_btn_secondary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                tools:text="Quality: All" />

            <TextView
                android:id="@+id/chip_language"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/sel_login_btn_secondary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                tools:text="Language: All" />

            <TextView
                android:id="@+id/chip_container"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/sel_login_btn_secondary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                tools:text="Type: All" />
        </com.google.android.flexbox.FlexboxLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_streams"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingBottom="12dp" />

            <ProgressBar
                android:id="@+id/pb_streams"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:indeterminateTint="#A855F7"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_no_streams"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/inter"
                android:textColor="#64748B"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="No sources found"
                tools:visibility="visible" />
        </FrameLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pb_loading_central"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:indeterminateTint="#A855F7"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layout_toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_login_chip"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tv_toast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:textColor="#F1F5F9"
            android:textSize="13sp"
            tools:text="Added to favourites" />
    </LinearLayout>
</FrameLayout>
