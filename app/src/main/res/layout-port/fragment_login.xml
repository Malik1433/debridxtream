<?xml version="1.0" encoding="utf-8"?>
<!--
  M1 (MOBILE_DUAL_MODE_PLAN): the PHONE login.

  Same view ids as the landscape TV layout, so LoginFragment and its overlay
  controllers bind to this without a single code change — the resource qualifier
  does the routing. TV activities are landscape-locked, so this file can never
  load there.

  Differences from the TV layout, all deliberate:
   - one vertical column instead of the 46/54 split (branding on top, form below)
   - phone-legible type (14-16sp fields, 12sp labels) instead of the px÷2 6-9sp trick
   - 48dp touch targets on every control (TV used 32-36dp because focus, not fingers)
   - the form scrolls, so the IME can cover half the screen without trapping anything
   - overlays sized to the viewport (match_parent + margins) instead of fixed 450dp
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#06090E"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- ══ Ambient blobs (same ids, phone-scaled) ══ -->
    <View
        android:id="@+id/view_blob_1"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_marginStart="-90dp"
        android:layout_marginTop="-90dp"
        android:background="@drawable/bg_login_blob_blue" />

    <View
        android:id="@+id/view_blob_2"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-80dp"
        android:layout_marginBottom="-80dp"
        android:background="@drawable/bg_login_blob_cyan" />

    <View
        android:id="@+id/view_blob_3"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_login_blob_blue" />

    <View
        android:id="@+id/view_scanline"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:alpha="0"
        android:background="@drawable/bg_login_scanline" />

    <!-- panel_left / view_grid keep the ids the branding code binds; the grid is the
         page backdrop here rather than a left column. -->
    <FrameLayout
        android:id="@+id/panel_left"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/view_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.5" />
    </FrameLayout>

    <ScrollView
        android:id="@+id/panel_right"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="24dp"
        android:paddingTop="36dp"
        android:paddingBottom="28dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── Branding ── -->
            <LinearLayout
                android:id="@+id/ll_title_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/iv_logo"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:background="@drawable/bg_login_logo_tile"
                    android:elevation="12dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.04"
                    android:text="DX"
                    android:textColor="#041014"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_welcome_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.03"
                    android:textColor="#F1F5F9"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    tools:text="DebridXtream" />

                <TextView
                    android:id="@+id/tv_login_tagline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.22"
                    android:text="IPTV · DEBRID · 4K"
                    android:textColor="#64748B"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_login_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:textColor="#334155"
                    android:textSize="10sp"
                    tools:text="v2.2.0" />
            </LinearLayout>

            <!-- ── Form ── -->
            <LinearLayout
                android:id="@+id/card_login_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="20dp"
                        android:background="@drawable/bg_login_accent_bar" />

                    <TextView
                        android:id="@+id/tv_card_heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.02"
                        android:text="Sign In"
                        android:textColor="#F1F5F9"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_card_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/inter"
                    android:text="Enter your Xtream credentials to continue"
                    android:textColor="#64748B"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/ll_login_fields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:orientation="vertical">

                    <!-- SERVER URL -->
                    <TextView
                        android:id="@+id/tv_label_server"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.14"
                        android:text="SERVER URL"
                        android:textColor="#475569"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:id="@+id/til_server_url"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_login_field"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp">

                        <ImageView
                            android:id="@+id/iv_icon_server"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_dns"
                            android:tint="#475569" />

                        <EditText
                            android:id="@+id/et_server_url"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:fontFamily="monospace"
                            android:hint="http://server.example.tv"
                            android:imeOptions="actionNext"
                            android:importantForAutofill="no"
                            android:inputType="textUri"
                            android:letterSpacing="0.02"
                            android:maxLines="1"
                            android:textColor="#F1F5F9"
                            android:textColorHint="#94A3B8"
                            android:textCursorDrawable="@drawable/cursor_login"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <!-- USERNAME -->
                    <TextView
                        android:id="@+id/tv_label_username"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.14"
                        android:text="USERNAME"
                        android:textColor="#475569"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:id="@+id/til_username"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_login_field"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp">

                        <ImageView
                            android:id="@+id/iv_icon_username"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_person"
                            android:tint="#475569" />

                        <EditText
                            android:id="@+id/et_username"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:fontFamily="@font/inter"
                            android:hint="Username"
                            android:imeOptions="actionNext"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textColor="#F1F5F9"
                            android:textColorHint="#94A3B8"
                            android:textCursorDrawable="@drawable/cursor_login"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <!-- PASSWORD -->
                    <TextView
                        android:id="@+id/tv_label_password"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.14"
                        android:text="PASSWORD"
                        android:textColor="#475569"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:id="@+id/til_password"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_login_field"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp">

                        <ImageView
                            android:id="@+id/iv_icon_password"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_lock"
                            android:tint="#475569" />

                        <EditText
                            android:id="@+id/et_password"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:fontFamily="@font/inter"
                            android:hint="Password"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:textColor="#F1F5F9"
                            android:textColorHint="#94A3B8"
                            android:textCursorDrawable="@drawable/cursor_login"
                            android:textSize="15sp" />

                        <ImageView
                            android:id="@+id/btn_toggle_password"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:clickable="true"
                            android:contentDescription="Show password"
                            android:focusable="true"
                            android:padding="12dp"
                            android:src="@drawable/ic_eye"
                            android:tint="#64748B" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Error -->
                <LinearLayout
                    android:id="@+id/ll_login_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_login_error"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_error_circle"
                        android:tint="#FF3355" />

                    <TextView
                        android:id="@+id/tv_login_error"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter"
                        android:textColor="#FF3355"
                        android:textSize="13sp"
                        tools:text="Invalid server URL. Must start with http:// or https://" />
                </LinearLayout>

                <!-- Sign In -->
                <LinearLayout
                    android:id="@+id/btn_login"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/sel_login_btn_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_login_play"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_play"
                        android:tint="#475569" />

                    <ProgressBar
                        android:id="@+id/progress_bar"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:indeterminateTint="#041014"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tv_login_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:letterSpacing="0.04"
                        android:text="Sign In"
                        android:textColor="#475569"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- OR -->
                <LinearLayout
                    android:id="@+id/ll_or_divider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#14FFFFFF" />

                    <TextView
                        android:id="@+id/tv_or_divider"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.1"
                        android:text="OR"
                        android:textColor="#475569"
                        android:textSize="11sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#14FFFFFF" />
                </LinearLayout>

                <!-- Connect via Phone / QR -->
                <LinearLayout
                    android:id="@+id/btn_setup_phone"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/sel_login_btn_secondary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:duplicateParentState="true"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_smartphone"
                        android:tint="@color/sel_login_secondary_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:duplicateParentState="true"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Connect via Phone / QR"
                        android:textColor="@color/sel_login_secondary_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Account sign-in. On a phone this is a realistic way in (real keyboard),
                     unlike the TV where typing an email on a remote is the slow path. -->
                <LinearLayout
                    android:id="@+id/btn_account_signin"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/sel_login_btn_secondary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:duplicateParentState="true"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Sign in with your account"
                        android:textColor="@color/sel_login_secondary_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_login_device_key"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:textColor="#475569"
                    android:textSize="12sp"
                    tools:text="DEVICE KEY  DZ5D-WKV7" />

                <!-- Touch device: no D-pad legend, just a plain hint line. -->
                <TextView
                    android:id="@+id/tv_login_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:letterSpacing="0.1"
                    android:text="TAP A FIELD TO TYPE"
                    android:textColor="#334155"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ══ PHONE / QR OVERLAY ══ -->
    <FrameLayout
        android:id="@+id/qr_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E004070C"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone"
        tools:visibility="visible">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:paddingHorizontal="24dp"
            android:paddingVertical="28dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:text="Connect via Phone"
                    android:textColor="#F1F5F9"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_login_qr_card"
                    android:padding="10dp">

                    <ImageView
                        android:id="@+id/iv_qr_code"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Pairing QR code" />

                    <TextView
                        android:id="@+id/tv_qr_dx_badge"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_login_logo_tile"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="DX"
                        android:textColor="#041014"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <View
                        android:id="@+id/view_qr_scanline"
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:alpha="0"
                        android:background="@drawable/bg_login_scanline" />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="@font/inter"
                    android:gravity="center"
                    android:text="Scan with your phone, or open the link and enter the code below."
                    android:textColor="#94A3B8"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/ll_pairing_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_login_field"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/tv_pairing_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.22"
                        android:textColor="#00F0FF"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:text="DZ5D-WKV7" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/view_qr_pulse_dot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_login_dot"
                        android:backgroundTint="#00FF88" />

                    <TextView
                        android:id="@+id/tv_qr_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.08"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        tools:text="WAITING FOR PHONE" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_qr_close"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/sel_login_btn_secondary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:duplicateParentState="true"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Close"
                        android:textColor="@color/sel_login_secondary_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- ══ ACCOUNT SIGN-IN OVERLAY ══ -->
    <FrameLayout
        android:id="@+id/account_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E004070C"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone"
        tools:visibility="visible">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:paddingHorizontal="24dp"
            android:paddingVertical="28dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:text="Account Sign In"
                    android:textColor="#F1F5F9"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_account_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/inter"
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    tools:text="Sign in to load your playlists" />

                <EditText
                    android:id="@+id/et_account_email"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_login_field"
                    android:fontFamily="@font/inter"
                    android:hint="Email"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:paddingHorizontal="14dp"
                    android:textColor="#F1F5F9"
                    android:textColorHint="#94A3B8"
                    android:textCursorDrawable="@drawable/cursor_login"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/et_account_password"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_login_field"
                    android:fontFamily="@font/inter"
                    android:hint="Password"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:paddingHorizontal="14dp"
                    android:textColor="#F1F5F9"
                    android:textColorHint="#94A3B8"
                    android:textCursorDrawable="@drawable/cursor_login"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_account_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/inter"
                    android:textColor="#FF3355"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="Wrong email or password"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/btn_account_submit"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/sel_login_btn_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_account_submit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:letterSpacing="0.04"
                        android:text="Sign In"
                        android:textColor="#475569"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_account_close"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/sel_login_btn_secondary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:duplicateParentState="true"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Close"
                        android:textColor="@color/sel_login_secondary_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</FrameLayout>
