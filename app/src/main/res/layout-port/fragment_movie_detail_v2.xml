<?xml version="1.0" encoding="utf-8"?>
<!--
  M4 (MOBILE_DUAL_MODE_PLAN): the movie detail the PHONE actually reaches.

  The browse grid opens MovieDetailFragmentV2, which binds this layout through view
  binding — so this file, not fragment_movie_detail.xml (that one serves the Debrid
  activity path), is what the phone shows. Every id is present at its landscape KIND;
  default visibilities are preserved exactly, because the fragment toggles them and a
  changed default would show empty chrome.

  Shape: the TV's 480dp details column over a full-bleed backdrop becomes one scrolling
  column — backdrop, title block, plot, then a WRAPPING action row (four buttons do not
  fit a phone width in one line), credits and the similar rail.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#06090E"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="24dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp">

                <ImageView
                    android:id="@+id/iv_backdrop"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/gradient_cinematic_bottom" />

                <LinearLayout
                    android:id="@+id/layout_top_bar"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageButton
                        android:id="@+id/btn_back"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/sel_login_btn_secondary"
                        android:contentDescription="Back"
                        android:padding="10dp"
                        android:src="@drawable/ic_arrow_back"
                        android:tint="#F1F5F9"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tv_breadcrumb_type"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.14"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        tools:text="IPTV / MOVIES" />

                    <TextView
                        android:id="@+id/tv_back_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textColor="#334155"
                        android:textSize="10sp"
                        android:visibility="gone" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/group_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp">

                <TextView
                    android:id="@+id/tv_content_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.16"
                    android:textColor="#00F0FF"
                    android:textSize="11sp"
                    tools:text="FEATURE FILM" />

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:textColor="#F1F5F9"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    tools:text="The Matrix Resurrections" />

                <com.google.android.flexbox.FlexboxLayout
                    android:id="@+id/layout_metadata_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:alignItems="center"
                    app:flexWrap="wrap">

                    <TextView
                        android:id="@+id/tv_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_login_chip"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:textColor="#00F0FF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="6.3 ★" />

                    <LinearLayout
                        android:id="@+id/badge_imdb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_login_chip"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/tv_imdb_rating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textColor="#FFAA00"
                            android:textSize="12sp"
                            tools:text="IMDb 5.6" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/badge_rt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_login_chip"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/tv_rt_rating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textColor="#FF3355"
                            android:textSize="12sp"
                            tools:text="63%" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_year"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:textColor="#94A3B8"
                        android:textSize="13sp"
                        tools:text="2021" />

                    <TextView
                        android:id="@+id/tv_dot_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="6dp"
                        android:text="·"
                        android:textColor="#475569"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:textColor="#94A3B8"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:text="2H 28M"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tv_dot_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="6dp"
                        android:text="·"
                        android:textColor="#475569"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_genre"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:textColor="#94A3B8"
                        android:textSize="13sp"
                        tools:text="Science Fiction" />

                    <TextView
                        android:id="@+id/tv_age_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_login_chip"
                        android:fontFamily="monospace"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="2dp"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:visibility="gone"
                        tools:text="R"
                        tools:visibility="visible" />
                </com.google.android.flexbox.FlexboxLayout>

                <!-- Resume -->
                <LinearLayout
                    android:id="@+id/layout_resume_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ProgressBar
                        android:id="@+id/pb_resume"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:max="100"
                        android:progressTint="#00F0FF"
                        tools:progress="40" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_resume_elapsed"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"
                            tools:text="26:56" />

                        <TextView
                            android:id="@+id/tv_resume_remaining"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textColor="#64748B"
                            android:textSize="11sp"
                            tools:text="1H 57M LEFT" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_plot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/inter"
                    android:lineSpacingExtra="4dp"
                    android:textColor="#94A3B8"
                    android:textSize="14sp"
                    tools:text="Plagued by strange memories, Neo's life takes an unexpected turn…" />

                <!-- Actions. container_actions MUST stay a LinearLayout (view binding needs
                     the same kind in every configuration), so the wrapping is done by a
                     Flexbox INSIDE it rather than by changing its type. -->
                <LinearLayout
                    android:id="@+id/container_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <com.google.android.flexbox.FlexboxLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:alignItems="center"
                        app:flexWrap="wrap">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_play"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/sel_login_btn_primary"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:paddingHorizontal="24dp"
                        android:text="Watch Now"
                        android:textAllCaps="false"
                        android:textColor="#041014"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_trailer"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/sel_login_btn_secondary"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:paddingHorizontal="18dp"
                        android:text="Trailer"
                        android:textAllCaps="false"
                        android:textColor="#F1F5F9"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btn_favorite"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/sel_login_btn_secondary"
                        android:contentDescription="Favourite"
                        android:padding="14dp"
                        android:src="@drawable/ic_favorite_border"
                        android:tint="#F1F5F9" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_mark_watched"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/sel_login_btn_secondary"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:paddingHorizontal="16dp"
                        android:text="Mark Watched"
                        android:textAllCaps="false"
                        android:textColor="#94A3B8"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_watched_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_login_chip"
                        android:fontFamily="monospace"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:textColor="#00FF88"
                        android:textSize="11sp"
                        android:visibility="gone"
                        tools:text="WATCHED"
                        tools:visibility="visible" />
                    </com.google.android.flexbox.FlexboxLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_director"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.14"
                        android:text="DIRECTOR"
                        android:textColor="#475569"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_director"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/inter"
                        android:textColor="#F1F5F9"
                        android:textSize="14sp"
                        tools:text="Lana Wachowski" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_cast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_cast_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.14"
                        android:textColor="#475569"
                        android:textSize="11sp"
                        tools:text="CAST" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_cast"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:clipToPadding="false"
                        android:overScrollMode="never" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_similar_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/header_similar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.14"
                        android:textColor="#475569"
                        android:textSize="11sp"
                        tools:text="BECAUSE YOU WATCHED" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_similar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:clipToPadding="false"
                        android:overScrollMode="never" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/pb_loading_central"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="#00F0FF"
        android:visibility="gone" />
</FrameLayout>
