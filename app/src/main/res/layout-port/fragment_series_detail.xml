<?xml version="1.0" encoding="utf-8"?>
<!--
  M4 (MOBILE_DUAL_MODE_PLAN): the series detail page on the PHONE.

  Same ids at their landscape KINDS, so SeriesDetailActivity runs unchanged.

  Shape: one scrolling column — backdrop with the poster overlapping it, title block,
  actions, resume, then the season selector with the seasons rail and the episode list.
  The episode list keeps nestedScrollingEnabled=false so the page scrolls as one.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#06090E"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="24dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── Backdrop + poster ── -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/iv_backdrop"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:background="@drawable/gradient_cinematic_bottom" />

                <ImageView
                    android:id="@+id/iv_poster"
                    android:layout_width="96dp"
                    android:layout_height="144dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="16dp"
                    android:contentDescription="@null"
                    android:elevation="6dp"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_content_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.16"
                        android:textColor="#A855F7"
                        android:textSize="11sp"
                        tools:text="SERIES" />

                    <TextView
                        android:id="@+id/tv_premium_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_login_chip"
                        android:fontFamily="monospace"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="2dp"
                        android:textColor="#FFAA00"
                        android:textSize="10sp"
                        android:visibility="gone"
                        tools:text="PREMIUM"
                        tools:visibility="visible" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:textColor="#F1F5F9"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    tools:text="House of the Dragon" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_rating_percentage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_login_chip"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:textColor="#A855F7"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="8.4 ★" />

                    <TextView
                        android:id="@+id/tv_year"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:fontFamily="@font/inter"
                        android:textColor="#94A3B8"
                        android:textSize="13sp"
                        tools:text="2024" />

                    <TextView
                        android:id="@+id/tv_season_episode_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:fontFamily="@font/inter"
                        android:textColor="#94A3B8"
                        android:textSize="13sp"
                        tools:text="2 Seasons" />

                    <TextView
                        android:id="@+id/tv_quality_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_login_chip"
                        android:fontFamily="monospace"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="2dp"
                        android:textColor="#A855F7"
                        android:textSize="11sp"
                        tools:text="4K" />

                    <TextView
                        android:id="@+id/tv_cc_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_login_chip"
                        android:fontFamily="monospace"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="2dp"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:visibility="gone"
                        tools:text="CC"
                        tools:visibility="visible" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_genre_year"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/inter"
                    android:textColor="#64748B"
                    android:textSize="13sp"
                    tools:text="Drama, Fantasy" />

                <TextView
                    android:id="@+id/tv_rating_stars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/inter"
                    android:textColor="#FFAA00"
                    android:textSize="13sp"
                    tools:text="★★★★☆" />

                <LinearLayout
                    android:id="@+id/layout_rd_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_login_chip"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="9dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tv_rd_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textColor="#00FF88"
                        android:textSize="12sp"
                        tools:text="12 SOURCES · 12 CACHED" />
                </LinearLayout>

                <!-- Resume -->
                <LinearLayout
                    android:id="@+id/layout_resume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_resume_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.12"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"
                            tools:text="CONTINUE" />

                        <TextView
                            android:id="@+id/tv_resume_right"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textColor="#64748B"
                            android:textSize="11sp"
                            tools:text="18 MIN LEFT" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_resume_ep_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter"
                        android:maxLines="1"
                        android:textColor="#F1F5F9"
                        android:textSize="14sp"
                        tools:text="S01E01 · The Heirs of the Dragon" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="7dp"
                        android:background="#1AFFFFFF" />

                    <View
                        android:id="@+id/v_resume_progress"
                        android:layout_width="120dp"
                        android:layout_height="4dp"
                        android:layout_marginTop="-4dp"
                        android:background="#A855F7" />
                </LinearLayout>

                <!-- Actions -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_watch_now"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_weight="1"
                        android:background="@drawable/sel_login_btn_primary"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Watch Now"
                        android:textAllCaps="false"
                        android:textColor="#041014"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_watch_trailer"
                        android:layout_width="wrap_content"
                        android:layout_height="54dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/sel_login_btn_secondary"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:paddingHorizontal="18dp"
                        android:text="Trailer"
                        android:textAllCaps="false"
                        android:textColor="#F1F5F9"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btn_add_favorite"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/sel_login_btn_secondary"
                        android:contentDescription="Favourite"
                        android:padding="15dp"
                        android:src="@drawable/ic_favorite_border"
                        android:tint="#F1F5F9" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/inter"
                    android:lineSpacingExtra="4dp"
                    android:textColor="#94A3B8"
                    android:textSize="14sp"
                    tools:text="An internal succession war within House Targaryen…" />

                <TextView
                    android:id="@+id/tv_director"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/inter"
                    android:textColor="#64748B"
                    android:textSize="13sp"
                    tools:text="Created by · Ryan Condal" />

                <TextView
                    android:id="@+id/tv_cast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/inter"
                    android:textColor="#64748B"
                    android:textSize="13sp"
                    tools:text="Cast · Matt Smith, Emma D'Arcy" />

                <!-- ── Seasons + episodes ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_season_selector"
                        android:layout_width="wrap_content"
                        android:layout_height="46dp"
                        android:background="@drawable/sel_login_btn_secondary"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:paddingHorizontal="18dp"
                        android:text="Season 1"
                        android:textAllCaps="false"
                        android:textColor="#F1F5F9"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_season_progress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        tools:text="3 / 10 WATCHED" />

                    <Button
                        android:id="@+id/btn_refresh"
                        android:layout_width="wrap_content"
                        android:layout_height="46dp"
                        android:background="@drawable/sel_login_btn_secondary"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:paddingHorizontal="14dp"
                        android:text="Refresh"
                        android:textAllCaps="false"
                        android:textColor="#94A3B8"
                        android:textSize="13sp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_seasons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never" />

                <TextView
                    android:id="@+id/tv_empty_episodes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/inter"
                    android:gravity="center"
                    android:textColor="#64748B"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:text="No episodes found"
                    tools:visibility="visible" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_episodes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── Loading overlay ── -->
    <FrameLayout
        android:id="@+id/layout_loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC06090E"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tv_loading_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/inter"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            tools:text="Loading episodes…" />
    </FrameLayout>
</FrameLayout>
