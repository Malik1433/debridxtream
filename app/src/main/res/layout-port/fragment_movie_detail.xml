<?xml version="1.0" encoding="utf-8"?>
<!--
  M4 (MOBILE_DUAL_MODE_PLAN): the movie detail page on the PHONE.

  Every id the activity binds is here at its landscape KIND (data binding requires
  kind-parity across configurations), so MovieDetailActivity runs unchanged.

  Shape: the TV's side-by-side (backdrop left, details right) becomes one scrolling
  column — 16:9 backdrop, then title/metadata, then the actions, then description, cast,
  sources and similar. Phone type sizes and 48dp+ targets throughout.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#06090E"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="24dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── Backdrop ── -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp">

                <ImageView
                    android:id="@+id/iv_backdrop"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/gradient_cinematic_bottom" />

                <ImageButton
                    android:id="@+id/btn_back"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_margin="10dp"
                    android:background="@drawable/sel_login_btn_secondary"
                    android:contentDescription="Back"
                    android:padding="10dp"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="#F1F5F9" />

                <TextView
                    android:id="@+id/tv_breadcrumb_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="14dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.14"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    tools:text="MOVIES" />

                <TextView
                    android:id="@+id/tv_back_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="12dp"
                    android:fontFamily="monospace"
                    android:textColor="#334155"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- ── Details ── -->
            <LinearLayout
                android:id="@+id/group_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp">

                <LinearLayout
                    android:id="@+id/layout_rd_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_content_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.16"
                        android:textColor="#00F0FF"
                        android:textSize="11sp"
                        tools:text="FEATURE FILM" />

                    <TextView
                        android:id="@+id/tv_premium_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_login_chip"
                        android:fontFamily="monospace"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="2dp"
                        android:textColor="#FFAA00"
                        android:textSize="10sp"
                        android:visibility="gone"
                        tools:text="PREMIUM"
                        tools:visibility="visible" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:textColor="#F1F5F9"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    tools:text="The Devil's Mouth" />

                <com.google.android.flexbox.FlexboxLayout
                    android:id="@+id/layout_metadata_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:alignItems="center"
                    app:flexWrap="wrap"
                    xmlns:app="http://schemas.android.com/apk/res-auto">

                    <TextView
                        android:id="@+id/tv_rating_percentage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_login_chip"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:textColor="#00F0FF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="6.6 ★" />

                    <LinearLayout
                        android:id="@+id/badge_imdb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/tv_imdb_rating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textColor="#FFAA00"
                            android:textSize="12sp"
                            tools:text="IMDb 7.1" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/badge_rt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/tv_rt_rating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textColor="#FF3355"
                            android:textSize="12sp"
                            tools:text="RT 82%" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_year"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:fontFamily="@font/inter"
                        android:textColor="#94A3B8"
                        android:textSize="13sp"
                        tools:text="2026" />

                    <TextView
                        android:id="@+id/tv_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:fontFamily="@font/inter"
                        android:textColor="#94A3B8"
                        android:textSize="13sp"
                        tools:text="1H 46M" />

                    <TextView
                        android:id="@+id/tv_genre_year"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:fontFamily="@font/inter"
                        android:textColor="#94A3B8"
                        android:textSize="13sp"
                        tools:text="Horror, Thriller" />

                    <TextView
                        android:id="@+id/tv_quality_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_login_chip"
                        android:fontFamily="monospace"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="2dp"
                        android:textColor="#00F0FF"
                        android:textSize="11sp"
                        tools:text="4K" />

                    <TextView
                        android:id="@+id/tv_age_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_login_chip"
                        android:fontFamily="monospace"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="2dp"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        tools:text="PG-13" />

                    <TextView
                        android:id="@+id/tv_rating_stars"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:textColor="#FFAA00"
                        android:textSize="13sp"
                        tools:text="★★★★☆" />
                </com.google.android.flexbox.FlexboxLayout>

                <!-- Debrid summary -->
                <LinearLayout
                    android:id="@+id/layout_rd_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_login_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="9dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tv_rd_summary_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textColor="#00FF88"
                        android:textSize="12sp"
                        tools:text="79 SOURCES FOUND · 79 CACHED" />
                </LinearLayout>

                <!-- Resume -->
                <LinearLayout
                    android:id="@+id/layout_resume_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ProgressBar
                        android:id="@+id/pb_resume"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:max="100"
                        android:progressTint="#00F0FF"
                        tools:progress="35" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_resume_elapsed"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"
                            tools:text="26:56" />

                        <TextView
                            android:id="@+id/tv_resume_remaining"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textColor="#64748B"
                            android:textSize="11sp"
                            tools:text="1H 57M LEFT" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Actions -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_play"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_weight="1"
                        android:background="@drawable/sel_login_btn_primary"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Watch Now"
                        android:textAllCaps="false"
                        android:textColor="#041014"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_trailer"
                        android:layout_width="wrap_content"
                        android:layout_height="54dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/sel_login_btn_secondary"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:paddingHorizontal="18dp"
                        android:text="Trailer"
                        android:textAllCaps="false"
                        android:textColor="#F1F5F9"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btn_favorite"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/sel_login_btn_secondary"
                        android:contentDescription="Favourite"
                        android:padding="15dp"
                        android:src="@drawable/ic_favorite_border"
                        android:tint="#F1F5F9" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/inter"
                    android:lineSpacingExtra="4dp"
                    android:textColor="#94A3B8"
                    android:textSize="14sp"
                    tools:text="A group of college friends' Thailand adventure turns deadly…" />

                <TextView
                    android:id="@+id/tv_director"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/inter"
                    android:textColor="#64748B"
                    android:textSize="13sp"
                    tools:text="Director · Jeff Wadlow" />

                <TextView
                    android:id="@+id/tv_cast_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.14"
                    android:textColor="#475569"
                    android:textSize="11sp"
                    tools:text="CAST" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_cast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never" />

                <!-- ── Sources ── -->
                <TextView
                    android:id="@+id/tv_sources_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:textColor="#F1F5F9"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    tools:text="Sources" />

                <TextView
                    android:id="@+id/tv_sources_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    tools:text="79 SOURCES · SORTED BY DE+HI PRIORITY" />

                <!-- Kept as a View for kind-parity; it is a divider on the phone. -->
                <View
                    android:id="@+id/layout_source_filters"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:background="#14FFFFFF" />

                <TextView
                    android:id="@+id/btn_cached_only"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/sel_login_btn_secondary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Cached only"
                    android:textColor="#94A3B8"
                    android:textSize="13sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_language_filters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_sources"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

                <!-- ── Similar ── -->
                <LinearLayout
                    android:id="@+id/layout_similar_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.14"
                        android:text="MORE LIKE THIS"
                        android:textColor="#475569"
                        android:textSize="11sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_similar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:clipToPadding="false"
                        android:overScrollMode="never" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
