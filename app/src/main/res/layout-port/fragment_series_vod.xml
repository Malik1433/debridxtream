<?xml version="1.0" encoding="utf-8"?>
<!--
  M3 (MOBILE_DUAL_MODE_PLAN): Series browse on the PHONE.

  Same ids and the same view KINDS as the landscape layout, so SeriesFragment binds
  unchanged (data binding also requires kind-parity across configurations).

  Shape: the 210dp left sidebar becomes a TOP STRIP — search on one line, the category
  list as a horizontal rail under it — and the poster grid takes the full width. The
  grid's span already self-computes from the measured width (coerced 2..8), so it lands
  on 3 columns at 411dp without any code change.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:fitsSystemWindows="true">

    <ImageView
        android:id="@+id/iv_background_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.18"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/ambient_color"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/gradient_overlay_ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_hero_lr" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ll_main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- ── Top strip (the rail, re-laid) ── -->
        <LinearLayout
            android:id="@+id/ll_series_sidebar_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/sidebar_logo_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:text="Series"
                    android:textColor="#F1F5F9"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/ll_offline_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_login_chip"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tv_offline_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textColor="#FFAA00"
                        android:textSize="10sp"
                        tools:text="OFFLINE" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/btn_search"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/sel_login_btn_secondary"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="Search"
                        android:src="@drawable/ic_search"
                        android:tint="#94A3B8" />
                </FrameLayout>
            </LinearLayout>

            <!-- Categories: a horizontal rail on the phone (VodFragment sets the axis
                 from R.bool.browse_categories_are_horizontal). -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_categories_sidebar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:overScrollMode="never" />
        </LinearLayout>

        <!-- ── Section header + sort ── -->
        <LinearLayout
            android:id="@+id/series_section_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_series_sidebar_container">

            <TextView
                android:id="@+id/tv_category_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/plus_jakarta_sans"
                android:maxLines="1"
                android:textColor="#F1F5F9"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="All Series" />

            <TextView
                android:id="@+id/tv_section_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="monospace"
                android:textColor="#475569"
                android:textSize="11sp"
                tools:text="1240 TITLES" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/sv_sort_chips"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="16dp"
            android:clipToPadding="false"
            android:scrollbars="none"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/series_section_header">

            <LinearLayout
                android:id="@+id/ll_sort_chips"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- ── Grid ── -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_series_grid"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="12dp"
            android:paddingBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sv_sort_chips" />

        <!-- ── Empty state ── -->
        <LinearLayout
            android:id="@+id/ll_empty_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/rv_series_grid"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/rv_series_grid"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tv_empty_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans"
                android:gravity="center"
                android:textColor="#F1F5F9"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Nothing here yet" />

            <TextView
                android:id="@+id/tv_empty_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:textColor="#64748B"
                android:textSize="13sp"
                tools:text="Try another category" />

            <TextView
                android:id="@+id/btn_retry"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/sel_login_btn_secondary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="26dp"
                android:text="Retry"
                android:textColor="#F1F5F9"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ── Loading skeleton. Must stay a GridLayout: kind-parity with landscape. ── -->
    <GridLayout
        android:id="@+id/ll_loading_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="180dp"
        android:columnCount="3"
        android:paddingHorizontal="12dp"
        android:visibility="gone">

        <include
            layout="@layout/item_movie_loading"
            android:layout_width="112dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp" />

        <include
            layout="@layout/item_movie_loading"
            android:layout_width="112dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp" />

        <include
            layout="@layout/item_movie_loading"
            android:layout_width="112dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp" />

        <include
            layout="@layout/item_movie_loading"
            android:layout_width="112dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp" />

        <include
            layout="@layout/item_movie_loading"
            android:layout_width="112dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp" />

        <include
            layout="@layout/item_movie_loading"
            android:layout_width="112dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp" />
    </GridLayout>
</FrameLayout>
