<?xml version="1.0" encoding="utf-8"?>
<!--
  M3: the browse category as a PHONE CHIP.

  The landscape row is `match_parent` wide because it lives in a vertical rail; in the
  phone's horizontal rail that would make one category fill the strip (the same trap the
  bottom nav hit in M2b). Here it is a wrap_content chip with the active indicator as an
  underline instead of a left bar. Same ids and kinds as the landscape row.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="40dp"
    android:layout_marginEnd="8dp"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp">

    <TextView
        android:id="@+id/tv_category_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:singleLine="true"
        android:text="Category"
        android:textColor="@color/vod_text_muted"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_category_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.06"
        android:singleLine="true"
        android:textColor="@color/vod_text_ghost"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Kept for id/kind parity; the chip shows selection through its background. -->
    <View
        android:id="@+id/v_active_indicator"
        android:layout_width="3dp"
        android:layout_height="20dp"
        android:background="@color/series_accent_purple"
        android:visibility="invisible" />
</LinearLayout>
