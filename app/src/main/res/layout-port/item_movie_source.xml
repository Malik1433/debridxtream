<?xml version="1.0" encoding="utf-8"?>
<!--
  M5: a source row on the PHONE.

  This is a DATA-BINDING layout, so the portrait file must keep the `<layout>` root and
  the same (empty) `<data>` block — ItemMovieSourceBinding is generated once across all
  configurations, and every one of the 14 ids must exist here at its landscape KIND and
  default visibility (`v_best_accent`, `tv_badge_seeders` and `tv_best_badge` all start
  `gone`; the adapter turns them on).

  Shape: the TV packs seven columns into a 34dp strip at 8-9sp. That is the px÷2 rule for
  a screen read from three metres away, and it is unreadable in the hand. Here the row
  breathes over three lines inside a 12dp-padded card — provider + languages, the release
  name, then the quality/type badges — with the size column and play affordance held to
  the right edge.

  `layout_size_bar` stays exactly 40dp wide: the adapter computes the fill width from a
  hard-coded SIZE_BAR_WIDTH_DP = 40f, so a wider track here would under-fill every bar.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp"
        android:background="@drawable/source_row_bg"
        android:clickable="true"
        android:descendantFocusability="blocksDescendants"
        android:focusable="true"
        android:minHeight="72dp">

        <View
            android:id="@+id/v_best_accent"
            android:layout_width="3dp"
            android:layout_height="0dp"
            android:background="@drawable/cin_best_accent_bar"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Left block: provider + languages, release name, badges -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_provider"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:clickable="false"
                        android:focusable="false"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:minWidth="44dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="RD ×4" />

                    <LinearLayout
                        android:id="@+id/ll_languages"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:clickable="false"
                        android:focusable="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_release_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:clickable="false"
                    android:ellipsize="end"
                    android:focusable="false"
                    android:fontFamily="monospace"
                    android:maxLines="2"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp"
                    tools:text="Dune.Part.Two.2024.2160p.WEB-DL.DV.HDR.DDP5.1.Atmos" />

                <LinearLayout
                    android:id="@+id/layout_badges"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_quality"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:clickable="false"
                        android:focusable="false"
                        android:gravity="center"
                        android:minWidth="46dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        tools:text="4K" />

                    <TextView
                        android:id="@+id/tv_badge_seeders"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:layout_marginStart="6dp"
                        android:clickable="false"
                        android:focusable="false"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="12"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tv_type"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:layout_marginStart="6dp"
                        android:clickable="false"
                        android:focusable="false"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:minWidth="58dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        tools:text="DIRECT" />
                </LinearLayout>
            </LinearLayout>

            <!-- Right block: size + play affordance -->
            <LinearLayout
                android:id="@+id/layout_size_column"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:clickable="false"
                android:focusable="false"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_filesize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:textColor="#F1F5F9"
                    android:textSize="13sp"
                    tools:text="22.4 GB" />

                <FrameLayout
                    android:id="@+id/layout_size_bar"
                    android:layout_width="40dp"
                    android:layout_height="4dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/cin_size_bar_track"
                    android:clickable="false"
                    android:focusable="false">

                    <View
                        android:id="@+id/v_size_bar_fill"
                        android:layout_width="20dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/cin_size_bar_fill"
                        android:backgroundTint="#00F0FF" />
                </FrameLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/iv_play"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/play_btn_bg"
                android:clickable="false"
                android:focusable="false"
                android:padding="6dp"
                android:src="@drawable/ic_play_arrow_24"
                app:tint="#94A3B8" />

            <TextView
                android:id="@+id/tv_best_badge"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/cin_best_badge_bg"
                android:clickable="false"
                android:focusable="false"
                android:fontFamily="monospace"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="★ BEST"
                android:textColor="#00F0FF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
