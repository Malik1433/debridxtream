<?xml version="1.0" encoding="utf-8"?>
<!--
  M6 (MOBILE_DUAL_MODE_PLAN): Settings on the PHONE.

  This was the worst screen on the handset: the landscape file is a category RAIL beside a
  detail PANEL, and at 411dp the rail took the full width while the panel collapsed to a
  sliver at the right edge showing nothing. Playback, Addons, Data & Storage and Sign Out
  were not merely awkward — they were unreachable. It also blocked M5's phone QA, because
  Addons is where a debrid addon is added.

  Phone shape (per the rulebook in CLAUDE.md): a horizontal category rail on top, the chosen
  category's settings filling everything below it. Same six ids, same kinds, same default
  visibilities, so SettingsFragment and both adapters bind unchanged; the one code line is
  the rail's orientation, read from R.bool.settings_categories_are_horizontal.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080B11"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="10dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_settings" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/outfit_extrabold"
            android:text="Settings"
            android:textColor="#F1F5F9"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tv_settings_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/share_tech_mono"
            android:letterSpacing="0.06"
            android:textColor="#64748B"
            android:textSize="10sp"
            tools:text="v2.2.0" />
    </LinearLayout>

    <!-- Category rail. Horizontal here; the fragment reads the orientation from a bool. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_settings_categories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#14FFFFFF" />

    <!-- Chosen category: its name, its description, then its settings -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="16dp">

        <View
            android:id="@+id/v_panel_dot"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginEnd="9dp"
            android:background="@drawable/stremio_live_dot" />

        <TextView
            android:id="@+id/tv_panel_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit_bold"
            android:letterSpacing="0.04"
            android:textColor="#F1F5F9"
            android:textSize="17sp"
            tools:text="Playback" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_panel_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="3dp"
        android:paddingBottom="10dp"
        android:textColor="#94A3B8"
        android:textSize="13sp"
        tools:text="Audio language priority, buffering and playback behaviour" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_settings_details"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="18dp" />
</LinearLayout>
