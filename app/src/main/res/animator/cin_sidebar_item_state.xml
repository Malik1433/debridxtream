<?xml version="1.0" encoding="utf-8"?>
<!--
  Sidebar item state animator: scale + translationZ on focus.
  Smoother than a manual setOnFocusChangeListener and runs on the layout itself.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <set>
            <objectAnimator
                android:propertyName="scaleX"
                android:duration="180"
                android:valueTo="1.04"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="scaleY"
                android:duration="180"
                android:valueTo="1.04"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="translationZ"
                android:duration="180"
                android:valueTo="6dp" />
        </set>
    </item>

    <item>
        <set>
            <objectAnimator
                android:propertyName="scaleX"
                android:duration="180"
                android:valueTo="1.0"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="scaleY"
                android:duration="180"
                android:valueTo="1.0"
                android:valueType="floatType" />
            <objectAnimator
                android:propertyName="translationZ"
                android:duration="180"
                android:valueTo="0dp" />
        </set>
    </item>

</selector>
