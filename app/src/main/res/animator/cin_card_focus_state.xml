<?xml version="1.0" encoding="utf-8"?>
<!-- Card focus state animator: subtle scale + lift on focus -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <objectAnimator
            android:propertyName="scaleX"
            android:duration="180"
            android:valueTo="1.06"
            android:valueType="floatType" />
    </item>
    <item android:state_focused="true">
        <objectAnimator
            android:propertyName="scaleY"
            android:duration="180"
            android:valueTo="1.06"
            android:valueType="floatType" />
    </item>
    <item android:state_focused="true">
        <objectAnimator
            android:propertyName="translationZ"
            android:duration="180"
            android:valueTo="14dp"
            android:valueType="floatType" />
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:duration="160" android:valueTo="1.0" android:valueType="floatType" />
            <objectAnimator android:propertyName="scaleY" android:duration="160" android:valueTo="1.0" android:valueType="floatType" />
            <objectAnimator android:propertyName="translationZ" android:duration="160" android:valueTo="0dp" android:valueType="floatType" />
        </set>
    </item>
</selector>
