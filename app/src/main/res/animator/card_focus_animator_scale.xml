<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.1" android:duration="200" android:interpolator="@android:interpolator/decelerate_quad" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.1" android:duration="200" android:interpolator="@android:interpolator/decelerate_quad" />
            <objectAnimator android:propertyName="translationZ" android:valueTo="8dp" android:duration="200" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.0" android:duration="200" android:interpolator="@android:interpolator/decelerate_quad" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.0" android:duration="200" android:interpolator="@android:interpolator/decelerate_quad" />
            <objectAnimator android:propertyName="translationZ" android:valueTo="0dp" android:duration="200" />
        </set>
    </item>
</selector>
