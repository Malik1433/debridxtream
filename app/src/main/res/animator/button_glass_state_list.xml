<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <set android:ordering="together">
            <objectAnimator
                android:propertyName="scaleX"
                android:valueFrom="1.0"
                android:valueTo="1.0"
                android:duration="120"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
            <objectAnimator
                android:propertyName="scaleY"
                android:valueFrom="1.0"
                android:valueTo="1.0"
                android:duration="120"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
            <objectAnimator
                android:propertyName="translationY"
                android:valueFrom="0"
                android:valueTo="0"
                android:valueType="floatType"
                android:duration="120"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
            <objectAnimator
                android:propertyName="translationZ"
                android:valueFrom="0"
                android:valueTo="0"
                android:valueType="floatType"
                android:duration="120"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </set>
    </item>

    <item android:state_focused="true">
        <set android:ordering="together">
            <objectAnimator
                android:propertyName="scaleX"
                android:valueFrom="1.0"
                android:valueTo="1.0"
                android:duration="260"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
            <objectAnimator
                android:propertyName="scaleY"
                android:valueFrom="1.0"
                android:valueTo="1.0"
                android:duration="260"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
            <objectAnimator
                android:propertyName="translationY"
                android:valueFrom="0"
                android:valueTo="0"
                android:valueType="floatType"
                android:duration="260"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
            <objectAnimator
                android:propertyName="translationZ"
                android:valueFrom="0"
                android:valueTo="0"
                android:valueType="floatType"
                android:duration="260"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </set>
    </item>

    <item>
        <set android:ordering="together">
            <objectAnimator
                android:propertyName="scaleX"
                android:valueTo="1.0"
                android:duration="240"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
            <objectAnimator
                android:propertyName="scaleY"
                android:valueTo="1.0"
                android:duration="240"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
            <objectAnimator
                android:propertyName="translationY"
                android:valueTo="0"
                android:duration="240"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
            <objectAnimator
                android:propertyName="translationZ"
                android:valueTo="0"
                android:duration="240"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </set>
    </item>

</selector>
