<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="232dp"
    android:layout_height="188dp"
    android:focusable="true"
    android:clickable="true"
    android:background="@drawable/selector_episode_focus"
    android:padding="7dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_thumb"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="#1A1F29"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_episode_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            tools:src="@tools:sample/backgrounds/scenic" />

        <LinearLayout
            android:id="@+id/layout_episode_placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_episode_placeholder"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_placeholder_episode_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#D6F4FF"
                android:textSize="28sp"
                android:textStyle="bold"
                tools:text="E01" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Episode"
                android:textColor="#9FB7C5"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Episode Badge -->
        <TextView
            android:id="@+id/tv_episode_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="@drawable/bg_episode_badge"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="E01" />

        <TextView
            android:id="@+id/tv_playing_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/bg_episode_playing_badge"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="Playing"
            android:textColor="#171000"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_episode_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:background="@drawable/bg_continue_type_badge"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp"
            android:textColor="#E7EDF3"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="42m" />

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/selector_episode_title_color"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintTop_toBottomOf="@+id/cv_thumb"
        tools:text="The Name of the Game" />

    <TextView
        android:id="@+id/tv_episode_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#A8B7C3"
        android:textSize="11sp"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        tools:text="Season 1" />

</androidx.constraintlayout.widget.ConstraintLayout>
