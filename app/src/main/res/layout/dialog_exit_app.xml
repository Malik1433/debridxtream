<?xml version="1.0" encoding="utf-8"?>
<!--
    Exit confirmation, shown when BACK is pressed at the top of Home. One layout, two rulebooks:

    TV  - only two focusables, both in one horizontal row, Cancel first and default-focused from
          ExitDialog.kt. Focus is a drawn 2dp ring on both buttons (never a colour-only change),
          and the ring colours differ (cyan / pale red) so the destructive button can never be
          mistaken for the safe one. nextFocusUp/Down point at self so D-pad cannot walk focus out
          of the dialog and into the Home rows behind the scrim. 340dp centred card is far inside
          any overscan margin.
    PHONE - buttons are 48dp tall with 48dp minWidth-equivalent padding, body copy is 12sp, one tap
          commits, and the dialog stays cancelable so a scrim tap dismisses. No "PRESS OK" legend.

    LinearLayout on a shape drawable rather than a CardView - see bg_exit_dialog_glass for why.
    Ids btn_cancel / btn_exit are contractual: ExitDialog.kt binds them by id.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/bg_exit_dialog_glass"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Branding row: app glyph + wordmark, so the dialog is identifiably DX Play, not a system alert -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_exit_logo_tile"
            android:contentDescription="@null"
            android:padding="5dp"
            android:src="@drawable/ic_play_arrow_24"
            android:tint="#04121A" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="@font/share_tech_mono"
            android:letterSpacing="0.22"
            android:text="@string/app_name"
            android:textAllCaps="true"
            android:textColor="#7A00F0FF"
            android:textSize="12sp" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/outfit_extrabold"
        android:letterSpacing="-0.01"
        android:text="@string/ui_exit_application"
        android:textColor="#F1F5F9"
        android:textSize="19sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:fontFamily="@font/inter_regular"
        android:lineSpacingExtra="3dp"
        android:text="@string/ui_are_you_sure_you_want"
        android:textColor="#94A3B8"
        android:textSize="13sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="18dp"
        android:background="#14FFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="end"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_exit_btn_cancel"
            android:fontFamily="@font/inter_semibold"
            android:letterSpacing="0.03"
            android:minWidth="104dp"
            android:nextFocusDown="@id/btn_cancel"
            android:nextFocusLeft="@id/btn_cancel"
            android:nextFocusRight="@id/btn_exit"
            android:nextFocusUp="@id/btn_cancel"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:stateListAnimator="@null"
            android:text="@string/cancel"
            android:textAllCaps="false"
            android:textColor="#F1F5F9"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_exit"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_exit_btn_exit"
            android:fontFamily="@font/inter_extrabold"
            android:letterSpacing="0.03"
            android:minWidth="104dp"
            android:nextFocusDown="@id/btn_exit"
            android:nextFocusLeft="@id/btn_cancel"
            android:nextFocusRight="@id/btn_exit"
            android:nextFocusUp="@id/btn_exit"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:stateListAnimator="@null"
            android:text="@string/ui_exit"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

    </LinearLayout>

</LinearLayout>
