<?xml version="1.0" encoding="utf-8"?>
<!--
  PHONE "My Library" — Watching / Completed / Saved.

  The television's version is untouched in layout-television/: 35dp gutters, a 12sp title, a 6.5sp
  count and 23dp tab pills with 8sp labels. Every one of those is a 10-foot number, and the tabs in
  particular were 23dp tall — half of the 48dp a thumb needs.

  Same ids and kinds, phone numbers: 16dp gutter, a 20sp title with the count under it, tabs and the
  sort control at 48dp with 13sp labels, and a grid of the phone library card.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/library_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="16dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit_extrabold"
                    android:letterSpacing="-0.02"
                    android:text="@string/ui_my_library"
                    android:textColor="#F1F5F9"
                    android:textSize="20sp" />

                <!--
                  The count lives in the TABS on a phone ("Watching 3", "Saved 12"), so a separate
                  line under the title would say the same number twice. Kept as a zero-sized view
                  because the television's copy still writes it.
                -->
                <TextView
                    android:id="@+id/lib_count"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>

        <!--
          Filled in code (StremioLibrarySection.buildTabs) — 48dp cells on a phone, and scrolling
          sideways: three tabs at a thumb-sized width do not fit 379dp, and the third was clipped
          mid-word rather than simply being out of reach.
        -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/libTabsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/libraryGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="true"
            android:paddingBottom="24dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/lib_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="@font/inter_regular"
        android:gravity="center"
        android:lineSpacingMultiplier="1.5"
        android:paddingHorizontal="32dp"
        android:text="@string/ui_nothing_here_yet"
        android:textColor="#64748B"
        android:textSize="13sp"
        android:visibility="gone" />
</FrameLayout>
