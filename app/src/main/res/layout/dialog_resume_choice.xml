<?xml version="1.0" encoding="utf-8"?>
<!--
    Resume or start over, asked AFTER a source is picked.

    Same shape as dialog_exit_app: a fixed-width CardView in a DialogFragment rather than an
    AlertDialog, because AlertDialog's minimum width renders as a half-screen slab on this TV
    (the Continue-Watching quick actions hit that and had to move into the card too).
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="420dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardBackgroundColor="#1A1A1A"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:cardPreventCornerOverlap="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tv_resume_choice_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="Dune: Part Two" />

        <TextView
            android:id="@+id/tv_resume_choice_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#B0B0B0"
            android:textSize="16sp"
            tools:text="You stopped at 42:15." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_start_over"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackground"
                android:minWidth="100dp"
                android:text="@string/resume_choice_start_over"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_resume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="100dp"
                android:text="@string/resume_choice_resume"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                tools:text="Resume" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
