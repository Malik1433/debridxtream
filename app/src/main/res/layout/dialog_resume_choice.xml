<?xml version="1.0" encoding="utf-8"?>
<!--
    Resume or start over, asked AFTER a source is picked.

    Plain LinearLayout on a shape drawable rather than a CardView: the card gave no way to draw the
    hairline edge that makes this read as glass, and its elevation shadow fought the translucency.
    See bg_resume_choice_glass for why this is translucency and not a real blur.

    Sized down from the first pass — it was a slab. Everything here is one step smaller: width,
    padding, type and buttons.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="312dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/bg_resume_choice_glass"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="17dp">

    <!-- Eyebrow, matching the detail page's section labels -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/resume_choice_eyebrow"
        android:textColor="@color/neon_cyan"
        android:textSize="9sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.2" />

    <TextView
        android:id="@+id/tv_resume_choice_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/source_text_primary"
        android:textSize="15sp"
        android:fontFamily="@font/inter_extrabold"
        android:letterSpacing="0.01"
        tools:text="Dune: Part Two" />

    <TextView
        android:id="@+id/tv_resume_choice_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/text_muted"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.04"
        tools:text="You stopped at 42:15." />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="end"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_start_over"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/cin_detail_btn_glass"
            android:text="@string/resume_choice_start_over"
            android:textColor="@color/cin_detail_focus_text"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:fontFamily="@font/inter_extrabold"
            android:letterSpacing="0.04"
            android:stateListAnimator="@null" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_resume"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:background="@drawable/cin_detail_btn_watch"
            android:textColor="#041014"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:fontFamily="@font/inter_extrabold"
            android:letterSpacing="0.04"
            android:stateListAnimator="@null"
            tools:text="Resume 42:15" />

    </LinearLayout>

</LinearLayout>
