<?xml version="1.0" encoding="utf-8"?>
<!--
    Resume or start over, asked AFTER a source is picked.

    Styled from the movie detail page it is launched from — same panel colour as the source sheet
    (#0E0D15), the same two button drawables as Watch Now / Trailer, and the same fonts. The first
    version copied dialog_exit_app, which is plain Material (#1A1A1A card, default Buttons) and looked
    like it belonged to a different app.

    Still a fixed-width CardView in a DialogFragment rather than an AlertDialog: AlertDialog's minimum
    width renders as a half-screen slab on this TV (the Continue-Watching quick actions hit that too).
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="440dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardBackgroundColor="#0E0D15"
    app:cardCornerRadius="14dp"
    app:cardElevation="12dp"
    app:cardPreventCornerOverlap="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:padding="26dp">

        <!-- Eyebrow, matching the detail page's section labels -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/resume_choice_eyebrow"
            android:textColor="@color/neon_cyan"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.2" />

        <TextView
            android:id="@+id/tv_resume_choice_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/source_text_primary"
            android:textSize="20sp"
            android:fontFamily="@font/inter_extrabold"
            android:letterSpacing="0.01"
            tools:text="Dune: Part Two" />

        <TextView
            android:id="@+id/tv_resume_choice_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.04"
            tools:text="You stopped at 42:15." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="end"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_start_over"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="10dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/cin_detail_btn_glass"
                android:text="@string/resume_choice_start_over"
                android:textColor="@color/cin_detail_focus_text"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:fontFamily="@font/inter_extrabold"
                android:letterSpacing="0.04"
                android:stateListAnimator="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_resume"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="@drawable/cin_detail_btn_watch"
                android:textColor="#041014"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:fontFamily="@font/inter_extrabold"
                android:letterSpacing="0.04"
                android:stateListAnimator="@null"
                tools:text="Resume 42:15" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
