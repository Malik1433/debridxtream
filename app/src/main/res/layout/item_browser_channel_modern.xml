<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="6dp"
    android:clipToPadding="false"
    android:clipChildren="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_channel"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:background="@drawable/selector_browser_item_modern"
        android:duplicateParentState="true"
        android:padding="8dp">

        <!-- Badges (Top Right) -->
        <LinearLayout
            android:id="@+id/badge_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/badge_hd_modern"
                style="@style/ChannelBadgeText"
                android:text="HD"
                android:background="@drawable/badge_background"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/badge_4k_modern"
                style="@style/ChannelBadgeText"
                android:text="4K"
                android:background="@drawable/badge_background"
                android:layout_marginStart="4dp"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Logo Container (centered top) -->
        <FrameLayout
            android:id="@+id/logo_container"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/channel_logo_bg_dark"
            android:padding="2dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/iv_channel_logo_modern"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                tools:src="@android:drawable/sym_def_app_icon" />
        </FrameLayout>

        <!-- Channel Number (Top Left, Small) -->
        <TextView
            android:id="@+id/tv_channel_num_modern"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white_opacity_50"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="01" />

        <!-- Channel Name (Centered, Multi-line) -->
        <TextView
            android:id="@+id/tv_channel_name_modern"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/logo_container"
            app:layout_constraintBottom_toTopOf="@id/tv_now_playing_modern"
            tools:text="HBO Family HD\nMovies" />

        <!-- Now Playing (Bottom, Small) -->
        <TextView
            android:id="@+id/tv_now_playing_modern"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/white_opacity_70"
            android:textSize="10sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="The Lion King" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
