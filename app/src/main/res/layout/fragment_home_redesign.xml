<?xml version="1.0" encoding="utf-8"?>
<!-- Home Screen Redesign - Professional IPTV Design System -->
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_bg_gradient_redesign"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="32dp"
    android:paddingBottom="24dp">

    <!-- ========== HEADER SECTION ========== -->
    
    <!-- App Title/Brand -->
    <TextView
        android:id="@+id/tv_app_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_title"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/ds_accent_gold"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.05"
        android:shadowColor="@color/app_title_shadow"
        android:shadowRadius="8"
        android:shadowDx="2"
        android:shadowDy="2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Search Icon - Top Right -->
    <ImageView
        android:id="@+id/btn_search"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="@dimen/icon_margin"
        android:src="@drawable/ic_search"
        android:background="@drawable/search_icon_bg"
        android:padding="10dp"
        android:tint="@color/ds_text_primary"
        android:focusable="true"
        android:clickable="true"
        android:contentDescription="@string/search_content_description"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_settings"
        android:nextFocusLeft="@id/btn_nav_debrid"
        android:nextFocusDown="@id/rv_featured" />

    <!-- Settings Icon - Top Right -->
    <ImageView
        android:id="@+id/btn_settings"
        android:layout_width="@dimen/icon_settings_size"
        android:layout_height="@dimen/icon_settings_size"
        android:src="@drawable/ic_settings"
        android:background="@drawable/search_icon_bg"
        android:padding="10dp"
        android:tint="@color/ds_text_primary"
        android:focusable="true"
        android:clickable="true"
        android:contentDescription="@string/settings_content_description"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:nextFocusLeft="@id/btn_search"
        android:nextFocusDown="@id/rv_featured" />

    <!-- Navigation Buttons Container -->
    <LinearLayout
        android:id="@+id/nav_buttons_container"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tv_app_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Live TV Button -->
        <TextView
            android:id="@+id/btn_nav_live_tv"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:minWidth="160dp"
            android:text="@string/nav_live_tv"
            android:textSize="15sp"
            android:textColor="@color/nav_button_glass_text"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/button_glass_3d_selector"
                        android:stateListAnimator="@animator/button_glass_state_list"
            android:foreground="@drawable/button_ripple"
            android:elevation="0dp"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusRight="@id/btn_nav_movies"
            android:nextFocusDown="@id/rv_featured" />

        <!-- Movies Button -->
        <TextView
            android:id="@+id/btn_nav_movies"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:minWidth="160dp"
            android:text="@string/nav_movies"
            android:textSize="15sp"
            android:textColor="@color/nav_button_glass_text"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/button_glass_3d_selector"
                        android:stateListAnimator="@animator/button_glass_state_list"
            android:foreground="@drawable/button_ripple"
            android:elevation="0dp"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusLeft="@id/btn_nav_live_tv"
            android:nextFocusRight="@id/btn_nav_series"
            android:nextFocusDown="@id/rv_featured" />

        <!-- Series Button -->
        <TextView
            android:id="@+id/btn_nav_series"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:minWidth="160dp"
            android:text="@string/nav_series"
            android:textSize="15sp"
            android:textColor="@color/nav_button_glass_text"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/button_glass_3d_selector"
                        android:stateListAnimator="@animator/button_glass_state_list"
            android:foreground="@drawable/button_ripple"
            android:elevation="0dp"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusLeft="@id/btn_nav_movies"
            android:nextFocusRight="@id/btn_nav_debrid"
            android:nextFocusDown="@id/rv_featured" />

        <!-- Debrid Button -->
        <TextView
            android:id="@+id/btn_nav_debrid"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:minWidth="160dp"
            android:text="@string/nav_debrid"
            android:textSize="15sp"
            android:textColor="@color/nav_button_glass_text"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp"
            android:background="@drawable/button_glass_3d_selector"
                        android:stateListAnimator="@animator/button_glass_state_list"
            android:foreground="@drawable/button_ripple"
            android:elevation="0dp"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusLeft="@id/btn_nav_series"
            android:nextFocusRight="@id/btn_search"
            android:nextFocusDown="@id/rv_featured" />

    </LinearLayout>

    <!-- Divider Line (Subtle) -->
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="@dimen/divider_height"
        android:layout_marginTop="16dp"
        android:background="@color/divider_color"
        app:layout_constraintTop_toBottomOf="@id/nav_buttons_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ========== SCROLLABLE CONTENT SECTION ========== -->
    
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ========== FEATURED CONTENT SECTION ========== -->
            <LinearLayout
                android:id="@+id/section_featured"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tv_section_featured"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_featured_content"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/nav_button_glass_text"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="10dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_featured"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipToPadding="false"
                    android:focusable="true"
                    android:nextFocusUp="@id/btn_nav_live_tv"
                    android:nextFocusDown="@id/rv_new_added"
                    tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_featured_card"
                    tools:itemCount="4" />
            </LinearLayout>

            <!-- ========== NEW ARRIVALS SECTION ========== -->
            <LinearLayout
                android:id="@+id/section_new_added"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tv_section_new_added"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_new_added"
                    android:textSize="@dimen/text_section_header"
                    android:textStyle="bold"
                    android:textColor="@color/ds_text_primary"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="@dimen/section_header_margin_bottom" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_new_added"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipToPadding="false"
                    android:focusable="true"
                    android:nextFocusUp="@id/rv_featured"
                    android:nextFocusDown="@id/rv_continue_watching"
                    tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_new_added_card"
                    tools:itemCount="10" />
            </LinearLayout>

            <!-- ========== CONTINUE WATCHING SECTION ========== -->
            <LinearLayout
                android:id="@+id/section_continue_watching"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tv_section_continue_watching"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_continue_watching_caps"
                    android:textSize="@dimen/text_section_header"
                    android:textStyle="bold"
                    android:textColor="@color/ds_text_primary"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="@dimen/section_header_margin_bottom" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_continue_watching"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipToPadding="false"
                    android:focusable="true"
                    android:nextFocusUp="@id/rv_new_added"
                    android:nextFocusDown="@id/rv_recent_live"
                    tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_continue_watching_card"
                    tools:itemCount="5" />
            </LinearLayout>

            <!-- ========== RECENTLY WATCHED SECTION ========== -->
            <LinearLayout
                android:id="@+id/section_recent_live"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tv_section_recent_live"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_recently_watched_caps"
                    android:textSize="@dimen/text_section_header"
                    android:textStyle="bold"
                    android:textColor="@color/ds_text_primary"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="@dimen/section_header_margin_bottom" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_recent_live"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipToPadding="false"
                    android:focusable="true"
                    android:nextFocusUp="@id/rv_continue_watching"
                    android:nextFocusDown="@id/rv_favorites"
                    tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_recent_live_card"
                    tools:itemCount="6" />
            </LinearLayout>

            <!-- ========== MY FAVORITES SECTION ========== -->
            <LinearLayout
                android:id="@+id/section_favorites"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tv_section_favorites"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_favorites_caps"
                    android:textSize="@dimen/text_section_header"
                    android:textStyle="bold"
                    android:textColor="@color/ds_text_primary"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="@dimen/section_header_margin_bottom" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_favorites"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipToPadding="false"
                    android:focusable="true"
                    android:nextFocusUp="@id/rv_recent_live"
                    tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_favorite_card"
                    tools:itemCount="5" />
            </LinearLayout>

            <!-- ========== TRENDING MOVIES SECTION ========== -->
            <LinearLayout
                android:id="@+id/section_trending_movies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tv_section_trending_movies"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_trending_movies"
                    android:textSize="@dimen/text_section_header"
                    android:textStyle="bold"
                    android:textColor="@color/ds_text_primary"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="@dimen/section_header_margin_bottom" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_trending_movies"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipToPadding="false"
                    android:focusable="true"
                    android:nextFocusUp="@id/rv_favorites"
                    android:nextFocusDown="@id/rv_trending_series"
                    tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_movie_card"
                    tools:itemCount="10" />
            </LinearLayout>

            <!-- ========== TRENDING SERIES SECTION ========== -->
            <LinearLayout
                android:id="@+id/section_trending_series"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tv_section_trending_series"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_trending_series"
                    android:textSize="@dimen/text_section_header"
                    android:textStyle="bold"
                    android:textColor="@color/ds_text_primary"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="@dimen/section_header_margin_bottom" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_trending_series"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipToPadding="false"
                    android:focusable="true"
                    android:nextFocusUp="@id/rv_trending_movies"
                    tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_series_card"
                    tools:itemCount="10" />
            </LinearLayout>

            <!-- ========== RECOMMENDED FOR YOU SECTION ========== -->
            <LinearLayout
                android:id="@+id/section_recommended"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tv_section_recommended"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_recommended_for_you"
                    android:textSize="@dimen/text_section_header"
                    android:textStyle="bold"
                    android:textColor="@color/ds_text_primary"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="@dimen/section_header_margin_bottom" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_recommended"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipToPadding="false"
                    android:focusable="true"
                    android:nextFocusUp="@id/rv_trending_series"
                    tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_recommended_card"
                    tools:itemCount="8" />
            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

