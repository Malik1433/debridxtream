<?xml version="1.0" encoding="utf-8"?>
<!--
  The category picker. Searchable on purpose: this owner's playlist has around 200 categories, and
  at that size scrolling is not a retrieval strategy - typing is.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_phone_sheet"
    android:orientation="vertical"
    android:paddingBottom="10dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_phone_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit_bold"
            android:text="@string/phone_categories"
            android:textColor="@color/phone_text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/phone_bcat_total"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="@font/share_tech_mono"
            android:textColor="@color/phone_text_muted"
            android:textSize="12sp"
            tools:text="214 TOTAL" />

        <ImageView
            android:id="@+id/phone_bcat_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/phone_close"
            android:padding="15dp"
            android:src="@drawable/ic_stremio_close"
            app:tint="@color/phone_text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_phone_search_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_search"
            app:tint="@color/phone_cyan" />

        <!-- The system keyboard, never an on-screen D-pad one: this is a phone. -->
        <EditText
            android:id="@+id/phone_bcat_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="@font/outfit_semibold"
            android:hint="@string/phone_search"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/phone_text_primary"
            android:textColorHint="@color/phone_text_muted"
            android:textCursorDrawable="@null"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/phone_bcat_matches"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/share_tech_mono"
            android:textColor="@color/phone_text_muted"
            android:textSize="12sp"
            tools:text="7 OF 214" />
    </LinearLayout>

    <TextView
        android:id="@+id/phone_bcat_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/share_tech_mono"
        android:gravity="center"
        android:paddingVertical="24dp"
        android:textColor="@color/phone_text_muted"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="NO CATEGORY MATCHES &quot;XYZ&quot;"
        tools:visibility="visible" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="460dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/phone_bcat_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
