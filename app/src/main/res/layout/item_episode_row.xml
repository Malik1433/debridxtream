<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="88dp"
    android:background="@drawable/movie_card_selector"
    android:focusable="true"
    android:focusableInTouchMode="@bool/rows_focusable_in_touch_mode"
    android:padding="12dp">

    <ImageView
        android:id="@+id/iv_episode_thumb"
        android:layout_width="104dp"
        android:layout_height="0dp"
        android:contentDescription="@string/series_detail_episode_thumbnail_desc"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_watched_indicator"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_margin="4dp"
        android:src="@android:drawable/checkbox_on_background"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/iv_episode_thumb"
        app:layout_constraintEnd_toEndOf="@id/iv_episode_thumb"
        app:tint="@color/ds_accent"
        android:contentDescription="@string/a11y_watched" />

    <ProgressBar
        android:id="@+id/pb_resume_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:max="100"
        android:progressDrawable="@drawable/custom_progress_drawable"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/iv_episode_thumb"
        app:layout_constraintStart_toStartOf="@id/iv_episode_thumb"
        app:layout_constraintEnd_toEndOf="@id/iv_episode_thumb" />

    <LinearLayout
        android:id="@+id/layout_episode_text"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="16dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_episode_thumb"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_episode_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/ui_episode_title"
            android:textColor="@color/ds_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_episode_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/ds_text_secondary"
            android:textSize="14sp" />

    </LinearLayout>

    <ImageView
        android:id="@+id/iv_play_indicator"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="@string/series_detail_episode_play_desc"
        android:src="@android:drawable/ic_media_play"
        android:tint="@color/ds_text_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

