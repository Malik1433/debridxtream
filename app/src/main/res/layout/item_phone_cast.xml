<?xml version="1.0" encoding="utf-8"?>
<!-- A cast member: 64dp circle, name, role. Omitted wholesale when there is no cast data. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="88dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/phone_cast_photo"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_phone_avatar"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        tools:src="@drawable/ic_person_placeholder" />

    <TextView
        android:id="@+id/phone_cast_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:ellipsize="end"
        android:fontFamily="@font/outfit_semibold"
        android:gravity="center_horizontal"
        android:maxLines="1"
        android:textColor="@color/phone_text_primary"
        android:textSize="12sp"
        tools:text="Timothee Chalamet" />

    <TextView
        android:id="@+id/phone_cast_role"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="@font/inter_regular"
        android:gravity="center_horizontal"
        android:maxLines="1"
        android:textColor="@color/phone_text_muted"
        android:textSize="12sp"
        tools:text="Paul Atreides" />
</LinearLayout>
