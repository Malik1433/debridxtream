<?xml version="1.0" encoding="utf-8"?>
<!--
    DERBIX MOVIE DETAIL V2 — Modernized Cinematic Layout (IPTV)
    TASK 020 — Optimizing for 1080p one-frame fit.
    Preserves all legacy IDs for MovieDetailFragmentV2.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0D10">

    <!-- Backdrop -->
    <ImageView
        android:id="@+id/iv_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.45"
        tools:src="@tools:sample/backgrounds/scenic" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cin_hero_overlay_left" />

    <!-- Content (One-frame optimized) -->
    <LinearLayout
        android:id="@+id/container_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="80dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="80dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_extrabold"
            android:textColor="#FFFFFF"
            android:textSize="52sp"
            android:letterSpacing="-0.02"
            android:lineSpacingMultiplier="0.9"
            tools:text="Dune: Part Two" />

        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/container_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:flexWrap="wrap"
            app:alignItems="center">

            <TextView
                android:id="@+id/tv_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_episode_badge"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="8.9" />

            <TextView
                android:id="@+id/tv_watched_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_episode_badge"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:text="WATCHED"
                android:visibility="gone"
                tools:visibility="visible"
                app:drawableStartCompat="@drawable/ic_check_circle"
                android:drawablePadding="4dp" />

            <TextView
                android:id="@+id/tv_year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:textColor="#B8C0CC"
                android:textSize="18sp"
                tools:text="2024" />

            <TextView
                android:id="@+id/tv_genre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:textColor="#B8C0CC"
                android:textSize="18sp"
                tools:text="Sci-Fi, Action" />
        </com.google.android.flexbox.FlexboxLayout>

        <TextView
            android:id="@+id/tv_plot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#E2E8F0"
            android:textSize="20sp"
            android:lineSpacingMultiplier="1.4"
            android:maxLines="3"
            android:ellipsize="end"
            tools:text="Paul Atreides unites with Chani and the Fremen while seeking revenge against the conspirators who destroyed his family." />

        <!-- Action Buttons -->
        <LinearLayout
            android:id="@+id/container_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_play"
                style="@style/Cin.Button.Primary.Blue"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginEnd="16dp"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:text="WATCH NOW"
                android:textSize="18sp"
                android:nextFocusUp="@id/btn_back"
                android:nextFocusRight="@id/btn_trailer"
                app:icon="@drawable/ic_play"
                app:iconSize="24dp"
                app:iconPadding="12dp"
                app:iconTint="@color/color_selector_cin_primary_blue_text"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_trailer"
                style="@style/Cin.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginEnd="16dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="TRAILER"
                android:textSize="16sp"
                android:nextFocusUp="@id/btn_back"
                android:nextFocusLeft="@id/btn_play"
                android:nextFocusRight="@id/btn_favorite"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_favorite"
                style="@style/Cin.Button.Secondary"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:nextFocusUp="@id/btn_back"
                android:nextFocusLeft="@id/btn_trailer"
                app:icon="@drawable/ic_favorite_border"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:cornerRadius="12dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Top-left back button -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_margin="36dp"
        android:background="@drawable/bg_circle_glass"
        android:contentDescription="Back"
        android:focusable="true"
        android:nextFocusDown="@id/btn_play"
        android:padding="18dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <!-- Central Loader -->
    <ProgressBar
        android:id="@+id/pb_loading_central"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:indeterminateTint="#3B82F6"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Maintenance / Scroll View Placeholder -->
    <View
        android:id="@+id/sv_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
