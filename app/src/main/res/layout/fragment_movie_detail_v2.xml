<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_pure_black">

    <!-- Cinematic Backdrop (Immersive Background) -->
    <ImageView
        android:id="@+id/iv_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.4"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        tools:src="@tools:sample/backgrounds/scenic" />

    <!-- Left Scrim Gradient (Heavy on the left for text) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_gradient_left" />

    <!-- Bottom Gradient (Transition to content) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:background="@drawable/gradient_bottom_up"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Content Scroll Container -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/sv_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="64dp">

            <!-- Content Block -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/container_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="120dp"
                android:paddingStart="64dp"
                android:paddingEnd="32dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.65">

                <!-- Title (Cinematic Scale) -->
                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:textColor="#FFFFFF"
                    android:textSize="64sp"
                    android:textStyle="bold"
                    android:lineHeight="72sp"
                    tools:text="Dune: Part Two"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Metadata Pills (Modern Chips) -->
                <LinearLayout
                    android:id="@+id/container_meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_title">

                    <TextView
                        android:id="@+id/tv_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_rating_badge"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:textColor="@color/ds_accent_gold"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="★ 8.9" />

                    <TextView
                        android:id="@+id/tv_year"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:textColor="#CCCCCC"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-medium"
                        tools:text="2024" />

                    <View
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="12dp"
                        android:background="#66FFFFFF" />

                    <TextView
                        android:id="@+id/tv_genre"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:textColor="#CCCCCC"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-medium"
                        tools:text="Sci-Fi • Action" />
                </LinearLayout>

                <!-- Action Buttons (Modern Horizontal Group) -->
                <LinearLayout
                    android:id="@+id/container_actions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/container_meta">

                    <Button
                        android:id="@+id/btn_play"
                        android:layout_width="wrap_content"
                        android:layout_height="64dp"
                        android:background="@drawable/btn_primary_action"
                        android:drawablePadding="12dp"
                        android:drawableStart="@android:drawable/ic_media_play"
                        android:drawableTint="#FFFFFF"
                        android:focusable="true"
                        android:focusedByDefault="true"
                        android:nextFocusUp="@+id/btn_back"
                        android:paddingStart="32dp"
                        android:paddingEnd="40dp"
                        android:text="WATCH NOW"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:elevation="8dp" />

                    <Button
                        android:id="@+id/btn_trailer"
                        android:layout_width="wrap_content"
                        android:layout_height="64dp"
                        android:layout_marginStart="20dp"
                        android:background="@drawable/btn_secondary_action"
                        android:focusable="true"
                        android:paddingStart="32dp"
                        android:paddingEnd="32dp"
                        android:text="TRAILER"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp" />

                    <ImageButton
                        android:id="@+id/btn_favorite"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="20dp"
                        android:background="@drawable/btn_secondary_action"
                        android:focusable="true"
                        android:src="@drawable/ic_favorite"
                        app:tint="#FFFFFF"
                        android:padding="16dp" />
                </LinearLayout>

                <!-- Plot (Readable & Clean) -->
                <TextView
                    android:id="@+id/tv_plot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:lineSpacingExtra="6dp"
                    android:textColor="#BBBBBB"
                    android:textSize="19sp"
                    android:fontFamily="sans-serif"
                    tools:text="Paul Atreides unites with Chani and the Fremen while on a warpath of revenge against the conspirators who destroyed his family."
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/container_actions" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Top Left Back Navigation -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_margin="32dp"
        android:background="@drawable/bg_circle_dark_translucent"
        android:contentDescription="Back"
        android:focusable="true"
        android:nextFocusDown="@+id/btn_play"
        android:padding="16dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#FFFFFF" />

    <!-- Progress Loader -->
    <ProgressBar
        android:id="@+id/pb_loading_central"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:indeterminateTint="@color/ds_accent"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
