<?xml version="1.0" encoding="utf-8"?>
<!--
    IPTV MOVIE DETAIL (V2) — cinematic design shared with Debrid Movie Detail,
    adapted for IPTV: single direct stream (no source panel), keeps Mark Watched.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#06090E">

    <ImageView
        android:id="@+id/iv_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.45"
        tools:src="@tools:sample/backgrounds/scenic"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cin_detail_overlay" />

    <!-- ══ TOP BAR ══ -->
    <LinearLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="@dimen/detail_top_bar_inset"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="44dp"
        android:paddingEnd="44dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/cin_detail_back_circle"
            android:contentDescription="@string/live_nav_back"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back"
            android:focusable="false"
            android:visibility="gone"
            app:tint="@color/cin_detail_focus_text" />

        <TextView
            android:id="@+id/tv_back_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="◄ BACK TO MOVIES" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/cin_dot_cyan" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/label_iptv"
                android:textColor="@color/source_text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_extrabold"
                android:letterSpacing="0.12" />

            <TextView
                android:id="@+id/tv_breadcrumb_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="@string/ui_movies"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_extrabold"
                android:letterSpacing="0.12" />
        </LinearLayout>
    </LinearLayout>

    <!-- ══ LEFT: MOVIE INFO ══

         M16: this column USED to be the 0dp-tall LinearLayout itself, and that is the defect the
         owner photographed on a real handset. A LinearLayout lays its children out from the top and
         simply runs past its own bottom edge; `clipChildren="false"` then means the overflow is not
         even clipped, it is PAINTED OVER whatever sits below. With a real three-line plot on a
         411dp-tall screen the action buttons landed on top of the plot and the "BECAUSE YOU
         WATCHED" rail landed on top of the buttons.

         The column now scrolls. `group_details` keeps its id and its kind so nothing that binds to
         it changes; only the new NestedScrollView carries the constraints. On a 540dp television
         the content is shorter than the viewport, so it never scrolls and nothing moves. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_details"
        android:layout_width="480dp"
        android:layout_height="0dp"
        android:layout_marginStart="44dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/layout_top_bar"
        app:layout_constraintBottom_toTopOf="@id/layout_similar_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0.0">

    <LinearLayout
        android:id="@+id/group_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_content_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_feature_film"
            android:textColor="@color/neon_cyan"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.2" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/inter_extrabold"
            android:textColor="@color/source_text_primary"
            android:textSize="30sp"
            android:letterSpacing="-0.02"
            android:lineSpacingMultiplier="1.02"
            android:maxLines="2"
            android:ellipsize="end"
            android:includeFontPadding="false"
            tools:text="The Movie Title" />

        <!-- Metadata row -->
        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/layout_metadata_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:flexWrap="wrap"
            app:alignItems="center">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/cin_detail_rating_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/neon_cyan"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    tools:text="8.6" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="★"
                    android:textColor="@color/neon_cyan"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- IMDb rating (OMDb) -->
            <LinearLayout
                android:id="@+id/badge_imdb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/cin_detail_rating_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_imdb"
                    android:textColor="@color/neon_amber"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter_extrabold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/tv_imdb_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:textColor="@color/source_text_primary"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    tools:text="8.6" />
            </LinearLayout>

            <!-- Rotten Tomatoes rating (OMDb) -->
            <LinearLayout
                android:id="@+id/badge_rt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/cin_detail_rating_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🍅"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tv_rt_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:textColor="@color/source_text_primary"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    tools:text="92%" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/source_text_secondary"
                android:textSize="11sp"
                android:fontFamily="monospace"
                tools:text="2024" />

            <TextView
                android:id="@+id/tv_dot_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="·"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/source_text_secondary"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="2H 46M" />

            <TextView
                android:id="@+id/tv_dot_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="·"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_genre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/source_text_secondary"
                android:textSize="11sp"
                tools:text="Sci-Fi, Adventure" />

            <TextView
                android:id="@+id/tv_age_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/cin_detail_quality_badge"
                android:textColor="@color/source_text_secondary"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="PG-13" />
        </com.google.android.flexbox.FlexboxLayout>

        <!-- Resume bar -->
        <LinearLayout
            android:id="@+id/layout_resume_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/cin_resume_bar_bg"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_play"
                android:scaleType="fitCenter"
                app:tint="@color/neon_cyan"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_resume_elapsed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/neon_cyan"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.10"
                        tools:text="RESUME FROM 1:12:34" />

                    <TextView
                        android:id="@+id/tv_resume_remaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp"
                        android:fontFamily="monospace"
                        tools:text="1:04:00 LEFT" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pb_resume"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="6dp"
                    android:max="100"
                    android:progressDrawable="@drawable/cin_resume_progress"
                    tools:progress="62" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_plot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/source_text_secondary"
            android:textSize="12sp"
            android:lineSpacingMultiplier="1.35"
            android:maxLines="3"
            android:ellipsize="end"
            android:includeFontPadding="false"
            tools:text="Plot goes here." />

        <!-- Action buttons -->
        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/container_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:flexWrap="wrap"
            app:alignItems="center"
            android:layout_marginTop="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginStart="-10dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_play"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/detail_action_height"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="@drawable/cin_detail_btn_watch"
                android:drawableStart="@drawable/ic_play"
                android:drawablePadding="6dp"
                android:drawableTint="#041014"
                android:text="@string/movie_detail_watch_now"
                android:textColor="#041014"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:fontFamily="@font/inter_extrabold"
                android:letterSpacing="0.04"
                android:focusable="true"
                android:nextFocusRight="@id/btn_trailer" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_trailer"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/detail_action_height"
                android:layout_marginStart="10dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/cin_detail_btn_glass"
                android:drawableStart="@drawable/ic_trailer_video"
                android:drawablePadding="6dp"
                android:drawableTint="@color/cin_detail_focus_text"
                android:text="@string/movie_detail_tab_trailer"
                android:textColor="@color/cin_detail_focus_text"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:fontFamily="@font/inter_extrabold"
                android:letterSpacing="0.04"
                android:focusable="true"
                android:nextFocusLeft="@id/btn_play"
                android:nextFocusRight="@id/btn_favorite" />

            <ImageButton
                android:id="@+id/btn_favorite"
                android:layout_width="@dimen/detail_fav_width"
                android:layout_height="@dimen/detail_action_height"
                android:layout_marginStart="10dp"
                android:background="@drawable/cin_detail_btn_glass"
                android:src="@drawable/ic_favorite_border"
                android:scaleType="centerInside"
                android:padding="9dp"
                android:contentDescription="@string/ui_favorite_2"
                app:tint="@color/cin_detail_focus_text"
                android:focusable="true"
                android:nextFocusLeft="@id/btn_trailer"
                android:nextFocusRight="@id/btn_mark_watched" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_mark_watched"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/detail_action_height"
                android:layout_marginStart="10dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/cin_detail_btn_glass"
                android:text="@string/ui_mark_watched"
                android:textColor="@color/cin_detail_focus_text"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:fontFamily="@font/inter_extrabold"
                android:letterSpacing="0.04"
                android:focusable="true"
                android:nextFocusLeft="@id/btn_favorite" />
        </com.google.android.flexbox.FlexboxLayout>

        <TextView
            android:id="@+id/tv_watched_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ui_watched"
            android:textColor="@color/neon_green"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Director + Cast -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/layout_director"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_director"
                    android:textColor="@color/text_muted"
                    android:textSize="9sp"
                    android:fontFamily="@font/inter_extrabold"
                    android:letterSpacing="0.16"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_director"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textColor="@color/source_text_primary"
                    android:textSize="12sp"
                    tools:text="Denis Villeneuve" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_cast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_cast_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_cast"
                    android:textColor="@color/text_muted"
                    android:textSize="9sp"
                    android:fontFamily="@font/inter_extrabold"
                    android:letterSpacing="0.16"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_cast"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal"
                    android:clipToPadding="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_cast_member"
                    tools:itemCount="5" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ══ SIMILAR MOVIES ROW ══ -->
    <LinearLayout
        android:id="@+id/layout_similar_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="44dp"
        android:paddingEnd="44dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/header_similar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_similar_movies"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:fontFamily="@font/inter_extrabold"
            android:letterSpacing="0.16"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_similar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:clipToPadding="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pb_loading_central"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminateTint="@color/neon_cyan"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
