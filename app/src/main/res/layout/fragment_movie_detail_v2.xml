<?xml version="1.0" encoding="utf-8"?>
<!--
    DERBIX MOVIE DETAIL V2 — modernized cinematic layout (Round 3)
    All IDs preserved for the v2 fragment:
      iv_backdrop, sv_content, container_info, tv_title, container_meta,
      tv_rating, tv_year, tv_genre, container_actions, btn_play, btn_trailer,
      btn_favorite, tv_plot, btn_back, pb_loading_central.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cin_ink_900">

    <!-- Backdrop -->
    <ImageView
        android:id="@+id/iv_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.55"
        android:importantForAccessibility="no"
        tools:src="@tools:sample/backgrounds/scenic" />

    <!-- 3-stop scrim -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cin_hero_overlay_left"
        android:importantForAccessibility="no" />

    <!-- Content scroll -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/sv_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="80dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/container_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="80dp"
                android:paddingStart="120dp"
                android:paddingEnd="60dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.66">

                <!-- Featured overline -->
                <LinearLayout
                    android:id="@+id/ll_overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <View
                        android:layout_width="38dp"
                        android:layout_height="2dp"
                        android:layout_marginEnd="14dp"
                        android:background="@drawable/cin_section_accent_bar" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FEATURED MOVIE"
                        android:textColor="@color/cin_gold_300"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter_extrabold"
                        android:textStyle="bold"
                        android:letterSpacing="0.36" />
                </LinearLayout>

                <!-- Title -->
                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/inter_extrabold"
                    android:textColor="@color/cin_text_primary"
                    android:textSize="58sp"
                    android:textStyle="bold"
                    android:lineSpacingMultiplier="0.96"
                    android:letterSpacing="-0.025"
                    android:shadowColor="#A6000000"
                    android:shadowDx="0"
                    android:shadowDy="4"
                    android:shadowRadius="24"
                    tools:text="Dune: Part Two"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ll_overline" />

                <!-- Meta chips -->
                <com.google.android.flexbox.FlexboxLayout
                    android:id="@+id/container_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:flexWrap="wrap"
                    app:alignItems="center"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_title">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="12dp"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/cin_chip_rating_v2">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_star_filled"
                            app:tint="@color/cin_gold_300"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/tv_rating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/cin_gold_200"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/plus_jakarta_sans"
                            tools:text="8.9" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_year"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="12dp"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:background="@drawable/cin_chip_meta"
                        android:textColor="@color/cin_text_secondary"
                        android:textSize="14sp"
                        android:fontFamily="@font/plus_jakarta_sans"
                        tools:text="2024" />

                    <TextView
                        android:id="@+id/tv_genre"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="12dp"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:background="@drawable/cin_chip_meta"
                        android:textColor="@color/cin_text_secondary"
                        android:textSize="14sp"
                        android:fontFamily="@font/plus_jakarta_sans"
                        tools:text="Sci-Fi · Action" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:background="@drawable/cin_chip_quality_gold"
                        android:text="4K · HDR · ATMOS"
                        android:textColor="#1A1108"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04"
                        android:fontFamily="@font/inter_extrabold" />
                </com.google.android.flexbox.FlexboxLayout>

                <!-- Action buttons -->
                <LinearLayout
                    android:id="@+id/container_actions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/container_meta">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_play"
                        style="@style/Cin.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="64dp"
                        android:layout_marginEnd="14dp"
                        android:paddingStart="36dp"
                        android:paddingEnd="36dp"
                        android:text="WATCH NOW"
                        android:textSize="17sp"
                        android:focusedByDefault="true"
                        android:nextFocusUp="@id/btn_back"
                        app:icon="@drawable/ic_play"
                        app:iconTint="@color/cin_text_on_gold"
                        app:iconGravity="textStart"
                        app:iconPadding="12dp"
                        app:cornerRadius="14dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_trailer"
                        style="@style/Cin.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="64dp"
                        android:layout_marginEnd="14dp"
                        android:paddingStart="32dp"
                        android:paddingEnd="32dp"
                        android:text="TRAILER"
                        android:textSize="17sp"
                        app:cornerRadius="14dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_favorite"
                        style="@style/Cin.Button.Icon"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        app:icon="@drawable/ic_favorite"
                        app:iconTint="@color/cin_text_primary"
                        app:cornerRadius="14dp" />
                </LinearLayout>

                <!-- Plot -->
                <TextView
                    android:id="@+id/tv_plot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:lineSpacingMultiplier="1.45"
                    android:textColor="@color/cin_text_secondary"
                    android:textSize="20sp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    tools:text="Paul Atreides unites with Chani and the Fremen while seeking revenge against the conspirators who destroyed his family."
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/container_actions" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Top-left back button -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_margin="36dp"
        android:background="@drawable/cin_btn_back_glass"
        android:contentDescription="Back"
        android:focusable="true"
        android:nextFocusDown="@+id/btn_play"
        android:padding="18dp"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/cin_text_primary"
        android:elevation="6dp" />

    <!-- Loader -->
    <ProgressBar
        android:id="@+id/pb_loading_central"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:indeterminateTint="@color/cin_gold_500"
        android:visibility="gone"
        android:elevation="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
