<?xml version="1.0" encoding="utf-8"?>
<!-- Cinematic episode card: 134dp wide, matching Debrid Series Detail design -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="134dp"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="3dp"
    android:background="@drawable/cin_series_ep_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Thumbnail container -->
        <FrameLayout
            android:layout_width="128dp"
            android:layout_height="72dp"
            android:clipChildren="false">

            <ImageView
                android:id="@+id/iv_episode_thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@drawable/cin_series_ep_thumb_border"
                tools:src="@tools:sample/backgrounds/scenic" />

            <!-- Bottom gradient on thumbnail -->
            <View
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_episode_overlay" />

            <!-- Episode tag (top-left) E01 -->
            <TextView
                android:id="@+id/tv_episode_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="4dp"
                android:background="@drawable/cin_series_ep_tag"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:textColor="#041014"
                android:textSize="6sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                tools:text="E01" />

            <!-- Duration tag (top-right) -->
            <TextView
                android:id="@+id/tv_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="4dp"
                android:background="@drawable/cin_series_ep_duration_bg"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:textColor="#CBD5E1"
                android:textSize="6sp"
                android:fontFamily="monospace"
                tools:text="55M" />

            <!-- Progress bar (bottom of thumb, only shown when in-progress) -->
            <FrameLayout
                android:id="@+id/layout_progress"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_gravity="bottom"
                android:visibility="gone"
                tools:visibility="visible">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/cin_series_progress_bg" />

                <View
                    android:id="@+id/v_progress_fill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/cin_series_progress_fill" />
            </FrameLayout>

            <!-- Badge circle (bottom-left): play or watched -->
            <FrameLayout
                android:id="@+id/layout_badge"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="5dp"
                android:layout_marginBottom="5dp">

                <View
                    android:id="@+id/v_badge_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/cin_series_ep_badge_play" />

                <!-- Watched checkmark -->
                <ImageView
                    android:id="@+id/iv_watched_indicator"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_check_circle"
                    android:visibility="gone"
                    app:tint="#041014"
                    tools:visibility="gone"
                    xmlns:app="http://schemas.android.com/apk/res-auto" />

                <!-- Play triangle -->
                <ImageView
                    android:id="@+id/iv_play_icon"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_play_arrow_24"
                    app:tint="#F1F5F9"
                    xmlns:app="http://schemas.android.com/apk/res-auto" />
            </FrameLayout>
        </FrameLayout>

        <!-- Episode title + subtitle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="1dp"
            android:paddingEnd="1dp"
            android:paddingTop="5dp">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#F1F5F9"
                android:textSize="8sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Ghost in the Noise" />

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#64748B"
                android:textSize="6sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.04"
                android:maxLines="1"
                tools:text="RESUME · 42%" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
