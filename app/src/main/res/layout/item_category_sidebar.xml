<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:layout_marginHorizontal="8dp"
    android:focusable="true"
    android:focusableInTouchMode="@bool/rows_focusable_in_touch_mode"
    android:background="@drawable/category_sidebar_item_bg"
    android:stateListAnimator="@animator/sidebar_item_animator"
    android:minHeight="48dp">

    <!-- Active Selection Indicator -->
    <View
        android:id="@+id/v_active_indicator"
        android:layout_width="4dp"
        android:layout_height="24dp"
        android:background="@color/brand_cyan"
        android:visibility="invisible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Icon Container (Visible in Expanded Mode) -->
    <ImageView
        android:id="@+id/iv_category_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="16dp"
        android:src="@drawable/ic_movie"
        app:tint="#99FFFFFF"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:contentDescription="@null" />

    <!-- Category Code (Primary in Collapsed, Leading in Expanded) -->
    <TextView
        android:id="@+id/tv_category_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="@string/ui_en"
        android:textColor="@color/brand_cyan"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/bg_badge_quality"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:fontFamily="@font/plus_jakarta_sans"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Category Name (Full Label, visible only when expanded) -->
    <TextView
        android:id="@+id/tv_category_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        android:text="@string/ui_category_name"
        android:textColor="#B3FFFFFF"
        android:textSize="17sp"
        android:textStyle="normal"
        android:fontFamily="@font/plus_jakarta_sans"
        android:singleLine="true"
        android:ellipsize="marquee"
        android:visibility="gone"
        app:layout_constraintStart_toEndOf="@id/tv_category_code"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
