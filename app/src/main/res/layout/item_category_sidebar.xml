<?xml version="1.0" encoding="utf-8"?>
<!--
    DERBIX CINEMATIC · CATEGORY SIDEBAR ITEM  (round 2)
    Drop-in replacement for item_category_sidebar.xml.
    PRESERVED IDS (CategorySidebarAdapter.kt binds them):
      v_active_indicator, iv_category_icon, tv_category_name
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:layout_marginHorizontal="4dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:background="@drawable/cin_sidebar_item_bg"
    android:stateListAnimator="@animator/cin_sidebar_item_state">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="14dp">

        <!-- Active gold pill (kept ID, restyled) -->
        <View
            android:id="@+id/v_active_indicator"
            android:layout_width="3dp"
            android:layout_height="20dp"
            android:background="@drawable/cin_sidebar_pill_gold"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/iv_category_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="14dp"
            android:src="@drawable/ic_movie"
            app:tint="#B3FFFFFF" />

        <TextView
            android:id="@+id/tv_category_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:text="Category Name"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp"
            android:fontFamily="@font/plus_jakarta_sans"
            android:textStyle="bold"
            android:letterSpacing="0.005"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>
