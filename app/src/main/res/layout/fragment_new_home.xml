<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_bg_gradient"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingTop="20dp"
    android:paddingBottom="20dp">

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- App Title -->
        <TextView
            android:id="@+id/tv_app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_title"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/accent_gold"
            android:shadowColor="@color/shadow_color"
            android:shadowRadius="6"
            android:shadowDx="2"
            android:shadowDy="2"
            android:letterSpacing="0.05"
            android:layout_marginEnd="48dp" />

        <!-- Navigation Buttons -->
        <LinearLayout
            android:id="@+id/nav_buttons_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="start">

            <TextView
                android:id="@+id/btn_nav_live_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_live_tv"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/nav_button_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusRight="@id/btn_nav_movies"
                android:nextFocusDown="@id/rv_featured" />

            <TextView
                android:id="@+id/btn_nav_movies"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_movies"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/nav_button_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@id/btn_nav_live_tv"
                android:nextFocusRight="@id/btn_nav_series"
                android:nextFocusDown="@id/rv_featured" />

            <TextView
                android:id="@+id/btn_nav_series"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_series"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/nav_button_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@id/btn_nav_movies"
                android:nextFocusRight="@id/btn_nav_search"
                android:nextFocusDown="@id/rv_featured" />

            <TextView
                android:id="@+id/btn_nav_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_search"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:background="@drawable/nav_button_bg"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@id/btn_nav_series"
                android:nextFocusRight="@id/btn_settings"
                android:nextFocusDown="@id/rv_featured" />
        </LinearLayout>

        <!-- Settings Button -->
        <ImageView
            android:id="@+id/btn_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_preferences"
            android:tint="@color/text_primary"
            android:background="@drawable/settings_button_bg"
            android:padding="12dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/btn_nav_search"
            android:nextFocusDown="@id/rv_featured"
            android:contentDescription="@string/settings" />
    </LinearLayout>

    <!-- Main Content ScrollView -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/header_container"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Featured Section -->
            <LinearLayout
                android:id="@+id/section_featured"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tv_section_featured"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_featured"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_gold"
                    android:shadowColor="@color/shadow_color"
                    android:shadowRadius="4"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:letterSpacing="0.02"
                    android:layout_marginBottom="10dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_featured"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipToPadding="false"
                    android:focusable="true"
                    android:nextFocusUp="@id/btn_nav_live_tv"
                    android:nextFocusDown="@id/rv_recent_live"
                    tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="4"
                    tools:listitem="@layout/item_featured_card" />
            </LinearLayout>

            <!-- Recent Live Channels Section -->
            <LinearLayout
                android:id="@+id/section_recent_live"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tv_section_recent_live"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_recent_live"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:letterSpacing="0.01"
                    android:layout_marginBottom="10dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_recent_live"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipToPadding="false"
                    android:focusable="true"
                    android:nextFocusUp="@id/rv_featured"
                    android:nextFocusDown="@id/rv_continue_watching"
                    tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="6"
                    tools:listitem="@layout/item_recent_live_card" />
            </LinearLayout>

            <!-- Continue Watching Section -->
            <LinearLayout
                android:id="@+id/section_continue_watching"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tv_section_continue_watching"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_continue_watching"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:letterSpacing="0.01"
                    android:layout_marginBottom="10dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_continue_watching"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipToPadding="false"
                    android:focusable="true"
                    android:nextFocusUp="@id/rv_recent_live"
                    android:nextFocusDown="@id/rv_favorites"
                    tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="5"
                    tools:listitem="@layout/item_continue_watching_card" />
            </LinearLayout>

            <!-- Favorites Section -->
            <LinearLayout
                android:id="@+id/section_favorites"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tv_section_favorites"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_favorites"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:letterSpacing="0.01"
                    android:layout_marginBottom="10dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_favorites"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipToPadding="false"
                    android:focusable="true"
                    android:nextFocusUp="@id/rv_continue_watching"
                    tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="5"
                    tools:listitem="@layout/item_favorite_card" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

