<?xml version="1.0" encoding="utf-8"?>
<!--
    DERBIX MOVIE DETAIL — modernized cinematic layout (Round 3)
    All IDs preserved for MovieDetailActivity.findViewById:
      iv_backdrop, tv_title, tv_director, tv_description, tv_duration,
      tv_genre_year, tv_rating_stars, tv_rating_percentage,
      tv_cast_title, rv_cast, group_details,
      tv_sources_header, tv_sources_status, layout_source_filters,
      btn_cached_only, rv_language_filters, rv_sources,
      iv_poster, btn_play, btn_trailer, btn_favorite,
      header_similar, rv_similar.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cin_ink_900">

    <!-- Full-bleed cinematic backdrop -->
    <ImageView
        android:id="@+id/iv_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.55"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:src="@tools:sample/backgrounds/scenic" />

    <!-- 3-stop scrim overlay (left-heavy + bottom + top haze) -->
    <View
        android:id="@+id/view_backdrop_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cin_hero_overlay_left"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- group_details wraps hero + sources for activity-level toggle -->
            <LinearLayout
                android:id="@+id/group_details"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="120dp"
                android:layout_marginEnd="120dp"
                android:layout_marginTop="80dp"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Hero row: text column + poster -->
                <LinearLayout
                    android:id="@+id/ll_hero_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <!-- Text column -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- Featured overline -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <View
                                android:layout_width="38dp"
                                android:layout_height="2dp"
                                android:layout_marginEnd="14dp"
                                android:background="@drawable/cin_section_accent_bar" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="FEATURED MOVIE"
                                android:textColor="@color/cin_gold_300"
                                android:textSize="13sp"
                                android:fontFamily="@font/inter_extrabold"
                                android:textStyle="bold"
                                android:letterSpacing="0.36" />
                        </LinearLayout>

                        <!-- Title (88sp display) -->
                        <TextView
                            android:id="@+id/tv_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:textColor="@color/cin_text_primary"
                            android:textSize="88sp"
                            android:lineSpacingMultiplier="0.96"
                            android:fontFamily="@font/inter_extrabold"
                            android:letterSpacing="-0.025"
                            android:shadowColor="#A6000000"
                            android:shadowDx="0"
                            android:shadowDy="4"
                            android:shadowRadius="24"
                            tools:text="Dune: Part Two" />

                        <!-- Meta chip row: rating · year · runtime · genre · 4K -->
                        <com.google.android.flexbox.FlexboxLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="28dp"
                            app:flexWrap="wrap"
                            app:alignItems="center">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:layout_marginEnd="12dp"
                                android:layout_marginBottom="8dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:background="@drawable/cin_chip_rating_v2">

                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:layout_marginEnd="8dp"
                                    android:src="@drawable/ic_star_filled"
                                    app:tint="@color/cin_gold_300"
                                    android:importantForAccessibility="no" />

                                <TextView
                                    android:id="@+id/tv_rating_percentage"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/cin_gold_200"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    tools:text="8.9" />
                            </LinearLayout>

                            <!-- legacy stars id (kept for activity binding) -->
                            <TextView
                                android:id="@+id/tv_rating_stars"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/tv_genre_year"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:layout_marginEnd="12dp"
                                android:layout_marginBottom="8dp"
                                android:gravity="center_vertical"
                                android:background="@drawable/cin_chip_meta"
                                android:textColor="@color/cin_text_secondary"
                                android:textSize="14sp"
                                android:fontFamily="@font/plus_jakarta_sans"
                                tools:text="2024 · Sci-Fi · Action" />

                            <TextView
                                android:id="@+id/tv_duration"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:layout_marginEnd="12dp"
                                android:layout_marginBottom="8dp"
                                android:gravity="center_vertical"
                                android:background="@drawable/cin_chip_meta"
                                android:textColor="@color/cin_text_secondary"
                                android:textSize="14sp"
                                android:fontFamily="@font/plus_jakarta_sans"
                                tools:text="2h 46m" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:layout_marginBottom="8dp"
                                android:gravity="center_vertical"
                                android:background="@drawable/cin_chip_quality_gold"
                                android:text="4K · HDR · ATMOS"
                                android:textColor="#1A1108"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.04"
                                android:fontFamily="@font/inter_extrabold" />
                        </com.google.android.flexbox.FlexboxLayout>

                        <!-- Synopsis -->
                        <TextView
                            android:id="@+id/tv_description"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="32dp"
                            android:maxWidth="780dp"
                            android:maxLines="4"
                            android:ellipsize="end"
                            android:textColor="@color/cin_text_secondary"
                            android:textSize="20sp"
                            android:lineSpacingMultiplier="1.45"
                            android:fontFamily="@font/plus_jakarta_sans"
                            tools:text="Paul Atreides unites with Chani and the Fremen while seeking revenge against the conspirators who destroyed his family." />

                        <!-- Action buttons -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="36dp"
                            android:orientation="horizontal"
                            android:clipChildren="false"
                            android:clipToPadding="false">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_play"
                                style="@style/Cin.Button.Primary"
                                android:layout_width="wrap_content"
                                android:layout_height="64dp"
                                android:layout_marginEnd="14dp"
                                android:paddingStart="36dp"
                                android:paddingEnd="36dp"
                                android:text="Watch Now"
                                android:textSize="17sp"
                                android:focusedByDefault="true"
                                app:icon="@drawable/ic_play"
                                app:iconTint="@color/cin_text_on_gold"
                                app:iconGravity="textStart"
                                app:iconPadding="12dp"
                                app:cornerRadius="14dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_trailer"
                                style="@style/Cin.Button.Secondary"
                                android:layout_width="wrap_content"
                                android:layout_height="64dp"
                                android:layout_marginEnd="14dp"
                                android:paddingStart="32dp"
                                android:paddingEnd="32dp"
                                android:text="Trailer"
                                android:textSize="17sp"
                                app:cornerRadius="14dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_favorite"
                                style="@style/Cin.Button.Icon"
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                app:icon="@drawable/ic_favorite"
                                app:iconTint="@color/cin_text_primary"
                                app:cornerRadius="14dp" />
                        </LinearLayout>

                        <!-- Director row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="36dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="96dp"
                                android:layout_height="wrap_content"
                                android:text="DIRECTOR"
                                android:textColor="@color/cin_text_tertiary"
                                android:textSize="11sp"
                                android:letterSpacing="0.20"
                                android:fontFamily="@font/inter_extrabold"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_director"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/cin_text_secondary"
                                android:textSize="16sp"
                                android:fontFamily="@font/plus_jakarta_sans"
                                tools:text="Denis Villeneuve" />
                        </LinearLayout>

                        <!-- Cast section -->
                        <TextView
                            android:id="@+id/tv_cast_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="28dp"
                            android:text="CAST"
                            android:textColor="@color/cin_text_tertiary"
                            android:textSize="11sp"
                            android:letterSpacing="0.20"
                            android:fontFamily="@font/inter_extrabold"
                            android:textStyle="bold"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_cast"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="horizontal"
                            android:clipToPadding="false"
                            android:clipChildren="false"
                            android:nestedScrollingEnabled="false"
                            android:visibility="gone"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            tools:listitem="@layout/item_cast_member"
                            tools:visibility="visible"
                            tools:itemCount="6" />

                    </LinearLayout>

                    <!-- Poster (right column) -->
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/iv_poster"
                        android:layout_width="340dp"
                        android:layout_height="510dp"
                        android:layout_marginStart="48dp"
                        android:layout_gravity="top"
                        android:scaleType="centerCrop"
                        android:elevation="20dp"
                        app:shapeAppearanceOverlay="@style/Cin.Shape.Poster"
                        tools:background="@color/cin_ink_500" />
                </LinearLayout>

                <!-- Sources card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="56dp"
                    android:orientation="vertical"
                    android:background="@drawable/cin_card_sources_glass"
                    android:padding="28dp"
                    android:elevation="12dp">

                    <LinearLayout
                        android:id="@+id/layout_source_filters"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tv_sources_header"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/cin_text_primary"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/inter_extrabold"
                                android:letterSpacing="-0.01"
                                tools:text="Streaming sources" />

                            <TextView
                                android:id="@+id/btn_cached_only"
                                style="@style/Cin.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:background="@drawable/cin_filter_chip_state"
                                android:textColor="@color/cin_season_pill_text"
                                tools:text="Cached only" />
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_language_filters"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="horizontal"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            tools:listitem="@layout/item_language_chip"
                            tools:itemCount="5" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_sources_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:textColor="@color/cin_text_tertiary"
                        android:textSize="13sp"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:visibility="gone"
                        tools:text="Loading reliable sources…"
                        tools:visibility="visible" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_sources"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:nestedScrollingEnabled="false"
                        android:clipToPadding="false"
                        android:clipChildren="false"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:itemCount="3" />
                </LinearLayout>
            </LinearLayout>

            <!-- Similar movies rail -->
            <include
                android:id="@+id/header_similar"
                layout="@layout/cin_view_section_header_v2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                app:layout_constraintTop_toBottomOf="@id/group_details"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_similar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="120dp"
                android:paddingTop="20dp"
                android:paddingBottom="56dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintTop_toBottomOf="@id/header_similar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                tools:listitem="@layout/cin_item_poster"
                tools:itemCount="6" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
