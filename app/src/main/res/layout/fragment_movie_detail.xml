<?xml version="1.0" encoding="utf-8"?>
<!--
    DERBIX MOVIE DETAIL — Modernized Cinematic Layout (Orville Style)
    TASK 020 — Optimizing for 1080p one-frame fit.
    Preserves all legacy IDs for MovieDetailActivity.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0D10">

    <!-- Backdrop -->
    <ImageView
        android:id="@+id/iv_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.45"
        tools:src="@tools:sample/backgrounds/scenic" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cin_hero_overlay_left" />

    <!-- Main Content (One-frame optimized) -->
    <LinearLayout
        android:id="@+id/group_details"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="80dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="80dp"
        android:paddingBottom="40dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_extrabold"
            android:textColor="#FFFFFF"
            android:textSize="52sp"
            android:letterSpacing="-0.02"
            android:lineSpacingMultiplier="0.9"
            tools:text="Dune: Part Two" />

        <com.google.android.flexbox.FlexboxLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:flexWrap="wrap"
            app:alignItems="center">

            <TextView
                android:id="@+id/tv_rating_percentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_episode_badge"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="8.9" />

            <TextView
                android:id="@+id/tv_genre_year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:textColor="#B8C0CC"
                android:textSize="18sp"
                tools:text="Sci-Fi, Action • 2024" />

            <TextView
                android:id="@+id/tv_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:textColor="#B8C0CC"
                android:textSize="18sp"
                tools:text="2h 46m" />
                
            <!-- Legacy support IDs -->
            <TextView android:id="@+id/tv_rating_stars" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        </com.google.android.flexbox.FlexboxLayout>

        <!-- RD Source Summary (TASK 020) -->
        <LinearLayout
            android:id="@+id/layout_rd_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/cin_card_glass_subtle"
            android:paddingStart="12dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/cin_src_badge_real"
                android:layout_marginEnd="8dp"
                app:tint="#3B82F6"/>

            <TextView
                android:id="@+id/tv_rd_summary_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#3B82F6"
                android:textSize="14sp"
                android:fontFamily="@font/inter"
                android:textStyle="bold"
                android:text="Press Watch Now to find sources" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#E2E8F0"
            android:textSize="20sp"
            android:lineSpacingMultiplier="1.4"
            android:maxLines="3"
            android:ellipsize="end"
            tools:text="Paul Atreides unites with Chani and the Fremen while seeking revenge against the conspirators who destroyed his family." />

        <!-- Action Buttons -->
        <LinearLayout
            android:id="@+id/container_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_play"
                style="@style/Cin.Button.Primary.Blue"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginEnd="16dp"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:text="WATCH NOW"
                android:textSize="18sp"
                android:nextFocusUp="@id/btn_back"
                android:nextFocusDown="@id/rv_cast"
                android:nextFocusRight="@id/btn_trailer"
                app:icon="@drawable/ic_play"
                app:iconSize="24dp"
                app:iconPadding="12dp"
                app:iconTint="@color/color_selector_cin_primary_blue_text"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_trailer"
                style="@style/Cin.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginEnd="16dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="TRAILER"
                android:textSize="16sp"
                android:nextFocusUp="@id/btn_back"
                android:nextFocusDown="@id/rv_cast"
                android:nextFocusLeft="@id/btn_play"
                android:nextFocusRight="@id/btn_favorite"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_favorite"
                style="@style/Cin.Button.Secondary"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:nextFocusUp="@id/btn_back"
                android:nextFocusDown="@id/rv_cast"
                android:nextFocusLeft="@id/btn_trailer"
                app:icon="@drawable/ic_favorite_border"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <!-- Secondary Info (Director/Cast) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DIRECTOR"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:letterSpacing="0.1"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_director"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    tools:text="Denis Villeneuve" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_cast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="48dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_cast_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CAST"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:letterSpacing="0.1"
                    android:textStyle="bold" />
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_cast"
                    android:layout_width="wrap_content"
                    android:layout_height="170dp"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_cast_member"
                    tools:itemCount="3" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- Hidden / Maintenance IDs (to prevent Activity crash) -->
    <LinearLayout
        android:id="@+id/container_sources_maintenance"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView android:id="@+id/tv_sources_header" android:layout_width="0dp" android:layout_height="0dp" />
        <TextView android:id="@+id/tv_sources_status" android:layout_width="0dp" android:layout_height="0dp" />
        <View android:id="@+id/layout_source_filters" android:layout_width="0dp" android:layout_height="0dp" />
        <TextView android:id="@+id/btn_cached_only" android:layout_width="0dp" android:layout_height="0dp" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_language_filters" android:layout_width="0dp" android:layout_height="0dp" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_sources" android:layout_width="0dp" android:layout_height="0dp" />
        <ImageView android:id="@+id/iv_poster" android:layout_width="0dp" android:layout_height="0dp" />
        <TextView android:id="@+id/header_similar" android:layout_width="0dp" android:layout_height="0dp" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_similar" android:layout_width="0dp" android:layout_height="0dp" />
    </LinearLayout>

    <!-- Loading Overlay -->
    <FrameLayout
        android:id="@+id/layout_loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D90B0D10"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <ProgressBar android:layout_width="56dp" android:layout_height="56dp" android:indeterminateTint="#3B82F6" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="#FFFFFF"
                android:text="Loading movie details..." />
        </LinearLayout>
    </FrameLayout>

    <!-- Top-left back button -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_margin="36dp"
        android:background="@drawable/bg_circle_glass"
        android:contentDescription="Back"
        android:scaleType="centerInside"
        android:src="@drawable/ic_back"
        android:focusable="true"
        android:nextFocusDown="@id/btn_play"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

</androidx.constraintlayout.widget.ConstraintLayout>
