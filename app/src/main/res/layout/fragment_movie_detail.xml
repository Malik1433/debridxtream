<?xml version="1.0" encoding="utf-8"?>
<!--
    DEBRID MOVIE DETAIL — Redesigned per Claude Design handoff.
    1920×1080 TV-optimized, full-bleed backdrop, left-aligned info.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#06090E">

    <!-- Full-bleed backdrop -->
    <ImageView
        android:id="@+id/iv_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.45"
        tools:src="@tools:sample/backgrounds/scenic" />

    <!-- Left + bottom gradient overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cin_detail_overlay" />

    <!-- ══ TOP BAR ══ -->
    <LinearLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="@dimen/detail_top_bar_inset"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="44dp"
        android:paddingEnd="44dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back button (removed from design — hardware BACK handles it) -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/cin_detail_back_circle"
            android:contentDescription="Back"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back"
            android:focusable="false"
            android:visibility="gone"
            android:nextFocusDown="@id/btn_play"
            app:tint="@color/cin_detail_focus_text" />

        <!-- Back-to-rail context hint -->
        <TextView
            android:id="@+id/tv_back_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="◄ BACK TO CONTINUE WATCHING" />

        <!-- Breadcrumb -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/dot_brand"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/cin_dot_cyan" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="DEBRID"
                android:textColor="@color/source_text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_extrabold"
                android:letterSpacing="0.12" />

            <TextView
                android:id="@+id/tv_breadcrumb_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="/ MOVIES"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_extrabold"
                android:letterSpacing="0.12" />
        </LinearLayout>

        <!-- RD Connected status -->
        <LinearLayout
            android:id="@+id/layout_rd_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/cin_detail_rd_status_pill"
            android:visibility="gone"
            tools:visibility="visible">

            <View
                android:id="@+id/dot_rd_status"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:background="@drawable/cin_dot_online" />

            <TextView
                android:id="@+id/tv_rd_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="RD CONNECTED"
                android:textColor="@color/neon_green"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <!-- Premium badge -->
        <TextView
            android:id="@+id/tv_premium_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/cin_detail_premium_pill"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="PREMIUM · 224 DAYS" />
    </LinearLayout>

    <!-- ══ LEFT: MOVIE INFO ══
         D4: the DEBRID movie detail is a structural twin of the IPTV one, so it carried the same
         defect M16a fixed there — a 0dp-tall LinearLayout runs past its own bottom, and with
         `clipChildren="false"` on the root that overflow is PAINTED OVER the similar rail. Same
         recipe: the column scrolls, `group_details` keeps its id and kind, and the root now clips. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_details"
        android:layout_width="480dp"
        android:layout_height="0dp"
        android:layout_marginStart="44dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="@dimen/detail_column_margin_bottom"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/layout_top_bar"
        app:layout_constraintBottom_toTopOf="@id/layout_similar_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0.0">

    <LinearLayout
        android:id="@+id/group_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Content type label -->
        <TextView
            android:id="@+id/tv_content_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FEATURE FILM"
            android:textColor="@color/neon_cyan"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.2"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Title -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/inter_extrabold"
            android:textColor="@color/source_text_primary"
            android:textSize="30sp"
            android:letterSpacing="-0.02"
            android:lineSpacingMultiplier="1.02"
            android:maxLines="2"
            android:ellipsize="end"
            android:includeFontPadding="false"
            tools:text="Dune: Part Two" />

        <!-- Metadata row -->
        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/layout_metadata_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:flexWrap="wrap"
            app:alignItems="center">

            <!-- Rating badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/cin_detail_rating_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_rating_percentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/neon_cyan"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    tools:text="8.6" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="★"
                    android:textColor="@color/neon_cyan"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- IMDb rating (OMDb) -->
            <LinearLayout
                android:id="@+id/badge_imdb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/cin_detail_rating_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IMDb"
                    android:textColor="@color/neon_amber"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter_extrabold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/tv_imdb_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:textColor="@color/source_text_primary"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    tools:text="8.6" />
            </LinearLayout>

            <!-- Rotten Tomatoes rating (OMDb) -->
            <LinearLayout
                android:id="@+id/badge_rt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/cin_detail_rating_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🍅"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tv_rt_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:textColor="@color/source_text_primary"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    tools:text="92%" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/source_text_secondary"
                android:textSize="11sp"
                android:fontFamily="monospace"
                tools:text="2024" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="·"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/source_text_secondary"
                android:textSize="11sp"
                android:fontFamily="monospace"
                tools:text="2H 46M" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="·"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_genre_year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/source_text_secondary"
                android:textSize="11sp"
                tools:text="Sci-Fi, Adventure" />

            <!-- Quality badge (4K DV etc) -->
            <TextView
                android:id="@+id/tv_quality_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/cin_detail_quality_badge"
                android:textColor="@color/neon_amber"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="4K DV" />

            <!-- Age / content rating badge (R / PG-13 / 18+) -->
            <TextView
                android:id="@+id/tv_age_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/cin_detail_quality_badge"
                android:textColor="@color/source_text_secondary"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="PG-13" />

            <!-- Hidden legacy IDs -->
            <TextView android:id="@+id/tv_rating_stars" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        </com.google.android.flexbox.FlexboxLayout>

        <!-- Source summary strip -->
        <LinearLayout
            android:id="@+id/layout_rd_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/cin_detail_source_summary_pill"
            android:visibility="gone"
            tools:visibility="visible">

            <View
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:background="@drawable/cin_dot_online" />

            <TextView
                android:id="@+id/tv_rd_summary_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/neon_cyan"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                tools:text="9 SOURCES FOUND · 6 CACHED · BEST 4K DV 22.4 GB" />
        </LinearLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/tv_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/source_text_secondary"
            android:textSize="12sp"
            android:lineSpacingMultiplier="1.35"
            android:maxLines="3"
            android:ellipsize="end"
            android:includeFontPadding="false"
            tools:text="Paul Atreides unites with Chani and the Fremen while seeking revenge against the conspirators who destroyed his family." />

        <!-- Resume bar (shown only when 0 < progress < 100) -->
        <LinearLayout
            android:id="@+id/layout_resume_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/cin_resume_bar_bg"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_play"
                android:scaleType="fitCenter"
                app:tint="@color/neon_cyan" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_resume_elapsed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/neon_cyan"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.10"
                        tools:text="RESUME FROM 1H 42M" />

                    <TextView
                        android:id="@+id/tv_resume_remaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp"
                        android:fontFamily="monospace"
                        tools:text="1H 4M LEFT" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pb_resume"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="6dp"
                    android:max="100"
                    android:progressDrawable="@drawable/cin_resume_progress"
                    tools:progress="62" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action buttons -->
        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/container_actions"
            app:flexWrap="wrap"
            app:alignItems="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginStart="-10dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Watch Now -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_play"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/detail_action_height"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="@drawable/cin_detail_btn_watch"
                android:drawableStart="@drawable/ic_play"
                android:drawablePadding="6dp"
                android:drawableTint="#041014"
                android:text="Watch Now"
                android:textColor="#041014"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:fontFamily="@font/inter_extrabold"
                android:letterSpacing="0.04"
                android:focusable="true"
                android:nextFocusUp="@id/btn_back"
                android:nextFocusDown="@id/rv_cast"
                android:nextFocusRight="@id/btn_trailer" />

            <!-- Trailer -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_trailer"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/detail_action_height"
                android:layout_marginStart="10dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/cin_detail_btn_glass"
                android:drawableStart="@drawable/ic_trailer_video"
                android:drawablePadding="6dp"
                android:drawableTint="@color/cin_detail_focus_text"
                android:text="Trailer"
                android:textColor="@color/cin_detail_focus_text"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:fontFamily="@font/inter_extrabold"
                android:letterSpacing="0.04"
                android:focusable="true"
                android:nextFocusUp="@id/btn_back"
                android:nextFocusDown="@id/rv_cast"
                android:nextFocusLeft="@id/btn_play"
                android:nextFocusRight="@id/btn_favorite" />

            <!-- Favorite -->
            <ImageButton
                android:id="@+id/btn_favorite"
                android:layout_width="42dp"
                android:layout_height="@dimen/detail_action_height"
                android:layout_marginStart="10dp"
                android:background="@drawable/cin_detail_btn_glass"
                android:src="@drawable/ic_favorite_border"
                android:scaleType="centerInside"
                android:padding="9dp"
                android:contentDescription="Favorite"
                app:tint="@color/cin_detail_focus_text"
                android:focusable="true"
                android:nextFocusUp="@id/btn_back"
                android:nextFocusDown="@id/rv_cast"
                android:nextFocusLeft="@id/btn_trailer" />
        </com.google.android.flexbox.FlexboxLayout>

        <!-- Director + Cast -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <!-- Director -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DIRECTOR"
                    android:textColor="@color/text_muted"
                    android:textSize="9sp"
                    android:fontFamily="@font/inter_extrabold"
                    android:letterSpacing="0.16"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_director"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textColor="@color/source_text_primary"
                    android:textSize="12sp"
                    tools:text="Denis Villeneuve" />
            </LinearLayout>

            <!-- Cast -->
            <LinearLayout
                android:id="@+id/layout_cast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_cast_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CAST"
                    android:textColor="@color/text_muted"
                    android:textSize="9sp"
                    android:fontFamily="@font/inter_extrabold"
                    android:letterSpacing="0.16"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_cast"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal"
                    android:clipToPadding="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_cast_member"
                    tools:itemCount="5" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ══ SIMILAR MOVIES ROW ══ -->
    <LinearLayout
        android:id="@+id/layout_similar_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="44dp"
        android:paddingEnd="44dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/header_similar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SIMILAR MOVIES"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:fontFamily="@font/inter_extrabold"
            android:letterSpacing="0.16"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_similar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:clipToPadding="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
    </LinearLayout>

    <!-- Hidden maintenance IDs -->
    <LinearLayout
        android:id="@+id/container_sources_maintenance"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView android:id="@+id/tv_sources_header" android:layout_width="0dp" android:layout_height="0dp" />
        <TextView android:id="@+id/tv_sources_status" android:layout_width="0dp" android:layout_height="0dp" />
        <View android:id="@+id/layout_source_filters" android:layout_width="0dp" android:layout_height="0dp" />
        <TextView android:id="@+id/btn_cached_only" android:layout_width="0dp" android:layout_height="0dp" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_language_filters" android:layout_width="0dp" android:layout_height="0dp" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_sources" android:layout_width="0dp" android:layout_height="0dp" />
        <ImageView android:id="@+id/iv_poster" android:layout_width="0dp" android:layout_height="0dp" />
    </LinearLayout>

    <!-- Loading Overlay -->
    <FrameLayout
        android:id="@+id/layout_loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D906090E"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <ProgressBar android:layout_width="56dp" android:layout_height="56dp" android:indeterminateTint="@color/neon_cyan" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/source_text_primary"
                android:text="Loading movie details..." />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
