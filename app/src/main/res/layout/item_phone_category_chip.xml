<?xml version="1.0" encoding="utf-8"?>
<!-- A pinned category. 48dp tall, so the chip itself is the target. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/phone_chip_root"
    android:layout_width="wrap_content"
    android:layout_height="48dp"
    android:layout_marginEnd="8dp"
    android:background="@drawable/bg_phone_chip"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="14dp">

    <TextView
        android:id="@+id/phone_chip_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/outfit_semibold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/phone_text_primary"
        android:textSize="12.5sp"
        tools:text="|FR| SPORT" />

    <TextView
        android:id="@+id/phone_chip_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:fontFamily="@font/share_tech_mono"
        android:includeFontPadding="false"
        android:textColor="@color/phone_text_muted"
        android:textSize="12sp"
        tools:text="86" />
</LinearLayout>
