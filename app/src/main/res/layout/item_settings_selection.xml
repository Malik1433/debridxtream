<?xml version="1.0" encoding="utf-8"?>
<!-- Settings value/action row — the PHONE arrangement. The TV keeps the original side-by-side row
     verbatim in `layout-television/item_settings_selection.xml`; read the note there for why the
     two had to part company.

     Measured cause, not a preference: title and value competed for one line, LinearLayout gives a
     wrap_content child its full width before a weighted one, and at phone width the title was left
     with ~169dp — "Preferred Audi…", "Secondary Audio Langu…". Stacking title / value / description
     is also what Android's own settings do, so nothing here is invented.

     Height is wrap_content over a 74dp floor: the M13 font scale (1.6x) overflows any fixed height,
     and 74dp still clears the 48dp touch minimum when the content is short.

     Same five ids, same View kinds, same default visibilities as the television file —
     SettingsDetailAdapter binds them through ItemSettingsSelectionBinding. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="74dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="20dp"
    android:paddingEnd="24dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_marginBottom="8dp"
    android:focusable="true"
    android:focusableInTouchMode="@bool/rows_focusable_in_touch_mode"
    android:clickable="true">

    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:layout_marginEnd="18dp"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit_semibold"
            android:textSize="19sp"
            android:textColor="#F1F5F9"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/share_tech_mono"
            android:textSize="16sp"
            android:textColor="#94A3B8"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/inter_regular"
            android:textSize="14sp"
            android:textColor="#94A3B8"
            android:maxLines="3"
            android:ellipsize="end" />
    </LinearLayout>

    <ImageView
        android:id="@+id/iv_chevron"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginStart="12dp"
        android:src="@drawable/ic_arrow_right"
        app:tint="#475569"
        android:contentDescription="@null" />
</LinearLayout>
