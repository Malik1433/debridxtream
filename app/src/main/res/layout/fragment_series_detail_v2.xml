<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Cinematic Backdrop (Fixed Background) -->
    <ImageView
        android:id="@+id/iv_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="1.0"
        tools:src="@tools:sample/backgrounds/scenic"
        android:importantForAccessibility="no" />

    <!-- Left Scrim Gradient (Fixed) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_gradient_left" />
        
    <!-- Bottom Gradient (Fixed - behind scroll content) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="300dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@drawable/gradient_bottom_up" />

    <!-- Content Scroll Container -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/sv_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="48dp">

            <!-- Content Block (Left Aligned) -->
            <!-- Adjusted vertical bias/margins since we are scrolling now. 
                 Using top margin instead of bias for consistent start position. -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/container_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingStart="48dp"
                android:layout_marginTop="120dp"
                app:layout_constraintWidth_percent="0.6"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Title -->
                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Stranger Things"
                    android:textColor="#FFFFFF"
                    android:textSize="56sp"
                    android:fontFamily="sans-serif-black"
                    android:textStyle="bold"
                    android:shadowColor="#000000"
                    android:shadowDx="4"
                    android:shadowDy="4"
                    android:shadowRadius="8"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- Metadata Pills -->
                <LinearLayout
                    android:id="@+id/container_meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_title"
                    app:layout_constraintStart_toStartOf="parent">

                    <TextView
                        android:id="@+id/tv_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="⭐ 9.5"
                        android:textColor="#FFD700"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:id="@+id/tv_year"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="2016"
                        android:textColor="#E0E0E0"
                        android:textSize="14sp"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:id="@+id/tv_genre"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Sci-Fi, Horror"
                        android:textColor="#E0E0E0"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                        
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HD"
                        android:textSize="10sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_meta_pill" />
                </LinearLayout>

                <!-- Action Buttons -->
                <LinearLayout
                    android:id="@+id/container_actions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="24dp"
                    app:layout_constraintTop_toBottomOf="@id/container_meta"
                    app:layout_constraintStart_toStartOf="parent">

                    <Button
                        android:id="@+id/btn_play"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Watch Now"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:background="@drawable/btn_primary_action"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:drawableStart="@android:drawable/ic_media_play"
                        android:drawableTint="#FFFFFF"
                        android:drawablePadding="8dp"
                        android:focusable="true"
                        android:nextFocusUp="@id/btn_back"
                        android:nextFocusRight="@id/btn_favorite" />

                    <Button
                        android:id="@+id/btn_favorite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Favorite"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/btn_secondary_action"
                        android:layout_marginStart="16dp"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:focusable="true"
                        android:nextFocusLeft="@id/btn_play" />
                </LinearLayout>

                <!-- Plot -->
                <TextView
                    android:id="@+id/tv_plot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="When a young boy disappears, his mother, a police chief and his friends must confront terrifying supernatural forces in order to get him back."
                    android:textColor="#CCCCCC"
                    android:textSize="16sp"
                    android:lineSpacingMultiplier="1.2"
                    android:maxLines="3"
                    android:ellipsize="end"
                    app:layout_constraintTop_toBottomOf="@id/container_actions"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginTop="24dp" 
                    android:layout_marginBottom="24dp"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Season Selector -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_seasons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="48dp"
                android:paddingEnd="48dp"
                android:clipToPadding="false"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/container_info"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="24dp"
                android:focusable="true"
                android:descendantFocusability="afterDescendants"
                android:nextFocusUp="@id/btn_play"
                android:nextFocusDown="@id/rv_episodes"
                tools:itemCount="5"
                tools:listitem="@layout/item_category_pill" />

            <!-- Episodes List (Wrap Content for ScrollView) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_episodes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingStart="42dp" 
                android:paddingBottom="16dp"
                android:clipToPadding="false"
                app:layout_constraintTop_toBottomOf="@id/rv_seasons"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:focusable="true"
                android:descendantFocusability="afterDescendants"
                android:nextFocusUp="@id/rv_seasons"
                tools:listitem="@layout/item_episode_v2" />

            <!-- Loading Skeleton Overlay (Inside Scroll for alignment) -->
            <LinearLayout
                android:id="@+id/layout_skeleton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible"
                app:layout_constraintTop_toBottomOf="@id/rv_seasons"
                app:layout_constraintStart_toStartOf="parent">
                
                <include layout="@layout/item_episode_skeleton" />
                <include layout="@layout/item_episode_skeleton" />
                <include layout="@layout/item_episode_skeleton" />
            </LinearLayout>
            
            <!-- Hidden Compatibility Views -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cv_poster"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <ImageView
                android:id="@+id/iv_poster"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp" 
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <TextView
                android:id="@+id/tv_meta"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Fixed Buttons -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="#FFFFFF"
        android:layout_margin="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:contentDescription="Back"
        android:focusable="true"
        android:nextFocusDown="@id/btn_play"
        android:nextFocusRight="@id/btn_favorite"/>

    <!-- Central Loader (Fixed) -->
    <!-- Central Loader (Fixed & Modern) -->
    <!-- Z-Index: Placed as last item to ensure it is drawn on top -->
    <ProgressBar
        android:id="@+id/pb_loading_central"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:visibility="gone"
        android:indeterminateDrawable="@drawable/progress_indeterminate_modern"
        android:elevation="50dp"
        android:layout_gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
