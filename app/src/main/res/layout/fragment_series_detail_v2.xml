<?xml version="1.0" encoding="utf-8"?>
<!--
    DERBIX SERIES DETAIL V2 — modernized cinematic layout (Round 3)
    All IDs preserved: iv_backdrop, sv_content, container_info, tv_title,
    container_meta, tv_rating, tv_year, tv_genre, container_actions, btn_play,
    btn_favorite, tv_plot, rv_seasons, rv_episodes, layout_skeleton, btn_back,
    pb_loading_central, cv_poster, iv_poster, tv_meta.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@color/cin_ink_900">

    <!-- Backdrop -->
    <ImageView
        android:id="@+id/iv_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.55"
        android:importantForAccessibility="no"
        tools:src="@tools:sample/backgrounds/scenic" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cin_hero_overlay_left"
        android:importantForAccessibility="no" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/sv_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="64dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/container_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingStart="120dp"
                android:layout_marginTop="160dp"
                app:layout_constraintWidth_percent="0.66"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Featured overline -->
                <LinearLayout
                    android:id="@+id/ll_overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <View
                        android:layout_width="38dp"
                        android:layout_height="2dp"
                        android:layout_marginEnd="14dp"
                        android:background="@drawable/cin_section_accent_bar" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LIMITED SERIES"
                        android:textColor="@color/cin_gold_300"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter_extrabold"
                        android:textStyle="bold"
                        android:letterSpacing="0.36" />
                </LinearLayout>

                <!-- Title -->
                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/inter_extrabold"
                    android:textColor="@color/cin_text_primary"
                    android:textSize="74sp"
                    android:textStyle="bold"
                    android:lineSpacingMultiplier="0.96"
                    android:letterSpacing="-0.025"
                    android:shadowColor="#A6000000"
                    android:shadowDx="0"
                    android:shadowDy="4"
                    android:shadowRadius="24"
                    tools:text="Shōgun"
                    app:layout_constraintTop_toBottomOf="@id/ll_overline"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- Meta chips -->
                <com.google.android.flexbox.FlexboxLayout
                    android:id="@+id/container_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:flexWrap="wrap"
                    app:alignItems="center"
                    app:layout_constraintTop_toBottomOf="@id/tv_title"
                    app:layout_constraintStart_toStartOf="parent">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="12dp"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/cin_chip_rating_v2">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_star_filled"
                            app:tint="@color/cin_gold_300"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/tv_rating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/cin_gold_200"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/plus_jakarta_sans"
                            tools:text="9.5" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_year"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="12dp"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:background="@drawable/cin_chip_meta"
                        android:textColor="@color/cin_text_secondary"
                        android:textSize="14sp"
                        android:fontFamily="@font/plus_jakarta_sans"
                        tools:text="2024" />

                    <TextView
                        android:id="@+id/tv_genre"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="12dp"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:background="@drawable/cin_chip_meta"
                        android:textColor="@color/cin_text_secondary"
                        android:textSize="14sp"
                        android:fontFamily="@font/plus_jakarta_sans"
                        tools:text="Drama · Historical" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:background="@drawable/cin_chip_quality_gold"
                        android:text="4K · HDR"
                        android:textColor="#1A1108"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04"
                        android:fontFamily="@font/inter_extrabold" />
                </com.google.android.flexbox.FlexboxLayout>

                <!-- Actions -->
                <LinearLayout
                    android:id="@+id/container_actions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="32dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    app:layout_constraintTop_toBottomOf="@id/container_meta"
                    app:layout_constraintStart_toStartOf="parent">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_play"
                        style="@style/Cin.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="64dp"
                        android:layout_marginEnd="14dp"
                        android:paddingStart="36dp"
                        android:paddingEnd="36dp"
                        android:text="Continue Watching"
                        android:textSize="17sp"
                        android:nextFocusUp="@id/btn_back"
                        android:nextFocusRight="@id/btn_favorite"
                        app:icon="@drawable/ic_play"
                        app:iconTint="@color/cin_text_on_gold"
                        app:iconGravity="textStart"
                        app:iconPadding="12dp"
                        app:cornerRadius="14dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_favorite"
                        style="@style/Cin.Button.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="64dp"
                        android:paddingStart="32dp"
                        android:paddingEnd="32dp"
                        android:text="Favorite"
                        android:textSize="17sp"
                        android:nextFocusLeft="@id/btn_play"
                        app:icon="@drawable/ic_favorite"
                        app:iconTint="@color/cin_text_primary"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp"
                        app:cornerRadius="14dp" />
                </LinearLayout>

                <!-- Plot -->
                <TextView
                    android:id="@+id/tv_plot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:layout_marginBottom="20dp"
                    android:lineSpacingMultiplier="1.45"
                    android:textColor="@color/cin_text_secondary"
                    android:textSize="19sp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:fontFamily="@font/plus_jakarta_sans"
                    tools:text="When a young boy disappears, his mother, a police chief and his friends must confront terrifying supernatural forces in order to get him back."
                    app:layout_constraintTop_toBottomOf="@id/container_actions"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Season header bar -->
            <LinearLayout
                android:id="@+id/ll_season_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="120dp"
                android:paddingEnd="120dp"
                android:paddingTop="24dp"
                android:paddingBottom="16dp"
                app:layout_constraintTop_toBottomOf="@id/container_info"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <View
                    android:layout_width="4dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="18dp"
                    android:background="@drawable/cin_section_accent_bar" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Episodes"
                    android:textColor="@color/cin_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter_extrabold"
                    android:letterSpacing="-0.01" />
            </LinearLayout>

            <!-- Season selector -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_seasons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="120dp"
                android:paddingEnd="120dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:visibility="gone"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintTop_toBottomOf="@id/ll_season_header"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:focusable="true"
                android:descendantFocusability="afterDescendants"
                android:nextFocusUp="@id/btn_play"
                android:nextFocusDown="@id/rv_episodes"
                tools:itemCount="5"
                tools:listitem="@layout/item_season_pill_v2" />

            <!-- Episodes -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_episodes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingStart="112dp"
                android:paddingEnd="112dp"
                android:paddingBottom="24dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                app:layout_constraintTop_toBottomOf="@id/rv_seasons"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:focusable="true"
                android:descendantFocusability="afterDescendants"
                android:nextFocusUp="@id/rv_seasons"
                tools:listitem="@layout/item_episode_v2" />

            <LinearLayout
                android:id="@+id/layout_skeleton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/rv_seasons"
                app:layout_constraintStart_toStartOf="parent">

                <include layout="@layout/item_episode_skeleton" />
                <include layout="@layout/item_episode_skeleton" />
                <include layout="@layout/item_episode_skeleton" />
            </LinearLayout>

            <!-- Hidden compatibility views -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cv_poster"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <ImageView
                android:id="@+id/iv_poster"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
            <TextView
                android:id="@+id/tv_meta"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Back button -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_margin="36dp"
        android:src="@drawable/ic_arrow_back"
        android:background="@drawable/cin_btn_back_glass"
        app:tint="@color/cin_text_primary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:padding="18dp"
        android:contentDescription="Back"
        android:focusable="true"
        android:nextFocusDown="@id/btn_play"
        android:nextFocusRight="@id/btn_favorite"
        android:elevation="6dp" />

    <!-- Loader -->
    <ProgressBar
        android:id="@+id/pb_loading_central"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:visibility="gone"
        android:indeterminateTint="@color/cin_gold_500"
        android:elevation="50dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
