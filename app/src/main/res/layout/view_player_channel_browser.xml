<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E6000000"
    android:padding="32dp"
    android:focusable="true"
    android:descendantFocusability="afterDescendants">

    <!-- Header / Clock -->
    <TextView
        android:id="@+id/tv_browser_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ui_12_00_pm"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Categories List (Left) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_browser_categories"
        android:layout_width="300dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:nextFocusLeft="@+id/rv_browser_categories"
        android:nextFocusRight="@+id/rv_browser_channels"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_browser_clock" />

    <!-- Channels Grid (Right) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_browser_channels"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:nextFocusLeft="@+id/rv_browser_categories"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/rv_browser_categories"
        app:layout_constraintTop_toBottomOf="@+id/tv_browser_clock" />

    <!-- Loading State -->
    <ProgressBar
        android:id="@+id/pb_browser_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/rv_browser_channels"
        app:layout_constraintStart_toStartOf="@+id/rv_browser_channels"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tv_browser_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ui_no_channels_found"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/rv_browser_channels"
        app:layout_constraintStart_toStartOf="@+id/rv_browser_channels"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
