<?xml version="1.0" encoding="utf-8"?>
<!-- Week 11: EPG Fragment Layout -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">
    
    <!-- RecyclerView for EPG timeline -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_epg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp"
        android:visibility="gone"
        tools:listitem="@layout/item_epg_program"
        tools:visibility="visible" />
    
    <!-- Loading indicator -->
    <ProgressBar
        android:id="@+id/progress_bar_epg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />
    
    <!-- Empty state -->
    <TextView
        android:id="@+id/text_empty_epg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/epg_empty_message"
        android:textColor="@color/text_secondary"
        android:textSize="18sp"
        android:visibility="gone" />

</FrameLayout>

