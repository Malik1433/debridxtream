<?xml version="1.0" encoding="utf-8"?>
<!--
  PHONE Debrid series detail — portrait.

  The television version is untouched in layout-television/. This file carries the same ids in the
  same view kinds, so SeriesDetailActivity binds either without knowing which it got — the rule
  this project already follows for two form factors.

  The shape matches the IPTV phone detail: 232dp poster-led header, one 56dp filled action, a
  secondary row, plot, then the season bar and the episode list. The episode list is HORIZONTAL
  here because the activity sets that layout manager itself and this fork changes no code; the
  cards are sized for a thumb instead of a remote.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/phone_home_bg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_details"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingTop="56dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/group_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ══ HEADER 232 ══ -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="232dp">

                    <ImageView
                        android:id="@+id/iv_backdrop"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0.55"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_phone_detail_scrim" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingBottom="16dp">

                        <ImageView
                            android:id="@+id/iv_poster"
                            android:layout_width="104dp"
                            android:layout_height="156dp"
                            android:background="@drawable/bg_phone_poster"
                            android:clipToOutline="true"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_content_type"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/share_tech_mono"
                                android:letterSpacing="0.12"
                                android:textColor="@color/phone_cyan"
                                android:textSize="10sp"
                                tools:text="SERIES" />

                            <TextView
                                android:id="@+id/tv_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:ellipsize="end"
                                android:fontFamily="@font/outfit_extrabold"
                                android:letterSpacing="-0.03"
                                android:lineSpacingMultiplier="1.2"
                                android:maxLines="2"
                                android:textColor="@color/phone_text_primary"
                                android:textSize="22sp"
                                tools:text="Shogun" />

                            <com.google.android.flexbox.FlexboxLayout
                                android:id="@+id/layout_metadata"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                app:alignItems="center"
                                app:flexWrap="wrap">

                                <LinearLayout
                                    android:id="@+id/layout_rating"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="10dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/tv_rating_stars"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/share_tech_mono"
                                        android:textColor="@color/phone_amber"
                                        android:textSize="13sp"
                                        tools:text="★★★★" />

                                    <TextView
                                        android:id="@+id/tv_rating_percentage"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:fontFamily="@font/share_tech_mono"
                                        android:textColor="@color/phone_text_primary"
                                        android:textSize="13sp"
                                        tools:text="86%" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/tv_year"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="10dp"
                                    android:fontFamily="@font/share_tech_mono"
                                    android:textColor="@color/phone_text_secondary"
                                    android:textSize="12sp"
                                    tools:text="2024" />

                                <TextView
                                    android:id="@+id/tv_season_episode_count"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="10dp"
                                    android:fontFamily="@font/share_tech_mono"
                                    android:textColor="@color/phone_text_secondary"
                                    android:textSize="12sp"
                                    tools:text="1 SEASON · 10 EP" />

                                <TextView
                                    android:id="@+id/tv_quality_badge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="8dp"
                                    android:background="@drawable/bg_phone_badge_cyan"
                                    android:fontFamily="@font/share_tech_mono"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="2dp"
                                    android:textColor="@color/phone_cyan"
                                    android:textSize="10sp"
                                    tools:text="4K" />

                                <TextView
                                    android:id="@+id/tv_cc_badge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_phone_badge_neutral"
                                    android:fontFamily="@font/share_tech_mono"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="2dp"
                                    android:textColor="@color/phone_text_secondary"
                                    android:textSize="10sp"
                                    tools:text="CC" />
                            </com.google.android.flexbox.FlexboxLayout>

                            <TextView
                                android:id="@+id/tv_genre_year"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:ellipsize="end"
                                android:fontFamily="@font/inter_regular"
                                android:maxLines="1"
                                android:textColor="@color/phone_text_secondary"
                                android:textSize="12.5sp"
                                tools:text="Drama · History" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_breadcrumb_debrid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/share_tech_mono"
                        android:letterSpacing="0.08"
                        android:textColor="@color/phone_text_muted"
                        android:textSize="11sp"
                        tools:text="DEBRID" />

                    <TextView
                        android:id="@+id/tv_breadcrumb_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/share_tech_mono"
                        android:letterSpacing="0.08"
                        android:textColor="@color/phone_text_muted"
                        android:textSize="11sp"
                        tools:text="SERIES" />

                    <TextView
                        android:id="@+id/tv_premium_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_phone_badge_cyan"
                        android:fontFamily="@font/share_tech_mono"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:textColor="@color/phone_cyan"
                        android:textSize="10sp"
                        android:visibility="gone"
                        tools:text="PREMIUM"
                        tools:visibility="visible" />
                </LinearLayout>

                <!-- ══ PRIMARY ACTION ══ -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_watch_now"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_phone_primary_button"
                    android:fontFamily="@font/outfit_bold"
                    android:stateListAnimator="@null"
                    android:text="@string/phone_play"
                    android:textAllCaps="false"
                    android:textColor="@color/phone_on_accent"
                    android:textSize="15sp" />

                <!-- Resume: its own card, because the activity fills three separate fields. -->
                <LinearLayout
                    android:id="@+id/layout_resume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_phone_card"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_resume_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="@font/share_tech_mono"
                            android:maxLines="1"
                            android:textColor="@color/phone_cyan"
                            android:textSize="11sp"
                            tools:text="CONTINUE S01E04" />

                        <TextView
                            android:id="@+id/tv_resume_right"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/share_tech_mono"
                            android:textColor="@color/phone_text_muted"
                            android:textSize="11sp"
                            tools:text="22m left" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_resume_ep_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_regular"
                        android:maxLines="1"
                        android:textColor="@color/phone_text_primary"
                        android:textSize="13sp"
                        tools:text="The Eightfold Fence" />

                    <View
                        android:id="@+id/v_resume_progress"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_phone_progress" />
                </LinearLayout>

                <!-- ══ ACTION ROW ══ -->
                <LinearLayout
                    android:id="@+id/layout_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_watch_trailer"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_phone_action"
                        android:fontFamily="@font/outfit_semibold"
                        android:stateListAnimator="@null"
                        android:text="@string/phone_trailer"
                        android:textAllCaps="false"
                        android:textColor="@color/phone_text_primary"
                        android:textSize="13sp" />

                    <ImageButton
                        android:id="@+id/btn_add_favorite"
                        android:layout_width="64dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_phone_action"
                        android:contentDescription="@string/a11y_favorite"
                        android:padding="16dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_favorite_border"
                        app:tint="@color/phone_text_primary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_rd_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_phone_card"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tv_rd_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/share_tech_mono"
                        android:textColor="@color/phone_text_secondary"
                        android:textSize="11.5sp"
                        tools:text="12 CACHED · 40 SOURCES" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="18dp"
                    android:fontFamily="@font/inter_regular"
                    android:lineSpacingMultiplier="1.65"
                    android:textColor="@color/phone_text_secondary"
                    android:textSize="12.5sp"
                    tools:text="In Japan in the year 1600, a English sailor washes ashore and is drawn into a war of succession." />

                <TextView
                    android:id="@+id/tv_director"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/inter_regular"
                    android:textColor="@color/phone_text_secondary"
                    android:textSize="12.5sp"
                    tools:text="Created by  Justin Marks" />

                <TextView
                    android:id="@+id/tv_cast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter_regular"
                    android:maxLines="2"
                    android:textColor="@color/phone_text_secondary"
                    android:textSize="12.5sp"
                    tools:text="Cast  Hiroyuki Sanada, Cosmo Jarvis" />
            </LinearLayout>

            <!-- ══ SEASON BAR + EPISODES ══ -->
            <LinearLayout
                android:id="@+id/layout_episodes_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@color/phone_bar_scrim"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_season_selector"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_phone_chip"
                        android:fontFamily="@font/outfit_bold"
                        android:minWidth="0dp"
                        android:paddingHorizontal="14dp"
                        android:stateListAnimator="@null"
                        android:textAllCaps="false"
                        android:textColor="@color/phone_text_primary"
                        android:textSize="14sp"
                        tools:text="Season 1" />

                    <TextView
                        android:id="@+id/tv_season_progress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/share_tech_mono"
                        android:maxLines="1"
                        android:textColor="@color/phone_text_muted"
                        android:textSize="12sp"
                        tools:text="10 EPISODES · 2 WATCHED" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_episodes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingHorizontal="16dp"
                    android:scrollbars="none" />

                <TextView
                    android:id="@+id/tv_empty_episodes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/share_tech_mono"
                    android:letterSpacing="0.08"
                    android:textColor="@color/phone_text_muted"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="NO EPISODES IN THIS SEASON"
                    tools:visibility="visible" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="28dp" />

            <!-- Stubs, exactly as the television layout keeps them: the season list is a picker
                 dialog on both form factors, and the D-pad hint bar has no meaning on a phone. -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_seasons"
                    android:layout_width="0dp"
                    android:layout_height="0dp" />

                <LinearLayout
                    android:id="@+id/layout_hint_bar"
                    android:layout_width="0dp"
                    android:layout_height="0dp" />

                <Button
                    android:id="@+id/btn_refresh"
                    android:layout_width="0dp"
                    android:layout_height="0dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ══ APP BAR ══ -->
    <LinearLayout
        android:id="@+id/layout_top_strip"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/phone_bar_scrim"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <ImageView
            android:id="@+id/phone_series_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/live_nav_back"
            android:padding="14dp"
            android:src="@drawable/ic_stremio_chevron_left"
            app:tint="@color/phone_text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/outfit_bold"
            android:maxLines="1"
            android:text="@string/nav_series"
            android:textColor="@color/phone_text_primary"
            android:textSize="16sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/layout_loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/phone_home_bg"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ProgressBar
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:indeterminateTint="@color/phone_cyan" />

            <TextView
                android:id="@+id/tv_loading_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/share_tech_mono"
                android:letterSpacing="0.1"
                android:textColor="@color/phone_text_secondary"
                android:textSize="12sp"
                tools:text="LOADING SERIES…" />
        </LinearLayout>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
