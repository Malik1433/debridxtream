<?xml version="1.0" encoding="utf-8"?>
<!--
    DERBIX SERIES DETAIL — modernized cinematic layout (Round 3)
    All IDs preserved for SeriesDetailActivity:
      iv_backdrop, iv_poster, tv_title, tv_rating_stars, tv_rating_percentage,
      tv_genre_year, tv_director, tv_cast, tv_description,
      rv_seasons, rv_episodes, tv_empty_episodes,
      btn_watch_now, btn_watch_trailer, btn_add_favorite, btn_refresh,
      layout_loading_overlay, tv_loading_message,
      tv_meta_seasons, tv_season_label.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cin_ink_900">

    <!-- Backdrop -->
    <ImageView
        android:id="@+id/iv_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.55"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:src="@tools:sample/backgrounds/scenic" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cin_hero_overlay_left"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Hero row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:paddingStart="120dp"
                android:paddingEnd="120dp"
                android:paddingTop="160dp"
                android:paddingBottom="40dp">

                <!-- Text column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="38dp"
                            android:layout_height="2dp"
                            android:layout_marginEnd="14dp"
                            android:background="@drawable/cin_section_accent_bar" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LIMITED SERIES"
                            android:textColor="@color/cin_gold_300"
                            android:textSize="13sp"
                            android:fontFamily="@font/inter_extrabold"
                            android:textStyle="bold"
                            android:letterSpacing="0.36" />
                    </LinearLayout>

                    <!-- Title -->
                    <TextView
                        android:id="@+id/tv_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:textColor="@color/cin_text_primary"
                        android:textSize="74sp"
                        android:lineSpacingMultiplier="0.96"
                        android:fontFamily="@font/inter_extrabold"
                        android:letterSpacing="-0.025"
                        android:shadowColor="#A6000000"
                        android:shadowDx="0"
                        android:shadowDy="4"
                        android:shadowRadius="24"
                        tools:text="Shōgun" />

                    <!-- Meta chips -->
                    <com.google.android.flexbox.FlexboxLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        app:flexWrap="wrap"
                        app:alignItems="center">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginEnd="12dp"
                            android:layout_marginBottom="8dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/cin_chip_rating_v2">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginEnd="8dp"
                                android:src="@drawable/ic_star_filled"
                                app:tint="@color/cin_gold_300"
                                android:importantForAccessibility="no" />

                            <TextView
                                android:id="@+id/tv_rating_percentage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/cin_gold_200"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/plus_jakarta_sans"
                                tools:text="9.1" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_rating_stars"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tv_genre_year"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginEnd="12dp"
                            android:layout_marginBottom="8dp"
                            android:gravity="center_vertical"
                            android:background="@drawable/cin_chip_meta"
                            android:textColor="@color/cin_text_secondary"
                            android:textSize="14sp"
                            android:fontFamily="@font/plus_jakarta_sans"
                            tools:text="2024 · Drama · Historical" />

                        <TextView
                            android:id="@+id/tv_meta_seasons"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginEnd="12dp"
                            android:layout_marginBottom="8dp"
                            android:gravity="center_vertical"
                            android:background="@drawable/cin_chip_meta"
                            android:textColor="@color/cin_text_secondary"
                            android:textSize="14sp"
                            android:fontFamily="@font/plus_jakarta_sans"
                            tools:text="1 Season · 10 Eps" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginBottom="8dp"
                            android:gravity="center_vertical"
                            android:background="@drawable/cin_chip_quality_gold"
                            android:text="4K · HDR"
                            android:textColor="#1A1108"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.04"
                            android:fontFamily="@font/inter_extrabold" />
                    </com.google.android.flexbox.FlexboxLayout>

                    <!-- Synopsis -->
                    <TextView
                        android:id="@+id/tv_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:maxWidth="780dp"
                        android:maxLines="3"
                        android:ellipsize="end"
                        android:textColor="@color/cin_text_secondary"
                        android:textSize="19sp"
                        android:lineSpacingMultiplier="1.45"
                        android:fontFamily="@font/plus_jakarta_sans"
                        tools:text="Series synopsis appears here." />

                    <!-- Action buttons -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:orientation="horizontal"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_watch_now"
                            style="@style/Cin.Button.Primary"
                            android:layout_width="wrap_content"
                            android:layout_height="64dp"
                            android:layout_marginEnd="14dp"
                            android:paddingStart="36dp"
                            android:paddingEnd="36dp"
                            android:text="Continue Watching"
                            android:textSize="17sp"
                            android:focusedByDefault="true"
                            app:icon="@drawable/ic_play"
                            app:iconTint="@color/cin_text_on_gold"
                            app:iconGravity="textStart"
                            app:iconPadding="12dp"
                            app:cornerRadius="14dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_watch_trailer"
                            style="@style/Cin.Button.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="64dp"
                            android:layout_marginEnd="14dp"
                            android:paddingStart="32dp"
                            android:paddingEnd="32dp"
                            android:text="Trailer"
                            android:textSize="17sp"
                            app:cornerRadius="14dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_add_favorite"
                            style="@style/Cin.Button.Icon"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:layout_marginEnd="14dp"
                            app:icon="@drawable/ic_favorite"
                            app:iconTint="@color/cin_text_primary"
                            app:cornerRadius="14dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_refresh"
                            style="@style/Cin.Button.Icon"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            app:icon="@drawable/ic_clear"
                            app:iconTint="@color/cin_text_primary"
                            app:cornerRadius="14dp" />
                    </LinearLayout>

                    <!-- Director / Cast inline rows -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="96dp"
                            android:layout_height="wrap_content"
                            android:text="DIRECTOR"
                            android:textColor="@color/cin_text_tertiary"
                            android:textSize="11sp"
                            android:letterSpacing="0.20"
                            android:fontFamily="@font/inter_extrabold"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_director"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/cin_text_secondary"
                            android:textSize="16sp"
                            android:fontFamily="@font/plus_jakarta_sans"
                            tools:text="—" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="96dp"
                            android:layout_height="wrap_content"
                            android:text="CAST"
                            android:textColor="@color/cin_text_tertiary"
                            android:textSize="11sp"
                            android:letterSpacing="0.20"
                            android:fontFamily="@font/inter_extrabold"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_cast"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:textColor="@color/cin_text_secondary"
                            android:textSize="16sp"
                            android:fontFamily="@font/plus_jakarta_sans"
                            tools:text="—" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Poster (right column) -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_poster"
                    android:layout_width="300dp"
                    android:layout_height="450dp"
                    android:layout_marginStart="48dp"
                    android:layout_gravity="top"
                    android:scaleType="centerCrop"
                    android:elevation="20dp"
                    app:shapeAppearanceOverlay="@style/Cin.Shape.Poster"
                    tools:background="@color/cin_ink_500" />
            </LinearLayout>

            <!-- Season header + selector -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="120dp"
                android:paddingEnd="120dp"
                android:paddingTop="32dp"
                android:paddingBottom="20dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/cin_section_accent_bar" />

                <TextView
                    android:id="@+id/tv_season_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Episodes"
                    android:textColor="@color/cin_text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter_extrabold"
                    android:letterSpacing="-0.01" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_seasons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipToPadding="false"
                    android:clipChildren="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_season_chip"
                    tools:itemCount="3" />
            </LinearLayout>

            <!-- Episodes -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="280dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_episodes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="120dp"
                    android:paddingEnd="120dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="56dp"
                    android:clipToPadding="false"
                    android:clipChildren="false"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_episode_row"
                    tools:itemCount="5" />

                <TextView
                    android:id="@+id/tv_empty_episodes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="48dp"
                    android:gravity="center"
                    android:textColor="@color/cin_text_tertiary"
                    android:textSize="16sp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:visibility="gone"
                    tools:text="No episodes available for this season." />
            </FrameLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Loading overlay (covers everything) -->
    <FrameLayout
        android:id="@+id/layout_loading_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#B30A0A0C"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="48dp"
            android:background="@drawable/cin_card_sources_glass"
            android:elevation="12dp">

            <ProgressBar
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:indeterminateTint="@color/cin_gold_500" />

            <TextView
                android:id="@+id/tv_loading_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textColor="@color/cin_text_secondary"
                android:textSize="16sp"
                android:fontFamily="@font/plus_jakarta_sans"
                tools:text="Loading episodes…" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
