<?xml version="1.0" encoding="utf-8"?>
<!-- Settings screen — rebuilt to "Settings Screen.dc.html". Category rail (left) + detail panel (right).
     Wired to the existing SettingsViewModel / SettingCategory model. Scale = design px / 2 = dp. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#06090E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- ══════ LEFT: category rail (380px/2 = 190dp) ══════ -->
        <LinearLayout
            android:layout_width="330dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="@dimen/settings_rail_padding_start"
            android:paddingEnd="16dp"
            android:paddingTop="@dimen/settings_rail_padding_top"
            android:paddingBottom="@dimen/settings_rail_padding_bottom">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_settings"
                    app:tint="#00F0FF"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit_extrabold"
                    android:textSize="@dimen/settings_screen_title_size"
                    android:textColor="#F1F5F9"
                    android:letterSpacing="-0.02"
                    android:text="@string/settings" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_settings_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/settings_version_margin_top"
                android:layout_marginBottom="@dimen/settings_version_margin_bottom"
                android:fontFamily="@font/share_tech_mono"
                android:textSize="@dimen/settings_version_size"
                android:textColor="#3D4F60"
                android:letterSpacing="0.12"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="DX PLAY · v2.5.6" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_settings_categories"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                tools:listitem="@layout/item_settings_category" />

        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#0DFFFFFF" />

        <!-- ══════ RIGHT: detail panel ══════ -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="@dimen/settings_panel_padding_start"
            android:paddingEnd="@dimen/settings_panel_padding_end"
            android:paddingTop="@dimen/settings_panel_padding_top"
            android:paddingBottom="@dimen/settings_panel_padding_bottom">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/v_panel_dot"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/stremio_live_dot" />

                <TextView
                    android:id="@+id/tv_panel_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit_bold"
                    android:textSize="@dimen/settings_panel_title_size"
                    android:textColor="#F1F5F9"
                    tools:text="General" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_panel_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="21dp"
                android:layout_marginTop="@dimen/settings_panel_desc_margin_top"
                android:layout_marginBottom="@dimen/settings_panel_desc_margin_bottom"
                android:fontFamily="@font/share_tech_mono"
                android:textSize="@dimen/settings_panel_desc_size"
                android:textColor="#3D4F60"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="General playback and account options" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_settings_details"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                tools:listitem="@layout/item_settings_toggle" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
