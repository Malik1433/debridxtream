<?xml version="1.0" encoding="utf-8"?>
<!--
  PHONE Settings — portrait, to the "DX Play Settings" design (G1).

  The television version is untouched in layout-television/: a category rail beside a detail panel,
  read from three metres. The previous phone attempt kept that shape and turned the rail sideways
  into a chip row — it fitted, but it was still the TV screen wearing a smaller coat, which is
  exactly what the owner said did not match a phone.

  **The designer's Decision 1: the TV's two panels become two DESTINATIONS, and every bound id
  survives.** So both views live here, in one layout, as two pages: the category list fills the
  screen, tapping a category slides the detail page over it, and Back returns. One fragment, one
  binding, every id present — the television shares this code and a missing id crashes it.

  The list rows carry a live subtitle of their own state ("4 add-ons · Real-Debrid on") rather than
  a fixed caption, so the list answers "what is set" before you open anything.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/phone_home_bg">

    <!-- ══════════════ PAGE 1 — the categories ══════════════ -->
    <LinearLayout
        android:id="@+id/settings_list_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/outfit_extrabold"
                android:letterSpacing="-0.02"
                android:text="@string/settings"
                android:textColor="@color/phone_text_primary"
                android:textSize="22sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_settings_categories"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="16dp"
            android:paddingBottom="12dp"
            android:scrollbars="none" />

        <!-- The build, at the foot of the list where the design puts it — out of the way of the
             settings themselves, but never more than one scroll from the person reporting a bug. -->
        <TextView
            android:id="@+id/tv_settings_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/share_tech_mono"
            android:letterSpacing="0.1"
            android:maxLines="1"
            android:paddingHorizontal="16dp"
            android:paddingBottom="20dp"
            android:textColor="@color/phone_text_muted"
            android:textSize="11sp"
            tools:text="DX PLAY 2.7.3 · BUILD 87" />
    </LinearLayout>

    <!-- ══════════════ PAGE 2 — one category's settings ══════════════
         Above the list and hidden until a category is chosen. The heading carries the same
         `v_panel_dot` / `tv_panel_title` / `tv_panel_desc` the television binds, so one adapter
         and one fragment serve both shapes. -->
    <LinearLayout
        android:id="@+id/settings_detail_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/phone_home_bg"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="16dp">

            <!-- 48dp, because Back must be a real target and not only a gesture. -->
            <ImageView
                android:id="@+id/settings_detail_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/live_nav_back"
                android:focusable="true"
                android:padding="14dp"
                android:src="@drawable/ic_stremio_chevron_left"
                app:tint="@color/phone_text_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/v_panel_dot"
                    android:layout_width="3dp"
                    android:layout_height="16dp"
                    android:background="@color/phone_cyan" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_panel_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/outfit_bold"
                        android:maxLines="1"
                        android:textColor="@color/phone_text_primary"
                        android:textSize="18sp"
                        tools:text="Playback" />

                    <TextView
                        android:id="@+id/tv_panel_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/share_tech_mono"
                        android:letterSpacing="0.08"
                        android:maxLines="1"
                        android:textColor="@color/phone_text_muted"
                        android:textSize="11sp"
                        tools:text="AUDIO · LANGUAGE" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_settings_details"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp"
            android:scrollbars="none" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
