<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="5dp">

    <View
        android:id="@+id/onair_bar"
        android:layout_width="1.5dp"
        android:layout_height="30dp"
        android:layout_marginEnd="6dp"
        android:background="@color/neon_cyan" />

    <FrameLayout
        android:id="@+id/onair_logo"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:clipToOutline="true"
        android:outlineProvider="background">

        <TextView
            android:id="@+id/onair_logo_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/plus_jakarta_sans"
            android:textColor="@android:color/white"
            android:textSize="8sp"
            android:textStyle="bold"
            tools:text="SKY" />

        <ImageView
            android:id="@+id/onair_logo_img"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/onair_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/plus_jakarta_sans"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/live_osd_text_primary"
                android:textSize="6.5sp"
                android:textStyle="bold"
                tools:text="SKY SPORT 1" />

            <TextView
                android:id="@+id/onair_live"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_live_badge_live"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:paddingHorizontal="3dp"
                android:paddingVertical="0.5dp"
                android:text="@string/livev2_live_badge"
                android:textColor="@android:color/white"
                android:textSize="4.5sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/onair_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/live_osd_text_dim"
            android:textSize="6sp"
            tools:text="Bundesliga: BVB vs FCB" />

        <ProgressBar
            android:id="@+id/onair_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:layout_marginTop="2.5dp"
            android:max="100"
            android:progressDrawable="@drawable/live_progress_bar"
            android:visibility="gone"
            tools:progress="48"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/onair_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:fontFamily="monospace"
        android:textColor="@color/live_osd_text_muted"
        android:textSize="5sp"
        tools:text="003" />
</LinearLayout>
