<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <androidx.cardview.widget.CardView
        android:id="@+id/card_poster"
        android:layout_width="@dimen/poster_top_10_width"
        android:layout_height="@dimen/poster_top_10_height"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:foreground="@drawable/bg_card_focus_cyan"
        app:cardBackgroundColor="@color/card_background"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            tools:srcCompat="@tools:sample/avatars" />

    </androidx.cardview.widget.CardView>

    <!-- Large Number Overlay -->
    <TextView
        android:id="@+id/tv_rank_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/plus_jakarta_sans"
        android:includeFontPadding="false"
        android:letterSpacing="0"
        android:text="1"
        android:textColor="@color/white"
        android:textSize="@dimen/number_text_size"
        android:textStyle="bold"
        android:shadowColor="@color/cin_overlay_70"
        android:shadowDx="0"
        android:shadowDy="4"
        android:shadowRadius="10"
        app:layout_constraintBottom_toBottomOf="@+id/card_poster"
        app:layout_constraintStart_toStartOf="@+id/card_poster"
        app:layout_constraintHorizontal_bias="0.0"
        android:translationX="@dimen/number_offset_x"
        android:translationY="@dimen/number_offset_y"
        android:elevation="10dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
