<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="9dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:focusableInTouchMode="@bool/rows_focusable_in_touch_mode">

    <!-- Cyan bloom behind the card (visible on focus; drawable set in code) -->
    <View
        android:id="@+id/view_focus_glow"
        android:layout_width="152dp"
        android:layout_height="216dp"
        android:duplicateParentState="true"
        app:layout_constraintStart_toStartOf="@+id/card_poster"
        app:layout_constraintEnd_toEndOf="@+id/card_poster"
        app:layout_constraintTop_toTopOf="@+id/card_poster"
        app:layout_constraintBottom_toBottomOf="@+id/card_poster" />

    <androidx.cardview.widget.CardView
        android:id="@+id/card_poster"
        android:layout_width="@dimen/poster_top_10_width"
        android:layout_height="@dimen/poster_top_10_height"
        android:layout_marginTop="8dp"
        android:duplicateParentState="true"
        android:foreground="@drawable/card_focus_cinematic"
        app:cardBackgroundColor="@color/card_background"
        app:cardCornerRadius="4dp"
        app:cardElevation="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            tools:srcCompat="@tools:sample/avatars"
            android:contentDescription="@null" />

        <!-- Bottom scrim -->
        <View
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:layout_gravity="bottom"
            android:background="@drawable/cin_card_footer_gradient" />

    </androidx.cardview.widget.CardView>

    <!-- Rank number (hidden — design shows plain posters) -->
    <TextView
        android:id="@+id/tv_rank_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/card_poster"
        app:layout_constraintStart_toStartOf="@+id/card_poster" />

    <!-- Dwell quick-info bubble (appears above card after ~450ms rest) -->
    <include
        android:id="@+id/quick_info_bubble"
        layout="@layout/view_card_quick_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        app:layout_constraintStart_toStartOf="@id/card_poster"
        app:layout_constraintEnd_toEndOf="@id/card_poster"
        app:layout_constraintBottom_toTopOf="@id/card_poster" />

    <!-- Meta below poster: title + sub -->
    <LinearLayout
        android:layout_width="@dimen/poster_top_10_width"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@id/card_poster"
        app:layout_constraintStart_toStartOf="@id/card_poster">

        <TextView
            android:id="@+id/tv_card_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_title"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:textColor="#F1F5F9"
            android:fontFamily="@font/plus_jakarta_sans"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_card_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="7sp"
            android:textStyle="bold"
            android:textColor="#94A3B8"
            android:fontFamily="monospace"
            android:letterSpacing="0.04"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
