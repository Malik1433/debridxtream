<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_background_primary">

    <!-- Immersive Background Backdrop -->
    <ImageView
        android:id="@+id/iv_background_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.6"
        android:contentDescription="Background Backdrop" />

    <!-- Gradient Overlay for Readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_backdrop_overlay" />

    <!-- Main content: Sidebar + Movies Grid -->
    <LinearLayout
        android:id="@+id/ll_main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:paddingTop="0dp"
        android:paddingBottom="0dp">

        <!-- Left Sidebar: Categories -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_categories_sidebar"
            android:layout_width="280dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:focusable="true"
            android:background="#99000000"
            android:focusableInTouchMode="true"
            android:nextFocusRight="@id/rv_movies_grid"
            android:clipToPadding="false"
            android:paddingTop="24dp"
            android:paddingBottom="24dp" />

        <!-- Right Content Area: Movies Grid -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:clipChildren="false">

                <!-- Category Title Header -->
                <TextView
                    android:id="@+id/tv_category_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:layout_marginBottom="24dp"
                    android:text="All Movies"
                    android:textSize="32sp"
                    android:textColor="@color/ds_text_primary"
                    android:textStyle="bold"
                    android:shadowColor="#80000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4"
                    android:fontFamily="sans-serif-black" />

                <!-- Movies Grid -->
                <!-- Use clipToPadding=false to allow focus zoom to not be clipped at edges if padded -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_movies_grid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusLeft="@id/rv_categories_sidebar"
                    android:clipToPadding="false"
                    android:clipChildren="false"
                    android:paddingBottom="48dp" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

    <!-- Loading State -->
    <LinearLayout
        android:id="@+id/ll_loading_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">
        
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/ds_accent" />
        
        <TextView
            android:id="@+id/tv_loading_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Loading movies..."
            android:textSize="18sp"
            android:textColor="@color/ds_text_primary" />
    </LinearLayout>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/ll_empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">
        
        <TextView
            android:id="@+id/tv_empty_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No movies available"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/ds_text_secondary"
            android:gravity="center" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Please check your connection or login again"
            android:textSize="16sp"
            android:textColor="@color/ds_text_tertiary"
            android:gravity="center" />
    </LinearLayout>

</FrameLayout>
