<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@color/vod_bg">

    <!-- Immersive Background Backdrop -->
    <ImageView
        android:id="@+id/iv_background_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.25"
        android:contentDescription="Background Backdrop" />

    <!-- Gradient Overlay -->
    <View
        android:id="@+id/gradient_overlay_ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_backdrop_overlay" />

    <!-- Main Content -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ll_main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="10dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- ═══ LEFT SIDEBAR (210dp) ═══ -->
        <LinearLayout
            android:id="@+id/ll_vod_sidebar_container"
            android:layout_width="210dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:background="@drawable/bg_vod_sidebar"
            android:elevation="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Logo area (94dp) -->
            <LinearLayout
                android:id="@+id/sidebar_logo_area"
                android:layout_width="match_parent"
                android:layout_height="94dp"
                android:paddingTop="28dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- DX badge -->
                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_vod_dx_badge"
                    android:elevation="4dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="DX"
                        android:textColor="#041014"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-condensed" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IPTV"
                        android:textColor="@color/vod_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.06" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MOVIES"
                        android:textColor="@color/vod_accent_cyan"
                        android:textSize="10sp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.14" />
                </LinearLayout>
            </LinearLayout>

            <!-- Search bar -->
            <FrameLayout
                android:id="@+id/btn_search"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_vod_search_bar"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:descendantFocusability="blocksDescendants"
                android:nextFocusDown="@id/rv_categories_sidebar"
                android:nextFocusRight="@id/rv_movies_grid">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp">

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:src="@drawable/ic_search"
                        app:tint="#64748B" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Search movies…"
                        android:textColor="@color/vod_text_faint"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="10dp"
                android:background="#0FFFFFFF" />

            <!-- CATEGORIES label -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingBottom="8dp"
                android:text="CATEGORIES"
                android:textColor="@color/vod_text_ghost"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.16" />

            <!-- Categories RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_categories_sidebar"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusRight="@id/rv_movies_grid"
                android:nextFocusLeft="@id/rv_categories_sidebar"
                android:nextFocusUp="@id/btn_search"
                android:descendantFocusability="afterDescendants" />


            <!-- Offline badge (hidden by default) -->
            <LinearLayout
                android:id="@+id/ll_offline_badge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:gravity="center_vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tv_offline_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OFFLINE MODE"
                    android:textColor="@color/vod_amber"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Divider above the status pill -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="#0DFFFFFF" />

            <!-- XTREAM ACTIVE status pill (pinned at sidebar bottom) -->
            <LinearLayout
                android:id="@+id/ll_xtream_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_series_status_pill"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_circle_green_dot" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="XTREAM ACTIVE"
                    android:textColor="#00FF88"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══ MAIN CONTENT AREA ═══ -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintStart_toEndOf="@id/ll_vod_sidebar_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- ─── TOP BAR (66dp) ─── -->
            <LinearLayout
                android:id="@+id/vod_top_bar"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="44dp"
                android:paddingEnd="52dp">

                <!-- Breadcrumb left -->
                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_circle_cyan_dot" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="IPTV"
                    android:textColor="@color/vod_text_secondary"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:text="›"
                    android:textColor="@color/vod_text_ghost"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MOVIES"
                    android:textColor="@color/vod_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.08" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Filter button -->
                <FrameLayout
                    android:id="@+id/btn_filter"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_vod_filter_btn"
                    android:paddingHorizontal="14dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_filter"
                            app:tint="#64748B" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="FILTER"
                            android:textColor="@color/vod_text_muted"
                            android:textSize="12sp"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.06" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Count badge -->
                <TextView
                    android:id="@+id/tv_title_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_vod_count_badge"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="0 TITLES"
                    android:textColor="@color/vod_text_ghost"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Top bar bottom border -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#0AFFFFFF" />

            <!-- ─── SORT ROW (48dp) ─── -->
            <LinearLayout
                android:id="@+id/vod_genre_sort_row"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="44dp"
                android:paddingEnd="52dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="14dp"
                    android:text="SORT"
                    android:textColor="@color/vod_text_ghost"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.16" />

                <!-- Sort chips -->
                <LinearLayout
                    android:id="@+id/ll_sort_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical" />
            </LinearLayout>

            <!-- Genre row bottom border -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#0AFFFFFF" />

            <!-- ─── SECTION HEADER (52dp) ─── -->
            <LinearLayout
                android:id="@+id/vod_section_header"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="44dp"
                android:paddingEnd="52dp"
                android:paddingTop="12dp"
                android:paddingBottom="10dp">

                <!-- Left: title + meta -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_category_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All Movies"
                        android:textColor="@color/vod_text_primary"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="-0.015"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/tv_section_meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 titles"
                        android:textColor="@color/vod_text_faint"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.05" />
                </LinearLayout>

                <!-- Right: column toggle (removed — posters now use one fixed home size) -->
                <LinearLayout
                    android:id="@+id/ll_col_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="COLS"
                        android:textColor="@color/vod_text_ghost"
                        android:textSize="10sp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.12" />

                    <TextView
                        android:id="@+id/btn_col_4"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:gravity="center"
                        android:background="@drawable/bg_vod_col_toggle_default"
                        android:text="4"
                        android:textColor="@color/vod_text_muted"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:focusable="true"
                        android:focusableInTouchMode="true" />

                    <TextView
                        android:id="@+id/btn_col_5"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:gravity="center"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_vod_col_toggle_active"
                        android:text="5"
                        android:textColor="@color/vod_accent_cyan"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:focusable="true"
                        android:focusableInTouchMode="true" />

                    <TextView
                        android:id="@+id/btn_col_6"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:gravity="center"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_vod_col_toggle_default"
                        android:text="6"
                        android:textColor="@color/vod_text_muted"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:focusable="true"
                        android:focusableInTouchMode="true" />
                </LinearLayout>
            </LinearLayout>

            <!-- Section header bottom border -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#08FFFFFF" />

            <!-- ─── MOVIES GRID (fills from directly under the section-header border) ─── -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_movies_grid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:paddingStart="44dp"
                android:paddingEnd="52dp"
                android:paddingTop="8dp"
                android:paddingBottom="48dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@id/rv_categories_sidebar"
                android:nextFocusRight="@id/rv_movies_grid" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Loading State (Shimmer) — fixed-width cards: GridLayout can't grid
         match_parent children (they collapse into one flat box). -->
    <GridLayout
        android:id="@+id/ll_loading_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="210dp"
        android:layout_marginTop="238dp"
        android:paddingStart="44dp"
        android:paddingEnd="52dp"
        android:columnCount="5"
        android:visibility="gone">

        <include layout="@layout/item_movie_loading"
            android:layout_width="118dp"
            android:layout_height="wrap_content"
            android:layout_margin="6dp" />
        <include layout="@layout/item_movie_loading"
            android:layout_width="118dp"
            android:layout_height="wrap_content"
            android:layout_margin="6dp" />
        <include layout="@layout/item_movie_loading"
            android:layout_width="118dp"
            android:layout_height="wrap_content"
            android:layout_margin="6dp" />
        <include layout="@layout/item_movie_loading"
            android:layout_width="118dp"
            android:layout_height="wrap_content"
            android:layout_margin="6dp" />
        <include layout="@layout/item_movie_loading"
            android:layout_width="118dp"
            android:layout_height="wrap_content"
            android:layout_margin="6dp" />
        <include layout="@layout/item_movie_loading"
            android:layout_width="118dp"
            android:layout_height="wrap_content"
            android:layout_margin="6dp" />
        <include layout="@layout/item_movie_loading"
            android:layout_width="118dp"
            android:layout_height="wrap_content"
            android:layout_margin="6dp" />
        <include layout="@layout/item_movie_loading"
            android:layout_width="118dp"
            android:layout_height="wrap_content"
            android:layout_margin="6dp" />
        <include layout="@layout/item_movie_loading"
            android:layout_width="118dp"
            android:layout_height="wrap_content"
            android:layout_margin="6dp" />
        <include layout="@layout/item_movie_loading"
            android:layout_width="118dp"
            android:layout_height="wrap_content"
            android:layout_margin="6dp" />
    </GridLayout>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/ll_empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_empty_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No movies available"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/vod_text_secondary"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Please check your connection or login again"
            android:textSize="16sp"
            android:textColor="@color/vod_text_muted"
            android:gravity="center" />
    </LinearLayout>

</FrameLayout>
