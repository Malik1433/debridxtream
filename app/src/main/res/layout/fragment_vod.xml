<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@color/background_pure_black">

    <!-- Immersive Background Backdrop -->
    <ImageView
        android:id="@+id/iv_background_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.4"
        android:contentDescription="Background Backdrop" />

    <!-- Gradient Overlay for Readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_backdrop_overlay" />

    <!-- Main Content Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ll_main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="10dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Left Sidebar (Collapsible with fixed grid space) -->
        <LinearLayout
            android:id="@+id/ll_vod_sidebar_container"
            android:layout_width="104dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:background="#E60A0A0A"
            android:elevation="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <!-- App Logo / Title Area -->
            <LinearLayout
                android:id="@+id/ll_sidebar_title_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="24dp"
                android:paddingTop="32dp"
                android:paddingBottom="24dp"
                android:orientation="horizontal"
                android:alpha="1"
                android:gravity="center_vertical">
                
                <!-- Using text for now as per design, can be replaced with logo image -->
                 <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_movie"
                    android:padding="2dp"
                    app:tint="@color/brand_cyan"
                    xmlns:app="http://schemas.android.com/apk/res-auto"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CINEMA"
                    android:textColor="@color/brand_cyan"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginStart="8dp"
                    android:singleLine="true"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>

            <!-- Categories List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_categories_sidebar"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:padding="0dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusRight="@id/rv_movies_grid"
                android:nextFocusLeft="@id/rv_categories_sidebar"
                android:nextFocusUp="@id/btn_search"
                android:descendantFocusability="afterDescendants"/>

            <!-- Bottom Settings Item (Hidden per user request) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="32dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">
                
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_settings"
                    app:tint="#66FFFFFF"
                    xmlns:app="http://schemas.android.com/apk/res-auto"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textColor="#66FFFFFF"
                    android:textSize="14sp"
                    android:layout_marginStart="12dp"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Right Content Area (Stable Margin based on collapsed sidebar) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="104dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <!-- Header Utility Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end|center_vertical"
                android:paddingTop="16dp"
                android:paddingEnd="48dp"
                android:paddingBottom="4dp"
                android:clipToPadding="false">

                <!-- Offline Mode Badge -->
                <LinearLayout
                    android:id="@+id/ll_offline_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_pill"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:gravity="center_vertical"
                    android:visibility="gone">
                    
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_cloud_off"
                        app:tint="@color/brand_cyan"
                        xmlns:app="http://schemas.android.com/apk/res-auto"/>
                        
                    <TextView
                        android:id="@+id/tv_offline_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OFFLINE MODE"
                        android:textColor="#CCFFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>

                <!-- Search Button -->
                <FrameLayout
                    android:id="@+id/btn_search"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="24dp"
                    android:background="@drawable/bg_circle_glass"
                    android:clickable="true"
                    android:focusable="true"
                    android:nextFocusDown="@id/rv_categories_sidebar"
                    android:nextFocusLeft="@id/rv_categories_sidebar">
                    
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_search"
                        app:tint="#CCFFFFFF"
                        xmlns:app="http://schemas.android.com/apk/res-auto"/>
                </FrameLayout>

                <!-- Profile Avatar (Hidden per user request) -->
                 <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="24dp"
                    android:background="@drawable/bg_circle_gradient_blue"
                    android:visibility="gone">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="JD"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                </FrameLayout>
            </LinearLayout>
            
             <!-- Category Title & Grid Container -->
             <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="0dp"
                android:paddingEnd="0dp">

                <TextView
                    android:id="@+id/tv_category_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recently Added"
                    android:textColor="@android:color/white"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"/>
                
                <View
                    android:layout_width="80dp"
                    android:layout_height="4dp"
                    android:background="@drawable/bg_blue_pill"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"/>

                 <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_movies_grid"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:clipChildren="false"
                    android:paddingBottom="48dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nextFocusLeft="@id/rv_categories_sidebar"
                    android:nextFocusRight="@id/rv_movies_grid"
                    android:nextFocusUp="@id/btn_search"/>

            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Loading State (Shimmer Skeleton Grid - Matches 4 Columns) -->
    <GridLayout
        android:id="@+id/ll_loading_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_marginStart="104dp"  
        android:layout_marginTop="238dp"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:columnCount="4"
        android:rowCount="3"
        android:visibility="gone">

        <include layout="@layout/item_movie_loading" />
        <include layout="@layout/item_movie_loading" />
        <include layout="@layout/item_movie_loading" />
        <include layout="@layout/item_movie_loading" />
        <include layout="@layout/item_movie_loading" />
        <include layout="@layout/item_movie_loading" />
        <include layout="@layout/item_movie_loading" />
        <include layout="@layout/item_movie_loading" />
    </GridLayout>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/ll_empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">
        
        <TextView
            android:id="@+id/tv_empty_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No movies available"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/ds_text_secondary"
            android:gravity="center" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Please check your connection or login again"
            android:textSize="16sp"
            android:textColor="@color/ds_text_tertiary"
            android:gravity="center" />
    </LinearLayout>

</FrameLayout>
