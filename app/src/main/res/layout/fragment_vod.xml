<?xml version="1.0" encoding="utf-8"?>
<!--
    DERBIX CINEMATIC · MOVIES / VOD GRID  (round 2)
    Drop-in replacement for fragment_vod.xml.
    PRESERVED IDS (do not rename — VodFragment.kt binds them):
      iv_background_backdrop, ll_main_content, ll_vod_sidebar_container,
      ll_sidebar_title_area, rv_categories_sidebar, ll_offline_badge,
      tv_offline_label, btn_search, tv_category_title, rv_movies_grid,
      ll_loading_state, ll_empty_state, tv_empty_message
    NEW: tv_screen_overline, tv_screen_subtitle, v_title_accent,
         tv_count_badge, tv_app_brand
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@color/cin_ink_900">

    <!-- Immersive backdrop (kept) -->
    <ImageView
        android:id="@+id/iv_background_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.28"
        android:contentDescription="Background Backdrop" />

    <!-- Cinematic vignette + gradient -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cin_hero_overlay_v2" />

    <!-- Ambient gold bloom -->
    <ImageView
        android:layout_width="600dp"
        android:layout_height="600dp"
        android:layout_gravity="end|top"
        android:layout_marginEnd="-180dp"
        android:layout_marginTop="-220dp"
        android:src="@drawable/cin_bloom_gold"
        android:alpha="0.32"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/ll_main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal">

        <!-- =========================================================
             CATEGORY SIDEBAR (288dp, gold-themed)
             ========================================================= -->
        <LinearLayout
            android:id="@+id/ll_vod_sidebar_container"
            android:layout_width="288dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/cin_bg_sidebar"
            android:elevation="8dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Brand mark -->
            <LinearLayout
                android:id="@+id/ll_sidebar_title_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingTop="32dp"
                android:paddingBottom="8dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/cin_logo_chip">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_movie"
                        app:tint="@color/cin_gold_500" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_app_brand"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DERBIX"
                        android:textColor="@color/cin_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04"
                        android:fontFamily="@font/plus_jakarta_sans" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="CINEMATIC TV"
                        android:textColor="@color/cin_gold_500"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.22"
                        android:fontFamily="@font/plus_jakarta_sans" />
                </LinearLayout>
            </LinearLayout>

            <!-- Screen badge: Movies -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingTop="14dp"
                android:paddingBottom="10dp">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/cin_chip_gold_soft">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_movie"
                        app:tint="@color/cin_gold_500" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="Movies"
                    android:textColor="@color/cin_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/plus_jakarta_sans" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:text="CATEGORIES"
                android:textColor="#7AFFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.22"
                android:fontFamily="@font/plus_jakarta_sans" />

            <!-- Categories list (kept ID) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_categories_sidebar"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="12dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusRight="@id/rv_movies_grid"
                android:nextFocusLeft="@id/rv_categories_sidebar"
                android:nextFocusUp="@id/btn_search"
                android:descendantFocusability="afterDescendants"/>

            <!-- Footer -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="20dp"
                android:background="#1AFFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="28dp"
                android:paddingVertical="18dp">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/cin_dot_online" />

                <TextView
                    android:id="@+id/tv_count_badge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="Library ready"
                    android:textColor="#99FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/plus_jakarta_sans" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="v2.4"
                    android:textColor="#66FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.16"
                    android:fontFamily="@font/plus_jakarta_sans" />
            </LinearLayout>
        </LinearLayout>

        <!-- =========================================================
             RIGHT CONTENT
             ========================================================= -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <!-- Top utility bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:orientation="horizontal"
                android:gravity="end|center_vertical"
                android:paddingStart="56dp"
                android:paddingEnd="56dp">

                <LinearLayout
                    android:id="@+id/ll_offline_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/cin_meta_chip"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/cin_dot_gold" />

                    <TextView
                        android:id="@+id/tv_offline_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="OFFLINE READY"
                        android:textColor="@color/cin_gold_500"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.18"
                        android:fontFamily="@font/plus_jakarta_sans" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/btn_search"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="18dp"
                    android:background="@drawable/cin_btn_circle_glass"
                    android:clickable="true"
                    android:focusable="true"
                    android:nextFocusDown="@id/rv_categories_sidebar"
                    android:nextFocusLeft="@id/rv_categories_sidebar">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_search"
                        app:tint="@color/cin_text_primary" />
                </FrameLayout>
            </LinearLayout>

            <!-- Screen header (gold accent + overline + title + subtitle) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:paddingStart="56dp"
                android:paddingEnd="56dp"
                android:paddingBottom="20dp">

                <View
                    android:id="@+id/v_title_accent"
                    android:layout_width="5dp"
                    android:layout_height="52dp"
                    android:background="@drawable/cin_section_accent_bar"
                    android:layout_marginEnd="20dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_screen_overline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CATEGORY · ALL MOVIES"
                        android:textColor="@color/cin_gold_500"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.24"
                        android:fontFamily="@font/plus_jakarta_sans" />

                    <TextView
                        android:id="@+id/tv_category_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Recently Added"
                        android:textColor="@color/cin_text_primary"
                        android:textSize="44sp"
                        android:textStyle="bold"
                        android:letterSpacing="-0.02"
                        android:fontFamily="@font/plus_jakarta_sans" />

                    <TextView
                        android:id="@+id/tv_screen_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Updated daily"
                        android:textColor="#80FFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="@font/plus_jakarta_sans" />
                </LinearLayout>
            </LinearLayout>

            <!-- Movies grid (kept ID) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_movies_grid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:paddingStart="40dp"
                android:paddingEnd="40dp"
                android:paddingBottom="48dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@id/rv_categories_sidebar"
                android:nextFocusRight="@id/rv_movies_grid"
                android:nextFocusUp="@id/btn_search" />
        </LinearLayout>
    </LinearLayout>

    <!-- Loading skeleton (kept) -->
    <GridLayout
        android:id="@+id/ll_loading_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="288dp"
        android:layout_marginTop="180dp"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:columnCount="6"
        android:rowCount="2"
        android:visibility="gone">
        <include layout="@layout/item_movie_loading" />
        <include layout="@layout/item_movie_loading" />
        <include layout="@layout/item_movie_loading" />
        <include layout="@layout/item_movie_loading" />
        <include layout="@layout/item_movie_loading" />
        <include layout="@layout/item_movie_loading" />
        <include layout="@layout/item_movie_loading" />
        <include layout="@layout/item_movie_loading" />
    </GridLayout>

    <!-- Empty state (kept) -->
    <LinearLayout
        android:id="@+id/ll_empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_empty_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No movies available"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#CCFFFFFF"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Please check your connection or login again"
            android:textSize="14sp"
            android:textColor="#80FFFFFF"
            android:gravity="center" />
    </LinearLayout>

</FrameLayout>
