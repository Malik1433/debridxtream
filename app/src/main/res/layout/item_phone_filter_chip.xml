<?xml version="1.0" encoding="utf-8"?>
<!-- A filter chip with its count. A chip whose count is zero renders disabled rather than hidden,
     so the shape of the result set stays visible. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/phone_fchip_root"
    android:layout_width="wrap_content"
    android:layout_height="48dp"
    android:layout_marginEnd="8dp"
    android:background="@drawable/bg_phone_chip"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp">

    <TextView
        android:id="@+id/phone_fchip_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/outfit_semibold"
        android:textColor="@color/phone_text_primary"
        android:textSize="12.5sp"
        tools:text="4K" />

    <TextView
        android:id="@+id/phone_fchip_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:fontFamily="@font/share_tech_mono"
        android:textColor="@color/phone_text_muted"
        android:textSize="12sp"
        tools:text="18" />
</LinearLayout>
