<?xml version="1.0" encoding="utf-8"?>
<!-- A filter option and how many titles it would leave. 48dp, so the chip is the target. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="48dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_phone_chip"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="13dp">

    <TextView
        android:id="@+id/phone_fchip_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/outfit_semibold"
        android:textColor="@color/phone_text_primary"
        android:textSize="12.5sp"
        tools:text="4K" />

    <TextView
        android:id="@+id/phone_fchip_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:fontFamily="@font/share_tech_mono"
        android:textColor="@color/phone_text_muted"
        android:textSize="12sp"
        tools:text="318" />
</LinearLayout>
