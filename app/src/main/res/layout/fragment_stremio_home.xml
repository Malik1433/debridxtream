<?xml version="1.0" encoding="utf-8"?>
<!--
  Stremio Home — pixel-perfect port of "Stremio Home.dc.html" (design 1920x1080, scaled px/2 -> dp).
  Chrome (hero + top nav) is always visible; Home/Discover/Library swap in content_host.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/stremio_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#06090E"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- ambient radial glow (bg set programmatically to exact RadialGradient) -->
    <View
        android:id="@+id/ambient_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ══════════════ HERO BANNER (640px/2 = 320dp) ══════════════ -->
    <FrameLayout
        android:id="@+id/heroBanner"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:clipChildren="false">

        <!-- backdrop + fades live in their own clipped layer so Ken Burns can over-scale the photo
             without leaking, while the hero text/CTA buttons (siblings, un-clipped) can scale on
             focus without being cut by the banner bounds. -->
        <FrameLayout
            android:id="@+id/hero_backdrop_clip"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="true"
            android:clipToPadding="true">

            <ImageView
                android:id="@+id/iv_hero_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                tools:src="@tools:sample/backgrounds/scenic" />

            <!-- horizontal LR fade (exact multi-stop set in code) -->
            <View
                android:id="@+id/hero_fade_lr"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- bottom fade (exact set in code) -->
            <View
                android:id="@+id/hero_fade_bottom"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- hero content: left 80/2=40dp, top 130/2=65dp, width 700/2=350dp -->
        <LinearLayout
            android:id="@+id/heroContentContainer"
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="40dp"
            android:layout_marginTop="65dp"
            android:orientation="vertical"
            android:clipChildren="false">

            <!-- label row -->
            <LinearLayout
                android:id="@+id/hero_label_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <View
                    android:id="@+id/hero_pulse_dot"
                    android:layout_width="3dp"
                    android:layout_height="3dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/stremio_pulse_dot" />

                <TextView
                    android:id="@+id/hero_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/share_tech_mono"
                    android:textSize="6sp"
                    android:textColor="#00F0FF"
                    android:letterSpacing="0.18"
                    tools:text="FEATURED TODAY" />
            </LinearLayout>

            <!-- title: Outfit 800, 68/2=34sp, line 0.95, ls -0.03em -->
            <TextView
                android:id="@+id/heroTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit_extrabold"
                android:textSize="34sp"
                android:textColor="#F1F5F9"
                android:letterSpacing="-0.03"
                android:lineSpacingMultiplier="0.95"
                android:layout_marginBottom="10dp"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="20"
                tools:text="Dune:\nPart Two" />

            <!-- badges row -->
            <LinearLayout
                android:id="@+id/hero_badges_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/hero_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/stremio_badge_rating"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:paddingTop="1.5dp"
                    android:paddingBottom="1.5dp"
                    android:fontFamily="@font/share_tech_mono"
                    android:textSize="6sp"
                    android:textColor="#F1F5F9"
                    android:layout_marginEnd="5dp"
                    tools:text="⭐ 8.5" />

                <TextView
                    android:id="@+id/hero_meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/share_tech_mono"
                    android:textSize="6sp"
                    android:textColor="#64748B"
                    android:layout_marginEnd="5dp"
                    tools:text="2024 · 2h 46m" />

                <TextView
                    android:id="@+id/hero_badge_4k"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/stremio_badge_4k"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="1.5dp"
                    android:paddingBottom="1.5dp"
                    android:fontFamily="@font/share_tech_mono"
                    android:textSize="5sp"
                    android:textColor="#041014"
                    android:textStyle="bold"
                    android:text="4K HDR"
                    android:layout_marginEnd="5dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/hero_badge_dolby"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/stremio_badge_dolby"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="1.5dp"
                    android:paddingBottom="1.5dp"
                    android:fontFamily="@font/share_tech_mono"
                    android:textSize="5sp"
                    android:textColor="#041014"
                    android:textStyle="bold"
                    android:text="DOLBY"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- genre chips (built programmatically) -->
            <LinearLayout
                android:id="@+id/hero_genres_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp" />

            <!-- description: Inter 16/2=8sp, line 1.65, maxWidth 560/2=280dp -->
            <TextView
                android:id="@+id/hero_description"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:textSize="8sp"
                android:textColor="#94A3B8"
                android:lineSpacingMultiplier="1.65"
                android:maxLines="@integer/stremio_hero_desc_lines"
                android:ellipsize="end"
                android:layout_marginBottom="14dp"
                tools:text="Paul Atreides unites with Chani and the Fremen while seeking revenge." />

            <!-- CTA buttons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clipChildren="false"
                android:clipToPadding="false">

                <LinearLayout
                    android:id="@+id/heroPlayBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/stremio_btn_primary"
                    android:paddingStart="21dp"
                    android:paddingEnd="21dp"
                    android:focusable="true"
                    android:layout_marginEnd="7dp">

                    <ImageView
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_marginEnd="7dp"
                        android:src="@drawable/ic_stremio_play"
                        app:tint="#041014" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/outfit_bold"
                        android:textSize="11sp"
                        android:textColor="#041014"
                        android:text="Play Now" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/heroTrailerBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/stremio_btn_glass"
                    android:paddingStart="17dp"
                    android:paddingEnd="17dp"
                    android:focusable="true"
                    android:layout_marginEnd="7dp">

                    <ImageView
                        android:layout_width="8.5dp"
                        android:layout_height="8.5dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_stremio_circle_play"
                        app:tint="#F1F5F9" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/outfit_semibold"
                        android:textSize="10sp"
                        android:textColor="#F1F5F9"
                        android:text="Trailer" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/heroWatchlistBtn"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/stremio_watchlist_btn"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_stremio_bookmark"
                        app:tint="#94A3B8" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- dot indicators: bottom 26/2=13dp, left 80/2=40dp -->
        <LinearLayout
            android:id="@+id/hero_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="40dp"
            android:layout_marginBottom="13dp"
            android:orientation="horizontal"
            android:gravity="center_vertical" />
    </FrameLayout>

    <!-- ══════════════ CONTENT HOST (starts just below the 320dp hero) ══════════════ -->
    <FrameLayout
        android:id="@+id/content_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="318dp"
        android:clipChildren="true"
        android:clipToPadding="true">

        <include layout="@layout/content_stremio_home" />
        <include layout="@layout/content_stremio_discover" />
        <include layout="@layout/content_stremio_library" />
    </FrameLayout>

    <!-- ══════════════ TOP NAV BAR (90px/2 = 45dp) ══════════════ -->
    <LinearLayout
        android:id="@+id/top_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginTop="@dimen/stremio_top_bar_inset"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="35dp"
        android:paddingEnd="35dp">

        <!-- logo + wordmark -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="30dp">

            <FrameLayout
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/stremio_logo_tile"
                android:layout_marginEnd="7dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/outfit_extrabold"
                    android:textSize="9sp"
                    android:textColor="#041014"
                    android:letterSpacing="-0.04"
                    android:text="DX" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit_extrabold"
                android:textSize="11sp"
                android:textColor="#F1F5F9"
                android:letterSpacing="-0.02"
                android:text="DebridXtream" />
        </LinearLayout>

        <!-- nav tabs (flex:1) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <include
                android:id="@+id/navTabHome"
                layout="@layout/item_stremio_nav_tab" />

            <include
                android:id="@+id/navTabDiscover"
                layout="@layout/item_stremio_nav_tab" />

            <include
                android:id="@+id/navTabLibrary"
                layout="@layout/item_stremio_nav_tab" />
        </LinearLayout>

        <!-- right controls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/nav_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="28dp"
                android:gravity="end"
                android:fontFamily="@font/share_tech_mono"
                android:textSize="8sp"
                android:textColor="#475569"
                android:letterSpacing="0.08"
                android:layout_marginEnd="5dp"
                tools:text="15:46" />

            <!-- search bar -->
            <LinearLayout
                android:id="@+id/searchBar"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:minWidth="130dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/stremio_glass6_selector"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:focusable="true"
                android:layout_marginEnd="5dp">

                <ImageView
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_stremio_search"
                    app:tint="#64748B" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="8sp"
                    android:textColor="#475569"
                    android:text="Search movies, series…" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/stremio_kbd_badge"
                    android:paddingStart="4.5dp"
                    android:paddingEnd="4.5dp"
                    android:paddingTop="1.5dp"
                    android:paddingBottom="1.5dp"
                    android:fontFamily="@font/share_tech_mono"
                    android:textSize="6sp"
                    android:textColor="#334155"
                    android:text="/" />
            </LinearLayout>

            <!-- bell -->
            <FrameLayout
                android:id="@+id/nav_bell"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/stremio_glass6_selector"
                android:focusable="true"
                android:layout_marginEnd="5dp">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_stremio_bell"
                    app:tint="#94A3B8" />

                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/stremio_bell_dot" />
            </FrameLayout>

            <!-- profile chip -->
            <LinearLayout
                android:id="@+id/nav_profile"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/stremio_profile_chip_selector"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:background="@drawable/stremio_avatar_tile"
                    android:layout_marginEnd="5.5dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/outfit_bold"
                        android:textSize="7.5sp"
                        android:textColor="#FFFFFF"
                        android:text="A" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit_semibold"
                    android:textSize="8.5sp"
                    android:textColor="#F1F5F9"
                    android:text="Alex"
                    android:layout_marginEnd="4dp" />

                <ImageView
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:src="@drawable/ic_stremio_chevron_down"
                    app:tint="#64748B" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ══════════════ STATUS / RESOLUTION OVERLAY ══════════════ -->
    <FrameLayout
        android:id="@+id/stremio_status_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B306090E"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <ProgressBar
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:indeterminateTint="#00F0FF" />

            <TextView
                android:id="@+id/stremio_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/outfit_medium"
                android:textSize="9sp"
                android:textColor="#94A3B8"
                android:text="Loading…" />
        </LinearLayout>
    </FrameLayout>

    <!-- ══════════════ SEARCH OVERLAY ══════════════ -->
    <include layout="@layout/overlay_stremio_search" />

    <!-- ══ NO DEBRID SERVICE YET (§9 / Qadam 3) ══
         Shown INSTEAD of leaving the customer on an empty Debrid screen wondering what is broken.
         One tier means every device may use Debrid; whether it does anything depends on the
         customer adding their own addons, so this is the screen that tells them how. -->
    <FrameLayout
        android:id="@+id/debrid_setup_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F206090E"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="460dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.18"
                android:text="DEBRID"
                android:textColor="#38BDF8"
                android:textSize="8sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Add your debrid service to use this section"
                android:textColor="#F1F5F9"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="3dp"
                android:text="Debrid plays movies and series from your own debrid provider. Nothing here works until you add your addon links — they are yours, not part of this app."
                android:textColor="#94A3B8"
                android:textSize="10sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="On your phone"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:text="Open the address below, sign in, and paste your addon links there. This TV picks them up on its own."
                android:textColor="#94A3B8"
                android:textSize="10sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:text="@string/companion_signup_url_short"
                android:textColor="#38BDF8"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Or on this TV"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Settings › Debrid › Stremio Addons › Add Addon"
                android:textColor="#94A3B8"
                android:textSize="10sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="BACK  ·  RETURN"
                android:textColor="#475569"
                android:textSize="8sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
