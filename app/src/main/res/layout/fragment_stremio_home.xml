<?xml version="1.0" encoding="utf-8"?>
<!--
  PHONE Debrid section — portrait.

  The television version is untouched in layout-television/: a wide hero, a top bar carrying the
  three tabs, a clock, a bell and a profile, all read from three metres. On a handset that bar is
  five controls fighting for 411dp, and the section was the last place the app still rotated to
  landscape when you entered it.

  Same ids, same kinds. The three tabs stay `include`s of the same nav-tab layout so the code that
  focuses, styles and switches them is unchanged; they simply sit in a chip row of their own under
  a 56dp app bar. The hero block is here in full but stays collapsed on this device — that was
  already the owner's decision (`debrid_home_shows_hero`), and its views must exist for the hero
  manager to bind.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/stremio_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/phone_home_bg">

    <View
        android:id="@+id/ambient_glow"
        android:layout_width="0dp"
        android:layout_height="0dp" />

    <!-- ══ HERO ══ collapsed on a phone; every id kept so the hero manager still binds. -->
    <FrameLayout
        android:id="@+id/heroBanner"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/hero_backdrop_clip"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/iv_hero_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <View
            android:id="@+id/hero_fade_lr"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <View
            android:id="@+id/hero_fade_bottom"
            android:layout_width="0dp"
            android:layout_height="0dp" />

        <LinearLayout
            android:id="@+id/heroContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/hero_label_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <View
                    android:id="@+id/hero_pulse_dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp" />

                <TextView
                    android:id="@+id/hero_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/heroTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:id="@+id/hero_badges_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/hero_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/hero_meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/hero_badge_4k"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/hero_badge_dolby"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hero_genres_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/hero_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:id="@+id/heroPlayBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/heroTrailerBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <FrameLayout
                android:id="@+id/heroWatchlistBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:id="@+id/hero_dots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </LinearLayout>
    </FrameLayout>

    <!-- ══ THE ROWS ══ everything this section actually is on a phone. The three sections are
         the SAME includes the television uses, so every row, card and adapter is shared. -->
    <FrameLayout
        android:id="@+id/content_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="112dp"
        android:layout_marginBottom="64dp">

        <include layout="@layout/content_stremio_home" />
        <include layout="@layout/content_stremio_discover" />
        <include layout="@layout/content_stremio_library" />
    </FrameLayout>

    <!-- ══ CHROME ══ a 56dp app bar, then the three tabs as a chip row. -->
    <LinearLayout
        android:id="@+id/top_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:background="@color/phone_bar_scrim"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/outfit_extrabold"
                android:letterSpacing="-0.03"
                android:text="@string/nav_debrid_label"
                android:textColor="@color/phone_text_primary"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/nav_clock"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/searchBar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/phone_search"
                    android:src="@drawable/ic_stremio_search"
                    app:tint="@color/phone_text_primary" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/nav_bell"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/nav_profile"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/nav_settings"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/phone_text_primary" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <include
                android:id="@+id/navTabHome"
                layout="@layout/item_stremio_nav_tab" />

            <include
                android:id="@+id/navTabDiscover"
                layout="@layout/item_stremio_nav_tab" />

            <include
                android:id="@+id/navTabLibrary"
                layout="@layout/item_stremio_nav_tab" />
        </LinearLayout>
    </LinearLayout>

    <!-- Debrid is one of the five tabs, so it carries the bar its siblings carry. -->
    <LinearLayout
        android:id="@+id/debrid_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="@color/phone_nav_scrim"
        android:orientation="horizontal" />

    <include layout="@layout/overlay_stremio_search" />

    <FrameLayout
        android:id="@+id/stremio_status_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:visibility="gone">

        <TextView
            android:id="@+id/stremio_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/share_tech_mono"
            android:gravity="center"
            android:padding="12dp"
            android:textColor="@color/phone_text_muted"
            android:textSize="12sp" />
    </FrameLayout>

    <!-- The "add your debrid service" gate, which on a phone must fit a phone. -->
    <FrameLayout
        android:id="@+id/debrid_setup_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/phone_home_bg"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/share_tech_mono"
                android:letterSpacing="0.12"
                android:text="@string/nav_debrid_label"
                android:textAllCaps="true"
                android:textColor="@color/phone_cyan"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/outfit_extrabold"
                android:text="@string/ui_add_your_debrid_service_to"
                android:textColor="@color/phone_text_primary"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/debrid_setup_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/inter_regular"
                android:lineSpacingMultiplier="1.5"
                android:text="@string/debrid_setup_companion_body"
                android:textColor="@color/phone_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/debrid_setup_action"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_phone_chip_active"
                android:fontFamily="@font/outfit_semibold"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="@string/settings"
                android:textColor="@color/phone_cyan"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
