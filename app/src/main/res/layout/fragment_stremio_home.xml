<?xml version="1.0" encoding="utf-8"?>
<!--
  PHONE Debrid section — portrait.

  The television version is untouched in layout-television/: a wide hero, a top bar carrying the
  three tabs, a clock, a bell and a profile, all read from three metres. On a handset that bar is
  five controls fighting for 411dp, and the section was the last place the app still rotated to
  landscape when you entered it.

  Same ids, same kinds. The three tabs stay `include`s of the same nav-tab layout so the code that
  focuses, styles and switches them is unchanged; they simply sit in a chip row of their own under
  a 56dp app bar. The hero block is here in full but stays collapsed on this device — that was
  already the owner's decision (`debrid_home_shows_hero`), and its views must exist for the hero
  manager to bind.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/stremio_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/phone_home_bg">

    <View
        android:id="@+id/ambient_glow"
        android:layout_width="0dp"
        android:layout_height="0dp" />

    <!--
      The hero used to sit here, collapsed to 0dp. It now lives in view_debrid_phone_hero.xml and
      is inflated as the FIRST ITEM of the rows list, so it scrolls away instead of standing on a
      third of the screen. Its ids moved with it; StremioHeroManager binds that view.
    -->

    <!-- ══ THE ROWS ══ everything this section actually is on a phone. The three sections are
         the SAME includes the television uses, so every row, card and adapter is shared.

         The error panel is a SIBLING ABOVE them rather than an overlay on top of them, because
         design 1d wants the rows that already loaded to stay usable while it is showing. As a
         real row in a vertical stack it pushes them down by exactly its own height; nothing has
         to be measured and nothing ends up hidden underneath it. -->
    <LinearLayout
        android:id="@+id/content_stack"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="112dp"
        android:layout_marginBottom="64dp"
        android:orientation="vertical">

        <include layout="@layout/view_debrid_phone_error" />

        <FrameLayout
            android:id="@+id/content_host"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <include layout="@layout/content_stremio_home" />
            <include layout="@layout/content_stremio_discover" />
            <include layout="@layout/content_stremio_library" />
        </FrameLayout>
    </LinearLayout>

    <!-- The loading state (design 1c). It covers the rows but NOT the chrome, so the app bar can
         say SYNCING and the dock still leaves the section in one tap. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="112dp"
        android:layout_marginBottom="64dp">

        <include layout="@layout/view_debrid_phone_skeleton" />
    </FrameLayout>

    <!-- ══ CHROME ══ a 56dp app bar, then the three tabs as a chip row. -->
    <LinearLayout
        android:id="@+id/top_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:background="@color/phone_bar_scrim"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/outfit_extrabold"
                android:letterSpacing="-0.03"
                android:text="@string/nav_debrid_label"
                android:textColor="@color/phone_text_primary"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/nav_clock"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <!-- Design 1c: while the page is blank shapes, the bar says what they are waiting
                 for. Nothing else in this app can answer "is it stuck, or is it working?". -->
            <TextView
                android:id="@+id/debrid_sync_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:fontFamily="@font/share_tech_mono"
                android:letterSpacing="0.14"
                android:text="@string/debrid_syncing"
                android:textColor="@color/phone_cyan"
                android:textSize="12sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/searchBar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/phone_search"
                    android:src="@drawable/ic_stremio_search"
                    app:tint="@color/phone_text_primary" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/nav_bell"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/nav_profile"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/nav_settings"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/phone_text_primary" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <include
                android:id="@+id/navTabHome"
                layout="@layout/item_stremio_nav_tab" />

            <include
                android:id="@+id/navTabDiscover"
                layout="@layout/item_stremio_nav_tab" />

            <include
                android:id="@+id/navTabLibrary"
                layout="@layout/item_stremio_nav_tab" />
        </LinearLayout>
    </LinearLayout>

    <!--
      1b · NOT CONNECTED.

      What was here said "Add your debrid service to use this section" and offered Settings. True,
      but it answers neither question a customer arriving on an empty tab actually has: what is
      this for, and what exactly do I do. The design's answer is a status, a reason, numbered
      steps and two real actions — which is what this is now.

      The steps are this product's, not the designer's: he drew Real-Debrid's device-pairing
      screen (a code typed into real-debrid.com/device), and this app has no such flow — access
      comes from addon links saved to the ACCOUNT. Building his literal card would have been
      building a door that opens onto nothing.
    -->
    <ScrollView
        android:id="@+id/debrid_setup_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="64dp"
        android:background="@color/phone_home_bg"
        android:clickable="true"
        android:focusable="true"
        android:fillViewport="true"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="72dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_phone_card"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_phone_dot_amber" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/share_tech_mono"
                        android:letterSpacing="0.16"
                        android:text="@string/debrid_state_not_connected"
                        android:textColor="@color/phone_amber"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/outfit_extrabold"
                    android:letterSpacing="-0.02"
                    android:text="@string/debrid_connect_title"
                    android:textColor="@color/phone_text_primary"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/debrid_setup_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/inter_regular"
                    android:lineSpacingMultiplier="1.65"
                    android:text="@string/debrid_connect_body"
                    android:textColor="@color/phone_text_secondary"
                    android:textSize="13sp" />

                <!-- The steps, in a well of their own so the address and the actions never blur
                     into one wall of text. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_phone_dashed_panel"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/share_tech_mono"
                        android:letterSpacing="0.14"
                        android:text="@string/debrid_step_one_label"
                        android:textColor="@color/phone_text_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/debrid_setup_url"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/share_tech_mono"
                        android:textColor="@color/phone_cyan"
                        android:textIsSelectable="true"
                        android:textSize="15sp"
                        tools:text="dxplay.xyz/account/manage" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="14dp"
                        android:background="#14FFFFFF" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/share_tech_mono"
                        android:letterSpacing="0.14"
                        android:text="@string/debrid_step_two_label"
                        android:textColor="@color/phone_text_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/inter_regular"
                        android:lineSpacingMultiplier="1.55"
                        android:text="@string/debrid_step_two_body"
                        android:textColor="@color/phone_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/debrid_setup_recheck"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_phone_primary_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/outfit_bold"
                    android:gravity="center"
                    android:text="@string/debrid_connect_recheck"
                    android:textColor="#04121A"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/debrid_setup_action"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_phone_btn_secondary"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/outfit_semibold"
                    android:gravity="center"
                    android:text="@string/debrid_connect_settings"
                    android:textColor="@color/phone_text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/inter_regular"
                android:lineSpacingMultiplier="1.6"
                android:paddingHorizontal="4dp"
                android:text="@string/debrid_addons_follow_account"
                android:textColor="@color/phone_text_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Debrid is one of the five tabs, so it carries the bar its siblings carry. LAST on purpose:
         the setup gate above is a full-screen clickable, so anything drawn after it is unreachable.
         With the gate on top, tapping Home or Movies did nothing at all and BACK was the only way
         out of this section — a bottom bar that stops working is not a bottom bar. -->
    <LinearLayout
        android:id="@+id/debrid_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="@color/phone_nav_scrim"
        android:orientation="horizontal" />

    <include layout="@layout/overlay_stremio_search" />

    <!-- The cancelable wait (design 1g). Declared before the status overlay so a status line can
         still be shown over it if something else needs to speak. -->
    <include layout="@layout/view_debrid_resolving" />

    <FrameLayout
        android:id="@+id/stremio_status_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:visibility="gone">

        <TextView
            android:id="@+id/stremio_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/share_tech_mono"
            android:gravity="center"
            android:padding="12dp"
            android:textColor="@color/phone_text_muted"
            android:textSize="12sp" />
    </FrameLayout>

</FrameLayout>
