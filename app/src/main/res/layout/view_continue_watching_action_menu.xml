<?xml version="1.0" encoding="utf-8"?>
<!-- Continue-Watching quick actions — compact cyan-glass context menu. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_cw_action_menu"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:elevation="16dp"
    android:orientation="vertical"
    android:paddingStart="13dp"
    android:paddingTop="11dp"
    android:paddingEnd="13dp"
    android:paddingBottom="11dp">

    <!-- Title -->
    <TextView
        android:id="@+id/tv_cw_menu_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:maxWidth="240dp"
        android:textColor="#F2F9FF"
        android:textSize="12.5sp"
        android:textStyle="bold"
        tools:text="|NL| Ne Zha" />

    <!-- Slim resume progress -->
    <LinearLayout
        android:id="@+id/row_cw_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ProgressBar
            android:id="@+id/pb_cw_menu_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/cw_menu_progress" />

        <TextView
            android:id="@+id/tv_cw_menu_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="monospace"
            android:textColor="#9FC6DE"
            android:textSize="8sp"
            tools:text="2:28 / 1:50:07" />
    </LinearLayout>

    <!-- Actions -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chip_cw_open_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_cw_chip_primary"
            android:drawableStart="@drawable/ic_cw_open_detail"
            android:drawablePadding="6dp"
            android:drawableTint="@color/cw_chip_primary_text"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:minHeight="32dp"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:stateListAnimator="@animator/cw_chip_focus"
            android:text="Open Detail"
            android:textAllCaps="false"
            android:textColor="@color/cw_chip_primary_text"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chip_cw_clear_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_cw_chip_secondary"
            android:drawableStart="@drawable/ic_cw_remove"
            android:drawablePadding="6dp"
            android:drawableTint="@color/cw_chip_secondary_text"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:minHeight="32dp"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:stateListAnimator="@animator/cw_chip_focus"
            android:text="Remove"
            android:textAllCaps="false"
            android:textColor="@color/cw_chip_secondary_text"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
