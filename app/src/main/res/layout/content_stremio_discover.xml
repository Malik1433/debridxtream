<?xml version="1.0" encoding="utf-8"?>
<!--
  PHONE Discover.

  The television's version is untouched in layout-television/: a 140dp "Top 10" column pinned to
  the left of a filter stack and a grid, all inside 35dp gutters with 7.5–8sp labels. On 411dp that
  column takes a third of the width and leaves the grid two posters wide, and every label is a
  10-foot size. This is the screen the owner called messy, and the mess is that shape.

  Same ids and kinds — StremioDiscoverSection binds either — but stacked the way a phone reads:
  filters at the top where a thumb starts, then Top 10 as a horizontal rail, then the endless grid.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/discover_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- Filters first: on a phone this is the control the thumb reaches for. -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/filterPillsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/filterExpandPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/stremio_expand_panel"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/activeTagsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:visibility="gone" />

        <!-- Top 10, as a rail rather than a column that eats a third of the width. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="20dp"
            android:paddingBottom="12dp">

            <View
                android:layout_width="3dp"
                android:layout_height="14dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/stremio_accent_bar_amber" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit_bold"
                android:text="@string/ui_top_10_this_week"
                android:textColor="#F1F5F9"
                android:textSize="15sp" />
        </LinearLayout>

        <!--
          Capped, and scrolling inside itself. Ten full-width rows are 720dp on a 914dp screen: at
          wrap_content the Top 10 ate the page and the grid below it was unreachable without
          scrolling past all ten. Three rows show, the rest are a flick away, and the grid keeps the
          screen it needs.
        -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/discoverTop10"
            android:layout_width="match_parent"
            android:layout_height="216dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="24dp"
            android:paddingBottom="12dp">

            <View
                android:layout_width="3dp"
                android:layout_height="14dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/stremio_accent_bar_blue" />

            <TextView
                android:id="@+id/discoverGridLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/outfit_bold"
                android:maxLines="1"
                android:text="@string/ui_trending_everywhere"
                android:textColor="#F1F5F9"
                android:textSize="15sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/discoverGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:nestedScrollingEnabled="true"
            android:paddingBottom="24dp" />
    </LinearLayout>
</FrameLayout>
