<?xml version="1.0" encoding="utf-8"?>
<!-- Library card: 150x224 px / 2 = 75 x 112 dp, radius 10px/2=5dp -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lib_card"
    android:layout_width="@dimen/poster_top_10_width"
    android:layout_height="@dimen/poster_top_10_height"
    android:layout_marginEnd="6dp"
    android:layout_marginBottom="6dp"
    android:focusable="true"
    android:clipChildren="true"
    android:foreground="@drawable/card_focus_cinematic">

    <ImageView
        android:id="@+id/lib_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/lib_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- status badge top-left 7px/2=3.5dp -->
    <TextView
        android:id="@+id/lib_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="3.5dp"
        android:layout_marginStart="3.5dp"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:fontFamily="@font/share_tech_mono"
        android:textSize="4sp"
        android:textStyle="bold" />

    <!-- progress bar above title (watching only) -->
    <FrameLayout
        android:id="@+id/lib_progress_wrap"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="19dp"
        android:background="@drawable/stremio_progress_track"
        android:visibility="gone">

        <View
            android:id="@+id/lib_progress_fill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/stremio_progress_fill" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/lib_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit_semibold"
            android:textSize="5.5sp"
            android:textColor="#F1F5F9"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/lib_year"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/share_tech_mono"
            android:textSize="4sp"
            android:textColor="#64748B"
            android:layout_marginTop="1dp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>
