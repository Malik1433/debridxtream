<?xml version="1.0" encoding="utf-8"?>
<!--
  PHONE library card. The television's copy — 75x112dp art with a 5.5sp title and a 4sp year
  painted over it — is untouched in layout-television/. Those sizes are the 10-foot "px÷2" rule;
  in the hand 4sp is not small type, it is no type at all.

  Same ids and kinds, so StremioLibraryAdapter binds either: 124x186 art, the title and year BELOW
  it at 13sp/12sp, the status badge readable at 12sp, and a 3dp progress bar on the art's edge.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lib_card"
    android:layout_width="124dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="18dp"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="124dp"
        android:layout_height="186dp"
        android:background="@drawable/bg_phone_poster"
        android:clipToOutline="true"
        android:foreground="@drawable/card_focus_cinematic">

        <ImageView
            android:id="@+id/lib_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <View
            android:id="@+id/lib_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/lib_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="6dp"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/share_tech_mono"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:textSize="12sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/lib_progress_wrap"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:background="@drawable/stremio_progress_track"
            android:visibility="gone">

            <View
                android:id="@+id/lib_progress_fill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/stremio_progress_fill" />
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/lib_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="@font/outfit_semibold"
        android:lineSpacingMultiplier="1.25"
        android:maxLines="2"
        android:textColor="#F1F5F9"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/lib_year"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="@font/share_tech_mono"
        android:maxLines="1"
        android:textColor="#64748B"
        android:textSize="12sp" />
</LinearLayout>
