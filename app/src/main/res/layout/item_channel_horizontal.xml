<?xml version="1.0" encoding="utf-8"?>
<!--
    CINEMATIC HORIZONTAL CHANNEL ROW (96dp tall, used in 3-column rail)
    Replaces: item_channel_horizontal.xml
    Preserves IDs: view_focus_bar, iv_channel_logo_horizontal,
      tv_channel_name_horizontal, tv_epg_now, tv_epg_next,
      badge_hd, badge_4k, badge_epg, badge_pay,
      pb_epg_progress, iv_favorite_indicator
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="104dp"
    android:layout_marginBottom="12dp"
    android:layout_marginHorizontal="6dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:stateListAnimator="@animator/cin_channel_card_state">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cin_channel_card_state"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="16dp">

        <!-- Focus accent bar (Kotlin-bound id) -->
        <View
            android:id="@+id/view_focus_bar"
            android:layout_width="3dp"
            android:layout_height="48dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/cin_sidebar_active_bar"
            android:duplicateParentState="true"
            android:visibility="invisible" />

        <!-- Logo -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/channel_logo_bg_dark"
            android:padding="6dp"
            android:layout_marginEnd="16dp">

            <ImageView
                android:id="@+id/iv_channel_logo_horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="@string/live_channel_logo_content_description"
                tools:src="@android:drawable/ic_menu_gallery" />
        </FrameLayout>

        <!-- Center column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <!-- Title row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="3dp">

                <TextView
                    android:id="@+id/tv_channel_name_horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="CNN International"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFFFF"
                    android:fontFamily="@font/inter_extrabold"
                    android:letterSpacing="-0.01"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- EPG row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_epg_now"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="Newsroom with Jim Acosta"
                    android:textSize="12sp"
                    android:textColor="#80FFFFFF"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Quality / pay badges -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginStart="10dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/badge_hd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HD"
                        android:textColor="#FFFFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.18"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/cin_pill_hd_glass"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/badge_4k"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4K"
                        android:textColor="#1A1108"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.18"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/cin_pill_4k_gold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/badge_epg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EPG"
                        android:textColor="#FFFFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.18"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/cin_pill_hd_glass"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/badge_pay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$"
                        android:textColor="#FFFFFFFF"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/cin_pill_hd_glass"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- Hidden next-program slot -->
            <TextView
                android:id="@+id/tv_epg_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- Mini progress -->
            <ProgressBar
                android:id="@+id/pb_epg_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/cin_preview_progress"
                android:visibility="invisible"
                tools:progress="40"
                tools:visibility="visible" />

        </LinearLayout>

        <!-- Right: favorite indicator -->
        <ImageView
            android:id="@+id/iv_favorite_indicator"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_favorite"
            app:tint="#FFC9A961"
            android:layout_marginStart="14dp"
            android:visibility="gone"
            tools:visibility="visible"
            android:contentDescription="@string/favorite_added" />

    </LinearLayout>
</FrameLayout>
