<?xml version="1.0" encoding="utf-8"?>
<!--
  The 10-foot PIN entry (2026-09-03): four digit boxes driven by the D-pad alone - UP/DOWN change
  the digit, LEFT/RIGHT move, OK confirms. No soft keyboard: the TV rulebook forbids depending on
  one, and a Fire TV remote has no number keys. The phone gets the native numeric keyboard instead
  (ParentalPinDialogs decides by R.bool.ui_uses_dpad_focus).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/pin_digits"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:contentDescription="@string/s_pin_hint">

        <TextView
            android:id="@+id/pin_d1"
            style="@style/PinWheelDigit"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/pin_d2"
            style="@style/PinWheelDigit"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/pin_d3"
            style="@style/PinWheelDigit"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/pin_d4"
            style="@style/PinWheelDigit"
            android:contentDescription="@null" />
    </LinearLayout>

    <TextView
        android:id="@+id/pin_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/s_pin_wheel_hint"
        android:textSize="12sp"
        android:textColor="#94A3B8" />
</LinearLayout>
