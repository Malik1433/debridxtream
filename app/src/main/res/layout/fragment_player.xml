<?xml version="1.0" encoding="utf-8"?>
<!--
    CINEMATIC PLAYER
    Replaces: fragment_player.xml + activity_player.xml controls overlay.
    Preserves IDs: video_view, controls_root, btn_play_pause, btn_skip_back,
      btn_skip_fwd, btn_subs, btn_audio, btn_quality, btn_back,
      seek_bar, tv_position, tv_duration, tv_title, tv_subtitle,
      progress_loading
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:use_controller="false" />

    <!-- Controls overlay -->
    <FrameLayout
        android:id="@+id/controls_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cin_player_overlay">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="@dimen/cin_space_6">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_back"
                style="@style/Cin.Button.Icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:icon="@drawable/ic_arrow_back"
                app:iconTint="@color/cin_text_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/cin_space_4"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="Movie Title"
                    android:textColor="@color/cin_text_primary"
                    android:textSize="@dimen/cin_text_title_sm"
                    android:fontFamily="@font/inter_extrabold" />
                <TextView
                    android:id="@+id/tv_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="2024 · 2h 14m · ★ 8.4"
                    android:textColor="@color/cin_text_secondary"
                    android:textSize="@dimen/cin_text_caption"
                    android:fontFamily="@font/plus_jakarta_sans" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_subs"
                style="@style/Cin.Button.Icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/cin_space_2"
                app:icon="@drawable/ic_subtitles"
                app:iconTint="@color/cin_text_primary" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_audio"
                style="@style/Cin.Button.Icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/cin_space_2"
                app:icon="@drawable/ic_audio"
                app:iconTint="@color/cin_text_primary" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_quality"
                style="@style/Cin.Button.Icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/cin_space_2"
                app:icon="@drawable/ic_settings"
                app:iconTint="@color/cin_text_primary" />
        </LinearLayout>

        <!-- Center playback controls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_skip_back"
                style="@style/Cin.Button.Icon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                app:icon="@drawable/ic_skip_back"
                app:iconSize="28dp"
                app:iconTint="@color/cin_text_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_play_pause"
                style="@style/Cin.Button.PlayHero"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginHorizontal="@dimen/cin_space_6"
                app:icon="@drawable/ic_play"
                app:iconSize="40dp"
                app:iconTint="@color/cin_text_on_gold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_skip_fwd"
                style="@style/Cin.Button.Icon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                app:icon="@drawable/ic_skip_fwd"
                app:iconSize="28dp"
                app:iconTint="@color/cin_text_primary" />
        </LinearLayout>

        <!-- Bottom seek bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:padding="@dimen/cin_space_6">

            <SeekBar
                android:id="@+id/seek_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progressDrawable="@drawable/cin_seekbar_track"
                android:thumb="@drawable/cin_seekbar_thumb"
                android:max="100"
                android:progress="35" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cin_space_2"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tv_position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="46:32"
                    android:textColor="@color/cin_text_primary"
                    android:textSize="@dimen/cin_text_caption"
                    android:fontFamily="@font/inter_extrabold" />
                <View
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
                <TextView
                    android:id="@+id/tv_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2:14:00"
                    android:textColor="@color/cin_text_tertiary"
                    android:textSize="@dimen/cin_text_caption"
                    android:fontFamily="@font/plus_jakarta_sans" />
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>

    <!-- Loading indicator -->
    <ProgressBar
        android:id="@+id/progress_loading"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/cin_gold_500"
        android:visibility="gone" />

</FrameLayout>
