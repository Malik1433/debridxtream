<?xml version="1.0" encoding="utf-8"?>
<!--
  PHONE Debrid error (design frame 1d).

  ONE panel serves both failures, because they differ in wording, not in kind:

    • nothing loaded   — it is the whole page, and it names what could not be reached.
    • a refresh failed — it sits ABOVE the rows that DID load and says they are the saved ones.

  The second case is why this is a panel and not a full-screen block. The ViewModel already keeps
  the cached rows when a refresh fails (the "never let a failed refresh destroy good data" rule),
  and the screen was throwing that work away by saying nothing at all. An error state that
  discards the rows is worse than the error.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/debrid_error_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    android:background="@drawable/bg_phone_alert_panel"
    android:orientation="vertical"
    android:padding="20dp"
    android:visibility="gone"
    tools:visibility="visible">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_error_circle"
            app:tint="@color/phone_red" />

        <TextView
            android:id="@+id/debrid_error_kicker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/share_tech_mono"
            android:letterSpacing="0.16"
            android:text="@string/debrid_catalog_unavailable"
            android:textColor="@color/phone_red"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/debrid_error_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/outfit_bold"
        android:text="@string/debrid_error_title"
        android:textColor="@color/phone_text_primary"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/debrid_error_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/inter_regular"
        android:lineSpacingMultiplier="1.65"
        android:textColor="@color/phone_text_secondary"
        android:textSize="13sp"
        tools:text="Timed out loading Debrid catalog. Check your connection and try again." />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/debrid_error_retry"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_phone_btn_secondary"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/outfit_semibold"
            android:gravity="center"
            android:text="@string/phone_retry"
            android:textColor="@color/phone_text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/debrid_error_addons"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_phone_chip"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/outfit_semibold"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/debrid_addons_button"
            android:textColor="@color/phone_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
