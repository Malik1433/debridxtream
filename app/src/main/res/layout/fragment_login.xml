<?xml version="1.0" encoding="utf-8"?>
<!-- Premium Split-Screen Login: Left Branding | Right Login Form -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:background="#0A0E1A"
    android:paddingTop="40dp"
    android:paddingBottom="40dp"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <!-- ============================================================ -->
    <!-- LEFT PANEL: Branding & Cinematic Background (45% width)       -->
    <!-- ============================================================ -->
    <FrameLayout
        android:id="@+id/panel_left"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.45"
        android:background="@drawable/bg_login_split_left">

        <!-- Subtle vignette overlay for depth -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/vignette_cinematic"
            android:alpha="0.6" />

        <!-- Branding container: vertically centered -->
        <LinearLayout
            android:id="@+id/ll_title_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="48dp">

            <!-- App Logo -->
            <ImageView
                android:id="@+id/iv_logo"
                android:layout_width="260dp"
                android:layout_height="100dp"
                android:src="@drawable/ic_login_logo"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter" />

            <!-- App Title -->
            <TextView
                android:id="@+id/tv_welcome_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/login_welcome_title"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.15" />

            <!-- Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/login_welcome_subtitle"
                android:textColor="@color/login_emerald"
                android:textSize="15sp"
                android:fontFamily="sans-serif" />

            <!-- Tagline -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/login_tagline"
                android:textColor="@color/login_tagline"
                android:textSize="13sp"
                android:fontFamily="sans-serif-light" />

            <!-- Decorative accent bar -->
            <View
                android:layout_width="48dp"
                android:layout_height="3dp"
                android:layout_marginTop="32dp"
                android:background="@color/login_emerald" />

        </LinearLayout>
    </FrameLayout>

    <!-- ============================================================ -->
    <!-- RIGHT PANEL: Login Form (55% width)                           -->
    <!-- ============================================================ -->
    <FrameLayout
        android:id="@+id/panel_right"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.55"
        android:background="#0D1117">

        <!-- Centered login card -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:overScrollMode="never">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/card_login_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginHorizontal="48dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_login_card_premium"
                android:padding="24dp">

                <!-- Card Heading -->
                <TextView
                    android:id="@+id/tv_card_heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_card_heading"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tv_card_subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Enter your IPTV provider credentials"
                    android:textColor="@color/login_tagline"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-light"
                    app:layout_constraintTop_toBottomOf="@id/tv_card_heading"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- ========== Input Fields ========== -->
                <LinearLayout
                    android:id="@+id/ll_login_fields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    app:layout_constraintTop_toBottomOf="@id/tv_card_subtitle">

                    <!-- Server URL -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_server_url"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/login_server_url_hint"
                        app:startIconDrawable="@drawable/ic_dns"
                        app:startIconTint="@color/login_tagline"
                        android:textColorHint="@color/login_tagline"
                        app:boxStrokeColor="@color/login_emerald"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:hintTextColor="@color/login_emerald">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_server_url"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif"
                            android:nextFocusDown="@id/et_username" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Username -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_username"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/login_username_hint"
                        app:startIconDrawable="@drawable/ic_person"
                        app:startIconTint="@color/login_tagline"
                        android:textColorHint="@color/login_tagline"
                        app:boxStrokeColor="@color/login_emerald"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:hintTextColor="@color/login_emerald">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_username"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif"
                            android:nextFocusDown="@id/et_password" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Password -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_password"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="@string/login_password_hint"
                        app:startIconDrawable="@drawable/ic_lock"
                        app:startIconTint="@color/login_tagline"
                        android:textColorHint="@color/login_tagline"
                        app:boxStrokeColor="@color/login_emerald"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="2dp"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:hintTextColor="@color/login_emerald"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/login_tagline">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif"
                            android:imeOptions="actionDone"
                            android:nextFocusDown="@id/btn_login" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <!-- ========== SIGN IN Button ========== -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_login"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/btn_login_emerald"
                    app:backgroundTint="@null"
                    android:text="@string/login_button_text"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    app:cornerRadius="12dp"
                    app:layout_constraintTop_toBottomOf="@id/ll_login_fields"
                    android:nextFocusDown="@id/btn_setup_phone" />

                <!-- ========== OR Divider ========== -->
                <LinearLayout
                    android:id="@+id/ll_or_divider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    app:layout_constraintTop_toBottomOf="@id/btn_login">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/white_opacity_10" />

                    <TextView
                        android:id="@+id/tv_or_divider"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:text="OR"
                        android:textColor="@color/white_opacity_30"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.15" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/white_opacity_10" />
                </LinearLayout>

                <!-- ========== Mobile / QR Connect Button ========== -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_setup_phone"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/btn_login_secondary_outline"
                    app:backgroundTint="@null"
                    android:text="@string/login_connect_mobile"
                    android:textColor="@color/white_opacity_70"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    app:strokeColor="@color/white_opacity_30"
                    app:strokeWidth="0dp"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_search"
                    app:iconTint="@color/login_emerald"
                    app:iconGravity="textStart"
                    app:iconPadding="12dp"
                    app:layout_constraintTop_toBottomOf="@id/ll_or_divider" />

                <!-- ========== Progress Bar ========== -->
                <ProgressBar
                    android:id="@+id/progress_bar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="16dp"
                    android:indeterminateTint="@color/login_emerald"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/btn_setup_phone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </ScrollView>
    </FrameLayout>

</LinearLayout>
