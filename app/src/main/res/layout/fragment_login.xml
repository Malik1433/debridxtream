<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:clipChildren="false"
    android:clipToPadding="false"> <!-- Samsung Navy Base -->

    <!-- Samsung Cinematic Background -->
    <FrameLayout
        android:id="@+id/bg_mosaic_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0">

        <ImageView
            android:id="@+id/iv_bg_mosaic"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/home_bg_cinematic"
            tools:ignore="ContentDescription" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_samsung_cinematic_gradient" />
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingVertical="20dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <!-- Premium Samsung Glass Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_login_container"
                android:layout_width="400dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:clipChildren="false"
                android:clipToPadding="false"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardElevation="0dp"
                app:cardCornerRadius="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_login_glass_panel"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:paddingHorizontal="28dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="24dp">

                    <ImageView
                        android:id="@+id/iv_logo"
                        android:layout_width="100dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="12dp"
                        android:src="@drawable/app_logo"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:id="@+id/tv_card_heading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:text="Welcome back!"
                        android:textColor="@color/white"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/tv_card_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:alpha="0.6"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:gravity="center"
                        android:text="Sign in to your account"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                    <!-- Inputs with Samsung Blue Accents -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_server_url"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="Server URL"
                        android:textColorHint="#80FFFFFF"
                        app:boxBackgroundColor="#0DFFFFFF"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="#3B82F6"
                        app:boxStrokeWidthFocused="2dp"
                        app:startIconDrawable="@drawable/ic_dns"
                        app:startIconTint="#60A5FA">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_server_url"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:imeOptions="actionNext"
                            android:inputType="textUri"
                            android:nextFocusDown="@id/et_username"
                            android:nextFocusUp="@id/et_server_url"
                            android:paddingVertical="10dp"
                            android:textColor="@color/white"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_username"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="Username or Email"
                        android:textColorHint="#80FFFFFF"
                        app:boxBackgroundColor="#0DFFFFFF"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="#3B82F6"
                        app:boxStrokeWidthFocused="2dp"
                        app:startIconDrawable="@drawable/ic_person"
                        app:startIconTint="#60A5FA">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_username"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:imeOptions="actionNext"
                            android:inputType="text"
                            android:nextFocusDown="@id/et_password"
                            android:nextFocusUp="@id/et_server_url"
                            android:paddingVertical="10dp"
                            android:textColor="@color/white"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_password"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:hint="Password"
                        android:textColorHint="#80FFFFFF"
                        app:boxBackgroundColor="#0DFFFFFF"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxStrokeColor="#3B82F6"
                        app:boxStrokeWidthFocused="2dp"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/white"
                        app:startIconDrawable="@drawable/ic_lock"
                        app:startIconTint="#60A5FA">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:imeOptions="actionDone"
                            android:inputType="textPassword"
                            android:nextFocusDown="@id/btn_login"
                            android:nextFocusUp="@id/et_username"
                            android:paddingVertical="10dp"
                            android:textColor="@color/white"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_login"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/btn_login_samsung_gradient"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:textStyle="bold"
                        android:text="Sign In"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:nextFocusDown="@id/btn_setup_phone"
                        android:nextFocusUp="@id/et_password"
                        app:backgroundTint="@null"
                        app:cornerRadius="12dp" />

                    <!-- Divider -->
                    <LinearLayout
                        android:id="@+id/ll_or_divider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="12dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0.5dp"
                            android:layout_weight="1"
                            android:alpha="0.15"
                            android:background="@color/white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="10dp"
                            android:alpha="0.4"
                            android:text="OR"
                            android:textColor="@color/white"
                            android:textSize="10sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0.5dp"
                            android:layout_weight="1"
                            android:alpha="0.15"
                            android:background="@color/white" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_setup_phone"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:textStyle="bold"
                        android:text="Sign in with QR Code"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:nextFocusDown="@id/btn_setup_phone"
                        android:nextFocusUp="@id/btn_login"
                        app:strokeColor="#26FFFFFF"
                        app:strokeWidth="1dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:indeterminateTint="#3B82F6"
                android:visibility="gone" />

            <View android:id="@+id/panel_right" android:layout_width="0dp" android:layout_height="0dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>
