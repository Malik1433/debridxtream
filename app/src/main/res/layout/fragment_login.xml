<?xml version="1.0" encoding="utf-8"?>
<!--
  PHONE Login — portrait.

  The television version (layout-television/) is a two-panel screen: branding on the left, the
  card on the right, sized to be read across a room. Neither panel fits a 411dp handset, so this
  keeps every id and stacks them: logo and title, then the three fields, then the primary button
  and the two alternatives. The decorative blobs, scanline and grid are gone stubs — atmosphere
  for a 55-inch screen, noise on a phone.

  The QR and account overlays cover the whole screen here rather than floating over a panel.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/phone_home_bg">

    <!-- Television atmosphere, kept only so the shared code can find them. -->
    <View android:id="@+id/view_blob_1" android:layout_width="0dp" android:layout_height="0dp" />
    <View android:id="@+id/view_blob_2" android:layout_width="0dp" android:layout_height="0dp" />
    <View android:id="@+id/view_blob_3" android:layout_width="0dp" android:layout_height="0dp" />
    <View android:id="@+id/view_scanline" android:layout_width="0dp" android:layout_height="0dp" />
    <View android:id="@+id/view_grid" android:layout_width="0dp" android:layout_height="0dp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingHorizontal="24dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="40dp"
            android:paddingBottom="32dp">

            <FrameLayout
                android:id="@+id/panel_left"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/ll_title_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/iv_logo"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:contentDescription="@null"
                        android:src="@mipmap/ic_launcher_foreground" />

                    <TextView
                        android:id="@+id/tv_welcome_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/outfit_extrabold"
                        android:letterSpacing="-0.02"
                        android:text="@string/app_title"
                        android:textColor="@color/phone_text_primary"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/tv_login_tagline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/inter_regular"
                        android:gravity="center"
                        android:textColor="@color/phone_text_secondary"
                        android:textSize="13sp"
                        tools:text="Sign in to your provider" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/panel_right"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">

                <LinearLayout
                    android:id="@+id/card_login_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_card_heading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/outfit_bold"
                        android:textColor="@color/phone_text_primary"
                        android:text="@string/ui_sign_in"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tv_card_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_regular"
                        android:textColor="@color/phone_text_secondary"
                        android:text="@string/ui_enter_your_xtream_credentials_to"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/ll_login_fields"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_label_server"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/share_tech_mono"
                    android:letterSpacing="0.1"
                    android:text="@string/ui_server_url"
                    android:textColor="@color/phone_text_muted"
                    android:textSize="11.5sp" />

                <LinearLayout
                    android:id="@+id/til_server_url"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_phone_search_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:id="@+id/iv_icon_server"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_dns"
                        app:tint="@color/phone_cyan" />

                    <EditText
                        android:id="@+id/et_server_url"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="@font/inter_regular"
                        android:hint="@string/ui_http_server_example_tv"
                        android:importantForAutofill="no"
                        android:inputType="textUri"
                        android:maxLines="1"
                        android:textColor="@color/phone_text_primary"
                        android:textColorHint="@color/phone_text_muted"
                        android:textSize="14sp"
                        tools:ignore="LabelFor" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_label_username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/share_tech_mono"
                    android:letterSpacing="0.1"
                    android:text="@string/ui_username"
                    android:textColor="@color/phone_text_muted"
                    android:textSize="11.5sp" />

                <LinearLayout
                    android:id="@+id/til_username"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_phone_search_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:id="@+id/iv_icon_username"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_person_placeholder"
                        app:tint="@color/phone_cyan" />

                    <EditText
                        android:id="@+id/et_username"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="@font/inter_regular"
                        android:hint="@string/login_username_hint"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="@color/phone_text_primary"
                        android:textColorHint="@color/phone_text_muted"
                        android:textSize="14sp"
                        tools:ignore="LabelFor" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_label_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/share_tech_mono"
                    android:letterSpacing="0.1"
                    android:text="@string/ui_password"
                    android:textColor="@color/phone_text_muted"
                    android:textSize="11.5sp" />

                <LinearLayout
                    android:id="@+id/til_password"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_phone_search_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:id="@+id/iv_icon_password"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/phone_cyan" />

                    <EditText
                        android:id="@+id/et_password"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="@font/inter_regular"
                        android:hint="@string/login_password_hint"
                        android:importantForAutofill="no"
                        android:inputType="textPassword"
                        android:maxLines="1"
                        android:textColor="@color/phone_text_primary"
                        android:textColorHint="@color/phone_text_muted"
                        android:textSize="14sp"
                        tools:ignore="LabelFor" />

                    <ImageView
                        android:id="@+id/btn_toggle_password"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/ui_show_password"
                        android:padding="12dp"
                        android:src="@drawable/ic_eye"
                        app:tint="@color/phone_text_muted" />

                </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_login_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_phone_card"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/tv_login_error"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_regular"
                            android:lineSpacingMultiplier="1.4"
                            android:textColor="@color/phone_amber"
                            android:textSize="12.5sp"
                            tools:text="Could not reach that server." />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_login"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_phone_primary_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iv_login_play"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_stremio_play"
                            app:tint="@color/phone_on_accent" />

                        <ProgressBar
                            android:id="@+id/progress_bar"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:indeterminateTint="@color/phone_on_accent"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tv_login_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/outfit_bold"
                            android:text="@string/ui_sign_in"
                            android:textColor="@color/phone_on_accent"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_or_divider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_or_divider"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/share_tech_mono"
                            android:letterSpacing="0.12"
                            android:textColor="@color/phone_text_muted"
                            android:textSize="11.5sp"
                            tools:text="OR" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_setup_phone"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_phone_action"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_smartphone"
                            app:tint="@color/phone_cyan" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/outfit_semibold"
                            android:text="@string/ui_connect_via_phone_qr"
                            android:textColor="@color/phone_text_primary"
                            android:textSize="13.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_account_signin"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_phone_action"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/outfit_semibold"
                            android:text="@string/ui_sign_in_with_your_account"
                            android:textColor="@color/phone_text_primary"
                            android:textSize="13.5sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_login_device_key"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/share_tech_mono"
                        android:gravity="center"
                        android:letterSpacing="0.1"
                        android:textColor="@color/phone_text_muted"
                        android:textSize="11.5sp"
                        tools:text="KEY · KZWM-AJHV" />

                    <TextView
                        android:id="@+id/tv_login_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/inter_regular"
                        android:gravity="center"
                        android:textColor="@color/phone_text_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_login_version"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/share_tech_mono"
                        android:gravity="center"
                        android:letterSpacing="0.1"
                        android:textColor="@color/phone_text_muted"
                        android:textSize="11sp"
                        tools:text="v2.6.6" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ══ QR PAIRING ══ full screen on a phone rather than a panel overlay. -->
    <FrameLayout
        android:id="@+id/qr_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/phone_home_bg"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <ImageView
                android:id="@+id/iv_qr_code"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:background="@color/white"
                android:contentDescription="@string/a11y_qr"
                android:padding="8dp" />

            <TextView
                android:id="@+id/tv_qr_dx_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/share_tech_mono"
                android:letterSpacing="0.12"
                android:textColor="@color/phone_cyan"
                android:textSize="12sp"
                tools:text="DX PLAY" />

            <View
                android:id="@+id/view_qr_scanline"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <LinearLayout
                android:id="@+id/ll_pairing_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/view_qr_pulse_dot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_phone_dot" />

                <TextView
                    android:id="@+id/tv_pairing_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/share_tech_mono"
                    android:letterSpacing="0.15"
                    android:maxLines="1"
                    android:textColor="@color/phone_text_primary"
                    android:textSize="26sp"
                    tools:text="KZWM-AJHV" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_qr_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/inter_regular"
                android:gravity="center"
                android:lineSpacingMultiplier="1.4"
                android:textColor="@color/phone_text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/btn_qr_close"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_phone_action"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit_semibold"
                    android:text="@string/phone_close"
                    android:textColor="@color/phone_text_primary"
                    android:textSize="13.5sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- ══ ACCOUNT SIGN-IN ══ -->
    <FrameLayout
        android:id="@+id/account_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/phone_home_bg"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <TextView
                android:id="@+id/tv_account_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:textColor="@color/phone_text_secondary"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/et_account_email"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_phone_search_field"
                android:fontFamily="@font/inter_regular"
                android:hint="@string/ui_email"
                android:importantForAutofill="no"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:textColor="@color/phone_text_primary"
                android:textColorHint="@color/phone_text_muted"
                android:textSize="14sp"
                tools:ignore="LabelFor" />

            <EditText
                android:id="@+id/et_account_password"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_phone_search_field"
                android:fontFamily="@font/inter_regular"
                android:hint="@string/ui_password"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:textColor="@color/phone_text_primary"
                android:textColorHint="@color/phone_text_muted"
                android:textSize="14sp"
                tools:ignore="LabelFor" />

            <TextView
                android:id="@+id/tv_account_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/inter_regular"
                android:textColor="@color/phone_amber"
                android:textSize="12.5sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/btn_account_submit"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_phone_primary_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_account_submit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit_bold"
                    android:textColor="@color/phone_on_accent"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tv_account_signup_url"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit_semibold"
                    android:text="@string/c_create_account"
                    android:textColor="@color/phone_cyan"
                    android:textSize="13.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_account_close"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_phone_action"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit_semibold"
                    android:text="@string/phone_close"
                    android:textColor="@color/phone_text_primary"
                    android:textSize="13.5sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
