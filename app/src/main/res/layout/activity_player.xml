<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true"
        app:show_buffering="when_playing"
        app:use_controller="true"
        app:animation_enabled="false"
        app:controller_layout_id="@layout/custom_player_control_view" />



    <!-- Live TV compact info bar (XCloud TV style). -->
    <include
        layout="@layout/view_player_epg_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp" />

    <!-- Cinematic Live Player OSD (LIVE_TV only) -->
    <include
        android:id="@+id/view_live_osd"
        layout="@layout/view_live_player_osd"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Reconnecting pill (QA fix 3): persistent while any recovery subsystem is
         retrying; hidden on the first rendered frame / READY. Styled to match the
         live OSD toast/conn-chip. -->
    <LinearLayout
        android:id="@+id/reconnecting_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_live_toast"
        android:elevation="11dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="11dp"
        android:paddingVertical="6.5dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="10dp"
            android:layout_height="10dp"
            style="?android:attr/progressBarStyleSmall"
            android:indeterminateTint="@color/neon_cyan" />

        <TextView
            android:id="@+id/reconnecting_banner_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.06"
            android:textColor="@color/neon_cyan"
            android:textSize="@dimen/stream_health_text_size"
            tools:text="RECONNECTING… (1/4)" />
    </LinearLayout>

    <!--
      Why playback keeps stopping. ONE pill, and it never speaks over the reconnecting one —
      diagnoseStreamHealth returns OK while that is showing, so the two cannot both be on screen.

      A statement, not a control: nothing here is focusable, so on the television it can never
      take focus from the OSD, and on a phone there is nothing to tap by mistake. It sits below
      the reconnect pill so that if the two ever did overlap the older one still reads.
    -->
    <LinearLayout
        android:id="@+id/stream_health_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="56dp"
        android:background="@drawable/bg_live_toast"
        android:elevation="11dp"
        android:focusable="false"
        android:gravity="center_vertical"
        android:maxWidth="420dp"
        android:orientation="horizontal"
        android:paddingHorizontal="11dp"
        android:paddingVertical="6.5dp"
        android:visibility="gone"
        tools:visibility="visible">

        <View
            android:id="@+id/stream_health_dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/bg_phone_dot_amber" />

        <TextView
            android:id="@+id/stream_health_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.04"
            android:textColor="@color/phone_text_primary"
            android:textSize="@dimen/stream_health_text_size"
            tools:text="THIS CHANNEL IS SLOW RIGHT NOW" />
    </LinearLayout>

    <include
        android:id="@+id/view_channel_browser"
        layout="@layout/view_player_channel_browser"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <include
        android:id="@+id/view_episode_browser"
        layout="@layout/view_player_episode_browser"
        android:layout_width="340dp"
        android:layout_height="match_parent"
        android:layout_gravity="end|center_vertical"
        android:layout_marginTop="96dp"
        android:layout_marginBottom="96dp"
        android:layout_marginEnd="26dp"
        android:visibility="gone" />

    <include
        android:id="@+id/view_next_episode_prompt"
        layout="@layout/view_next_episode_prompt"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Support QR Overlay (Hidden by default) -->
    <LinearLayout
        android:id="@+id/layout_support_qr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#E6000000"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_stream_failed"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/img_support_qr"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="16dp"
            android:background="#FFFFFF"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/a11y_support_qr" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_scan_for_support"
            android:textColor="#CCCCCC"
            android:textSize="16sp"
            android:layout_marginTop="16dp" />
    </LinearLayout>

    <!-- Cinematic loading overlay (Stremio-style): backdrop behind, zooming title,
         a subtle progress hint. Technical resolve/retry noise is hidden. -->
    <FrameLayout
        android:id="@+id/layout_debrid_resolving"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#050709"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_resolving_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:alpha="0.42"
            android:contentDescription="@null" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/cin_resolving_scrim" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="48dp"
            android:paddingEnd="48dp">

            <!-- Auto-sizing so long titles shrink to fit two lines instead of being cut,
                 and stay within bounds even while the breathing scale is applied.
                 Vertical padding + clipChildren=false give the drop shadow, font
                 descenders and the 1.05x breathing scale room so the last line is not
                 clipped from the bottom. -->
            <TextView
                android:id="@+id/tv_resolving_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:text=""
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:letterSpacing="0.01"
                android:fontFamily="@font/plus_jakarta_sans"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="8"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="22sp"
                android:autoSizeMaxTextSize="52sp"
                android:autoSizeStepGranularity="1sp" />

            <!-- Clean indeterminate loader: a cyan segment sweeps smoothly back and forth
                 WITHIN a wider rounded track (stays contained, never slides off the edges). -->
            <FrameLayout
                android:id="@+id/loader_bar_track"
                android:layout_width="240dp"
                android:layout_height="4dp"
                android:layout_marginTop="26dp"
                android:background="@drawable/cin_loader_track"
                android:clipChildren="true"
                android:clipToPadding="true">

                <View
                    android:id="@+id/loader_bar_seg"
                    android:layout_width="82dp"
                    android:layout_height="4dp"
                    android:background="@drawable/cin_loader_segment" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
    <!-- Debug Overlay (Netflix Style) -->
    <include layout="@layout/debug_overlay" />

</FrameLayout>
