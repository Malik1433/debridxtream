<?xml version="1.0" encoding="utf-8"?>
<!--
    PREMIUM CINEMATIC LIVE TV (Samsung One UI Tizen 2025 Style)
    Extends: fragment_live_3column.xml
    Design: Pitch-black background, Electric Blue accents, Glassmorphism panels.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:clipChildren="false"
    android:background="#0B0D10">

    <!-- ============ LEFT SIDEBAR (Premium Glass) ============ -->
    <LinearLayout
        android:id="@+id/sidebar_container"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="false"
        android:background="@drawable/cin_premium_sidebar_bg"
        android:paddingTop="36dp"
        android:paddingBottom="36dp">

        <!-- Branded header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:layout_marginBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_live_tv"
                android:textColor="#3B82F6"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.4"
                android:fontFamily="@font/inter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ui_discovery"
                android:textColor="#FFFFFFFF"
                android:textSize="32sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_extrabold"
                android:letterSpacing="-0.03" />

        </LinearLayout>

        <!-- Premium Search -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/cin_premium_search_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_search"
                app:tint="#B8C0CC"
                android:contentDescription="@string/search" />

            <EditText
                android:id="@+id/et_category_search"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/ui_search_categories"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:nextFocusDown="@id/rv_sidebar_categories"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#424754"
                android:textSize="15sp"
                android:fontFamily="@font/inter" />
        </LinearLayout>

        <!-- Category list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_sidebar_categories"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="12dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="true"
            android:nextFocusRight="@id/rv_channels_horizontal"
            android:nextFocusUp="@id/et_category_search" />

        <!-- Helper anchors -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:visibility="gone">
            <ImageView android:id="@+id/icon_live_tv" android:layout_width="0dp" android:layout_height="0dp"
    android:contentDescription="@null" />
            <ImageView android:id="@+id/icon_favorites" android:layout_width="0dp" android:layout_height="0dp"
    android:contentDescription="@null" />
        </LinearLayout>

    </LinearLayout>

    <!-- ============ CENTER: Channel Grid (One UI Style) ============ -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:clipChildren="false"
        android:paddingTop="36dp"
        android:paddingHorizontal="32dp"
        android:paddingBottom="36dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_category_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_popular_channels"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFFFF"
                    android:fontFamily="@font/inter_extrabold"
                    android:letterSpacing="-0.03" />

                <TextView
                    android:id="@+id/tv_channel_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/ui_148_channels"
                    android:textSize="12sp"
                    android:textColor="#3B82F6"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter"
                    android:letterSpacing="0.1" />

            </LinearLayout>

        </LinearLayout>

        <!-- Channel list -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_channels_horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:paddingTop="32dp"
                android:paddingBottom="140dp"
                android:focusable="true"
                android:nextFocusLeft="@id/rv_sidebar_categories"
                android:nextFocusRight="@id/preview_panel_container" />

            <LinearLayout
                android:id="@+id/ll_loading_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">
                <ProgressBar
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:indeterminate="true"
                    android:indeterminateTint="#3B82F6" />
                <TextView
                    android:id="@+id/tv_loading_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/ui_syncing_streams"
                    android:textSize="15sp"
                    android:textColor="#B8C0CC"
                    android:fontFamily="@font/inter" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_empty_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/ui_no_streams_found_in_this"
                android:textSize="16sp"
                android:textColor="#424754"
                android:fontFamily="@font/inter"
                android:visibility="gone" />
        </FrameLayout>

    </LinearLayout>

    <!-- ============ RIGHT: Premium Preview Panel ============ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/preview_panel_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:background="#12161C"
        android:clipChildren="false"
        android:elevation="8dp"
        android:paddingTop="32dp"
        android:paddingHorizontal="24dp"
        android:paddingBottom="36dp">

        <!-- Top Status Bar -->
        <LinearLayout
            android:id="@+id/preview_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="24dp"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_current_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:45"
                android:textSize="16sp"
                android:textColor="#FFFFFFFF"
                android:fontFamily="@font/inter"
                android:layout_marginEnd="16dp" />

            <ImageView
                android:id="@+id/iv_weather_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_weather_cloud"
                app:tint="#3B82F6"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/live_preview_weather_icon" />

            <TextView
                android:id="@+id/tv_weather"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ui_mostly_cloudy_24_c"
                android:textSize="14sp"
                android:textColor="#B8C0CC"
                android:fontFamily="@font/inter" />

            <ImageView
                android:id="@+id/btn_preview_search"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_search"
                app:tint="#FFFFFFFF"
                android:padding="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/cin_premium_icon_btn"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusLeft="@id/rv_channels_horizontal"
                android:contentDescription="@string/a11y_search" />

            <ImageView
                android:id="@+id/btn_profile"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="#FFFFFFFF"
                android:background="@drawable/cin_premium_icon_btn"
                android:padding="12dp"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusLeft="@id/rv_channels_horizontal"
                android:contentDescription="@string/a11y_profile" />
        </LinearLayout>

        <!-- Preview Player Frame -->
        <FrameLayout
            android:id="@+id/preview_video_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:background="#000000"
            android:clipToOutline="true"
            app:layout_constraintTop_toBottomOf="@id/preview_top_bar"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.media3.ui.PlayerView
                android:id="@+id/preview_player_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:use_controller="false"
                app:surface_type="texture_view" />

            <!-- Info Overlay (Premium Gradient) -->
            <LinearLayout
                android:id="@+id/preview_info_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:paddingTop="64dp"
                android:paddingHorizontal="24dp"
                android:paddingBottom="24dp"
                android:background="@drawable/cin_premium_preview_scrim">

                <TextView
                    android:id="@+id/tv_preview_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_astra_news_global"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFFFF"
                    android:fontFamily="@font/inter_extrabold"
                    android:letterSpacing="-0.02"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_preview_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/ui_breaking_news_and_in_depth"
                    android:textSize="14sp"
                    android:textColor="#B8C0CC"
                    android:fontFamily="@font/inter"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:lineSpacingMultiplier="1.2" />

                <!-- Premium Progress Bar -->
                <ProgressBar
                    android:id="@+id/preview_progress_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="16dp"
                    android:max="100"
                    android:progress="45"
                    android:progressDrawable="@drawable/cin_premium_progress_bar" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/tv_current_time_preview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12:00"
                        android:textSize="12sp"
                        android:textColor="#3B82F6"
                        android:fontFamily="@font/inter" />
                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                    <TextView
                        android:id="@+id/tv_total_time_preview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="13:00"
                        android:textSize="12sp"
                        android:textColor="#B8C0CC"
                        android:fontFamily="@font/inter" />
                </LinearLayout>

                <!-- Premium Action Chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="20dp">

                    <TextView
                        android:id="@+id/btn_favorite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_favorite"
                        android:textColor="#FFFFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/inter"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="10dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/cin_premium_action_btn"
                        android:focusable="true"
                        android:clickable="true"
                        android:nextFocusLeft="@id/rv_channels_horizontal" />

                    <TextView
                        android:id="@+id/btn_epg_next"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_epg_guide"
                        android:textColor="#FFFFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/inter"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="10dp"
                        android:background="@drawable/cin_premium_action_btn"
                        android:focusable="true"
                        android:clickable="true"
                        android:nextFocusLeft="@id/rv_channels_horizontal" />
                </LinearLayout>

            </LinearLayout>

            <!-- Floating Fullscreen Action -->
            <ImageView
                android:id="@+id/btn_fullscreen"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="top|end"
                android:layout_margin="20dp"
                android:src="@android:drawable/ic_menu_crop"
                app:tint="#FFFFFFFF"
                android:background="@drawable/cin_premium_icon_btn_floating"
                android:padding="12dp"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusLeft="@id/rv_channels_horizontal"
                android:contentDescription="@string/a11y_fullscreen" />

            <FrameLayout
                android:id="@+id/preview_loading_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#12161C"
                android:visibility="gone">
                <ProgressBar
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="#3B82F6" />
            </FrameLayout>

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
