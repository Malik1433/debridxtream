<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="196dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginEnd="12dp"
    android:focusable="true"
    android:focusableInTouchMode="@bool/rows_focusable_in_touch_mode"
    android:clickable="true">

    <androidx.cardview.widget.CardView
        android:layout_width="196dp"
        android:layout_height="110dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#0A101C">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Thumbnail -->
            <ImageView
                android:id="@+id/iv_cw_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <!-- Bottom overlay -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:background="#B3000000"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_cw_time_left"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="45m LEFT"
                        android:textColor="@color/vod_text_muted"
                        android:textSize="10sp"
                        android:fontFamily="monospace" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RESUME ▶"
                        android:textColor="@color/vod_accent_cyan"
                        android:textSize="10sp"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <!-- Progress bar -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="4dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#1EFFFFFF" />

                    <View
                        android:id="@+id/v_cw_progress"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_progress_fill" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- Title below card -->
    <TextView
        android:id="@+id/tv_cw_title"
        android:layout_width="196dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Movie Title"
        android:textColor="@color/vod_text_secondary"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:singleLine="true"
        android:ellipsize="end" />
</LinearLayout>
