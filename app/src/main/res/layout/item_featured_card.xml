<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="200dp"
    android:layout_height="112dp"
    android:layout_marginEnd="12dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    android:foreground="@drawable/card_focus_enhanced">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Featured Image/Backdrop -->
        <ImageView
            android:id="@+id/iv_featured_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@string/poster"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Gradient Overlay for Text Readability -->
        <View
            android:id="@+id/gradient_overlay"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@drawable/gradient_overlay_bottom"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Featured Title -->
        <TextView
            android:id="@+id/tv_featured_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Featured Content Title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:shadowColor="@color/shadow_color"
            android:shadowRadius="8"
            android:shadowDx="2"
            android:shadowDy="2"
            android:maxLines="2"
            android:ellipsize="end"
            android:padding="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>

