<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:focusable="true"
    android:clickable="true"
    android:padding="8dp">

    <!-- Focus Border Overlay (Required by Adapter) -->
    <View
        android:id="@+id/v_focus_border"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/border_focus_white"
        android:visibility="invisible"
        app:layout_constraintTop_toTopOf="@id/cv_thumb"
        app:layout_constraintBottom_toBottomOf="@id/cv_thumb"
        app:layout_constraintStart_toStartOf="@id/cv_thumb"
        app:layout_constraintEnd_toEndOf="@id/cv_thumb"
        android:translationZ="10dp"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_thumb"
        android:layout_width="0dp"
        android:layout_height="146dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_episode_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            tools:src="@tools:sample/backgrounds/scenic"
            android:contentDescription="Episode Thumbnail" />
            
        <ImageView
            android:id="@+id/iv_play_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_media_play"
            app:tint="#FFFFFF"
            android:alpha="0.8"/>
            
         <TextView
            android:id="@+id/tv_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            tools:text="45m"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:background="#AA000000"
            android:padding="4dp"
            android:layout_margin="4dp"/>

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tv_episode_number"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="Episode 1"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/cv_thumb"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="Pilot"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/tv_episode_number"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tv_plot"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="No description"
        android:textColor="#888888"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
