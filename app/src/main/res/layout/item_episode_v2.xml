<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:clickable="true"
    android:padding="6dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Focus Border Glow (Blue) -->
    <View
        android:id="@+id/v_focus_border"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_episode_focus_glow"
        android:visibility="invisible"
        app:layout_constraintTop_toTopOf="@id/cv_thumb"
        app:layout_constraintBottom_toBottomOf="@id/cv_thumb"
        app:layout_constraintStart_toStartOf="@id/cv_thumb"
        app:layout_constraintEnd_toEndOf="@id/cv_thumb"
        android:translationZ="2dp"/>

    <!-- Watched Checkmark (Top Right) -->
    <ImageView
        android:id="@+id/iv_watched_indicator"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:padding="6dp"
        android:src="@drawable/ic_check_circle"
        app:tint="@android:color/white"
        android:background="@drawable/bg_watched_badge"
        android:clickable="false"
        android:focusable="false"
        android:elevation="6dp"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintTop_toTopOf="@id/cv_thumb"
        app:layout_constraintEnd_toEndOf="@id/cv_thumb"
        android:translationZ="4dp"
        android:contentDescription="@string/a11y_watched" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_thumb"
        android:layout_width="match_parent"
        android:layout_height="146dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#1A1F29"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_episode_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            tools:src="@tools:sample/backgrounds/scenic"
            android:contentDescription="@null" />

        <!-- Episode Badge (Top Left) -->
        <TextView
            android:id="@+id/tv_episode_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="16dp"
            android:background="@drawable/bg_episode_badge"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="@font/inter"
            tools:text="E01" />

        <!-- Removed iv_watched_indicator from inside CardView -->

        <!-- Gradient Overlay -->
        <View
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_episode_overlay" />

        <!-- Footer Content -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:padding="12dp">

            <LinearLayout
                android:id="@+id/ll_text_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/iv_play_card"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="The Name of the Game" />

                <TextView
                    android:id="@+id/tv_duration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Episode 1 • 62 min • When a Supe..." />
            </LinearLayout>

            <ImageView
                android:id="@+id/iv_play_card"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/bg_episode_play_circle"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:contentDescription="@string/a11y_play" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Hidden IDs for logic -->
        <TextView android:id="@+id/tv_plot" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
