<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_sidebar_container"
    android:layout_width="@dimen/home_nav_rail_width"
    android:layout_height="match_parent"
    android:background="@drawable/bg_nav_rail"
    android:paddingTop="11dp"
    android:paddingBottom="11dp"
    android:elevation="16dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Logo mark "DX" -->
    <FrameLayout
        android:id="@+id/sidebar_header"
        android:layout_width="@dimen/home_nav_header_size"
        android:layout_height="@dimen/home_nav_header_size"
        android:background="@drawable/bg_logo_mark"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- The real mark, not "DX" set as text: the login screen already shows the artwork, and
             two different logos in one app is one too many. contentDescription is @null — it is
             decoration beside a nav rail whose items name themselves. -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_brand_tile" />
    </FrameLayout>

    <!-- Magnetic sliding highlight capsule (behind nav icons) -->
    <View
        android:id="@+id/sidebar_capsule"
        android:layout_width="@dimen/home_nav_item_width"
        android:layout_height="@dimen/home_nav_item_height"
        android:background="@drawable/bg_nav_item_focused"
        android:alpha="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Main navigation list (icon-only, flyout labels) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_sidebar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/home_nav_list_margin_top"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="@dimen/home_nav_item_inset"
        android:paddingEnd="@dimen/home_nav_item_inset"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/sidebar_header"
        app:layout_constraintBottom_toTopOf="@id/sidebar_settings_divider"
        app:layout_constraintVertical_bias="0" />

    <!-- Divider before settings -->
    <View
        android:id="@+id/sidebar_settings_divider"
        android:layout_width="28dp"
        android:layout_height="1dp"
        android:layout_marginBottom="8dp"
        android:background="#14FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/sidebar_settings_item" />

    <!-- Settings -->
    <include
        android:id="@+id/sidebar_settings_item"
        layout="@layout/item_sidebar_nav"
        android:layout_width="0dp"
        android:layout_height="@dimen/home_nav_item_height"
        android:layout_marginStart="@dimen/home_nav_item_inset"
        android:layout_marginEnd="@dimen/home_nav_item_inset"
        android:layout_marginBottom="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/sidebar_profile_mark" />

    <!-- Profile mark -->
    <FrameLayout
        android:id="@+id/sidebar_profile_mark"
        android:layout_width="@dimen/home_nav_profile_size"
        android:layout_height="@dimen/home_nav_profile_size"
        android:background="@drawable/bg_profile_mark"
        android:focusable="true"
        android:focusableInTouchMode="@bool/rows_focusable_in_touch_mode"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- "A" is only a design-time placeholder: the real initial comes from the signed-in
             account (or the Xtream username) at bind time. It used to be a literal, so every
             user in the world saw someone else's letter. -->
        <TextView
            android:id="@+id/sidebar_profile_initial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="@font/plus_jakarta_sans"
            android:includeFontPadding="false"
            tools:text="A" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
