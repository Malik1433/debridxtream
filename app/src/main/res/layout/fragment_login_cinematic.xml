<?xml version="1.0" encoding="utf-8"?>
<!--
    CINEMATIC LOGIN
    Replaces: fragment_login.xml
    Preserves IDs: panel_left, panel_right, iv_logo, tv_welcome_title,
      tv_card_heading, til_server_url/username/password,
      et_server_url/username/password, btn_login, btn_setup_phone,
      tv_or_divider, progress_bar
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:background="@drawable/cin_bg_app">

    <!-- LEFT BRANDING (45%) -->
    <FrameLayout
        android:id="@+id/panel_left"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.45">

        <!-- Ambient gold bloom -->
        <ImageView
            android:layout_width="700dp"
            android:layout_height="700dp"
            android:layout_gravity="center"
            android:src="@drawable/cin_bloom_gold"
            android:alpha="0.7" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/cin_vignette_radial" />

        <LinearLayout
            android:id="@+id/ll_title_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="@dimen/cin_space_12">

            <ImageView
                android:id="@+id/iv_logo"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/cin_logo_mark"
                android:contentDescription="@string/app_name" />

            <ImageView
                android:layout_width="240dp"
                android:layout_height="60dp"
                android:layout_marginTop="@dimen/cin_space_6"
                android:src="@drawable/cin_logo_wordmark"
                android:adjustViewBounds="true"
                android:contentDescription="Derbix TV" />

            <TextView
                android:id="@+id/tv_welcome_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cin_space_4"
                android:text="Cinematic streaming, untethered"
                android:textColor="@color/cin_text_secondary"
                android:textSize="@dimen/cin_text_body"
                android:fontFamily="@font/plus_jakarta_sans"
                android:letterSpacing="0.02" />

            <View
                android:layout_width="48dp"
                android:layout_height="3dp"
                android:layout_marginTop="@dimen/cin_space_8"
                android:background="@color/cin_gold_500" />

        </LinearLayout>
    </FrameLayout>

    <!-- RIGHT FORM (55%) -->
    <FrameLayout
        android:id="@+id/panel_right"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.55"
        android:background="@color/cin_ink_900">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/card_login_container"
                android:layout_width="420dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginVertical="@dimen/cin_space_8"
                android:orientation="vertical"
                android:background="@drawable/cin_card_glass"
                android:padding="@dimen/cin_space_8">

                <TextView
                    android:id="@+id/tv_card_heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sign in"
                    android:textColor="@color/cin_text_primary"
                    android:textSize="@dimen/cin_text_title"
                    android:fontFamily="@font/inter_extrabold"
                    android:letterSpacing="-0.01" />

                <TextView
                    android:id="@+id/tv_card_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cin_space_2"
                    android:text="Enter your IPTV provider credentials"
                    android:textColor="@color/cin_text_tertiary"
                    android:textSize="@dimen/cin_text_caption"
                    android:fontFamily="@font/plus_jakarta_sans" />

                <LinearLayout
                    android:id="@+id/ll_login_fields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cin_space_6"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_server_url"
                        style="@style/Cin.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Server URL"
                        app:startIconDrawable="@drawable/ic_dns">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_server_url"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri"
                            android:textColor="@color/cin_text_primary"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:nextFocusDown="@id/et_username" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_username"
                        style="@style/Cin.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cin_space_3"
                        android:hint="Username"
                        app:startIconDrawable="@drawable/ic_person">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_username"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/cin_text_primary"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:nextFocusDown="@id/et_password" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_password"
                        style="@style/Cin.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cin_space_3"
                        android:hint="Password"
                        app:startIconDrawable="@drawable/ic_lock"
                        app:endIconMode="password_toggle">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textColor="@color/cin_text_primary"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:imeOptions="actionDone"
                            android:nextFocusDown="@id/btn_login" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_login"
                    style="@style/Cin.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cin_btn_h_lg"
                    android:layout_marginTop="@dimen/cin_space_6"
                    android:text="Sign in" />

                <LinearLayout
                    android:id="@+id/ll_or_divider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cin_space_5"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/cin_stroke_subtle" />
                    <TextView
                        android:id="@+id/tv_or_divider"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/cin_space_4"
                        android:text="or"
                        android:textColor="@color/cin_text_tertiary"
                        android:textSize="@dimen/cin_text_caption"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:letterSpacing="0.18"
                        android:textAllCaps="true" />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="@color/cin_stroke_subtle" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_setup_phone"
                    style="@style/Cin.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/cin_btn_h"
                    android:layout_marginTop="@dimen/cin_space_4"
                    android:text="Pair with phone (QR)"
                    app:icon="@drawable/ic_search"
                    app:iconTint="@color/cin_gold_300"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp" />

                <ProgressBar
                    android:id="@+id/progress_bar"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/cin_space_5"
                    android:indeterminateTint="@color/cin_gold_500"
                    android:visibility="gone" />

            </LinearLayout>
        </ScrollView>
    </FrameLayout>

</LinearLayout>
