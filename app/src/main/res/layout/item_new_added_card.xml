<?xml version="1.0" encoding="utf-8"?>
<!-- New Added Content Card - Glass Effect Design -->
<FrameLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_container"
    android:layout_width="110dp"
    android:layout_height="160dp"
    android:layout_marginEnd="12dp"
    android:focusable="true"
    android:clickable="true"
    android:background="@drawable/glass_card_selector"
    android:elevation="8dp">

    <!-- Subtle Glass Overlay - MI IPTV Style (10% white) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1AFFFFFF" />

    <!-- Content Container with More Padding -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp">

        <!-- Poster Image -->
        <ImageView
            android:id="@+id/iv_poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@string/poster"
            android:alpha="0.9"
            tools:src="@android:color/darker_gray" />

        <!-- NEW Badge - Top Left -->
        <TextView
            android:id="@+id/tv_new_badge"
            android:layout_width="@dimen/badge_new_width"
            android:layout_height="@dimen/badge_new_height"
            android:layout_gravity="top|start"
            android:layout_margin="@dimen/badge_new_margin"
            android:background="@drawable/badge_bg_new"
            android:gravity="center"
            android:text="@string/new_badge"
            android:textColor="@color/badge_text"
            android:textSize="@dimen/text_badge"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05"
            android:elevation="4dp" />

        <!-- Bottom Gradient Overlay -->
        <View
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_gravity="bottom"
            android:background="@drawable/gradient_card_overlay" />

        <!-- Title Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:padding="@dimen/content_card_padding">

            <!-- Title -->
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ds_text_primary"
                android:textSize="@dimen/text_card_title"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Movie Title Here" />

            <!-- Metadata -->
            <TextView
                android:id="@+id/tv_metadata"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/ds_text_secondary"
                android:textSize="@dimen/text_card_subtitle"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="2024 | HD" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>

