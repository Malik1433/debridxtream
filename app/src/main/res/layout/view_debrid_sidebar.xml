<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sidebar_container"
    android:layout_width="84dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_debrid_source_item"
    android:elevation="14dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="false">

    <!-- Navigation Items Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="10dp"
        android:paddingTop="12dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp">

        <!-- Legacy brand retained hidden so existing bindings stay safe. -->
        <TextView
            android:id="@+id/sidebar_brand_logo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STREAM\nFLIX"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/plus_jakarta_sans"
            android:gravity="center"
            android:layout_marginBottom="32dp"
            android:visibility="gone"
            android:letterSpacing="0.05" />

        <!-- Primary Navigation Items -->
        <include
            android:id="@+id/nav_item_search"
            layout="@layout/item_debrid_sidebar" />

        <include
            android:id="@+id/nav_item_discover"
            layout="@layout/item_debrid_sidebar"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</FrameLayout>
