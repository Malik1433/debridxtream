<?xml version="1.0" encoding="utf-8"?>
<!--
    CINEMATIC PLAYER CONTROLS
    Replaces: custom_player_control_view.xml
    Preserves IDs: exo_play_pause_center, layout_bottom_panel,
      tv_player_title, tv_player_subtitle, exo_position, exo_progress,
      exo_duration, btn_player_shuffle, exo_rew, exo_play, exo_pause,
      exo_ffwd, btn_aspect_ratio, btn_next_episode
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Center play/pause indicator (gold puck) -->
    <ImageButton
        android:id="@+id/exo_play_pause_center"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="@drawable/cin_player_play_circle"
        android:padding="26dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_play_arrow_24"
        android:visibility="gone"
        android:elevation="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#1A1108" />

    <!-- Bottom control panel -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_bottom_panel"
        android:layout_width="780dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:background="@drawable/cin_player_glass_panel"
        android:padding="28dp"
        android:elevation="20dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Top row: NOW PLAYING overline + title + subtitle -->
        <TextView
            android:id="@+id/tv_now_playing_overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NOW PLAYING"
            android:textColor="#FFC9A961"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.32"
            android:fontFamily="@font/plus_jakarta_sans"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_player_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#FFFFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="@font/inter_extrabold"
            android:letterSpacing="-0.02"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_now_playing_overline"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Scream  ·  S02 E01" />

        <TextView
            android:id="@+id/tv_player_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="#80FFFFFF"
            android:textSize="13sp"
            android:fontFamily="@font/plus_jakarta_sans"
            android:letterSpacing="0.04"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_player_title"
            tools:text="Movie · Real-Debrid · 4K HDR" />

        <!-- Position / progress / duration row -->
        <TextView
            android:id="@+id/exo_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/inter_extrabold"
            android:letterSpacing="0.04"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/exo_progress"
            app:layout_constraintBottom_toBottomOf="@id/exo_progress"
            tools:text="00:01" />

        <com.tvonnet.debridxtreamiptv.ui.custom.WavySeekBar
            android:id="@+id/exo_progress"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="22dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:focusable="true"
            app:layout_constraintTop_toBottomOf="@id/tv_player_subtitle"
            app:layout_constraintStart_toEndOf="@id/exo_position"
            app:layout_constraintEnd_toStartOf="@id/exo_duration" />

        <TextView
            android:id="@+id/exo_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#80FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/inter_extrabold"
            android:letterSpacing="0.04"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/exo_progress"
            app:layout_constraintBottom_toBottomOf="@id/exo_progress"
            tools:text="00:30" />

        <!-- Control buttons strip -->
        <LinearLayout
            android:id="@+id/control_strip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/exo_progress">

            <!-- Settings -->
            <ImageButton
                android:id="@+id/btn_player_shuffle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/cin_player_btn_glass_circle"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings"
                android:focusable="true"
                android:clickable="true"
                app:tint="#FFC9A961"
                android:contentDescription="Settings" />

            <!-- Rewind -->
            <ImageButton
                android:id="@+id/exo_rew"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="20dp"
                android:background="@drawable/cin_player_btn_glass_circle"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_rewind"
                android:focusable="true"
                android:clickable="true"
                app:tint="#FFFFFFFF"
                android:contentDescription="Rewind" />

            <!-- Play / Pause (gold focusable hero button) -->
            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginStart="20dp"
                android:elevation="6dp">

                <ImageButton
                    android:id="@+id/exo_play"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/cin_player_btn_play_focusable"
                    android:padding="18dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_play_arrow_24"
                    android:focusable="true"
                    android:clickable="true"
                    app:tint="#1A1108"
                    android:contentDescription="Play" />

                <ImageButton
                    android:id="@+id/exo_pause"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/cin_player_btn_play_focusable"
                    android:padding="18dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_pause"
                    android:focusable="true"
                    android:clickable="true"
                    android:visibility="gone"
                    app:tint="#1A1108"
                    android:contentDescription="Pause" />
            </FrameLayout>

            <!-- Forward -->
            <ImageButton
                android:id="@+id/exo_ffwd"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="20dp"
                android:background="@drawable/cin_player_btn_glass_circle"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_forward"
                android:focusable="true"
                android:clickable="true"
                app:tint="#FFFFFFFF"
                android:contentDescription="Fast forward" />

            <!-- Aspect Ratio -->
            <ImageButton
                android:id="@+id/btn_aspect_ratio"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="20dp"
                android:background="@drawable/cin_player_btn_glass_circle"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_aspect_ratio"
                android:focusable="true"
                android:clickable="true"
                app:tint="#FFFFFFFF"
                android:contentDescription="Aspect ratio" />

            <!-- Next Episode (hidden by default — PlayerActivity toggles) -->
            <ImageButton
                android:id="@+id/btn_next_episode"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="20dp"
                android:background="@drawable/cin_player_btn_glass_circle"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_skip_next"
                android:focusable="true"
                android:clickable="true"
                android:visibility="gone"
                app:tint="#FFFFFFFF"
                android:contentDescription="Next episode" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
