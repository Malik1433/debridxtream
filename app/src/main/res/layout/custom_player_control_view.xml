<?xml version="1.0" encoding="utf-8"?>
<!--
  VOD Player redesign (VOD Player.dc.html). Clean cinematic glass controller.
  Device is 320dpi (2x) -> design px HALVED to dp. Icon-only buttons for a clean, uncluttered row.
  All existing R.id.* preserved; adds btn_prev_episode + btn_episodes.
  NOTE: exo_rew/exo_ffwd must stay ImageButton (media3 casts them to ImageView).
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cin_player_overlay"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- ══════ TOP BAR ══════ -->
    <LinearLayout
        android:id="@+id/layout_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        android:paddingTop="20dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_stremio_chevron_left"
            android:tint="@color/stremio_text_muted"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_player_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:textColor="@color/stremio_text_primary"
                android:textSize="13sp"
                tools:text="Kara" />
            <TextView
                android:id="@+id/tv_player_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:fontFamily="sans-serif"
                android:textColor="@color/stremio_text_muted"
                android:textSize="9sp"
                tools:text="Movie" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_player_quality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_vodp_quality_pill"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="#041014"
            android:textSize="8sp"
            android:visibility="gone"
            tools:text="1080p"
            tools:visibility="visible" />

        <TextClock
            android:id="@+id/tv_player_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm a"
            android:format24Hour="HH:mm"
            android:fontFamily="monospace"
            android:textColor="@color/stremio_text_muted"
            android:textSize="9sp"
            android:letterSpacing="0.04"
            tools:text="11:34 PM" />

    </LinearLayout>

    <!-- ══════ BOTTOM OSD ══════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_player_bottom_gradient"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="30dp"
        android:paddingTop="12dp"
        android:paddingEnd="30dp"
        android:paddingBottom="22dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/cv_player_poster"
            android:layout_width="56dp"
            android:layout_height="80dp"
            app:cardCornerRadius="7dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#12202A"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <ImageView
                android:id="@+id/iv_player_poster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                tools:src="@drawable/placeholder_poster" />
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_vodp_poster" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:id="@+id/layout_controls_column"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintStart_toEndOf="@id/cv_player_poster"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- seek bar -->
            <!-- Custom design seek bar (visual) + transparent media3 TimeBar (scrub/focus). -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="24dp">

                <com.tvonnet.debridxtreamiptv.player.stabilized.VodSeekOverlay
                    android:id="@+id/vod_seek_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <androidx.media3.ui.DefaultTimeBar
                    android:id="@+id/exo_progress"
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:focusable="true"
                    app:bar_height="5dp"
                    app:buffered_color="#00000000"
                    app:played_ad_marker_color="#00000000"
                    app:played_color="#00000000"
                    app:scrubber_color="#00000000"
                    app:scrubber_disabled_size="0dp"
                    app:scrubber_dragged_size="0dp"
                    app:scrubber_enabled_size="0dp"
                    app:touch_target_height="24dp"
                    app:unplayed_color="#00000000" />
            </FrameLayout>

            <!-- timestamps -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="14dp">
                <TextView
                    android:id="@+id/exo_position"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:textColor="@color/live_osd_text_soft"
                    android:textSize="8sp"
                    android:letterSpacing="0.04"
                    tools:text="24:17" />
                <TextView
                    android:id="@+id/exo_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/stremio_text_faint"
                    android:textSize="8sp"
                    android:letterSpacing="0.04"
                    tools:text="1:32:08" />
            </LinearLayout>

            <!-- glass control card -->
            <LinearLayout
                android:id="@+id/layout_control_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_vodp_glass_card"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- back 10s (media3-managed: ImageButton) -->
                <ImageButton
                    android:id="@+id/exo_rew"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_player_ref_button"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_rewind"
                    android:focusable="true"
                    android:nextFocusUp="@id/exo_progress"
                    app:tint="@color/live_osd_text_soft"
                    tools:ignore="ContentDescription" />

                <!-- prev episode (series only) -->
                <ImageButton
                    android:id="@+id/btn_prev_episode"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_player_ref_button"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_skip_previous"
                    android:focusable="true"
                    android:visibility="gone"
                    android:nextFocusUp="@id/exo_progress"
                    app:tint="@color/live_osd_text_soft"
                    tools:ignore="ContentDescription" />

                <!-- play / pause (big circle) -->
                <FrameLayout
                    android:id="@+id/layout_play_pause"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:focusable="false">
                    <ImageButton
                        android:id="@+id/exo_play"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_player_play_circle"
                        android:padding="16dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_play_arrow_24"
                        android:focusable="true"
                        android:nextFocusUp="@id/exo_progress"
                        app:tint="@color/stremio_text_primary"
                        tools:ignore="ContentDescription" />
                    <ImageButton
                        android:id="@+id/exo_pause"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_player_play_circle"
                        android:padding="16dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_pause"
                        android:focusable="true"
                        android:visibility="gone"
                        android:nextFocusUp="@id/exo_progress"
                        app:tint="@color/stremio_text_primary"
                        tools:ignore="ContentDescription" />
                </FrameLayout>

                <!-- next episode (series only) -->
                <ImageButton
                    android:id="@+id/btn_next_episode"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_player_ref_button"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_skip_next"
                    android:focusable="true"
                    android:visibility="gone"
                    android:nextFocusUp="@id/exo_progress"
                    app:tint="@color/live_osd_text_soft"
                    tools:ignore="ContentDescription" />

                <!-- fwd 10s (media3-managed: ImageButton) -->
                <ImageButton
                    android:id="@+id/exo_ffwd"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_player_ref_button"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_forward"
                    android:focusable="true"
                    android:nextFocusUp="@id/exo_progress"
                    app:tint="@color/live_osd_text_soft"
                    tools:ignore="ContentDescription" />

                <!-- episodes list (series only) -->
                <ImageButton
                    android:id="@+id/btn_episodes"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_player_ref_button"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_player_episodes"
                    android:focusable="true"
                    android:visibility="gone"
                    android:nextFocusUp="@id/exo_progress"
                    app:tint="@color/stremio_text_secondary"
                    tools:ignore="ContentDescription" />

                <!-- sources / language switch (movies only): re-pick a source mid-playback -->
                <ImageButton
                    android:id="@+id/btn_player_sources"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_player_ref_button"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_player_quality"
                    android:focusable="true"
                    android:visibility="gone"
                    android:nextFocusUp="@id/exo_progress"
                    app:tint="@color/stremio_text_secondary"
                    tools:ignore="ContentDescription" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- audio / subtitles / aspect group -->
                <LinearLayout
                    android:id="@+id/layout_utility_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <ImageButton
                        android:id="@+id/btn_player_audio"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_player_ref_button"
                        android:padding="11dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_player_audio_waveform"
                        android:focusable="true"
                        android:nextFocusUp="@id/exo_progress"
                        app:tint="@color/stremio_text_secondary"
                        tools:ignore="ContentDescription" />

                    <ImageButton
                        android:id="@+id/btn_player_subtitles"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_player_ref_button"
                        android:padding="11dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_player_subtitles"
                        android:focusable="true"
                        android:nextFocusUp="@id/exo_progress"
                        app:tint="@color/stremio_text_secondary"
                        tools:ignore="ContentDescription" />

                    <ImageButton
                        android:id="@+id/btn_aspect_ratio"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_player_ref_button"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_aspect_ratio"
                        android:focusable="true"
                        android:nextFocusUp="@id/exo_progress"
                        app:tint="@color/stremio_text_secondary"
                        tools:ignore="ContentDescription" />

                    <!-- retained for Activity compatibility (aspect label updates no-op if absent) -->
                    <TextView
                        android:id="@+id/tv_aspect_label"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Hidden container: views bound by Kotlin code but not present in the reference design. -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/layout_xray_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_xray"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_player_language"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/layout_volume_control"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <ImageButton
                android:id="@+id/btn_player_volume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <SeekBar
                android:id="@+id/volume_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
