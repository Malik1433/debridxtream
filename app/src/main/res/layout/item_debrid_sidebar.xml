<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="@drawable/bg_debrid_sidebar_item"
    android:orientation="horizontal"
    android:gravity="center"
    android:paddingStart="0dp"
    android:paddingEnd="0dp"
    android:focusable="true"
    android:focusableInTouchMode="@bool/rows_focusable_in_touch_mode"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:scaleType="fitCenter"
        app:tint="@color/color_debrid_sidebar_icon"
        android:contentDescription="@string/ui_navigation_icon" />

    <TextView
        android:id="@+id/tv_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:textColor="@color/color_debrid_sidebar_text"
        android:textSize="16sp"
        android:fontFamily="@font/plus_jakarta_sans"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone"
        android:alpha="0"
        android:text="@string/ui_dashboard" />

</LinearLayout>
