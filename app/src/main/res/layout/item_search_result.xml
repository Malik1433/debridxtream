<?xml version="1.0" encoding="utf-8"?>
<!-- TV best-practice: focus handled by an outer container with a selector background. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="@drawable/search_result_card_background"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:clipToOutline="true"
    android:descendantFocusability="blocksDescendants"
    android:foreground="@drawable/search_result_focus_highlight"
    android:foregroundGravity="fill"
    android:focusable="true"
    android:focusableInTouchMode="@bool/rows_focusable_in_touch_mode"
    android:outlineProvider="background"
    android:stateListAnimator="@animator/search_result_focus_animator">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <ImageView
            android:id="@+id/iv_icon"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:contentDescription="@string/stream_icon"
            android:scaleType="centerCrop"
            tools:src="@drawable/ic_movie" />

        <TextView
            android:id="@+id/tv_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Stream Name" />

        <TextView
            android:id="@+id/tv_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="Live TV" />
    </LinearLayout>

</FrameLayout>
