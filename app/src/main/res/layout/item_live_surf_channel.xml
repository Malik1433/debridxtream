<?xml version="1.0" encoding="utf-8"?>
<!-- Live channel row. The channel's own colour (pulled from its logo) washes across the row from
     the left and fades out before the text; the logo itself stays a clean, contained card because
     this provider bakes a silver plate into every logo file. See ChannelAccentWash. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:layout_marginBottom="3dp"
    android:background="@drawable/bg_live_surf_row"
    android:focusable="true"
    android:clipToPadding="false">

    <!-- per-channel colour wash, behind everything -->
    <View
        android:id="@+id/surf_wash"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- category color bar -->
        <View
            android:id="@+id/surf_cat_bar"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:background="@color/neon_cyan" />

        <!-- channel number -->
        <TextView
            android:id="@+id/surf_num"
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="center"
            android:textColor="@color/live_osd_text_faint"
            android:textSize="6.5sp"
            tools:text="003" />

        <!-- The logo. No tile behind it: these logo files already carry their own plate, so a
             second background reads as a frame inside a frame. Initials are the fallback for a
             channel with no logo at all. -->
        <FrameLayout
            android:id="@+id/surf_logo"
            android:layout_width="72dp"
            android:layout_height="52dp"
            android:layout_marginStart="2dp">

            <TextView
                android:id="@+id/surf_logo_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="SKY" />

            <ImageView
                android:id="@+id/surf_logo_img"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:visibility="gone" />
        </FrameLayout>

        <!-- info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="9dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/surf_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:maxLines="1"
                    android:textColor="@color/live_osd_text_primary"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    tools:text="SKY SPORT 1" />

                <TextView
                    android:id="@+id/surf_playing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_live_playing_badge"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.06"
                    android:paddingHorizontal="3.5dp"
                    android:paddingVertical="1dp"
                    android:text="▶ PLAYING"
                    android:textColor="#041014"
                    android:textSize="4.5sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/surf_now"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.5dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/live_osd_text_muted"
                android:textSize="6.5sp"
                tools:text="Bundesliga: BVB vs FCB" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/surf_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="100dp"
                    android:layout_height="1.5dp"
                    android:max="100"
                    android:progressDrawable="@drawable/live_progress_bar"
                    tools:progress="48" />

                <TextView
                    android:id="@+id/surf_left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/live_osd_text_faint"
                    android:textSize="5sp"
                    tools:text="55m left" />
            </LinearLayout>
        </LinearLayout>

        <!-- right meta -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical"
            android:paddingEnd="9dp">

            <TextView
                android:id="@+id/surf_quality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_live_badge_quality_hd"
                android:fontFamily="monospace"
                android:paddingHorizontal="4.5dp"
                android:paddingVertical="1.5dp"
                android:textColor="#041014"
                android:textSize="5.5sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="4K UHD"
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/surf_fav"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginTop="4dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_live_star_filled"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
