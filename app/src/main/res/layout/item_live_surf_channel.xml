<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="37dp"
    android:layout_marginBottom="3dp"
    android:background="@drawable/bg_live_surf_row"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp">

    <TextView
        android:id="@+id/surf_num"
        android:layout_width="15dp"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:gravity="center"
        android:textColor="@color/live_osd_text_faint"
        android:textSize="6.5sp"
        tools:text="003" />

    <FrameLayout
        android:id="@+id/surf_logo"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:layout_marginStart="7dp">

        <TextView
            android:id="@+id/surf_logo_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/plus_jakarta_sans"
            android:textColor="@android:color/white"
            android:textSize="6.5sp"
            android:textStyle="bold"
            tools:text="SKY" />

        <ImageView
            android:id="@+id/surf_logo_img"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:padding="3dp"
            android:scaleType="fitCenter"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/surf_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:fontFamily="@font/plus_jakarta_sans"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/live_osd_text_primary"
                android:textSize="7.5sp"
                android:textStyle="bold"
                tools:text="SKY SPORT 1" />

            <TextView
                android:id="@+id/surf_playing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_live_playing_badge"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:paddingHorizontal="3dp"
                android:paddingVertical="0.5dp"
                android:text="PLAYING"
                android:textColor="#041014"
                android:textSize="4.5sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/surf_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/live_osd_text_dim"
            android:textSize="6.5sp"
            android:visibility="gone"
            tools:text="Bundesliga: BVB vs FCB"
            tools:visibility="visible" />
    </LinearLayout>

    <ImageView
        android:id="@+id/surf_fav"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginStart="4dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_live_star_filled"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
