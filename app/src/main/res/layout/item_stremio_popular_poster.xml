<?xml version="1.0" encoding="utf-8"?>
<!-- Poster card (enlarged): 120 x 180 dp (2:3), radius 6dp -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/poster_card"
    android:layout_width="120dp"
    android:layout_height="180dp"
    android:layout_marginEnd="9dp"
    android:focusable="true"
    android:clipChildren="true"
    android:foreground="@drawable/stremio_popular_focus_fg">

    <ImageView
        android:id="@+id/poster_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/poster_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- quality badge top-right 9px/2=4.5dp -->
    <TextView
        android:id="@+id/poster_quality"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="4.5dp"
        android:layout_marginEnd="4.5dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:fontFamily="@font/share_tech_mono"
        android:textSize="6.5sp"
        android:textColor="#041014"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:layout_marginBottom="5dp">

        <TextView
            android:id="@+id/poster_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit_semibold"
            android:textSize="9sp"
            android:textColor="#F1F5F9"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/poster_year"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/share_tech_mono"
            android:textSize="6.5sp"
            android:textColor="#64748B"
            android:layout_marginTop="1.5dp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Continue Watching progress bar (gone unless CW) -->
    <FrameLayout
        android:id="@+id/poster_progress_wrap"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="bottom"
        android:background="@drawable/stremio_progress_track"
        android:visibility="gone">

        <View
            android:id="@+id/poster_progress_fill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/stremio_progress_fill" />
    </FrameLayout>
</FrameLayout>
