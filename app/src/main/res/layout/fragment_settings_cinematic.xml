<?xml version="1.0" encoding="utf-8"?>
<!--
    CINEMATIC SETTINGS
    Replaces: fragment_settings.xml
    Preserves IDs: sidebar_panel, rv_settings, tv_account_name, tv_account_status,
      btn_logout
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cin_bg_app">

    <include
        android:id="@+id/sidebar_panel"
        layout="@layout/cin_view_sidebar"
        android:layout_width="@dimen/cin_sidebar_expanded"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <include
        android:id="@+id/top_bar"
        layout="@layout/cin_view_topbar"
        android:layout_width="0dp"
        android:layout_height="@dimen/cin_topbar_h"
        app:layout_constraintStart_toEndOf="@id/sidebar_panel"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_screen_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/cin_gutter_screen"
        android:layout_marginTop="@dimen/cin_space_4"
        android:text="Settings"
        android:textColor="@color/cin_text_primary"
        android:textSize="@dimen/cin_text_display"
        android:fontFamily="@font/inter_extrabold"
        android:letterSpacing="-0.02"
        app:layout_constraintStart_toEndOf="@id/sidebar_panel"
        app:layout_constraintTop_toBottomOf="@id/top_bar" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/cin_space_5"
        android:paddingHorizontal="@dimen/cin_gutter_screen"
        android:paddingBottom="@dimen/cin_space_10"
        android:clipToPadding="false"
        app:layout_constraintStart_toEndOf="@id/sidebar_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_screen_title"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Account card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/cin_space_5"
                android:background="@drawable/cin_card_glass">

                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/cin_avatar_gold">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="D"
                        android:textColor="@color/cin_text_on_gold"
                        android:textSize="@dimen/cin_text_title"
                        android:fontFamily="@font/inter_extrabold" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/cin_space_4"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tv_account_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Derbix User"
                        android:textColor="@color/cin_text_primary"
                        android:textSize="@dimen/cin_text_body"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tv_account_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Connected · Premium · Expires Dec 2025"
                        android:textColor="@color/cin_text_tertiary"
                        android:textSize="@dimen/cin_text_caption"
                        android:fontFamily="@font/plus_jakarta_sans" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_logout"
                    style="@style/Cin.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/cin_btn_h"
                    android:text="Sign out" />

            </LinearLayout>

            <!-- Settings rows -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cin_space_6"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/cin_item_settings"
                tools:itemCount="8" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
