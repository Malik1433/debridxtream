<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_pure_black">

    <!-- Hero Background (Full Screen) -->
    <ImageView
        android:id="@+id/iv_hero_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.6"
        tools:src="@tools:sample/backgrounds/scenic" />

    <!-- Gradient Overlay for Readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/vignette_cinematic" />
        
    <!-- Main Content Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Content Area -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_content"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="24dp"
            android:clipToPadding="false"
            android:paddingStart="0dp"
            android:paddingTop="48dp"
            android:paddingEnd="0dp"
            android:paddingBottom="48dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/rv_sidebar"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Hero Section Wrapper -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp">

                    <TextView
                        android:id="@+id/tv_hero_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Featured Movie Title"
                        android:textColor="@color/white"
                        android:textSize="36sp"
                        android:textStyle="bold"
                        android:shadowColor="@color/black"
                        android:shadowRadius="8"
                        android:layout_marginBottom="8dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.7" />

                    <TextView
                        android:id="@+id/tv_hero_description"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="This is a short description of the movie. It is very cinematic and cool."
                        android:textColor="#CCFFFFFF"
                        android:textSize="16sp"
                        android:maxLines="3"
                        android:ellipsize="end"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="24dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_hero_title"
                        app:layout_constraintWidth_percent="0.7" />

                    <LinearLayout
                        android:id="@+id/ll_hero_buttons"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="24dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_hero_description">
                        
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_hero_watch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Watch Now"
                            android:backgroundTint="@color/brand_cyan"
                            android:textColor="@color/white"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:textStyle="bold"
                            app:cornerRadius="8dp"
                            android:layout_marginEnd="16dp" />
                            
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_hero_details"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="More Info"
                            android:backgroundTint="#4DFFFFFF"
                            android:textColor="@color/white"
                            app:cornerRadius="8dp"
                            app:strokeColor="@color/white"
                            app:strokeWidth="1dp" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Top 10 Movies Row -->
                <TextView
                    android:id="@+id/tv_title_top_10_movies"
                    android:text="Top 10 Movies Today"
                    android:textSize="20sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_top_10_movies"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="0dp"
                    android:clipToPadding="false"
                    android:layout_marginBottom="32dp"
                    tools:listitem="@layout/item_top_10_card"
                    tools:itemCount="5"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                <!-- Top 10 Series Row -->
                <TextView
                    android:id="@+id/tv_title_top_10_series"
                    android:text="Top 10 Series Today"
                    android:textSize="20sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_top_10_series"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="0dp"
                    android:clipToPadding="false"
                    android:layout_marginBottom="32dp"
                    tools:listitem="@layout/item_top_10_card"
                    tools:itemCount="5"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />



            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Main Sidebar RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_sidebar"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:paddingTop="32dp"
            android:paddingBottom="32dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:listitem="@layout/item_sidebar_nav" />

        <!-- Visual Boundary: Clean Cut 1dp Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:background="#1AFFFFFF"
            app:layout_constraintStart_toEndOf="@+id/rv_sidebar"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
