<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_pure_black">

    <!-- Hero Background (Full Screen) -->
    <ImageView
        android:id="@+id/iv_hero_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.8" 
        tools:src="@tools:sample/backgrounds/scenic" />

    <!-- Gradient Overlay for Readability (LUMINA style) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/vignette_lumina" />
        
    <!-- Main Content Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Content Area -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_content"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="24dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:paddingStart="0dp"
            android:paddingTop="48dp"
            android:paddingEnd="0dp"
            android:paddingBottom="48dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/rv_sidebar"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Hero Section Wrapper -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp">

                    <TextView
                        android:id="@+id/tv_hero_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Featured Movie Title"
                        android:textColor="@color/white"
                        android:textSize="48sp"
                        android:textStyle="bold"
                        android:shadowColor="@color/brand_cyan"
                        android:shadowRadius="24"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="8dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.7" />

                    <TextView
                        android:id="@+id/tv_hero_description"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="This is a short description of the movie. It is very cinematic and cool."
                        android:textColor="@color/glass_text_secondary"
                        android:textSize="16sp"
                        android:maxLines="3"
                        android:ellipsize="end"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="24dp"
                        android:lineSpacingExtra="4dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_hero_title"
                        app:layout_constraintWidth_percent="0.6" />

                    <LinearLayout
                        android:id="@+id/ll_hero_buttons"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="24dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_hero_description">
                        
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_hero_watch"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:text="PLAY NOW"
                            android:backgroundTint="@color/brand_cyan"
                            android:textColor="@color/velvet_black"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:textStyle="bold"
                            app:cornerRadius="8dp"
                            app:iconGravity="textStart"
                            app:iconPadding="6dp"
                            app:iconSize="16dp"
                            app:icon="@drawable/ic_play"
                            app:iconTint="@color/velvet_black"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="0dp"
                            android:layout_marginEnd="12dp" />
                            
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_hero_details"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:text="MORE INFO"
                            android:backgroundTint="@color/glass_card_bg_light"
                            android:textColor="@color/white"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:textStyle="bold"
                            app:cornerRadius="8dp"
                            app:strokeColor="@color/glass_card_border_focus"
                            app:strokeWidth="1dp"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="0dp" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Top 10 Movies Row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">
                    <View
                        android:layout_width="4dp"
                        android:layout_height="20dp"
                        android:background="@color/brand_cyan"
                        android:layout_marginEnd="12dp" />
                    <TextView
                        android:id="@+id/tv_title_top_10_movies"
                        android:text="TRENDING MOVIES"
                        android:textSize="20sp"
                        android:textColor="@color/white"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_top_10_movies"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="0dp"
                    android:clipToPadding="false"
                    android:clipChildren="false"
                    android:layout_marginBottom="32dp"
                    tools:listitem="@layout/item_top_10_card"
                    tools:itemCount="5"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                <!-- Top 10 Series Row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">
                    <View
                        android:layout_width="4dp"
                        android:layout_height="20dp"
                        android:background="@color/brand_cyan"
                        android:layout_marginEnd="12dp" />
                    <TextView
                        android:id="@+id/tv_title_top_10_series"
                        android:text="TRENDING SERIES"
                        android:textSize="20sp"
                        android:textColor="@color/white"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_top_10_series"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="0dp"
                    android:clipToPadding="false"
                    android:clipChildren="false"
                    android:layout_marginBottom="32dp"
                    tools:listitem="@layout/item_top_10_card"
                    tools:itemCount="5"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />



            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Background Container for Sidebar Area (Glassmorphism) -->
        <View
            android:id="@+id/sidebar_bg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="#66050505"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/rv_sidebar"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- Visual Boundary: Cybernetic Glowing Divider -->
        <View
            android:id="@+id/divider_sidebar"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/colorFocusCyanGlow"
            app:layout_constraintStart_toEndOf="@+id/rv_sidebar"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Main Sidebar RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_sidebar"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:paddingTop="32dp"
            android:paddingBottom="32dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:listitem="@layout/item_sidebar_nav" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
