<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_pure_black">

    <!-- Hero Background (Full Screen) -->
    <ImageView
        android:id="@+id/iv_hero_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.8" 
        tools:src="@tools:sample/backgrounds/scenic" />

    <!-- Gradient Overlay for Readability (LUMINA style) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/vignette_lumina" />
        
    <!-- Main Content Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Content Area -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_content"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="32dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:paddingStart="0dp"
            android:paddingTop="28dp"
            android:paddingEnd="56dp"
            android:paddingBottom="44dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/sidebar_panel"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Hero Section Wrapper -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:id="@+id/tv_hero_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Featured Movie Title"
                        android:textColor="@color/white"
                        android:textSize="38sp"
                        android:textStyle="bold"
                        android:shadowColor="@color/brand_cyan"
                        android:shadowRadius="18"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.7" />

                    <TextView
                        android:id="@+id/tv_hero_description"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="This is a short description of the movie. It is very cinematic and cool."
                        android:textColor="@color/glass_text_secondary"
                        android:textSize="15sp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="12dp"
                        android:lineSpacingExtra="2dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_hero_title"
                        app:layout_constraintWidth_percent="0.6" />

                    <LinearLayout
                        android:id="@+id/ll_hero_buttons"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="14dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_hero_description">
                        
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_hero_watch"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:text="PLAY NOW"
                            android:backgroundTint="@color/brand_cyan"
                            android:textColor="@color/velvet_black"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:textStyle="bold"
                            app:cornerRadius="8dp"
                            app:iconGravity="textStart"
                            app:iconPadding="6dp"
                            app:iconSize="16dp"
                            app:icon="@drawable/ic_play"
                            app:iconTint="@color/velvet_black"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="0dp"
                            android:layout_marginEnd="12dp"
                            android:nextFocusDown="@+id/rv_top_10_movies" />
                            
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_hero_details"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:text="MORE INFO"
                            android:backgroundTint="@color/glass_card_bg_light"
                            android:textColor="@color/white"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:textStyle="bold"
                            app:cornerRadius="8dp"
                            app:strokeColor="@color/glass_card_border_focus"
                            app:strokeWidth="1dp"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="0dp"
                            android:nextFocusDown="@+id/rv_top_10_movies" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Top 10 Movies Row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <View
                        android:layout_width="4dp"
                        android:layout_height="18dp"
                        android:background="@color/brand_cyan"
                        android:layout_marginEnd="12dp" />
                    <TextView
                        android:id="@+id/tv_title_top_10_movies"
                        android:text="TRENDING MOVIES"
                        android:textSize="18sp"
                        android:textColor="@color/white"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:textStyle="bold"
                        android:letterSpacing="0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_top_10_movies"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="0dp"
                    android:paddingEnd="36dp"
                    android:clipToPadding="false"
                    android:clipChildren="false"
                    android:layout_marginBottom="22dp"
                    tools:listitem="@layout/item_top_10_card"
                    tools:itemCount="5"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                <!-- Top 10 Series Row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <View
                        android:layout_width="4dp"
                        android:layout_height="18dp"
                        android:background="@color/brand_cyan"
                        android:layout_marginEnd="12dp" />
                    <TextView
                        android:id="@+id/tv_title_top_10_series"
                        android:text="TRENDING SERIES"
                        android:textSize="18sp"
                        android:textColor="@color/white"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:textStyle="bold"
                        android:letterSpacing="0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_top_10_series"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="0dp"
                    android:paddingEnd="36dp"
                    android:clipToPadding="false"
                    android:clipChildren="false"
                    android:layout_marginBottom="22dp"
                    tools:listitem="@layout/item_top_10_card"
                    tools:itemCount="5"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                <!-- Recent Live Row -->
                <LinearLayout
                    android:id="@+id/section_recent_live"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_marginBottom="20dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">
                        <View
                            android:layout_width="4dp"
                            android:layout_height="18dp"
                            android:background="@color/brand_cyan"
                            android:layout_marginEnd="12dp" />
                        <TextView
                            android:id="@+id/tv_title_recent_live"
                            android:text="@string/section_recent_live"
                            android:textSize="18sp"
                            android:textColor="@color/white"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:textStyle="bold"
                            android:letterSpacing="0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_recent_live_channels"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="0dp"
                        android:paddingEnd="36dp"
                        android:clipToPadding="false"
                        android:clipChildren="false"
                        tools:listitem="@layout/item_recent_live_card"
                        tools:itemCount="5"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                </LinearLayout>

                <!-- Continue Watching Row -->
                <LinearLayout
                    android:id="@+id/section_continue_watching"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_marginBottom="20dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">
                        <View
                            android:layout_width="4dp"
                            android:layout_height="18dp"
                            android:background="@color/brand_cyan"
                            android:layout_marginEnd="12dp" />
                        <TextView
                            android:id="@+id/tv_title_continue_watching"
                            android:text="@string/section_continue_watching"
                            android:textSize="18sp"
                            android:textColor="@color/white"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:textStyle="bold"
                            android:letterSpacing="0"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_continue_watching"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="0dp"
                        android:paddingEnd="36dp"
                        android:clipToPadding="false"
                        android:clipChildren="false"
                        tools:listitem="@layout/item_continue_watching_card"
                        tools:itemCount="5"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                </LinearLayout>



            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Premium Sidebar Panel (structured; full labels visible) -->
        <include
            android:id="@+id/sidebar_panel"
            layout="@layout/view_home_sidebar"
            android:layout_width="@dimen/sidebar_width_expanded"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Visual Boundary: Soft premium edge shadow -->
        <View
            android:id="@+id/divider_sidebar"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@drawable/shadow_sidebar_right"
            app:layout_constraintStart_toEndOf="@+id/sidebar_panel"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- RecyclerView moved inside `view_home_sidebar` -->

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
