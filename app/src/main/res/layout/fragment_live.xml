<?xml version="1.0" encoding="utf-8"?>
<!--
    CINEMATIC SIMPLE LIVE FRAGMENT (legacy 2-row layout — modernized).
    Replaces: fragment_live.xml
    Preserves IDs: rv_live_categories, tv_category_title,
      rv_channels, ll_loading_state, progress_bar, tv_loading_message,
      tv_empty_state
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cin_live_bg"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingHorizontal="40dp"
        android:paddingTop="32dp"
        android:paddingBottom="20dp">

        <!-- Section header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <View
                android:layout_width="4dp"
                android:layout_height="32dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/cin_section_accent_bar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIVE TV"
                    android:textColor="#FFC9A961"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.32"
                    android:fontFamily="@font/plus_jakarta_sans" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Channels"
                    android:textColor="#FFFFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter_extrabold"
                    android:letterSpacing="-0.02" />
            </LinearLayout>
        </LinearLayout>

        <!-- Categories pill rail -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_live_categories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:nextFocusDown="@id/rv_channels" />

        <TextView
            android:id="@+id/tv_category_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:fontFamily="@font/inter_extrabold"
            android:letterSpacing="-0.01" />

        <!-- Channel grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_channels"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="14dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:nextFocusUp="@id/rv_live_categories" />
    </LinearLayout>

    <!-- Loading -->
    <LinearLayout
        android:id="@+id/ll_loading_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:indeterminate="true"
            android:indeterminateTint="#FFC9A961" />

        <TextView
            android:id="@+id/tv_loading_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Loading…"
            android:textSize="16sp"
            android:textColor="#B3FFFFFF"
            android:fontFamily="@font/plus_jakarta_sans" />
    </LinearLayout>

    <!-- Empty -->
    <TextView
        android:id="@+id/tv_empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="No data available. Please login first."
        android:textSize="20sp"
        android:textColor="#B3FFFFFF"
        android:fontFamily="@font/plus_jakarta_sans"
        android:visibility="gone" />
</FrameLayout>
