<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/source_row_bg"
        android:descendantFocusability="blocksDescendants"
        android:focusable="true"
        android:clickable="true">

        <!-- BEST PICK left edge accent bar (shown only on the best row) -->
        <View
            android:id="@+id/v_best_accent"
            android:layout_width="3dp"
            android:layout_height="0dp"
            android:background="@drawable/cin_best_accent_bar"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="6dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Col 1: Provider badge -->
            <TextView
                android:id="@+id/tv_provider"
                android:layout_width="34dp"
                android:layout_height="20dp"
                android:gravity="center"
                android:textSize="9sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:focusable="false"
                android:clickable="false"
                tools:text="RD" />

            <!-- Col 2: Language flags -->
            <LinearLayout
                android:id="@+id/ll_languages"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:focusable="false"
                android:clickable="false" />

            <!-- Col 3: Release name -->
            <TextView
                android:id="@+id/tv_release_name"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:textSize="9sp"
                android:textColor="#E2E8F0"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:ellipsize="end"
                android:focusable="false"
                android:clickable="false"
                tools:text="Dune.Part.Two.2024.2160p.WEB-DL.DV.HDR" />

            <LinearLayout
                android:id="@+id/layout_badges"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:focusable="false"
                android:clickable="false">

                <!-- Col 4: Quality pill -->
                <TextView
                    android:id="@+id/tv_quality"
                    android:layout_width="38dp"
                    android:layout_height="17dp"
                    android:layout_marginStart="5dp"
                    android:gravity="center"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:focusable="false"
                    android:clickable="false"
                    tools:text="4K" />

                <TextView
                    android:id="@+id/tv_badge_seeders"
                    android:layout_width="wrap_content"
                    android:layout_height="17dp"
                    android:layout_marginStart="5dp"
                    android:gravity="center"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:visibility="gone"
                    android:focusable="false"
                    android:clickable="false"
                    tools:text="12" />

                <!-- Col 5: Type badge -->
                <TextView
                    android:id="@+id/tv_type"
                    android:layout_width="48dp"
                    android:layout_height="17dp"
                    android:layout_marginStart="5dp"
                    android:gravity="center"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:focusable="false"
                    android:clickable="false"
                    tools:text="DIRECT" />
            </LinearLayout>

            <!-- Col 6: File size + visual bar -->
            <LinearLayout
                android:id="@+id/layout_size_column"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:orientation="vertical"
                android:gravity="end"
                android:focusable="false"
                android:clickable="false">

                <TextView
                    android:id="@+id/tv_filesize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:textSize="10sp"
                    android:textColor="#F1F5F9"
                    android:fontFamily="monospace"
                    android:focusable="false"
                    android:clickable="false"
                    tools:text="22.4 GB" />

                <FrameLayout
                    android:id="@+id/layout_size_bar"
                    android:layout_width="40dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/cin_size_bar_track"
                    android:focusable="false"
                    android:clickable="false">

                    <View
                        android:id="@+id/v_size_bar_fill"
                        android:layout_width="20dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/cin_size_bar_fill"
                        android:backgroundTint="#00F0FF" />
                </FrameLayout>
            </LinearLayout>

            <!-- Col 7: Play icon -->
            <ImageView
                android:id="@+id/iv_play"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/play_btn_bg"
                android:src="@drawable/ic_play_arrow_24"
                android:padding="4dp"
                android:focusable="false"
                android:clickable="false"
                app:tint="#64748B" />

            <!-- Col 7 (alt): BEST badge — replaces play icon on the best row -->
            <TextView
                android:id="@+id/tv_best_badge"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:background="@drawable/cin_best_badge_bg"
                android:text="★ BEST"
                android:textColor="#00F0FF"
                android:textSize="8sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:visibility="gone"
                android:focusable="false"
                android:clickable="false"
                tools:visibility="visible" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
