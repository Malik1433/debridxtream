<?xml version="1.0" encoding="utf-8"?>
<!--
  PHONE source row. Same ids and kinds as the television row in layout-television/, so
  MovieSourceAdapter binds either — but stacked instead of columned: five side-by-side columns
  need 900dp to breathe, and this screen has 411. Release name on top, then the facts as a chip
  line, with a 56dp play target on the right.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:descendantFocusability="blocksDescendants"
        android:focusable="true"
        android:minHeight="76dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <!-- BEST PICK accent, on the leading edge as on the television row. -->
        <View
            android:id="@+id/v_best_accent"
            android:layout_width="3dp"
            android:layout_height="0dp"
            android:background="@drawable/cin_best_accent_bar"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

        <!--
          The cache dot. On a phone an uncached pick means a wait on cellular, so whether this
          link plays NOW is the first thing the eye should meet — green for instant, amber for
          fetch-first. It is a mark, not a control: the row is the target.
        -->
        <View
            android:id="@+id/v_cache_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_phone_dot_green"
            app:layout_constraintBottom_toBottomOf="@id/tv_release_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_release_name" />

        <TextView
            android:id="@+id/tv_release_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/inter_regular"
            android:maxLines="2"
            android:textColor="@color/phone_text_primary"
            android:textSize="13.5sp"
            app:layout_constraintEnd_toStartOf="@id/iv_play"
            app:layout_constraintStart_toEndOf="@id/v_cache_dot"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Spider-Man.Brand.New.Day.2026.2160p.WEB-DL" />

        <LinearLayout
            android:id="@+id/layout_badges"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toStartOf="@id/iv_play"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_release_name">

            <TextView
                android:id="@+id/tv_quality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_phone_badge_cyan"
                android:fontFamily="@font/share_tech_mono"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:textColor="@color/phone_cyan"
                android:textSize="10.5sp"
                tools:text="1080P" />

            <TextView
                android:id="@+id/tv_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_phone_badge_green"
                android:fontFamily="@font/share_tech_mono"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:textColor="@color/phone_green"
                android:textSize="10.5sp"
                tools:text="DIRECT" />

            <TextView
                android:id="@+id/tv_badge_seeders"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_phone_badge_neutral"
                android:fontFamily="@font/share_tech_mono"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:textColor="@color/phone_text_secondary"
                android:textSize="10.5sp"
                android:visibility="gone"
                tools:text="120"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tv_best_badge"
                android:text="@string/ui_best"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_phone_best_chip"
                android:fontFamily="@font/share_tech_mono"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:textColor="@color/phone_cyan"
                android:textSize="10.5sp"
                android:visibility="gone"
                tools:text="★ BEST"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Provider, languages and size share the third line. -->
        <TextView
            android:id="@+id/tv_provider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clickable="false"
            android:focusable="false"
            android:fontFamily="@font/share_tech_mono"
            android:textColor="@color/phone_text_muted"
            android:textSize="11sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_badges"
            tools:text="RD" />

        <LinearLayout
            android:id="@+id/ll_languages"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="@id/tv_provider"
            app:layout_constraintStart_toEndOf="@id/tv_provider"
            app:layout_constraintTop_toTopOf="@id/tv_provider" />

        <LinearLayout
            android:id="@+id/layout_size_column"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="@id/tv_provider"
            app:layout_constraintStart_toEndOf="@id/ll_languages"
            app:layout_constraintTop_toTopOf="@id/tv_provider">

            <TextView
                android:id="@+id/tv_filesize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/share_tech_mono"
                android:textColor="@color/phone_text_muted"
                android:textSize="11sp"
                tools:text="14.2 GB" />

            <FrameLayout
                android:id="@+id/layout_size_bar"
                android:layout_width="52dp"
                android:layout_height="3dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_phone_progress_track">

                <View
                    android:id="@+id/v_size_bar_fill"
                    android:layout_width="26dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_phone_progress" />
            </FrameLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_play"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_phone_action"
            android:contentDescription="@string/a11y_play"
            android:padding="17dp"
            android:src="@drawable/ic_stremio_play"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/phone_text_primary" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
