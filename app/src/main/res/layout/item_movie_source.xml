<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/source_row_bg"
        android:descendantFocusability="blocksDescendants"
        android:focusable="true"
        android:clickable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="6dp">

            <!-- Col 1: Provider badge -->
            <TextView
                android:id="@+id/tv_provider"
                android:layout_width="34dp"
                android:layout_height="20dp"
                android:gravity="center"
                android:textSize="9sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:focusable="false"
                android:clickable="false"
                tools:text="RD" />

            <!-- Col 2: Language flags -->
            <LinearLayout
                android:id="@+id/ll_languages"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:focusable="false"
                android:clickable="false" />

            <!-- Col 3: Release name -->
            <TextView
                android:id="@+id/tv_release_name"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:textSize="9sp"
                android:textColor="#E2E8F0"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:ellipsize="end"
                android:focusable="false"
                android:clickable="false"
                tools:text="Dune.Part.Two.2024.2160p.WEB-DL.DV.HDR" />

            <LinearLayout
                android:id="@+id/layout_badges"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:focusable="false"
                android:clickable="false">

                <!-- Col 4: Quality pill -->
                <TextView
                    android:id="@+id/tv_quality"
                    android:layout_width="38dp"
                    android:layout_height="17dp"
                    android:layout_marginStart="5dp"
                    android:gravity="center"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:focusable="false"
                    android:clickable="false"
                    tools:text="4K" />

                <TextView
                    android:id="@+id/tv_badge_seeders"
                    android:layout_width="wrap_content"
                    android:layout_height="17dp"
                    android:layout_marginStart="5dp"
                    android:gravity="center"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:visibility="gone"
                    android:focusable="false"
                    android:clickable="false"
                    tools:text="12" />

                <!-- Col 5: Type badge -->
                <TextView
                    android:id="@+id/tv_type"
                    android:layout_width="48dp"
                    android:layout_height="17dp"
                    android:layout_marginStart="5dp"
                    android:gravity="center"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:focusable="false"
                    android:clickable="false"
                    tools:text="DIRECT" />
            </LinearLayout>

            <!-- Col 6: File size -->
            <TextView
                android:id="@+id/tv_filesize"
                android:layout_width="46dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:gravity="end|center_vertical"
                android:textSize="10sp"
                android:textColor="#F1F5F9"
                android:fontFamily="monospace"
                android:focusable="false"
                android:clickable="false"
                tools:text="22.4 GB" />

            <!-- Col 7: Play icon -->
            <ImageView
                android:id="@+id/iv_play"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/play_btn_bg"
                android:src="@drawable/ic_play_arrow_24"
                android:padding="4dp"
                android:focusable="false"
                android:clickable="false"
                app:tint="#64748B" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
