<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp">

    <TextView
        android:id="@+id/phone_bsort_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="@font/outfit_semibold"
        android:textColor="@color/phone_text_primary"
        android:textSize="14sp"
        tools:text="Recently added" />

    <TextView
        android:id="@+id/phone_bsort_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:fontFamily="@font/share_tech_mono"
        android:textColor="@color/phone_text_muted"
        android:textSize="12sp"
        tools:text="DEFAULT" />

    <ImageView
        android:id="@+id/phone_bsort_check"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="12dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_stremio_check"
        android:visibility="gone"
        app:tint="@color/phone_cyan"
        tools:visibility="visible" />
</LinearLayout>
