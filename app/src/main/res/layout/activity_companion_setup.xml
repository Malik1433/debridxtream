<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/onyx">

    <!-- Background Decoration -->
    <View
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:background="@drawable/bg_circle_card"
        android:alpha="0.05"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginTop="-100dp"
        android:layout_marginLeft="-100dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/qr_container">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connect Companion App"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:fontFamily="sans-serif-black"
            android:textAllCaps="true" />

        <TextView
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:text="Scan the QR code with your phone to configure your IPTV and Debrid settings instantly without typing on the remote."
            android:textColor="@color/white_opacity_70"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="40dp"
            android:background="@drawable/glass_card_bg"
            android:padding="20dp">

            <TextView
                android:id="@+id/tv_device_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="------"
                android:textColor="@color/gold_primary"
                android:textSize="48sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:letterSpacing="0.2" />
        </LinearLayout>
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OR ENTER CODE AT DEBXTREAM.COM/SETUP"
            android:textColor="@color/white_opacity_50"
            android:textSize="12sp"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.1" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/qr_container"
        android:layout_width="400dp"
        android:layout_height="400dp"
        android:background="@drawable/glass_card_focused_gold"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginRight="80dp">

        <ImageView
            android:id="@+id/iv_qr_code"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />
            
        <ProgressBar
            android:id="@+id/pb_loading"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/gold_primary" />
    </FrameLayout>

    <!-- Status Bar -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_margin="40dp">
        
        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_circle_card"
            android:backgroundTint="@color/epg_playing" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Waiting for connection..."
            android:textColor="@color/white_opacity_50"
            android:textSize="14sp"
            android:layout_marginLeft="12dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
