<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="9dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Cyan bloom behind the card (visible on focus; drawable set in code) -->
    <View
        android:id="@+id/view_focus_glow"
        android:layout_width="168dp"
        android:layout_height="105dp"
        android:duplicateParentState="true"
        app:layout_constraintStart_toStartOf="@+id/card_continue"
        app:layout_constraintEnd_toEndOf="@+id/card_continue"
        app:layout_constraintTop_toTopOf="@+id/card_continue"
        app:layout_constraintBottom_toBottomOf="@+id/card_continue" />

    <!-- Wide 16:9 card (144×81 = design 288×162) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_continue"
        android:layout_width="144dp"
        android:layout_height="81dp"
        app:cardBackgroundColor="@color/cin_ink_700"
        app:cardCornerRadius="4dp"
        app:cardElevation="4dp"
        android:duplicateParentState="true"
        android:foreground="@drawable/card_focus_cinematic"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/iv_continue_poster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@string/poster"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Bottom gradient scrim -->
            <View
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/cin_card_footer_gradient"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Content type badge (hidden — design has plain cards) -->
            <TextView
                android:id="@+id/tv_continue_type_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Progress bar (bottom of card) -->
            <ProgressBar
                android:id="@+id/progress_watch"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:progress="50"
                android:progressDrawable="@drawable/cin_progress_continue_cyan"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- Dwell quick-info bubble (appears above card after ~450ms rest) -->
    <include
        android:id="@+id/quick_info_bubble"
        layout="@layout/view_card_quick_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        app:layout_constraintStart_toStartOf="@id/card_continue"
        app:layout_constraintEnd_toEndOf="@id/card_continue"
        app:layout_constraintBottom_toTopOf="@id/card_continue" />

    <!-- Meta below card: title + progress time -->
    <LinearLayout
        android:layout_width="144dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@id/card_continue"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tv_continue_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Content Title"
            android:textSize="7sp"
            android:textStyle="bold"
            android:textColor="#E2E8F0"
            android:fontFamily="@font/plus_jakarta_sans"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_continue_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="15:30 / 45:00"
            android:textSize="5.5sp"
            android:textColor="#64748B"
            android:fontFamily="monospace"
            android:letterSpacing="0.04"
            android:layout_marginTop="1.5dp"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
