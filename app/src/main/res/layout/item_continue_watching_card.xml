<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="168dp"
    android:layout_height="286dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="12dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    app:cardBackgroundColor="@color/cin_ink_700"
    app:cardCornerRadius="8dp"
    app:cardElevation="8dp"
    android:foreground="@drawable/card_focus_enhanced">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cin_ink_700">

        <!-- Content Poster -->
        <ImageView
            android:id="@+id/iv_continue_poster"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/poster"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/content_info_container"
            app:layout_constraintDimensionRatio="3:4" />

        <View
            android:id="@+id/poster_footer_scrim"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:background="@drawable/cin_card_footer_gradient"
            app:layout_constraintBottom_toBottomOf="@id/iv_continue_poster"
            app:layout_constraintStart_toStartOf="@id/iv_continue_poster"
            app:layout_constraintEnd_toEndOf="@id/iv_continue_poster" />

        <!-- Content Info Container -->
        <LinearLayout
            android:id="@+id/content_info_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Title -->
            <TextView
                android:id="@+id/tv_continue_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Content Title"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/cin_text_primary"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginBottom="6dp" />

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progress_watch"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:progress="50"
                android:progressDrawable="@drawable/cin_progress_gold" />

            <!-- Progress Text -->
            <TextView
                android:id="@+id/tv_continue_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="15:30 / 45:00"
                android:textSize="12sp"
                android:textColor="@color/cin_text_secondary"
                android:layout_marginTop="4dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>

