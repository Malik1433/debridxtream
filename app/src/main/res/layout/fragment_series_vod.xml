<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_pure_black">

    <!-- Immersive Background Backdrop -->
    <ImageView
        android:id="@+id/iv_background_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.4"
        android:contentDescription="Series Backdrop" />

    <!-- Gradient Overlay for Readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_backdrop_overlay" />

    <!-- Main content: Sidebar + Series Grid -->
    <LinearLayout
        android:id="@+id/ll_main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Left Sidebar: Categories -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_categories_sidebar"
            android:layout_width="260dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:background="@color/surface_dark"
            android:nextFocusRight="@id/rv_series_grid"
            android:clipToPadding="false"
            android:paddingTop="24dp"
            android:paddingBottom="24dp" />

        <!-- Right Content Area: Series Grid -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:clipChildren="false">

            <!-- Category Title Header -->
            <TextView
                android:id="@+id/tv_category_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="24dp"
                android:text="All Series"
                android:textSize="32sp"
                android:textColor="@color/ds_text_primary"
                android:textStyle="bold"
                android:shadowColor="#80000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:fontFamily="sans-serif-black" />

            <!-- Series Grid -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_series_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@id/rv_categories_sidebar"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:paddingBottom="48dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Loading State -->
    <LinearLayout
        android:id="@+id/ll_loading_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/progress_indeterminate_modern" />

        <TextView
            android:id="@+id/tv_loading_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Loading series..."
            android:textSize="18sp"
            android:textColor="@color/ds_text_secondary" />
    </LinearLayout>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/ll_empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_empty_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/series_empty_state_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/ds_text_secondary"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/series_empty_state_hint"
            android:textSize="16sp"
            android:textColor="@color/ds_text_tertiary"
            android:gravity="center" />
    </LinearLayout>

</FrameLayout>

