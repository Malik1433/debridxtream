<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_background_primary">

    <!-- Main content: Sidebar + Series Grid -->
    <LinearLayout
        android:id="@+id/ll_main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="24dp">

        <!-- Left Sidebar: Categories -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_categories_sidebar"
            android:layout_width="240dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusRight="@id/rv_series_grid"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <!-- Right Content Area: Series Grid -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="32dp">

            <!-- Category Title Header -->
            <TextView
                android:id="@+id/tv_category_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="All Series"
                android:textSize="24sp"
                android:textColor="@color/ds_text_primary"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <!-- Series Grid -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_series_grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusLeft="@id/rv_categories_sidebar"
                android:clipToPadding="false" />

        </LinearLayout>

    </LinearLayout>

    <!-- Loading State -->
    <LinearLayout
        android:id="@+id/ll_loading_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/progress_indeterminate_modern" />

        <TextView
            android:id="@+id/tv_loading_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Loading series..."
            android:textSize="18sp"
            android:textColor="@color/ds_text_secondary" />
    </LinearLayout>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/ll_empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_empty_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/series_empty_state_title"
            android:textSize="20sp"
            android:textColor="@color/ds_text_secondary"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/series_empty_state_hint"
            android:textSize="16sp"
            android:textColor="@color/ds_text_tertiary"
            android:gravity="center" />
    </LinearLayout>

</FrameLayout>

