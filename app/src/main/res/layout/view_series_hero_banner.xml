<?xml version="1.0" encoding="utf-8"?>
<!-- Purple mirror of view_vod_hero_banner.xml for the Series screen -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="44dp"
    android:paddingEnd="52dp"
    android:paddingTop="16dp"
    android:visibility="gone">

    <!-- Fixed 188dp banner (design: height 188px, margin 16 52 0 44) -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="188dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@android:color/transparent">

        <!-- Banner background -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_series_hero_banner" />

        <!-- Top accent line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="top"
            android:background="#80A78BFA" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="28dp"
            android:paddingEnd="20dp">

            <!-- Left info column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="16dp">

                <!-- FEATURED SERIES tag -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <View
                        android:layout_width="2dp"
                        android:layout_height="14dp"
                        android:background="@color/series_accent_purple" />
                    <View
                        android:layout_width="2dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="2dp"
                        android:background="@color/series_accent_purple" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="FEATURED SERIES"
                        android:textColor="@color/series_accent_purple"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.22" />
                </LinearLayout>

                <!-- Title -->
                <TextView
                    android:id="@+id/tv_hero_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Featured Series"
                    android:textColor="@color/vod_text_primary"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="-0.025"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Meta row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/tv_hero_star"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="★"
                        android:textColor="@color/series_accent_purple"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_hero_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:text="8.6"
                        android:textColor="@color/vod_text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="monospace" />

                    <TextView
                        android:id="@+id/tv_hero_dot1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="6dp"
                        android:text="·"
                        android:textColor="@color/vod_text_ghost"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_hero_year"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2024"
                        android:textColor="@color/vod_text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="monospace" />

                    <TextView
                        android:id="@+id/tv_hero_dot2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="6dp"
                        android:text="·"
                        android:textColor="@color/vod_text_ghost"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_hero_genre"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Drama"
                        android:textColor="@color/vod_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Description -->
                <TextView
                    android:id="@+id/tv_hero_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="A gripping tale..."
                    android:textColor="@color/vod_text_muted"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.55"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_marginBottom="12dp" />

                <!-- Buttons -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/btn_hero_play"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_series_hero_play_btn"
                        android:paddingHorizontal="22dp"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:clickable="true">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="13dp"
                                android:layout_height="13dp"
                                android:src="@android:drawable/ic_media_play"
                                app:tint="#0E0420"
                                android:contentDescription="@null" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="WATCH NOW"
                                android:textColor="#0E0420"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-condensed"
                                android:letterSpacing="0.05" />
                        </LinearLayout>
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/btn_hero_list"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_vod_hero_list_btn"
                        android:paddingHorizontal="18dp"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:clickable="true">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="+"
                                android:textColor="@color/vod_text_primary"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="MY LIST"
                                android:textColor="@color/vod_text_primary"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.03" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Right poster -->
            <androidx.cardview.widget.CardView
                android:layout_width="108dp"
                android:layout_height="162dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="8dp"
                android:rotation="2">

                <ImageView
                    android:id="@+id/iv_hero_poster"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_series_hero_banner"
                    android:contentDescription="@null" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
