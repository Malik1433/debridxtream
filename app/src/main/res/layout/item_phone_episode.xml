<?xml version="1.0" encoding="utf-8"?>
<!--
  An episode. 96dp with a 128x72 still, because a still is how people recognise an episode they
  half-watched — a text row cannot do that job.

  The 2dp left border is RESERVED transparent on every row, so the NEXT UP row can take it without
  shifting the whole list sideways by two pixels.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/phone_ep_root"
    android:layout_width="match_parent"
    android:layout_height="96dp"
    android:background="@drawable/bg_phone_row_reserved"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="4dp">

    <FrameLayout
        android:layout_width="128dp"
        android:layout_height="72dp">

        <ImageView
            android:id="@+id/phone_ep_still"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_phone_still"
            android:clipToOutline="true"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/phone_ep_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="4dp"
            android:fontFamily="@font/share_tech_mono"
            android:textColor="#80F1F5F9"
            android:textSize="12sp"
            tools:text="E04" />

        <!-- Next up wears a play disc on the still: on a touch screen there is no focus to say
             "this is the one", so the row has to say it itself. -->
        <ImageView
            android:id="@+id/phone_ep_play"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_phone_play_disc"
            android:contentDescription="@null"
            android:padding="9dp"
            android:src="@drawable/ic_stremio_play"
            android:visibility="gone"
            app:tint="@color/phone_on_accent"
            tools:visibility="visible" />

        <ProgressBar
            android:id="@+id/phone_ep_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:max="100"
            android:progressDrawable="@drawable/bg_phone_progress_track"
            android:visibility="gone"
            tools:progress="48"
            tools:visibility="visible" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/phone_ep_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/outfit_semibold"
                android:maxLines="1"
                android:textColor="@color/phone_text_primary"
                android:textSize="13.5sp"
                tools:text="4. The Eightfold Fence" />

            <ImageView
                android:id="@+id/phone_ep_watched"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/phone_watched"
                android:src="@drawable/ic_check_circle"
                android:visibility="gone"
                app:tint="@color/phone_cyan"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/phone_ep_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_phone_next_badge"
                android:fontFamily="@font/share_tech_mono"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="@string/phone_next_up"
                android:textColor="@color/phone_cyan"
                android:textSize="12sp"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/phone_ep_plot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/inter_regular"
            android:maxLines="1"
            android:textColor="@color/phone_text_muted"
            android:textSize="12sp"
            tools:text="Toranaga's forces prepare while Blackthorne learns the language." />

        <TextView
            android:id="@+id/phone_ep_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/share_tech_mono"
            android:maxLines="1"
            android:textColor="@color/phone_text_muted"
            android:textSize="12sp"
            tools:text="30 MIN LEFT · 28:10 OF 58:00" />
    </LinearLayout>

    <ImageView
        android:id="@+id/phone_ep_overflow"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/phone_more_options"
        android:padding="15dp"
        android:src="@drawable/ic_stremio_more"
        app:tint="@color/phone_text_muted" />
</LinearLayout>
