<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="39dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_live_surf_row"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="0dp"
    android:paddingEnd="11dp">

    <!-- accent bar -->
    <View
        android:id="@+id/cat_accent"
        android:layout_width="2dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="11dp"
        android:background="@color/neon_cyan" />

    <!-- icon badge -->
    <FrameLayout
        android:id="@+id/cat_icon"
        android:layout_width="24dp"
        android:layout_height="24dp">

        <TextView
            android:id="@+id/cat_abbr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/plus_jakarta_sans"
            android:textColor="@android:color/white"
            android:textSize="7sp"
            android:textStyle="bold"
            tools:text="SPT" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/cat_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/plus_jakarta_sans"
            android:maxLines="1"
            android:textColor="@color/live_osd_text_primary"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="Sports" />

        <TextView
            android:id="@+id/cat_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.06"
            android:textColor="@color/live_osd_text_faint"
            android:textSize="5.5sp"
            android:visibility="gone"
            tools:text="24 channels"
            tools:visibility="visible" />
    </LinearLayout>

    <ImageView
        android:id="@+id/cat_chevron"
        android:layout_width="9dp"
        android:layout_height="9dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_live_chevron_right"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
