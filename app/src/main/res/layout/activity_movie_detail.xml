<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mesh_gradient_lumina"
    android:paddingStart="24dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Immersive Backdrop -->
    <ImageView
        android:id="@+id/iv_backdrop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/movie_detail_backdrop_content_desc"
        android:scaleType="centerCrop"
        android:alpha="0.8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <View
        android:id="@+id/view_backdrop_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/vignette_lumina"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Left Guideline for alignment -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="56dp" />

    <!-- Top Guideline -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="48dp" />



    <!-- Main Content Container -->
    <FrameLayout
        android:id="@+id/layout_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/guideline_left"
        app:layout_constraintTop_toTopOf="@id/guideline_top">

        <!-- DETAILS VIEW (Left + Right Columns) -->
        <LinearLayout
            android:id="@+id/group_details"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- LEFT COLUMN: Info & Actions (45% Width) -->
            <ScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.45"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Movie Title -->
                    <TextView
                        android:id="@+id/tv_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Movie Title"
                        android:textColor="@color/white"
                        android:textSize="48sp"
                        android:fontFamily="@font/inter_extrabold"
                        android:textStyle="normal"
                        android:shadowColor="#4D00E5FF"
                        android:shadowRadius="16"
                        android:shadowDx="0"
                        android:shadowDy="0" />

                    <!-- Metadata Row -->
                    <LinearLayout
                        android:id="@+id/layout_metadata_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_genre_year"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_glass_neon_lumina"
                            android:paddingStart="12dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="6dp"
                            android:text="2024"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:fontFamily="@font/inter"
                            android:textStyle="bold" />

                        <Space
                            android:layout_width="12dp"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/tv_duration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_glass_neon_lumina"
                            android:paddingStart="12dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="6dp"
                            android:text="1h 45m"
                            android:textColor="@color/white"
                            android:fontFamily="@font/inter"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <Space
                            android:layout_width="12dp"
                            android:layout_height="wrap_content" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_glass_neon_lumina"
                            android:gravity="center_vertical"
                            android:paddingStart="12dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="6dp">
                            
                            <TextView
                                android:id="@+id/tv_rating_percentage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="7.5"
                                android:fontFamily="@font/inter"
                                android:textColor="#00E5FF"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_rating_stars"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="★"
                                android:textColor="#00E5FF"
                                android:textSize="12sp" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Description -->
                    <TextView
                        android:id="@+id/tv_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:lineSpacingMultiplier="1.4"
                        android:text="Movie description goes here..."
                        android:fontFamily="@font/inter"
                        android:textColor="@color/glass_text_secondary"
                        android:textSize="16sp"
                        android:maxLines="6"
                        android:ellipsize="end" />
                    
                    <TextView
                        android:id="@+id/tv_director"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textSize="14sp"
                        android:textColor="@color/ds_text_tertiary"
                        android:visibility="gone"
                        tools:visibility="visible"
                        tools:text="Directed by: Jalmari Helander" />
                        
                    <!-- rv_cast -->
                    <TextView
                        android:id="@+id/tv_cast_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="Cast"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_cast"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:paddingEnd="16dp"
                        android:scrollbars="none"
                        android:visibility="gone"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_cast_member"
                        tools:visibility="visible" />




                </LinearLayout>
            </ScrollView>

            <Space
                android:layout_width="48dp"
                android:layout_height="match_parent" />

            <!-- RIGHT COLUMN: Sources & Filters (55% Width) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.55"
                android:orientation="vertical">

                <!-- Source Filters (Header) -->
                <LinearLayout
                    android:id="@+id/layout_source_filters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <TextView
                        android:id="@+id/tv_sources_header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/movie_detail_sources_header"
                        android:textColor="@color/white"
                        android:fontFamily="@font/inter"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:gravity="center_vertical">
                        
                        <TextView
                            android:id="@+id/btn_cached_only"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_tab_button_selector"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:layout_marginEnd="16dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:text="@string/source_filter_cached_only"
                            android:textColor="@color/tab_button_text_selector"
                            android:textSize="12sp" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_language_filters"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            tools:itemCount="4"
                            tools:listitem="@layout/item_language_chip" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Source List -->
                <TextView
                    android:id="@+id/tv_sources_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/ds_text_secondary"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:text="Loading reliable sources..." />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_sources"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingBottom="24dp"
                    android:scrollbars="vertical"
                    android:fadeScrollbars="true" />

            </LinearLayout>

        </LinearLayout>


    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
