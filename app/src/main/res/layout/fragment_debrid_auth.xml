<?xml version="1.0" encoding="utf-8"?>
<!--
  PHONE Real-Debrid sign-in — portrait.

  The television answer moved to layout-television/ unchanged: 48dp padding, a 32sp title, a 48sp
  device code and two buttons side by side, all measured to read from three metres. In the hand
  that column does not fit, which is why this screen was still being spun to landscape.

  Here it is a normal phone form: one scrolling column, 16dp gutters, buttons stacked full-width at
  56dp so the primary action is never a 30dp target, and the device code big but not 48sp. It
  SCROLLS because the soft keyboard takes half the screen the moment the manual API-key field is
  opened — a centred fixed column would push Submit off the bottom.

  Same ids and same view KINDS as the television file (card_device_code is still a CardView, the
  four buttons are still Buttons), so DebridAuthFragment binds either without asking which it got.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/phone_home_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit_extrabold"
            android:letterSpacing="-0.03"
            android:text="@string/debrid_auth_title"
            android:textColor="@color/phone_text_primary"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tv_instructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/outfit_semibold"
            android:lineSpacingMultiplier="1.35"
            android:text="@string/debrid_auth_start_message"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/progress_auth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:indeterminateTint="@color/phone_cyan"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- The code the user types on real-debrid.com. Monospace and letter-spaced, because it is
             read off this screen and typed on another device. -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_device_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/phone_panel"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/tv_device_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/share_tech_mono"
                android:gravity="center"
                android:letterSpacing="0.15"
                android:padding="20dp"
                android:textColor="@color/phone_cyan"
                android:textSize="30sp"
                android:textStyle="bold"
                tools:text="A1B2C3" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tv_verification_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/share_tech_mono"
            android:gravity="center"
            android:textColor="@color/phone_text_primary"
            android:textSize="15sp"
            android:visibility="gone"
            tools:text="real-debrid.com/device"
            tools:visibility="visible" />

        <!-- Manual API key, for an account that already has one. -->
        <LinearLayout
            android:id="@+id/ll_manual_entry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/et_api_key"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:autofillHints="password"
                android:background="@drawable/bg_phone_search_field"
                android:fontFamily="@font/outfit_semibold"
                android:hint="@string/ui_legacy_real_debrid_api_key"
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:textColor="@color/phone_text_primary"
                android:textColorHint="@color/phone_text_muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_submit_manual"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_phone_btn_secondary"
                android:backgroundTint="@null"
                android:fontFamily="@font/outfit_bold"
                android:stateListAnimator="@null"
                android:text="@string/ui_submit_legacy_key"
                android:textAllCaps="false"
                android:textColor="@color/phone_text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Stacked, not side by side: two half-width buttons on a 411dp screen give neither one
             room for its label, and the primary action wants the full line. -->
        <LinearLayout
            android:id="@+id/ll_auth_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical">

            <Button
                android:id="@+id/btn_start_auth"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_phone_primary_button"
                android:backgroundTint="@null"
                android:fontFamily="@font/outfit_bold"
                android:stateListAnimator="@null"
                android:text="@string/debrid_auth_start"
                android:textAllCaps="false"
                android:textColor="@color/phone_on_accent"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btn_cancel_auth"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_phone_btn_secondary"
                android:backgroundTint="@null"
                android:fontFamily="@font/outfit_bold"
                android:stateListAnimator="@null"
                android:text="@string/cancel"
                android:textAllCaps="false"
                android:textColor="@color/phone_text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_show_manual"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/outfit_semibold"
            android:text="@string/ui_legacy_manual_entry"
            android:textAllCaps="false"
            android:textColor="@color/phone_cyan"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
