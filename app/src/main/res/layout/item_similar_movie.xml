<?xml version="1.0" encoding="utf-8"?>
<!--
  PHONE "more like this" card. Same ids and kinds as the television one; only the poster is sized
  for the hand (a 70dp poster is a thumbnail here) and the focus frame is dropped, because on a
  touchscreen nothing is ever focused.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="112dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/iv_similar_poster"
        android:layout_width="112dp"
        android:layout_height="164dp"
        android:background="@drawable/bg_phone_poster"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        tools:src="@tools:sample/backgrounds/scenic" />

    <TextView
        android:id="@+id/tv_similar_title"
        android:layout_width="112dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:ellipsize="end"
        android:fontFamily="@font/share_tech_mono"
        android:maxLines="1"
        android:textColor="@color/phone_text_muted"
        android:textSize="11.5sp"
        tools:text="2021 - 8.0" />
</LinearLayout>
