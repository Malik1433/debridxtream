<?xml version="1.0" encoding="utf-8"?>
<!-- Home Screen Modern Redesign - Cinematic Theme -->
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home_bg_cinematic"
    android:paddingStart="32dp"
    android:paddingEnd="32dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- ========== HEADER SECTION ========== -->
    
    <!-- App Title/Brand -->
    <TextView
        android:id="@+id/tv_app_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_title"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#FFD700"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.05"
        android:shadowColor="#80000000"
        android:shadowRadius="12"
        android:shadowDx="4"
        android:shadowDy="4"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Background Sync Banner -->
    <LinearLayout
        android:id="@+id/update_banner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@drawable/bg_glass_panel"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tv_app_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/update_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Updating data (0%)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="6dp" />

        <ProgressBar
            android:id="@+id/update_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#FFD700"
            android:backgroundTint="#33FFFFFF" />

        <TextView
            android:id="@+id/update_counts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Live 0  Movies 0  Series 0"
            android:textSize="12sp"
            android:textColor="#B3FFFFFF"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- Search Icon - Top Right -->
    <ImageView
        android:id="@+id/btn_search"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/ic_search"
        android:background="@drawable/search_icon_bg"
        android:padding="10dp"
        android:tint="#FFFFFF"
        android:focusable="true"
        android:clickable="true"
        android:contentDescription="@string/search_content_description"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_settings"
        android:nextFocusLeft="@id/btn_nav_debrid"
        android:nextFocusDown="@id/rv_featured" />

    <!-- Settings Icon - Top Right -->
    <ImageView
        android:id="@+id/btn_settings"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:src="@drawable/ic_settings"
        android:background="@drawable/search_icon_bg"
        android:padding="10dp"
        android:tint="#FFFFFF"
        android:focusable="true"
        android:clickable="true"
        android:contentDescription="@string/settings_content_description"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:nextFocusLeft="@id/btn_search"
        android:nextFocusDown="@id/rv_featured" />

    <!-- Navigation Buttons Container -->
    <LinearLayout
        android:id="@+id/nav_buttons_container"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/update_banner"
        app:layout_goneMarginTop="24dp"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Live TV Button -->
        <TextView
            android:id="@+id/btn_nav_live_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="120dp"
            android:text="@string/nav_live_tv"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/nav_button_gold_selector"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusRight="@id/btn_nav_movies"
            android:nextFocusDown="@id/rv_featured" />

        <!-- Movies Button -->
        <TextView
            android:id="@+id/btn_nav_movies"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="120dp"
            android:text="@string/nav_movies"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/nav_button_ultra_modern"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusLeft="@id/btn_nav_live_tv"
            android:nextFocusRight="@id/btn_nav_series"
            android:nextFocusDown="@id/rv_featured" />

        <!-- Series Button -->
        <TextView
            android:id="@+id/btn_nav_series"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="120dp"
            android:text="@string/nav_series"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/nav_button_ultra_modern"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusLeft="@id/btn_nav_movies"
            android:nextFocusRight="@id/btn_nav_debrid"
            android:nextFocusDown="@id/rv_featured" />

        <!-- Debrid Button -->
        <TextView
            android:id="@+id/btn_nav_debrid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="120dp"
            android:text="@string/nav_debrid"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="@drawable/nav_button_gold_selector"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusLeft="@id/btn_nav_series"
            android:nextFocusRight="@id/btn_search"
            android:nextFocusDown="@id/rv_featured" />

    </LinearLayout>

    <!-- ========== SCROLLABLE CONTENT SECTION ========== -->
    
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:focusable="false"
        android:descendantFocusability="afterDescendants"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/nav_buttons_container"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="32dp">

            <!-- ========== FEATURED CAROUSEL ========== -->
            <LinearLayout
                android:id="@+id/section_featured"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_marginBottom="40dp">

                <TextView
                    android:id="@+id/tv_section_featured"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_featured_content"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FFD700"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="16dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_featured"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipToPadding="false"
                    android:descendantFocusability="afterDescendants"
                    android:nextFocusUp="@id/btn_nav_live_tv"
                    android:nextFocusDown="@id/rv_recent_live"
                    tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_featured_card"
                    tools:itemCount="3" />
            </LinearLayout>

            <!-- ========== RECENT LIVE CHANNELS (CIRCULAR) ========== -->
            <LinearLayout
                android:id="@+id/section_recent_live"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_marginBottom="40dp">

                <TextView
                    android:id="@+id/tv_section_recent_live"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_recently_watched_caps"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="16dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_recent_live"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipToPadding="false"
                    android:descendantFocusability="afterDescendants"
                    android:nextFocusUp="@id/rv_featured"
                    android:nextFocusDown="@id/rv_new_added"
                    tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_recent_live_card"
                    tools:itemCount="6" />
            </LinearLayout>

            <!-- ========== LATEST MOVIES (NEW ARRIVALS) ========== -->
            <LinearLayout
                android:id="@+id/section_new_added"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_marginBottom="40dp">

                <TextView
                    android:id="@+id/tv_section_new_added"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_new_added"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="16dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_new_added"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipToPadding="false"
                    android:descendantFocusability="afterDescendants"
                    android:nextFocusUp="@id/rv_recent_live"
                    android:nextFocusDown="@id/rv_continue_watching"
                    tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_new_added_card"
                    tools:itemCount="8" />
            </LinearLayout>

            <!-- ========== CONTINUE WATCHING ========== -->
            <LinearLayout
                android:id="@+id/section_continue_watching"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_marginBottom="40dp">

                <TextView
                    android:id="@+id/tv_section_continue_watching"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_continue_watching_caps"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="16dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_continue_watching"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipToPadding="false"
                    android:descendantFocusability="afterDescendants"
                    android:nextFocusUp="@id/rv_new_added"
                    android:nextFocusDown="@id/rv_favorites"
                    tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_continue_watching_card"
                    tools:itemCount="5" />
            </LinearLayout>

            <!-- ========== FAVORITES ========== -->
            <LinearLayout
                android:id="@+id/section_favorites"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_marginBottom="40dp">

                <TextView
                    android:id="@+id/tv_section_favorites"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_favorites_caps"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="16dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_favorites"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipToPadding="false"
                    android:descendantFocusability="afterDescendants"
                    android:nextFocusUp="@id/rv_continue_watching"
                    tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_favorite_card"
                    tools:itemCount="5" />
            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
