<?xml version="1.0" encoding="utf-8"?>
<!-- Stremio full-screen Search overlay. Padding 60px 120px / 2 = 30dp 60dp. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/searchOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone"
    android:clickable="true"
    android:focusable="false"
    android:background="#EB06090E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="60dp"
        android:paddingEnd="60dp"
        android:paddingTop="30dp"
        android:paddingBottom="30dp">

        <!-- search input row: 72px/2=36dp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/stremio_search_input"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginBottom="24dp">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/ic_stremio_search"
                app:tint="#00F0FF"
                android:layout_marginEnd="9dp" />

            <EditText
                android:id="@+id/search_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="@font/outfit_medium"
                android:textSize="14sp"
                android:textColor="#F1F5F9"
                android:textColorHint="#475569"
                android:textCursorDrawable="@null"
                android:hint="Search movies, series, actors…"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:inputType="text" />

            <ImageView
                android:id="@+id/search_clear"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:padding="5dp"
                android:src="@drawable/ic_stremio_close"
                app:tint="#64748B"
                android:background="@drawable/stremio_kbd_badge"
                android:layout_marginEnd="6dp"
                android:visibility="gone"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/stremio_kbd_badge"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:fontFamily="@font/share_tech_mono"
                android:textSize="5.5sp"
                android:textColor="#334155"
                android:text="ESC" />
        </LinearLayout>

        <!-- NO-QUERY state -->
        <LinearLayout
            android:id="@+id/search_noquery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- recent -->
            <LinearLayout
                android:layout_width="190dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="40dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/share_tech_mono"
                    android:textSize="5.5sp"
                    android:textColor="#475569"
                    android:letterSpacing="0.1"
                    android:text="RECENT SEARCHES"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:id="@+id/search_recent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- trending + categories -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/share_tech_mono"
                    android:textSize="5.5sp"
                    android:textColor="#475569"
                    android:letterSpacing="0.1"
                    android:text="TRENDING NOW"
                    android:layout_marginBottom="10dp" />

                <com.google.android.flexbox.FlexboxLayout
                    android:id="@+id/search_trending"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:flexWrap="wrap" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/share_tech_mono"
                    android:textSize="5.5sp"
                    android:textColor="#475569"
                    android:letterSpacing="0.1"
                    android:text="BROWSE CATEGORIES"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="8dp" />

                <com.google.android.flexbox.FlexboxLayout
                    android:id="@+id/search_categories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:flexWrap="wrap" />
            </LinearLayout>
        </LinearLayout>

        <!-- HAS-QUERY results -->
        <LinearLayout
            android:id="@+id/search_results_wrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/search_results_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/share_tech_mono"
                android:textSize="5.5sp"
                android:textColor="#475569"
                android:letterSpacing="0.1"
                android:layout_marginBottom="10dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/search_results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </LinearLayout>

    <!-- close button top-right: 30/40px -> 15/20dp -->
    <FrameLayout
        android:id="@+id/search_close"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/stremio_close_btn"
        android:focusable="true">

        <ImageView
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_stremio_close"
            app:tint="#94A3B8" />
    </FrameLayout>
</FrameLayout>
