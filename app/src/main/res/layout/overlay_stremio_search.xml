<?xml version="1.0" encoding="utf-8"?>
<!--
  PHONE Debrid search (design "DX Play Debrid Phone.dc.html", frame 1e).

  What was here was the television's: a 36-key on-screen grid you drove with a D-pad, plus SPACE /
  DEL / CLEAR buttons, and results as a poster grid with 5–7sp captions. On a handset every one of
  those is a defect by the phone rulebook — the native soft keyboard exists, one tap must act, and
  6sp is not readable in the hand. The television file is untouched in layout-television/.

  Every id the controller binds is still here (search_query_bar, search_hint, search_query,
  search_caret, search_count, search_scopes, search_trending*, search_results*, search_noresults*),
  so nothing in the search logic had to learn which device it is on. The two views that only make
  sense with a remote — search_keys and search_actions — are simply absent, and the controller
  looks them up null-safely.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/searchOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/phone_home_bg"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone"
    tools:visibility="visible">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ══ THE FIELD ══ back, then the input. 56dp bar, 44dp field, 48dp touch targets. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/phone_bar_scrim"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/search_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/a11y_back"
                android:focusable="true"
                android:padding="14dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/phone_text_primary" />

            <LinearLayout
                android:id="@+id/search_query_bar"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_phone_search_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="4dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_stremio_search"
                    app:tint="@color/phone_cyan" />

                <!--
                  The real input. inputType textNoSuggestions because a title is not prose and the
                  keyboard's autocorrect fights every foreign name in this catalogue;
                  imeOptions actionSearch so the keyboard's own key ends the query.
                -->
                <EditText
                    android:id="@+id/search_input"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/inter_regular"
                    android:hint="@string/phone_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text|textNoSuggestions"
                    android:maxLines="1"
                    android:textColor="@color/phone_text_primary"
                    android:textColorHint="@color/phone_text_muted"
                    android:textCursorDrawable="@null"
                    android:textSize="14sp"
                    tools:ignore="Autofill" />

                <ImageView
                    android:id="@+id/search_clear"
                    android:layout_width="@dimen/tap_min"
                    android:layout_height="@dimen/tap_min"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/clear"
                    android:focusable="true"
                    android:padding="12dp"
                    android:src="@drawable/ic_clear"
                    android:visibility="gone"
                    app:tint="@color/phone_text_muted"
                    tools:visibility="visible" />

                <!-- The blinking caret belongs to a screen with no cursor of its own. The EditText
                     draws a real one, so this stays for the binder and never shows. -->
                <View
                    android:id="@+id/search_caret"
                    android:layout_width="0dp"
                    android:layout_height="0dp" />

                <TextView
                    android:id="@+id/search_hint"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/search_query"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- ══ COUNT, THEN SCOPE ══
             The design puts these on one line, with three chips. This app has a fourth the design
             did not know about — Live — and dropping a working filter to match a picture is the
             wrong trade, so the chips take a line of their own. On one line at 411dp the count
             pushed "Live" half off the screen, and a control sliced by the edge reads as broken
             even when it is only scrolled. -->
        <TextView
            android:id="@+id/search_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/share_tech_mono"
            android:letterSpacing="0.16"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:textColor="@color/phone_text_muted"
            android:textSize="12sp"
            tools:text="14 RESULTS" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/search_scopes"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- ══ RESULTS ══ -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/search_results_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="16dp">

                    <!-- Suggested terms, shown only while nothing has been typed. -->
                    <LinearLayout
                        android:id="@+id/search_trending_wrap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="14dp">

                        <!-- A bare row of chips is a puzzle; one line says what they are for. -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:fontFamily="@font/share_tech_mono"
                            android:letterSpacing="0.16"
                            android:text="@string/phone_search_try"
                            android:textColor="@color/phone_text_muted"
                            android:textSize="12sp" />

                        <com.google.android.flexbox.FlexboxLayout
                            android:id="@+id/search_trending"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:flexWrap="wrap" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="4dp">

                        <View
                            android:id="@+id/search_results_accent"
                            android:layout_width="3dp"
                            android:layout_height="14dp"
                            android:background="@drawable/stremio_search_accent_cyan" />

                        <TextView
                            android:id="@+id/search_results_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="@font/outfit_bold"
                            android:maxLines="1"
                            android:textColor="@color/phone_text_primary"
                            android:textSize="15sp"
                            tools:text="Popular right now" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/search_results"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                    <LinearLayout
                        android:id="@+id/search_noresults"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="48dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/search_noresults_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/outfit_bold"
                            android:textColor="@color/phone_text_primary"
                            android:textSize="17sp"
                            tools:text="No matches for &quot;NIGHTFALL&quot;" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/inter_regular"
                            android:lineSpacingMultiplier="1.6"
                            android:text="@string/phone_search_no_results_body"
                            android:textColor="@color/phone_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </FrameLayout>
    </LinearLayout>

</FrameLayout>
