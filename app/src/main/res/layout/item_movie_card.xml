<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:padding="2dp"
    android:clipToPadding="false"
    android:clipChildren="false">

    <!-- Focused Glow View (Anchored to Card) -->
    <View
        android:id="@+id/glow_focus"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="-12dp"
        android:alpha="0"
        android:background="@drawable/bg_movie_focus_cyan"
        app:layout_constraintTop_toTopOf="@id/card_container"
        app:layout_constraintBottom_toBottomOf="@id/card_container"
        app:layout_constraintStart_toStartOf="@id/card_container"
        app:layout_constraintEnd_toEndOf="@id/card_container" />

    <androidx.cardview.widget.CardView
        android:id="@+id/card_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="2:3"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@android:color/transparent">

        <!-- Poster Image -->
        <ImageView
            android:id="@+id/iv_movie_poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Movie Poster"
            android:scaleType="centerCrop" />

        <!-- Top Right Quality Badge (e.g., 4K) -->
        <LinearLayout
            android:id="@+id/ll_quality_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@drawable/bg_badge_quality"
            android:orientation="horizontal"
            android:paddingHorizontal="5dp"
            android:paddingVertical="2dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tv_quality_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4K"
                android:textColor="@android:color/white"
                android:textSize="9sp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Top Left Favorite Heart -->
        <ImageView
            android:id="@+id/iv_favorite_indicator"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|start"
            android:layout_margin="4dp"
            android:padding="5dp"
            android:src="@drawable/ic_favorite"
            app:tint="@color/brand_cyan"
            android:background="@drawable/bg_circle_dark_translucent"
            android:visibility="gone" />

        <!-- Glass Metadata Layer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_glass_card_footer"
            android:orientation="vertical"
            android:paddingBottom="12dp"
            android:paddingHorizontal="10dp"
            android:paddingTop="12dp">

            <TextView
                android:id="@+id/tv_movie_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="Movie Title"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textStyle="bold"
                android:lineSpacingExtra="2dp"
                android:letterSpacing="0.01" />

            <!-- Metadata Row: Star | Rating | Year | Lang -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_favorite" 
                    app:tint="#FFD700"
                    android:contentDescription="Rating Star"/>

                <TextView
                    android:id="@+id/tv_movie_rating_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8.9"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:layout_marginStart="2dp"/>
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" • "
                    android:textColor="#66FFFFFF"
                    android:textSize="8sp"
                    android:layout_marginStart="2dp"/>

                 <TextView
                    android:id="@+id/tv_movie_year"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2024"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:layout_marginStart="4dp"/>

                <!-- Extra space before badge -->
                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>

                <!-- Language / Format Badge -->
                <TextView
                    android:id="@+id/tv_lang_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MULTI"
                    android:textColor="#FFFFFF"
                    android:textSize="7sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp"
                    android:background="@drawable/bg_badge_quality"
                    android:visibility="gone"/>

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
