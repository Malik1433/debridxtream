<?xml version="1.0" encoding="utf-8"?>
<!--
  The three endings of a paged list, in one 72dp row: loading more, the end of the catalogue, and
  a page that failed. The loaded rows always stay - a page failure is never a full-screen error
  over content the user already has.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp">

    <ProgressBar
        android:id="@+id/phone_foot_spinner"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:indeterminateTint="@color/phone_cyan"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/phone_foot_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:fontFamily="@font/share_tech_mono"
        android:letterSpacing="0.12"
        android:textColor="@color/phone_text_muted"
        android:textSize="12sp"
        tools:text="LOADING MORE - 120 OF 1,204" />

    <TextView
        android:id="@+id/phone_foot_retry"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:background="@drawable/bg_phone_chip_active"
        android:fontFamily="@font/outfit_semibold"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:text="@string/phone_retry"
        android:textColor="@color/phone_cyan"
        android:textSize="13sp"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
