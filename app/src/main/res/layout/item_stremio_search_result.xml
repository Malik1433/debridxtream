<?xml version="1.0" encoding="utf-8"?>
<!-- Search result: 160x240 px / 2 = 80 x 120 dp, radius 10px/2=5dp -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sr_card"
    android:layout_width="80dp"
    android:layout_height="120dp"
    android:layout_marginEnd="7dp"
    android:layout_marginBottom="7dp"
    android:focusable="true"
    android:clipChildren="true"
    android:foreground="@drawable/stremio_grid_focus_fg">

    <ImageView
        android:id="@+id/sr_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/sr_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/sr_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:fontFamily="@font/share_tech_mono"
        android:textSize="4sp"
        android:textColor="#041014"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/sr_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit_semibold"
            android:textSize="5.5sp"
            android:textColor="#F1F5F9"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/sr_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/share_tech_mono"
            android:textSize="4.5sp"
            android:textColor="#475569"
            android:layout_marginTop="1dp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>
