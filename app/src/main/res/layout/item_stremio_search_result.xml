<?xml version="1.0" encoding="utf-8"?>
<!--
  PHONE search result — a ROW (design "DX Play Debrid Phone.dc.html", frame 1e).

  The television's answer is a poster grid with 5–7sp captions: right at three metres, useless in
  the hand. On a phone a search result is read, not browsed — you already know what you typed — so
  the design gives it a 72dp row with a thumbnail, a real title, a meta line and the type badge.

  Same ids as the television card (sr_card, sr_image, sr_overlay, sr_type, sr_live, sr_title,
  sr_meta), so StremioSearchResultAdapter binds either without knowing which it got.

  The chevron on the right is an AFFORDANCE, not a second control: the whole row is the tap target
  (one tap acts), and a button that repeats what the row already does is worse than no button.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sr_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="80dp">

        <ImageView
            android:id="@+id/sr_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_phone_poster"
            android:clipToOutline="true"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <!-- The television tints the poster on focus; on a phone it stays a plain thumbnail, but
             the view must exist for the shared binder. -->
        <View
            android:id="@+id/sr_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/sr_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/outfit_semibold"
            android:maxLines="2"
            android:textColor="@color/phone_text_primary"
            android:textSize="14sp"
            tools:text="Nightfall" />

        <TextView
            android:id="@+id/sr_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:fontFamily="@font/share_tech_mono"
            android:maxLines="1"
            android:textColor="@color/phone_text_muted"
            android:textSize="12sp"
            tools:text="2025 · ⭐8.5" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sr_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/share_tech_mono"
                android:letterSpacing="0.06"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="MOVIE" />

            <LinearLayout
                android:id="@+id/sr_live"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/stremio_live_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:visibility="gone"
                tools:visibility="visible">

                <View
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/stremio_live_dot" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/share_tech_mono"
                    android:text="@string/livev2_live_badge"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_stremio_chevron_right"
        app:tint="@color/phone_text_muted" />

</LinearLayout>
