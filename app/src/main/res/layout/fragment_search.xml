<?xml version="1.0" encoding="utf-8"?>
<!--
  PHONE Search — portrait.

  The television version is untouched in layout-television/: there, a query bar across the top and
  an A-Z key grid you walk with a D-pad is exactly right. On a handset it is the wrong instrument
  entirely, so this file keeps the SAME ids in the same kinds and rearranges them for a thumb:
  one column, a real 48dp field the system keyboard types into, scope chips under it, and the
  results filling everything below.

  The key grid and its SPACE / DEL / CLEAR row exist here only as gone stubs. They are D-pad
  affordances, and the phone rulebook is explicit: the native soft keyboard, never an on-screen
  D-pad one.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/phone_home_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="64dp">

        <!-- ══ QUERY ══ a real field, so the phone's own keyboard, dictionary and paste apply. -->
        <LinearLayout
            android:id="@+id/search_query_bar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_phone_search_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_search"
                app:tint="@color/phone_cyan" />

            <TextView
                android:id="@+id/search_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/inter_regular"
                android:maxLines="1"
                android:text="@string/ui_search_movies_series"
                android:textColor="@color/phone_text_muted"
                android:textSize="13.5sp" />

            <EditText
                android:id="@+id/search_query"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="@font/outfit_semibold"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/phone_text_primary"
                android:textSize="14sp"
                android:visibility="gone"
                tools:ignore="LabelFor"
                tools:visibility="visible" />

            <!-- The blinking caret belongs to the television's fake field; a real EditText brings
                 its own, and two carets is one too many. -->
            <View
                android:id="@+id/search_caret"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/search_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/share_tech_mono"
                android:textColor="@color/phone_text_muted"
                android:textSize="12sp"
                tools:text="24" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:overScrollMode="never"
            android:paddingHorizontal="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/search_scopes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- D-pad instruments, kept only so the shared code can bind them. -->
        <LinearLayout
            android:id="@+id/search_keys"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/search_actions"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/search_results_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingTop="14dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/search_trending_wrap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/search_trending_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:fontFamily="@font/outfit_bold"
                        android:text="@string/ui_trending_searches"
                        android:textColor="@color/phone_text_primary"
                        android:textSize="15sp" />

                    <com.google.android.flexbox.FlexboxLayout
                        android:id="@+id/search_trending"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:paddingHorizontal="16dp"
                        app:flexWrap="wrap" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/search_results_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <View
                        android:id="@+id/search_results_accent"
                        android:layout_width="3dp"
                        android:layout_height="14dp"
                        android:background="@color/phone_cyan" />

                    <TextView
                        android:id="@+id/search_results_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/outfit_bold"
                        android:textColor="@color/phone_text_primary"
                        android:textSize="15sp"
                        tools:text="Results" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/search_results"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingHorizontal="16dp"
                    android:scrollbars="none" />

                <LinearLayout
                    android:id="@+id/search_noresults"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="40dp"
                    android:background="@drawable/bg_phone_dashed_panel"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="26dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/search_noresults_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/outfit_bold"
                        android:gravity="center"
                        android:textColor="@color/phone_text_primary"
                        android:textSize="13.5sp"
                        tools:text="No results for &quot;dune&quot;" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="24dp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- Search is a tab, so it carries the bar its siblings carry. -->
    <LinearLayout
        android:id="@+id/search_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="@color/phone_nav_scrim"
        android:orientation="horizontal" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
