<?xml version="1.0" encoding="utf-8"?>
<!--
  Main-home Search screen — rebuilt to "Search Page.dc.html" (shares the design with the Debrid
  search overlay). 10-foot on-screen keyboard (left) + results grid (right). Wired to SearchViewModel
  (IPTV live / VOD / series). Scale = design px / 2 = dp. Dynamic content built in SearchFragment.kt.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#06090E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="32dp"
        android:paddingTop="28dp">

        <!-- title + query bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit_extrabold"
                android:textSize="17sp"
                android:textColor="#F1F5F9"
                android:letterSpacing="-0.02"
                android:text="@string/nav_search"
                android:layout_marginEnd="11dp" />

            <LinearLayout
                android:id="@+id/search_query_bar"
                android:layout_width="0dp"
                android:layout_height="33dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_stremio_search"
                    app:tint="#00F0FF"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@null" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/search_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="11sp"
                        android:textColor="#475569"
                        android:singleLine="true"
                        android:text="@string/ui_search_movies_series_live_channels" />

                    <TextView
                        android:id="@+id/search_query"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/outfit_semibold"
                        android:textSize="12sp"
                        android:textColor="#F1F5F9"
                        android:letterSpacing="0.02"
                        android:singleLine="true"
                        android:visibility="gone" />
                </FrameLayout>

                <View
                    android:id="@+id/search_caret"
                    android:layout_width="2dp"
                    android:layout_height="15dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="8dp"
                    android:background="#00F0FF" />

                <TextView
                    android:id="@+id/search_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/share_tech_mono"
                    android:textSize="6.5sp"
                    android:textColor="#475569"
                    android:letterSpacing="0.06"
                    tools:text="8 RESULTS" />
            </LinearLayout>
        </LinearLayout>

        <!-- main: keyboard + results -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="226dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/search_scopes"
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:id="@+id/search_keys"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="7dp" />

                <LinearLayout
                    android:id="@+id/search_actions"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:orientation="horizontal"
                    android:layout_marginTop="7dp" />
            </LinearLayout>

            <androidx.core.widget.NestedScrollView
                android:id="@+id/search_results_scroll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="20dp"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:paddingBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/search_trending_wrap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <View
                                android:layout_width="2dp"
                                android:layout_height="10dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/stremio_search_accent_cyan" />

                            <TextView
                                android:id="@+id/search_trending_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/outfit_bold"
                                android:textSize="10sp"
                                android:textColor="#F1F5F9"
                                android:text="@string/ui_trending_searches" />
                        </LinearLayout>

                        <com.google.android.flexbox.FlexboxLayout
                            android:id="@+id/search_trending"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="18dp"
                            app:flexWrap="wrap" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/search_results_header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp"
                        android:visibility="gone">

                        <View
                            android:id="@+id/search_results_accent"
                            android:layout_width="2dp"
                            android:layout_height="10dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/stremio_search_accent_cyan" />

                        <TextView
                            android:id="@+id/search_results_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/outfit_bold"
                            android:textSize="10sp"
                            android:textColor="#F1F5F9"
                            tools:text="Results" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/search_results"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:nestedScrollingEnabled="false" />

                    <LinearLayout
                        android:id="@+id/search_noresults"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingTop="40dp"
                        android:paddingBottom="40dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_stremio_search"
                            app:tint="#334155"
                            android:layout_marginBottom="8dp"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/search_noresults_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/outfit_semibold"
                            android:textSize="9.5sp"
                            android:textColor="#64748B"
                            tools:text="No matches for &quot;DUNE&quot;" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_regular"
                            android:textSize="7.5sp"
                            android:textColor="#475569"
                            android:layout_marginTop="6dp"
                            android:text="@string/ui_try_a_different_title_or" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
