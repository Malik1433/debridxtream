<?xml version="1.0" encoding="utf-8"?>
<!--
    CINEMATIC INITIAL SYNC (drop-in for fragment_initial_sync.xml)

    All original IDs preserved exactly:
      iv_sync_watermark, sync_card, sync_header, iv_sync_icon,
      tv_sync_title, tv_sync_subtitle,
      tv_sync_status, tv_sync_percent, sync_progress,
      sync_counts_row, tv_count_live, tv_count_movies, tv_count_series,
      tv_sync_note, tv_sync_error, btn_sync_retry
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cin_bg_app">

    <!-- Ambient bloom -->
    <ImageView
        android:layout_width="900dp"
        android:layout_height="900dp"
        android:alpha="0.55"
        android:contentDescription="@null"
        android:src="@drawable/cin_bloom_gold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cin_vignette_radial" />

    <!-- Wordmark watermark, low opacity -->
    <ImageView
        android:id="@+id/iv_sync_watermark"
        android:layout_width="280dp"
        android:layout_height="120dp"
        android:alpha="0.10"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/cin_logo_wordmark"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.92" />

    <!-- Sync card -->
    <LinearLayout
        android:id="@+id/sync_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/cin_space_12"
        android:background="@drawable/cin_card_glass"
        android:orientation="vertical"
        android:padding="@dimen/cin_space_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="760dp">

        <!-- Header row -->
        <LinearLayout
            android:id="@+id/sync_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/cin_pill_glass">
                <ImageView
                    android:id="@+id/iv_sync_icon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_weather_cloud"
                    app:tint="@color/cin_gold_300" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/cin_space_4"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_sync_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_extrabold"
                    android:letterSpacing="-0.01"
                    android:text="Preparing your library"
                    android:textColor="@color/cin_text_primary"
                    android:textSize="@dimen/cin_text_title_sm" />

                <TextView
                    android:id="@+id/tv_sync_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="Syncing channels, movies and series"
                    android:textColor="@color/cin_text_tertiary"
                    android:textSize="@dimen/cin_text_caption" />
            </LinearLayout>
        </LinearLayout>

        <!-- Status + percent row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cin_space_6"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_sync_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Preparing data"
                android:textColor="@color/cin_text_primary"
                android:textSize="@dimen/cin_text_body"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_sync_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_extrabold"
                android:text="0%"
                android:textColor="@color/cin_gold_300"
                android:textSize="@dimen/cin_text_body" />
        </LinearLayout>

        <!-- Progress bar -->
        <ProgressBar
            android:id="@+id/sync_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="@dimen/cin_space_3"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/cin_progress_gold" />

        <!-- Counts row (3 glass pills, evenly weighted) -->
        <LinearLayout
            android:id="@+id/sync_counts_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cin_space_5"
            android:orientation="horizontal"
            android:weightSum="3">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/cin_pill_glass"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/cin_space_4">

                <TextView
                    android:id="@+id/tv_count_live"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_extrabold"
                    android:text="0"
                    android:textColor="@color/cin_gold_300"
                    android:textSize="@dimen/cin_text_title_sm" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cin_space_1"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:letterSpacing="0.18"
                    android:text="LIVE"
                    android:textAllCaps="true"
                    android:textColor="@color/cin_text_tertiary"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/cin_space_3"
                android:layout_weight="1"
                android:background="@drawable/cin_pill_glass"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/cin_space_4">

                <TextView
                    android:id="@+id/tv_count_movies"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_extrabold"
                    android:text="0"
                    android:textColor="@color/cin_gold_300"
                    android:textSize="@dimen/cin_text_title_sm" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cin_space_1"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:letterSpacing="0.18"
                    android:text="MOVIES"
                    android:textAllCaps="true"
                    android:textColor="@color/cin_text_tertiary"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/cin_space_3"
                android:layout_weight="1"
                android:background="@drawable/cin_pill_glass"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/cin_space_4">

                <TextView
                    android:id="@+id/tv_count_series"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_extrabold"
                    android:text="0"
                    android:textColor="@color/cin_gold_300"
                    android:textSize="@dimen/cin_text_title_sm" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cin_space_1"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:letterSpacing="0.18"
                    android:text="SERIES"
                    android:textAllCaps="true"
                    android:textColor="@color/cin_text_tertiary"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Note -->
        <TextView
            android:id="@+id/tv_sync_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cin_space_4"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="First sync can take a minute. Please keep the app open."
            android:textColor="@color/cin_text_tertiary"
            android:textSize="@dimen/cin_text_caption" />

        <!-- Error + retry -->
        <TextView
            android:id="@+id/tv_sync_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cin_space_3"
            android:fontFamily="@font/plus_jakarta_sans"
            android:text="Sync failed. Check your connection."
            android:textColor="@color/cin_error"
            android:textSize="@dimen/cin_text_caption"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sync_retry"
            style="@style/Cin.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/cin_btn_h"
            android:layout_marginTop="@dimen/cin_space_4"
            android:paddingHorizontal="@dimen/cin_space_8"
            android:text="Retry sync"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
