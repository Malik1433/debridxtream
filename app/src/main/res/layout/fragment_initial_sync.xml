<?xml version="1.0" encoding="utf-8"?>
<!--
  PHONE first sync — portrait.

  The television card is a wide panel read across a room. On a handset in landscape it put RETRY
  SYNC off the bottom edge, so a first sync that failed left a NEW user on a dead screen with no
  way to try again. That is the whole reason this fork exists.

  Same ids, same kinds, one column, and the retry button inside the card where it cannot escape.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/phone_home_bg">

    <ImageView
        android:id="@+id/iv_sync_watermark"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/sync_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_margin="20dp"
        android:background="@drawable/bg_phone_card"
        android:padding="20dp">

        <LinearLayout
            android:id="@+id/sync_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_sync_icon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_weather_cloud"
                app:tint="@color/phone_cyan" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_sync_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit_bold"
                    android:textColor="@color/phone_text_primary"
                    android:textSize="18sp"
                    tools:text="Preparing your library" />

                <TextView
                    android:id="@+id/tv_sync_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/inter_regular"
                    android:textColor="@color/phone_text_secondary"
                    android:textSize="13sp"
                    tools:text="Syncing channels, movies, and series" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_sync_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/outfit_semibold"
            android:textColor="@color/phone_text_primary"
            android:textSize="15sp"
            app:layout_constraintEnd_toStartOf="@id/tv_sync_percent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sync_header"
            tools:text="Syncing" />

        <TextView
            android:id="@+id/tv_sync_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/share_tech_mono"
            android:textColor="@color/phone_amber"
            android:textSize="15sp"
            app:layout_constraintBaseline_toBaselineOf="@id/tv_sync_status"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="0%" />

        <ProgressBar
            android:id="@+id/sync_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progressDrawable="@drawable/bg_phone_button_progress"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_sync_status" />

        <LinearLayout
            android:id="@+id/sync_counts_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sync_progress">

            <TextView
                android:id="@+id/tv_count_live"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/share_tech_mono"
                android:textColor="@color/phone_text_secondary"
                android:textSize="13sp"
                tools:text="0 Channels" />

            <TextView
                android:id="@+id/tv_count_movies"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/share_tech_mono"
                android:gravity="center"
                android:textColor="@color/phone_text_secondary"
                android:textSize="13sp"
                tools:text="0 Movies" />

            <TextView
                android:id="@+id/tv_count_series"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/share_tech_mono"
                android:gravity="end"
                android:textColor="@color/phone_text_secondary"
                android:textSize="13sp"
                tools:text="0 Series" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_sync_note"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/inter_regular"
            android:lineSpacingMultiplier="1.4"
            android:textColor="@color/phone_text_muted"
            android:textSize="12.5sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sync_counts_row"
            tools:text="First sync can take a minute. Please keep the app open." />

        <TextView
            android:id="@+id/tv_sync_error"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/inter_regular"
            android:lineSpacingMultiplier="1.4"
            android:textColor="@color/phone_amber"
            android:textSize="12.5sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_sync_note"
            tools:text="Could not reach your provider."
            tools:visibility="visible" />

        <!-- The retry the phone lost. Inside the card, full width, 52dp. -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_sync_retry"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_phone_primary_button"
            android:fontFamily="@font/outfit_bold"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/phone_on_accent"
            android:textSize="14sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_sync_error"
            tools:text="Retry sync"
            tools:visibility="visible" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
