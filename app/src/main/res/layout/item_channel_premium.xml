<?xml version="1.0" encoding="utf-8"?>
<!--
    PREMIUM CHANNEL ITEM (Samsung One UI 2025 Style)
    Used in fragment_live_premium.xml
    Preserves IDs for ChannelPagingAdapter compatibility.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="108dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="12dp"
    android:layout_marginHorizontal="8dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Premium Card Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cin_premium_channel_card_bg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="20dp">

        <!-- Focus highlight bar -->
        <View
            android:id="@+id/view_focus_bar"
            android:layout_width="4dp"
            android:layout_height="56dp"
            android:layout_marginEnd="16dp"
            android:background="#3B82F6"
            android:visibility="invisible" />

        <!-- High-res Logo Frame -->
        <FrameLayout
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/cin_premium_logo_bg"
            android:padding="8dp"
            android:translationY="0dp"
            android:layout_marginEnd="18dp">

            <ImageView
                android:id="@+id/iv_channel_logo_horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                tools:src="@android:drawable/ic_menu_gallery" />
        </FrameLayout>

        <!-- Content Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:translationY="0dp">

            <TextView
                android:id="@+id/tv_channel_name_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Discovery Science HD"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF"
                android:fontFamily="@font/inter_extrabold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_epg_now"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                tools:text="How It's Made: Quantum Computers"
                android:textSize="13sp"
                android:textColor="#B8C0CC"
                android:fontFamily="@font/inter"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Progress & Badges -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ProgressBar
                    android:id="@+id/pb_epg_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="3dp"
                    android:max="100"
                    android:progress="65"
                    android:progressDrawable="@drawable/cin_premium_progress_bar" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:translationY="0dp"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/badge_4k"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4K"
                        android:textColor="#3B82F6"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:background="@drawable/cin_premium_badge_bg"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/badge_hd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HD"
                        android:textColor="#B8C0CC"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:background="@drawable/cin_premium_badge_bg"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Hidden Next Program -->
        <TextView android:id="@+id/tv_epg_next" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

        <ImageView
            android:id="@+id/iv_favorite_indicator"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_favorite"
            app:tint="#3B82F6"
            android:layout_marginStart="16dp"
            android:visibility="gone" />

    </LinearLayout>
</FrameLayout>
