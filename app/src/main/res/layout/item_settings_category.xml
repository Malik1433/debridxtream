<?xml version="1.0" encoding="utf-8"?>
<!-- Settings category row — "Settings Screen.dc.html". 64px/2 = 32dp. Bg/focus set in adapter. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cat_root"
    android:layout_width="match_parent"
    android:layout_height="54dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingEnd="18dp"
    android:layout_marginBottom="3dp"
    android:focusable="true"
    android:focusableInTouchMode="@bool/rows_focusable_in_touch_mode"
    android:clickable="true">

    <View
        android:id="@+id/v_cat_bar"
        android:layout_width="4dp"
        android:layout_height="30dp"
        android:layout_marginEnd="14dp" />

    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:padding="7dp"
        android:scaleType="fitCenter"
        android:layout_marginEnd="16dp"
        android:src="@drawable/ic_settings" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit_semibold"
            android:textSize="18sp"
            android:textColor="#F1F5F9"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="General" />

        <TextView
            android:id="@+id/tv_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/share_tech_mono"
            android:textSize="12sp"
            android:textColor="#3D4F60"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <ImageView
        android:id="@+id/iv_arrow"
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:src="@drawable/ic_arrow_right"
        app:tint="#3D4F60" />
</LinearLayout>
