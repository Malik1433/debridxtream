<?xml version="1.0" encoding="utf-8"?>
<!--
  PHONE settings category — a chip in a horizontal rail.

  The television row (layout-television/) is match_parent wide because it lives in a vertical rail
  beside the panel. Reused as-is in the phone's horizontal rail, the first category took the whole
  screen and the other seven were off it entirely.

  Same ids, same kinds: the accent bar and the chevron are gone stubs, because a chip that is
  already highlighted needs neither a selection bar nor an arrow to somewhere.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cat_root"
    android:layout_width="wrap_content"
    android:layout_height="48dp"
    android:layout_marginEnd="8dp"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp">

    <View
        android:id="@+id/v_cat_bar"
        android:layout_width="0dp"
        android:layout_height="0dp" />

    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/outfit_semibold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/phone_text_primary"
        android:textSize="13sp"
        tools:text="Playback" />

    <!-- The subtitle is the rail's second line on television; a chip has room for the name only,
         and the panel below repeats it in full the moment the chip is chosen. -->
    <TextView
        android:id="@+id/tv_sub"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/iv_arrow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:visibility="gone" />
</LinearLayout>
