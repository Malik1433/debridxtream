<?xml version="1.0" encoding="utf-8"?>
<!-- Modern 3-Column TV Layout with Preview Panel -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:clipChildren="false"
    android:background="@drawable/live_tv_background">

    <!-- ==================== LEFT SIDEBAR ==================== -->
    <LinearLayout
        android:id="@+id/sidebar_container"
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:clipChildren="false"
        android:background="@drawable/live_tv_sidebar_bg"
        android:paddingTop="22dp"
        android:paddingBottom="24dp">

        <!-- Section Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/live_sidebar_section_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/tv_text_primary"
            android:layout_marginStart="24dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/search_bar_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/search"
                android:src="@drawable/ic_search"
                android:tint="@color/tv_text_secondary" />

            <EditText
                android:id="@+id/et_category_search"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/live_category_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:nextFocusDown="@id/rv_sidebar_categories"
                android:textColor="@color/tv_text_primary"
                android:textColorHint="@color/tv_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Country/Category List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_sidebar_categories"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="true"
            android:nextFocusRight="@id/rv_channels_horizontal"
            android:nextFocusUp="@id/et_category_search" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/icon_live_tv"
                android:layout_width="0dp"
                android:layout_height="0dp" />

            <ImageView
                android:id="@+id/icon_favorites"
                android:layout_width="0dp"
                android:layout_height="0dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- ==================== CENTER: CHANNEL LIST ==================== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:clipChildren="false"
        android:paddingTop="28dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <!-- Channel List Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tv_category_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/live_category_placeholder"
                android:textSize="24sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="@color/tv_text_primary" />

            <TextView
                android:id="@+id/tv_channel_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/live_channel_count_placeholder"
                android:textSize="13sp"
                android:includeFontPadding="false"
                android:textColor="@color/tv_text_secondary" />
        </LinearLayout>

        <!-- Channels content container (list + loading/empty overlays) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false">

            <!-- Horizontal Channel Cards RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_channels_horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:focusable="true"
                android:nextFocusLeft="@id/rv_sidebar_categories"
                android:nextFocusRight="@id/preview_panel_container" />

            <!-- Loading state -->
            <LinearLayout
                android:id="@+id/ll_loading_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/tv_accent_cyan" />

                <TextView
                    android:id="@+id/tv_loading_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/live_loading_channels"
                    android:textSize="16sp"
                    android:textColor="@color/tv_text_secondary" />
            </LinearLayout>

            <!-- Empty state -->
            <TextView
                android:id="@+id/tv_empty_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/live_no_channels"
                android:textSize="18sp"
                android:textColor="@color/tv_text_secondary"
                android:visibility="gone" />
        </FrameLayout>

    </LinearLayout>

    <!-- ==================== RIGHT: PREVIEW PANEL ==================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/preview_panel_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.15"
        android:background="@android:color/transparent"
        android:clipChildren="false"
        android:paddingTop="16dp"
        android:paddingStart="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

        <!-- Top Bar (Time, Weather, Search, Profile) -->
        <LinearLayout
            android:id="@+id/preview_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="10dp"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Time -->
            <TextView
                android:id="@+id/tv_current_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/live_time_placeholder"
                android:textSize="14sp"
                android:textStyle="normal"
                android:textColor="@color/tv_text_primary"
                android:layout_marginEnd="12dp" />

            <ImageView
                android:id="@+id/iv_weather_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_weather_cloud"
                android:tint="@color/tv_text_secondary"
                android:layout_marginEnd="6dp"
                android:contentDescription="@string/live_preview_weather_icon" />

            <!-- Weather (Optional) -->
            <TextView
                android:id="@+id/tv_weather"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/live_preview_weather_placeholder"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="11sp"
                android:textColor="@color/tv_text_tertiary" />

            <!-- Search Icon -->
            <ImageView
                android:id="@+id/btn_preview_search"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_search"
                android:tint="@color/tv_text_primary"
                android:padding="8dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/topbar_icon_bg"
                android:scaleType="center"
                android:contentDescription="@string/search_content_description"
                android:focusable="true" />

            <!-- Profile Icon -->
            <ImageView
                android:id="@+id/btn_profile"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_menu_myplaces"
                android:tint="@color/tv_text_primary"
                android:background="@drawable/avatar_circle_bg"
                android:padding="8dp"
                android:scaleType="center"
                android:contentDescription="@string/settings_content_description"
                android:focusable="true" />
        </LinearLayout>

        <!-- Preview Video Container -->
        <FrameLayout
            android:id="@+id/preview_video_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/preview_frame_bg"
            android:clipToOutline="true"
            app:layout_constraintTop_toBottomOf="@id/preview_top_bar"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- ExoPlayer Preview -->
            <androidx.media3.ui.PlayerView
                android:id="@+id/preview_player_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/preview_placeholder_bg"
                app:resize_mode="zoom"
                app:use_controller="false"
                app:show_buffering="when_playing"
                app:surface_type="texture_view" />

            <!-- Loading State -->
            <FrameLayout
                android:id="@+id/preview_loading_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/preview_placeholder_bg"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/tv_accent_cyan" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="80dp"
                    android:text="@string/live_preview_loading_state"
                    android:textSize="14sp"
                    android:textColor="@color/tv_text_secondary" />
            </FrameLayout>

            <!-- Fullscreen Button Overlay -->
            <ImageView
                android:id="@+id/btn_fullscreen"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="12dp"
                android:src="@android:drawable/ic_menu_crop"
                android:tint="@color/tv_text_primary"
                android:background="@drawable/topbar_icon_bg"
                android:padding="9dp"
                android:contentDescription="@string/live_preview_fullscreen"
                android:focusable="true"
                android:clickable="true" />

            <!-- Preview Info Container -->
            <LinearLayout
                android:id="@+id/preview_info_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingBottom="14dp"
                android:background="@drawable/hero_info_scrim">

                <!-- Now Playing Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/live_preview_label_now"
                    android:textSize="10sp"
                    android:textColor="@color/tv_text_tertiary"
                    android:layout_marginBottom="6dp" />

                <!-- Program Title -->
                <TextView
                    android:id="@+id/tv_preview_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/live_preview_title_placeholder"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/tv_text_primary"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_marginBottom="8dp" />

                <!-- Program Description -->
                <TextView
                    android:id="@+id/tv_preview_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/live_preview_description_placeholder"
                    android:textSize="12sp"
                    android:textColor="@color/tv_text_secondary"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:lineSpacingMultiplier="1.2"
                    android:layout_marginBottom="10dp" />

                <!-- Progress Bar -->
                <ProgressBar
                    android:id="@+id/preview_progress_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:progressTint="@color/tv_progress_fill"
                    android:progressBackgroundTint="@color/tv_progress_bg"
                    android:layout_marginBottom="4dp" />

                <!-- Time Stamps -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_current_time_preview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/live_time_placeholder"
                        android:textSize="11sp"
                        android:textColor="@color/tv_text_tertiary" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tv_total_time_preview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/live_time_placeholder"
                        android:textSize="11sp"
                        android:textColor="@color/tv_text_tertiary" />
                </LinearLayout>

                <!-- Quick Actions (EPG Next, Favorite, etc.) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <TextView
                        android:id="@+id/btn_favorite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/live_favorite_action_add"
                        android:textSize="11sp"
                        android:textColor="@color/tv_text_secondary"
                        android:padding="5dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/btn_secondary_outline"
                        android:focusable="true"
                        android:clickable="true"
                        android:contentDescription="@string/live_favorite_action_add" />

                    <TextView
                        android:id="@+id/btn_epg_next"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/live_preview_next_button"
                        android:textSize="11sp"
                        android:textColor="@color/tv_text_secondary"
                        android:padding="5dp"
                        android:background="@drawable/btn_secondary_outline"
                        android:focusable="true"
                        android:clickable="true"
                        android:contentDescription="@string/live_preview_next_button" />
                </LinearLayout>

            </LinearLayout>
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>




