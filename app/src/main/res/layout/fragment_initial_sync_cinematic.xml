<?xml version="1.0" encoding="utf-8"?>
<!--
    CINEMATIC INITIAL SYNC / SPLASH
    Wired to InitialSyncFragment. IDs match the fragment's findViewById calls:
      sync_progress, tv_sync_status, tv_sync_percent,
      tv_count_live, tv_count_movies, tv_count_series,
      tv_sync_error, btn_sync_retry
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cin_bg_app">

    <!-- Ambient bloom -->
    <ImageView
        android:layout_width="800dp"
        android:layout_height="800dp"
        android:layout_gravity="center"
        android:src="@drawable/cin_bloom_gold"
        android:alpha="0.6" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cin_vignette_radial" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/cin_logo_mark" />

        <ImageView
            android:layout_width="280dp"
            android:layout_height="64dp"
            android:layout_marginTop="@dimen/cin_space_8"
            android:src="@drawable/cin_logo_wordmark"
            android:adjustViewBounds="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cin_space_4"
            android:text="Cinematic streaming"
            android:textColor="@color/cin_text_secondary"
            android:textSize="@dimen/cin_text_body_sm"
            android:fontFamily="@font/plus_jakarta_sans"
            android:letterSpacing="0.16"
            android:textAllCaps="true" />

        <ProgressBar
            android:id="@+id/sync_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="360dp"
            android:layout_height="4dp"
            android:layout_marginTop="@dimen/cin_space_10"
            android:progressDrawable="@drawable/cin_progress_gold"
            android:indeterminate="false"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/tv_sync_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cin_space_4"
            android:text="Loading your library..."
            android:textColor="@color/cin_text_tertiary"
            android:textSize="@dimen/cin_text_caption"
            android:fontFamily="@font/plus_jakarta_sans" />

        <TextView
            android:id="@+id/tv_sync_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cin_space_2"
            android:text="0%"
            android:textColor="@color/cin_gold_300"
            android:textSize="@dimen/cin_text_caption"
            android:fontFamily="@font/inter_extrabold" />

        <!-- Live / Movies / Series count chips -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cin_space_8"
            android:orientation="horizontal"
            android:gravity="center">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="@dimen/cin_space_5"
                android:paddingVertical="@dimen/cin_space_3"
                android:background="@drawable/cin_pill_glass">

                <TextView
                    android:id="@+id/tv_count_live"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/cin_gold_300"
                    android:textSize="@dimen/cin_text_body_lg"
                    android:fontFamily="@font/inter_extrabold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cin_space_1"
                    android:text="LIVE"
                    android:textColor="@color/cin_text_tertiary"
                    android:textSize="10sp"
                    android:letterSpacing="0.18"
                    android:textAllCaps="true"
                    android:fontFamily="@font/plus_jakarta_sans" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/cin_space_3"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="@dimen/cin_space_5"
                android:paddingVertical="@dimen/cin_space_3"
                android:background="@drawable/cin_pill_glass">

                <TextView
                    android:id="@+id/tv_count_movies"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/cin_gold_300"
                    android:textSize="@dimen/cin_text_body_lg"
                    android:fontFamily="@font/inter_extrabold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cin_space_1"
                    android:text="MOVIES"
                    android:textColor="@color/cin_text_tertiary"
                    android:textSize="10sp"
                    android:letterSpacing="0.18"
                    android:textAllCaps="true"
                    android:fontFamily="@font/plus_jakarta_sans" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/cin_space_3"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="@dimen/cin_space_5"
                android:paddingVertical="@dimen/cin_space_3"
                android:background="@drawable/cin_pill_glass">

                <TextView
                    android:id="@+id/tv_count_series"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/cin_gold_300"
                    android:textSize="@dimen/cin_text_body_lg"
                    android:fontFamily="@font/inter_extrabold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cin_space_1"
                    android:text="SERIES"
                    android:textColor="@color/cin_text_tertiary"
                    android:textSize="10sp"
                    android:letterSpacing="0.18"
                    android:textAllCaps="true"
                    android:fontFamily="@font/plus_jakarta_sans" />
            </LinearLayout>
        </LinearLayout>

        <!-- Error message + retry (hidden until sync fails) -->
        <TextView
            android:id="@+id/tv_sync_error"
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cin_space_6"
            android:gravity="center"
            android:textColor="@color/cin_error"
            android:textSize="@dimen/cin_text_caption"
            android:fontFamily="@font/plus_jakarta_sans"
            android:visibility="gone"
            tools:text="Sync failed. Check your connection."
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sync_retry"
            style="@style/Cin.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/cin_btn_h"
            android:layout_marginTop="@dimen/cin_space_4"
            android:paddingHorizontal="@dimen/cin_space_8"
            android:text="Retry"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

</FrameLayout>
