<?xml version="1.0" encoding="utf-8"?>
<!--
    CINEMATIC LIVE TV SIDEBAR CATEGORY ROW
    Replaces: item_sidebar_category.xml
    Preserves IDs: tv_category_name_sidebar (and any category-icon id used by adapter)

    SidebarCategoryAdapter binds: root view + tv_category_name_sidebar.
    We add v_active_indicator + iv_category_icon so it matches both modern and
    legacy bindings.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_marginVertical="3dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cin_sidebar_cat_state"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp">

        <!-- Active gold bar -->
        <View
            android:id="@+id/v_active_indicator"
            android:layout_width="3dp"
            android:layout_height="20dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/cin_sidebar_active_bar"
            android:visibility="invisible" />

        <!-- Category icon (optional — adapter may set src) -->
        <ImageView
            android:id="@+id/iv_category_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="12dp"
            android:scaleType="fitCenter"
            app:tint="#FFFFFFFF"
            android:visibility="gone"
            tools:visibility="visible"
            tools:src="@android:drawable/ic_menu_view" />

        <!-- Category name (modern binding) -->
        <TextView
            android:id="@+id/tv_category_name_sidebar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="@font/plus_jakarta_sans"
            android:letterSpacing="0.02"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Sports HD" />

        <!-- Channel count (optional — set in adapter) -->
        <TextView
            android:id="@+id/tv_category_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#80FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="@font/plus_jakarta_sans"
            android:letterSpacing="0.06"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="142" />

    </LinearLayout>

</FrameLayout>
