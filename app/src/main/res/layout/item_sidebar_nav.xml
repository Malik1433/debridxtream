<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_container"
    android:layout_width="match_parent"
    android:layout_height="@dimen/home_nav_item_height"
    android:layout_marginBottom="@dimen/home_nav_item_margin"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="@bool/rows_focusable_in_touch_mode"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Active indicator dot (left edge, extends into rail padding) -->
    <View
        android:id="@+id/view_selection_indicator"
        android:layout_width="2.5dp"
        android:layout_height="14dp"
        android:translationX="-7dp"
        android:background="@color/brand_cyan"
        android:visibility="invisible"
        android:elevation="3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Icon and label form a PACKED vertical chain, so this one layout serves both devices: with
         the label gone (TV) the chain collapses and the icon centres exactly as before; with it
         shown (phone) the pair sits centred as a unit. No second layout, no runtime repositioning. -->
    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="@dimen/home_nav_icon_size"
        android:layout_height="@dimen/home_nav_icon_size"
        android:contentDescription="@null"
        app:layout_constraintBottom_toTopOf="@id/tv_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:src="@android:drawable/ic_menu_search" />

    <!-- Shown on a phone, where there is no focus and therefore no flyout to name the destination.
         Hidden on TV, where the focused item names itself. -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:fontFamily="@font/plus_jakarta_sans"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/nav_search"
        android:textColor="#94A3B8"
        android:textSize="@dimen/home_nav_label_size"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_icon" />

</androidx.constraintlayout.widget.ConstraintLayout>
