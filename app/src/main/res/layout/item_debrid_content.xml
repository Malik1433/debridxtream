<?xml version="1.0" encoding="utf-8"?>
<!--
  PHONE poster card for the Debrid grids (See All).

  The television card moved to layout-television/ unchanged: it is a FIXED 128x192 tile with the
  title painted ON the art behind a gradient, sized so a focus scale of 1.15 has room to grow. None
  of that is a phone card. Here the tile fills its grid column, so three of them fit any handset
  width, and the title sits UNDER the art like every other phone poster in this app
  (item_phone_poster) — a busy poster never eats the text.

  Every id the television file carries is carried here too, so DebridDiscoverAdapter binds either
  without knowing which it got. `glow_focus` stays as a gone view: the adapter animates its alpha
  on focus, which a touchscreen never delivers, and animating a gone view is a no-op.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="5dp"
    android:layout_marginBottom="18dp"
    android:clickable="true"
    android:focusable="true">

    <View
        android:id="@+id/glow_focus"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/card_poster"
        app:layout_constraintEnd_toEndOf="@id/card_poster"
        app:layout_constraintStart_toStartOf="@id/card_poster"
        app:layout_constraintTop_toTopOf="@id/card_poster" />

    <androidx.cardview.widget.CardView
        android:id="@+id/card_poster"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardBackgroundColor="@color/phone_panel"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:layout_constraintDimensionRatio="2:3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/iv_poster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/placeholder_poster" />

            <TextView
                android:id="@+id/tv_rating_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:background="@drawable/bg_phone_quality_badge"
                android:fontFamily="@font/share_tech_mono"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="@color/phone_on_accent"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="8.5" />

            <ProgressBar
                android:id="@+id/progress_watch"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_gravity="bottom"
                android:progressDrawable="@drawable/progress_bar_cinematic"
                android:visibility="gone" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/metadata_overlay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_poster">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/outfit_semibold"
            android:lineSpacingMultiplier="1.25"
            android:maxLines="2"
            android:textColor="@color/phone_text_primary"
            android:textSize="13sp"
            tools:text="Dune: Part Two" />

        <TextView
            android:id="@+id/tv_year"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="@font/share_tech_mono"
            android:maxLines="1"
            android:textColor="@color/phone_text_muted"
            android:textSize="12sp"
            tools:text="2024" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
