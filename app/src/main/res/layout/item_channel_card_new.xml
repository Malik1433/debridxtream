<?xml version="1.0" encoding="utf-8"?>
<!--
    CINEMATIC CHANNEL CARD (220×220, grid - "new" Netflix-style)
    Replaces: item_channel_card_new.xml
    Preserves IDs: iv_channel_logo, tv_channel_number_badge,
      layout_name_container, tv_channel_number_name,
      tv_current_program, tv_viewer_count
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="220dp"
    android:layout_height="240dp"
    android:layout_marginHorizontal="6dp"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="16dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:stateListAnimator="@animator/cin_channel_card_state">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/cin_channel_card_state"
        android:padding="2dp">

        <!-- Logo area (top) -->
        <FrameLayout
            android:id="@+id/logo_area"
            android:layout_width="0dp"
            android:layout_height="148dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/iv_channel_logo"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:contentDescription="Channel logo" />

            <!-- LIVE pill (top-left) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|top"
                android:layout_margin="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="7dp"
                android:paddingVertical="3dp"
                android:background="@drawable/cin_pill_live_v2">

                <View
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/cin_dot_live_v2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIVE"
                    android:textColor="#FFFFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.18"
                    android:fontFamily="@font/plus_jakarta_sans" />
            </LinearLayout>

            <!-- Hidden number badge -->
            <TextView
                android:id="@+id/tv_channel_number_badge"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Hairline divider (gold) -->
        <View
            android:id="@+id/divider_card"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="#1AC9A961"
            app:layout_constraintTop_toBottomOf="@id/logo_area"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Name container -->
        <LinearLayout
            android:id="@+id/layout_name_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/divider_card"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/tv_channel_number_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BBC News HD"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF"
                android:fontFamily="@font/inter_extrabold"
                android:letterSpacing="-0.01"
                android:maxLines="2"
                android:ellipsize="end"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2" />

            <TextView
                android:id="@+id/tv_current_program"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="11sp"
                android:textColor="#80FFFFFF"
                android:fontFamily="@font/plus_jakarta_sans"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone"
                tools:text="Now: News at Ten"
                tools:visibility="visible" />

            <!-- Hidden -->
            <TextView
                android:id="@+id/tv_viewer_count"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
