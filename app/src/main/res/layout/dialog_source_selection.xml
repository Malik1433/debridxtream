<?xml version="1.0" encoding="utf-8"?>
<!--
  PHONE source picker.

  The television version is a right-side slide-in panel sized in `source_sheet_width`; on a 411dp
  phone that panel is wider than the screen, so the header and the first filter chip fell off the
  left edge. Same ids and kinds here, laid out as a full-width bottom-anchored sheet: the list
  fills the screen, the filters are one scrolling row, and nothing is off-screen.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B3000000">

    <!-- Tapping outside closes, the way a phone sheet always does. -->
    <View
        android:id="@+id/v_backdrop_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <LinearLayout
        android:id="@+id/panel_sources"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:layout_marginTop="72dp"
        android:background="@drawable/bg_phone_sheet"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_phone_sheet_handle" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_header_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp">

            <TextView
                android:id="@+id/tv_header_title"
                android:text="@string/ui_select_source"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/outfit_bold"
                android:maxLines="1"
                android:textColor="@color/phone_text_primary"
                android:textSize="16sp"
                app:layout_constraintEnd_toStartOf="@id/chip_lang_priority"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Select source" />

            <TextView
                android:id="@+id/tv_dialog_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/inter_regular"
                android:maxLines="1"
                android:textColor="@color/phone_text_secondary"
                android:textSize="12.5sp"
                app:layout_constraintEnd_toStartOf="@id/chip_lang_priority"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_header_title"
                tools:text="Spider-Man: Brand New Day" />

            <TextView
                android:id="@+id/tv_source_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="@font/share_tech_mono"
                android:maxLines="1"
                android:textColor="@color/phone_text_muted"
                android:textSize="11.5sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_dialog_title"
                tools:text="82 sources · sorted by EN priority" />

            <!-- The language-priority chip stays a real 48dp target, pinned to the top right. -->
            <LinearLayout
                android:id="@+id/chip_lang_priority"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_phone_chip"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tv_lang_priority"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/share_tech_mono"
                    android:textColor="@color/phone_cyan"
                    android:textSize="11.5sp"
                    tools:text="EN PRIORITY" />
            </LinearLayout>

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrier_header_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="start"
                app:constraint_referenced_ids="chip_lang_priority" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tv_cache_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/inter_regular"
            android:lineSpacingMultiplier="1.4"
            android:paddingHorizontal="16dp"
            android:text="@string/phone_source_cache_note"
            android:textColor="@color/phone_text_muted"
            android:textSize="12sp" />

        <FrameLayout
            android:id="@+id/filter_bar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:overScrollMode="never"
                android:paddingHorizontal="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layout_source_filters"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chip_quality"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_phone_chip"
                        android:fontFamily="@font/inter_regular"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/phone_text_primary"
                        android:textSize="13sp"
                        tools:text="Quality: All" />

                    <TextView
                        android:id="@+id/chip_language"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_phone_chip"
                        android:fontFamily="@font/inter_regular"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/phone_text_primary"
                        android:textSize="13sp"
                        tools:text="Language: All" />

                    <TextView
                        android:id="@+id/chip_type"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_phone_chip"
                        android:fontFamily="@font/inter_regular"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/phone_text_primary"
                        android:textSize="13sp"
                        tools:text="Source: All" />
                </LinearLayout>
            </HorizontalScrollView>
        </FrameLayout>

        <View
            android:id="@+id/v_filter_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/phone_panel" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_sources"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingTop="8dp"
            android:scrollbars="none" />

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginVertical="16dp"
            android:indeterminateTint="@color/phone_cyan"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/share_tech_mono"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingBottom="10dp"
            android:textColor="@color/phone_text_muted"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="SEARCHING SOURCES…"
            tools:visibility="visible" />
    </LinearLayout>
</FrameLayout>
