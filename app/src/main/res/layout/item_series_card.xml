<?xml version="1.0" encoding="utf-8"?>
<!--
    IPTV VOD SERIES · POSTER CARD (matches "SERIES GRID CARD" in the design HTML).
    Title + meta are an overlaid GLASS FOOTER inside the poster bottom (NOT below it).
    PRESERVED IDS (SeriesPagingAdapter.kt binds them):
      glow_focus, card_container, iv_series_poster, iv_favorite_indicator,
      tv_series_title, tv_series_year, tv_series_rating, ll_rating_container
    NEW IDS: fl_new_badge, tv_new_label, fl_play_overlay, tv_meta_dot
    (seasons badge + episodes segment REMOVED per design correction)
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:padding="4dp"
    android:clipToPadding="false"
    android:clipChildren="false">

    <!-- Focus glow: purple bloom. Extends 12dp beyond the poster so the
         inset blur spills outward. Drawable set in code (FocusGlow). -->
    <View
        android:id="@+id/glow_focus"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="-12dp"
        android:duplicateParentState="true"
        app:layout_constraintTop_toTopOf="@id/card_container"
        app:layout_constraintBottom_toBottomOf="@id/card_container"
        app:layout_constraintStart_toStartOf="@id/card_container"
        app:layout_constraintEnd_toEndOf="@id/card_container" />

    <!-- ─── POSTER (2:3, radius 10dp) ─── -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="2:3"
        app:cardCornerRadius="4dp"
        app:cardElevation="0dp"
        android:duplicateParentState="true"
        android:foreground="@drawable/card_focus_series_purple"
        app:cardBackgroundColor="@color/card_background">

        <!-- Poster Image -->
        <ImageView
            android:id="@+id/iv_series_poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Series Poster"
            android:scaleType="centerCrop" />

        <!-- ─── GLASS FOOTER (overlaid inside poster bottom) ─── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:background="@drawable/bg_series_card_footer_glass"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="30dp"
            android:paddingBottom="11dp">

            <!-- Title only — a calm grid. Rating/year for the focused card show in
                 the section header (updateSectionHeaderForSeries). -->
            <TextView
                android:id="@+id/tv_series_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Series Title"
                android:textColor="#F1F5F9"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- NEW badge (top-left, purple, year >= 2024) -->
        <FrameLayout
            android:id="@+id/fl_new_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="@drawable/bg_badge_new_purple"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_new_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NEW"
                android:textColor="#A78BFA"
                android:textSize="9sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.08" />
        </FrameLayout>

        <!-- Favorite indicator (hidden by default) -->
        <ImageView
            android:id="@+id/iv_favorite_indicator"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:padding="5dp"
            android:src="@drawable/ic_favorite"
            app:tint="#A78BFA"
            android:background="@drawable/bg_circle_dark_translucent"
            android:visibility="gone" />
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
