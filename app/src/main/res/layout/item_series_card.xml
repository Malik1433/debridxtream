<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="0dp"
    android:layout_marginVertical="0dp"
    android:padding="24dp"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:elevation="0dp"
    android:clipToPadding="false"
    android:clipChildren="false">

    <!-- Focused Glow View (Anchored to Card) -->
    <View
        android:id="@+id/glow_focus"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="-20dp"
        android:background="@drawable/bg_movie_focus_cyan"
        android:alpha="0"
        app:layout_constraintTop_toTopOf="@id/card_container"
        app:layout_constraintBottom_toBottomOf="@id/card_container"
        app:layout_constraintStart_toStartOf="@id/card_container"
        app:layout_constraintEnd_toEndOf="@id/card_container" />

    <androidx.cardview.widget.CardView
        android:id="@+id/card_container"
        android:layout_width="140dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintDimensionRatio="2:3"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@android:color/transparent">

        <!-- Series Poster -->
        <ImageView
            android:id="@+id/iv_series_poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Series Poster"
            android:scaleType="centerCrop" />

        <!-- Top Right Rating Badge -->
        <LinearLayout
            android:id="@+id/ll_rating_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/bg_badge_quality"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_series_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8.5"
                android:textColor="#FFD700"
                android:textSize="11sp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Top Left Favorite Heart -->
        <ImageView
            android:id="@+id/iv_favorite_indicator"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|start"
            android:layout_margin="6dp"
            android:padding="6dp"
            android:src="@drawable/ic_favorite"
            app:tint="@color/brand_cyan"
            android:background="@drawable/bg_circle_dark_translucent"
            android:visibility="gone" />

        <!-- Glass Metadata Layer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_glass_card_footer"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tv_series_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:text="Series Title"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textStyle="bold"
                android:letterSpacing="0.01" />

            <TextView
                android:id="@+id/tv_series_year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="2024"
                android:textColor="#CCFFFFFF"
                android:textSize="9sp"
                android:fontFamily="@font/plus_jakarta_sans" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
