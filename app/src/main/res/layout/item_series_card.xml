<?xml version="1.0" encoding="utf-8"?>
<!--
    DERBIX CINEMATIC · SERIES POSTER CARD  (round 2)
    Drop-in replacement for item_series_card.xml.
    PRESERVED IDS (SeriesPagingAdapter.kt binds them):
      glow_focus, card_container, iv_series_poster, iv_favorite_indicator,
      tv_series_title, tv_series_year, tv_series_rating, ll_rating_container
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="14dp"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clipChildren="false"
    android:clipToPadding="false">

    <View
        android:id="@+id/glow_focus"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="-12dp"
        android:alpha="0"
        android:background="@drawable/cin_card_focus_gold"
        app:layout_constraintTop_toTopOf="@id/card_container"
        app:layout_constraintBottom_toBottomOf="@id/card_container"
        app:layout_constraintStart_toStartOf="@id/card_container"
        app:layout_constraintEnd_toEndOf="@id/card_container" />

    <androidx.cardview.widget.CardView
        android:id="@+id/card_container"
        android:layout_width="160dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintDimensionRatio="2:3"
        app:cardCornerRadius="14dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/cin_ink_700"
        android:stateListAnimator="@animator/cin_card_focus_state">

        <ImageView
            android:id="@+id/iv_series_poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Series Poster"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:id="@+id/ll_rating_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:background="@drawable/cin_badge_quality_gold"
            android:orientation="horizontal"
            android:paddingHorizontal="7dp"
            android:paddingVertical="3dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="★"
                android:textColor="#0A0A0A"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_series_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:text="8.5"
                android:textColor="#0A0A0A"
                android:textSize="10sp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textStyle="bold"
                android:letterSpacing="0.04" />
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_favorite_indicator"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:padding="6dp"
            android:src="@drawable/ic_favorite"
            app:tint="@color/cin_gold_500"
            android:background="@drawable/cin_circle_dark_translucent"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/cin_card_footer_gradient"
            android:orientation="vertical"
            android:paddingHorizontal="11dp"
            android:paddingTop="22dp"
            android:paddingBottom="11dp">

            <TextView
                android:id="@+id/tv_series_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="Series Title"
                android:textColor="@color/cin_text_primary"
                android:textSize="13sp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textStyle="bold"
                android:letterSpacing="0.005" />

            <TextView
                android:id="@+id/tv_series_year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="2024"
                android:textColor="#B3FFFFFF"
                android:textSize="10sp"
                android:fontFamily="@font/plus_jakarta_sans" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
