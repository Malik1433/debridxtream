<?xml version="1.0" encoding="utf-8"?>
<!--
  M2 (MOBILE_DUAL_MODE_PLAN): layout facts the CODE needs, expressed as resources so the
  qualifier decides them — no mode plumbing through fragments.

  Default (here) = the TV rail: vertical, on the left.
  values-port overrides it for the phone bottom bar.
-->
<resources>
    <bool name="home_nav_is_horizontal">false</bool>
    <!-- M3: browse category list — a left rail on TV, a top chip rail on the phone. -->
    <bool name="browse_categories_are_horizontal">false</bool>
    <!--
      M5: the play circle on a source row. On TV it is a FOCUS affordance — it appears on
      the focused row and marks where CENTER will act. A touch device has no focused row,
      so the same rule would hide it forever; there it is a permanent tap affordance.
    -->
    <bool name="source_row_play_always_visible">false</bool>
    <!--
      M5: tapping the dimmed area behind a sheet closes it. TV leaves this off on purpose —
      there is nothing to tap, and attaching a click listener would make the backdrop
      clickable, which lets it into the D-pad focus order and adds a dead stop to the
      ladder. BACK already closes the panel there.
    -->
    <bool name="dismiss_on_backdrop_tap">false</bool>
    <!--
      M7: which Live screen a "live" hop opens WHEN THE USER HAS NOT CHOSEN. The EPG guide is a
      multi-day timeline grid and needs width; the classic screen is a channel list with a
      preview above it. TV keeps the guide, a phone gets the list. An explicit choice in
      Settings still wins on both.
    -->
    <bool name="live_defaults_to_classic">false</bool>
    <!--
      M7b: may a list row take focus FROM A TOUCH? On TV, yes — focus is the whole interaction
      model. On a phone it is the wrong model outright (the rulebook in CLAUDE.md says one tap
      acts), and a row that grabs focus on ACTION_DOWN can have its click cancelled when the
      list scrolls the newly-focused row into view. Rows stay `focusable` in both cases; this
      only governs focus acquired by touching.
    -->
    <bool name="rows_focusable_in_touch_mode">true</bool>
    <!-- M6: Settings categories — a vertical rail beside the detail panel on TV, a top chip
         rail above it on the phone (there is no room for two columns at 411dp). -->
    <bool name="settings_categories_are_horizontal">false</bool>
</resources>
