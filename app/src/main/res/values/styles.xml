<?xml version="1.0" encoding="utf-8"?>
<resources>
    
    <!-- Week 14: App Theme with Preference Support -->
    <style name="AppTheme" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/cin_gold_500</item>
        <item name="colorPrimaryDark">@color/cin_ink_900</item>
        <item name="colorAccent">@color/cin_gold_500</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>
        <!-- Dialogs used to fall back to the platform light sheet on a near-black app. Wiring both
             attributes here fixes every dialog in the app at once (appcompat and framework). -->
        <item name="alertDialogTheme">@style/Theme.DebridXtream.Dialog.Alert</item>
        <item name="android:alertDialogTheme">@style/Theme.DebridXtream.Dialog.Alert.Framework</item>
        <item name="dialogTheme">@style/Theme.DebridXtream.Dialog.Alert</item>
        <item name="android:dialogTheme">@style/Theme.DebridXtream.Dialog.Alert.Framework</item>
    </style>

    <!-- Global Focus Styling -->
    <style name="AppTheme_Card_Focused">
        <item name="android:background">@drawable/bg_source_card_focused</item>
        <item name="android:elevation">8dp</item>
    </style>
    
    <style name="AppTheme_Button_Focused">
        <item name="android:background">@drawable/bg_button_glass_stroke</item>
        <item name="android:elevation">4dp</item>
    </style>
    
    <!-- Week 10: Favorites Filter Tab Style -->
    <style name="FilterTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:background">@drawable/filter_tab_background</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="CircleAppearance">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="DropdownAnimationStyle">
        <item name="android:windowEnterAnimation">@anim/dropdown_slide_in</item>
        <item name="android:windowExitAnimation">@anim/dropdown_slide_out</item>
    </style>

    <style name="SourcePanelAnimation">
        <item name="android:windowEnterAnimation">@anim/panel_slide_in_right</item>
        <item name="android:windowExitAnimation">@anim/panel_slide_out_right</item>
    </style>

    <!-- Compact context-menu dialog: kills AlertDialog's default ~65%-of-screen minimum
         width so the menu wraps tightly to its content instead of filling half the screen. -->
    <style name="CwActionMenuDialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
        <item name="windowMinWidthMajor">0dp</item>
        <item name="windowMinWidthMinor">0dp</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
    </style>

    <!-- Parental PIN digit box for the D-pad wheel (dialog_pin_wheel.xml, 2026-09-03). The
         selected box is drawn by the dialog (cyan text); the boxes themselves never take focus,
         the row does, so one D-pad handler owns all four. -->
    <style name="PinWheelDigit">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#E2E8F0</item>
        <item name="android:background">#1E293B</item>
        <item name="android:focusable">false</item>
    </style>
</resources>
