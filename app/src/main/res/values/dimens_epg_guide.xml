<?xml version="1.0" encoding="utf-8"?>
<!--
  Live TV EPG Guide dimensions (from "Live TV EPG - Spec.md").

  M13: one set again, for both devices. M12 had split these because a phone was portrait and the
  300dp channel column ate three quarters of a 411dp-wide screen. Landscape gives the phone ~891dp,
  so the TV spec fits and the guide looks the same on both — which is the point of the decision.
  The two `epg_channel_*` values below are still resources rather than literals because the draw
  code reads them; that stays useful if a small-screen override is ever needed again.
-->
<resources>
    <dimen name="epg_nav_rail_width">148dp</dimen>
    <dimen name="epg_detail_height">176dp</dimen>
    <dimen name="epg_channel_col_width">300dp</dimen>
    <dimen name="epg_header_height">44dp</dimen>
    <dimen name="epg_channel_number_indent">38dp</dimen>
    <dimen name="epg_channel_logo_size">40dp</dimen>

    <!-- Row density (spec §7) -->
    <dimen name="epg_row_cozy">58dp</dimen>
    <dimen name="epg_row_standard">70dp</dimen>
    <dimen name="epg_row_roomy">96dp</dimen>

    <dimen name="epg_preview_tile_width">300dp</dimen>
    <dimen name="epg_chip_height">40dp</dimen>
    <dimen name="epg_day_tab_height">34dp</dimen>

    <!--
      M18 — the guide against the phone rulebook (§1c). These are PHONE values; the TV literals
      live verbatim in values-television/dimens_epg_guide.xml.
    -->
    <!-- A phone has a system status bar over the top edge; the TV's 14dp is under it. -->
    <dimen name="epg_top_inset">38dp</dimen>
    <!-- Touch floors for the code-built chips/tabs; 0dp on TV = wrap_content as before. -->
    <dimen name="epg_chip_min_height">48dp</dimen>
    <dimen name="epg_day_tab_min_height">48dp</dimen>
    <dimen name="epg_jump_now_height">48dp</dimen>
    <!-- At 1.6x the 176dp info block only holds one line of title and one of description. -->
    <integer name="epg_title_lines">1</integer>
    <integer name="epg_desc_lines">1</integer>
</resources>
