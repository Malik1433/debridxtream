<?xml version="1.0" encoding="utf-8"?>
<!--
  M17 — the player chrome's touch metrics for the PHONE. The TV keeps its design literals in
  values-television/dimens_player.xml (verbatim what was inline before this batch).

  Phone rule (§1c): every control ≥48dp. The 40dp/28dp buttons and the 24dp seek touch strip
  were sized for a D-pad, where physical size is irrelevant.
-->
<resources>
    <dimen name="player_ctrl_btn_size">48dp</dimen>
    <dimen name="player_seek_row_height">48dp</dimen>
    <dimen name="live_osd_btn_height">48dp</dimen>
    <dimen name="live_osd_btn_icon_size">18dp</dimen>
    <dimen name="live_osd_btn_icon_size_small">18dp</dimen>
    <dimen name="live_osd_fav_size">48dp</dimen>
    <dimen name="live_osd_fav_icon_size">20dp</dimen>
    <!-- "55 MIN LEFT" at 1.6x fontScale needs ~70dp; the TV's 46dp clips it. -->
    <dimen name="live_min_left_width">84dp</dimen>
    <!-- The player's status pills (reconnecting, stream health). -->
    <dimen name="stream_health_text_size">12sp</dimen>
</resources>
