<?xml version="1.0" encoding="utf-8"?>
<!-- Search result card — "Search Page.dc.html". Poster 178x264 px / 2 = 89 x 132 dp. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sr_card"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="3dp"
    android:focusable="true"
    android:foreground="@drawable/card_focus_cinematic">

    <FrameLayout
        android:layout_width="@dimen/poster_top_10_width"
        android:layout_height="@dimen/poster_top_10_height"
        android:clipChildren="true">

        <ImageView
            android:id="@+id/sr_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <View
            android:id="@+id/sr_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/sr_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginTop="5dp"
            android:layout_marginStart="5dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:fontFamily="@font/share_tech_mono"
            android:textSize="5sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <LinearLayout
            android:id="@+id/sr_live"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="5dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/stremio_live_badge"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:visibility="gone">

            <View
                android:layout_width="2dp"
                android:layout_height="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/stremio_live_dot" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/share_tech_mono"
                android:textSize="4.5sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:text="@string/livev2_live_badge" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/sr_title"
        android:layout_width="@dimen/poster_top_10_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:fontFamily="@font/outfit_semibold"
        android:textSize="7sp"
        android:textColor="#E2E8F0"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/sr_meta"
        android:layout_width="@dimen/poster_top_10_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/share_tech_mono"
        android:textSize="5.5sp"
        android:textColor="#64748B"
        android:letterSpacing="0.04"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
