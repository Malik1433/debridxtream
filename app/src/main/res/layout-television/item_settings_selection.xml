<?xml version="1.0" encoding="utf-8"?>
<!-- Settings value/action row — "Settings Screen.dc.html". 68px/2 = 34dp. Bg/focus set in adapter.

     M14: this file is the TV's row, copied here BYTE-FOR-BYTE from what `layout/` shipped and was
     verified with. It did not change; the phone's copy did, and it moved out from under it.

     Why the fork was unavoidable. Title and value sit side by side, and LinearLayout serves the
     wrap_content value its full width FIRST — so the weighted title column gets the remainder. On
     a 543dp phone panel with the M13 1.6x type that remainder is ~169dp, and "Secondary Audio
     Language" still read "Secondary Audio Langu…" even after the row was allowed to grow taller.
     Capping the value instead only moves the ellipsis onto the value. The phone therefore stacks
     title / value / description the way Android's own settings do (`layout/`), while ten feet away
     there is room for both on one line and this arrangement stays right.

     Parity rule: same five ids, same View kinds, same default visibilities in both files, because
     SettingsDetailAdapter binds them through ItemSettingsSelectionBinding. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="74dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="20dp"
    android:paddingEnd="24dp"
    android:layout_marginBottom="8dp"
    android:focusable="true"
    android:focusableInTouchMode="@bool/rows_focusable_in_touch_mode"
    android:clickable="true">

    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:layout_marginEnd="18dp"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit_semibold"
            android:textSize="19sp"
            android:textColor="#F1F5F9"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/inter_regular"
            android:textSize="14sp"
            android:textColor="#94A3B8"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:fontFamily="@font/share_tech_mono"
        android:textSize="16sp"
        android:textColor="#94A3B8"
        android:letterSpacing="0.06"
        android:maxLines="1"
        android:ellipsize="end" />

    <ImageView
        android:id="@+id/iv_chevron"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:layout_marginStart="12dp"
        android:src="@drawable/ic_arrow_right"
        app:tint="#475569"
        android:contentDescription="@null" />
</LinearLayout>
