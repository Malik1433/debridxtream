<?xml version="1.0" encoding="utf-8"?>
<!-- Stremio Library tab: header + sub-tabs + poster grid -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/library_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="35dp"
        android:paddingEnd="35dp"
        android:clipChildren="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="9dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit_extrabold"
                    android:textSize="12sp"
                    android:textColor="#F1F5F9"
                    android:letterSpacing="-0.02"
                    android:text="@string/ui_my_library" />

                <TextView
                    android:id="@+id/lib_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="6.5sp"
                    android:textColor="#475569"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/libTabsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="23dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/stremio_glass5"
                android:paddingStart="9dp"
                android:paddingEnd="9dp">

                <ImageView
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:src="@drawable/ic_stremio_sort"
                    app:tint="#64748B"
                    android:layout_marginEnd="3.5dp"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="7.5sp"
                    android:textColor="#94A3B8"
                    android:text="@string/ui_sort" />
            </LinearLayout>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/libraryGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:paddingBottom="20dp"
            android:nestedScrollingEnabled="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/lib_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="40dp"
        android:fontFamily="@font/inter_regular"
        android:textSize="9sp"
        android:textColor="#475569"
        android:text="@string/ui_nothing_here_yet"
        android:visibility="gone" />
</FrameLayout>
