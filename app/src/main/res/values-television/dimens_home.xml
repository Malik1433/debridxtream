<?xml version="1.0" encoding="utf-8"?>
<!--
  M15 — the TV's home metrics, EXACTLY the literals that were inline in
  `layout/fragment_home_cinematic.xml`, `view_home_sidebar.xml` and `item_sidebar_nav.xml` before
  this batch. Nothing here is a new decision; every number is the home redesign's px/2 value,
  lifted into a resource only so the phone can answer differently.

  If a value here stops matching the design, that is a bug in this file.
-->
<resources>
    <!-- Hero -->
    <dimen name="home_hero_band_height">360dp</dimen>
    <dimen name="home_hero_section_height">340dp</dimen>
    <dimen name="home_hero_title_size">38sp</dimen>
    <dimen name="home_hero_desc_size">9.5sp</dimen>
    <dimen name="home_hero_btn_height">30dp</dimen>
    <dimen name="home_hero_btn_margin">12dp</dimen>
    <dimen name="home_hero_fav_size">30dp</dimen>

    <!-- Navigation rail -->
    <dimen name="home_nav_item_height">34dp</dimen>
    <dimen name="home_nav_item_margin">4dp</dimen>
    <dimen name="home_nav_item_width">34dp</dimen>
    <dimen name="home_nav_item_inset">13dp</dimen>
    <dimen name="home_nav_header_size">32dp</dimen>
    <dimen name="home_nav_list_margin_top">18dp</dimen>
    <dimen name="home_nav_profile_size">30dp</dimen>
    <!-- The TV rail stays the narrow icon strip it was: a focused item names itself in the flyout,
         so a label under every glyph would be redundant chrome at three metres. -->
    <dimen name="home_nav_rail_width">60dp</dimen>
    <dimen name="home_nav_icon_size">17dp</dimen>
    <dimen name="home_nav_label_size">7sp</dimen>
</resources>
