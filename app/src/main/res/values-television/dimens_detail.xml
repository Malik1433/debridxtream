<?xml version="1.0" encoding="utf-8"?>
<!--
  M16 — the TV's detail-page metrics, EXACTLY the literals that were inline in
  `fragment_movie_detail_v2.xml` and `fragment_series_detail_v2.xml` before this batch.
  Nothing here is a new decision.
-->
<resources>
    <dimen name="detail_action_height">38dp</dimen>
    <dimen name="detail_fav_width">42dp</dimen>
    <dimen name="series_action_height">29dp</dimen>
    <dimen name="series_fav_size">29dp</dimen>
    <!-- The phone draws under the system status bar; the TV has none. -->
    <dimen name="detail_top_bar_inset">0dp</dimen>
    <!-- Series' own top strip: 20dp on TV, plus the phone's status-bar clearance. -->
    <dimen name="series_top_strip_margin_top">20dp</dimen>
    <!-- The series info column starts below that strip. -->
    <dimen name="series_header_margin_top">69dp</dimen>
    <!--
      M16b: the phone's series page gave its info column only 92dp — Play S01 · E01 and the plot
      were below the fold. Two measured reclaims: the header started 91dp down when the top strip
      only occupies 62dp, and the episode thumbnail is a 10-foot 184x100dp. A 110x62dp card still
      shows the still and the episode title, which is what identifies an episode.
    -->
    <dimen name="series_episode_card_width">192dp</dimen>
    <dimen name="series_episode_thumb_width">184dp</dimen>
    <dimen name="series_episode_thumb_height">100dp</dimen>
    <!-- D4: with the similar rail hidden on a phone the info column runs to the screen edge and the
         action row sat flush against it (and grazed the gesture pill). -->
    <dimen name="detail_column_margin_bottom">4dp</dimen>
</resources>
