<?xml version="1.0" encoding="utf-8"?>
<!--
  M13: only BEHAVIOUR is overridden here now. The shape flags moved back to `values` because a
  phone runs the TV layout too (owner decision 2026-08-07, landscape everywhere) — they describe
  the layout, not the device, so they must be identical on both.

  `-television` matches a TV in either orientation and never matches a phone, which is exactly the
  question the four flags below ask: is this thing driven by a D-pad, or by a finger?
-->
<resources>
    <bool name="ui_uses_dpad_focus">true</bool>
    <bool name="rows_focusable_in_touch_mode">true</bool>
    <bool name="source_row_play_always_visible">false</bool>
    <bool name="dismiss_on_backdrop_tap">false</bool>
    <!-- M15: a TV has no system status bar, so home draws its own clock / key / expiry strip. -->
    <bool name="home_shows_tv_status_strip">true</bool>
    <!-- M16: 540dp of height is enough for the film's column AND the recommendation rail. -->
    <bool name="detail_shows_similar_row">true</bool>
    <!-- M18: the guide's detail-panel button stays in the TV design (it fits at TV type sizes). -->
    <bool name="epg_shows_primary_btn">true</bool>
    <!-- 2026-08-10: the ten-foot Debrid home keeps its hero; only the phone drops it. -->
    <bool name="debrid_home_shows_hero">true</bool>
    <!-- 2026-08-12: the phone now opens Live on the three-column browse, because a guide grid is
         unreadable in the hand. At three metres the grid is exactly what you want, so the TV keeps
         it — the default stays "guide" here. -->
    <bool name="live_defaults_to_classic">false</bool>
</resources>
