<?xml version="1.0" encoding="utf-8"?>
<!--
  D2 — the TV's Debrid metrics, EXACTLY the literals that were inline in `item_debrid_content.xml`
  and `fragment_stremio_home.xml` before this batch. Nothing here is a new decision.
  The hero line cap is 10, which no plot in the design reaches — it is "unbounded" spelled as a
  number, because `maxLines` needs one.
-->
<resources>
    <dimen name="debrid_card_title_size">14sp</dimen>
    <dimen name="debrid_card_year_size">12sp</dimen>
    <dimen name="debrid_card_overlay_padding_top">32dp</dimen>
    <dimen name="stremio_top_bar_inset">0dp</dimen>
    <integer name="stremio_hero_desc_lines">10</integer>
    <dimen name="stremio_top10_row_height">42dp</dimen>
    <dimen name="stremio_top10_rank_width">18dp</dimen>
    <integer name="stremio_top10_title_lines">1</integer>
    <dimen name="stremio_hero_height">320dp</dimen>
    <dimen name="stremio_content_top">318dp</dimen>
    <dimen name="stremio_hero_content_top">65dp</dimen>
    <!-- D3: two lines alone still broke words mid-way ("Obse/ssion", "Super/girl") because the
         rail's text column is ~48dp and a 12sp word needs more. 6sp renders at ~9.6sp, which fits
         "Obsession" on one line. -->
    <dimen name="stremio_top10_title_size">7.5sp</dimen>
    <dimen name="stremio_top10_thumb_width">26dp</dimen>
    <dimen name="stremio_top10_thumb_margin">8dp</dimen>
</resources>
