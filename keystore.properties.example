# Release signing + anti-repack config for the app module.
# Copy to `keystore.properties` (which is git-ignored) and fill in real values.
# WITHOUT this file the app signs with the debug key and the signature self-check
# is disabled — safe for development, but provides NO anti-crack protection.
#
# 1) Generate a private release key. KEEP THE .jks AND ITS PASSWORDS SAFE IN TWO PLACES:
#    lose them and this app can never be updated again — not by sideload, not by Play.
#    Keep it OUTSIDE the repo so it can never be committed or swept into a project backup:
#      keytool -genkeypair -v -keystore C:/Users/<you>/keys/dxplay-release.jks \
#        -alias dxplay -keyalg RSA -keysize 2048 -validity 10000
#    (10000 days ≈ 27 years; Play requires a key valid well past 2033.)
#
# 2) Read the cert SHA-256 for EXPECTED_SIGNING_SHA256 (uppercase hex, strip the colons):
#      keytool -list -v -keystore C:/Users/<you>/keys/dxplay-release.jks -alias dxplay
#    Copy the "SHA256:" line, remove the ":" separators.
#    LEAVE IT EMPTY for the first release — a wrong value makes the app refuse to run,
#    so turn the self-check on only once release-signed builds are proven on a device.
#
# 3) Migration note: an already-installed DEBUG-signed build cannot update in place to
#    a release-signed one (Android rejects a signing-cert change) — uninstall then
#    reinstall once on each device when you cut over. Confirmed on the Fire TV:
#    INSTALL_FAILED_UPDATE_INCOMPATIBLE ... signatures do not match previously installed version.
#
# ⚠ This is a .properties file, so BACKSLASHES ARE ESCAPES: write the Windows path with
#   forward slashes (C:/Users/...) or doubled backslashes, never C:\Users\...

storeFile=C:/Users/<you>/keys/dxplay-release.jks
storePassword=CHANGE_ME
keyAlias=dxplay
keyPassword=CHANGE_ME

# RELEASE cert SHA-256, uppercase hex, no colons. Empty = self-check disabled.
EXPECTED_SIGNING_SHA256=
