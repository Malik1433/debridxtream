rules_version = '2';

// DebridXtream Firestore rules — licensing + admin panel + companion pairing.
// Deploy: Firebase console → Firestore → Rules → paste → Publish
// (or `firebase deploy --only firestore:rules`).
//
// Admin = any signed-in user whose UID has a doc in the `admins` collection.
// One-time setup: Firebase console → Firestore → create collection `admins` →
// add a doc whose ID is your Auth UID (Authentication tab shows it) → {role:"owner"}.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // The telemetry a device may write about itself, checked only for the keys in `keys` (on an
    // update that is the CHANGED keys, so a legacy value nobody is touching can never block a write).
    // The activation code alphabet is LicenseManager.deriveActivationCode's: no 0/O/1/I.
    function licenseTelemetryOk(d, keys) {
      return (!keys.hasAny(['activationCode']) ||
          (d.activationCode is string &&
           d.activationCode.matches('^[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}$'))) &&
        (!keys.hasAny(['appVersionName']) ||
          (d.appVersionName is string && d.appVersionName.matches('^[0-9A-Za-z._+-]{1,32}$'))) &&
        (!keys.hasAny(['appVersionCode']) || d.appVersionCode is int) &&
        (!keys.hasAny(['lastSeenAt']) || d.lastSeenAt == request.time);
    }

    // ── Device licenses ────────────────────────────────────────────────
    // The TV app is UNAUTHENTICATED; its doc id is an unguessable install UUID
    // which acts as the capability. Devices may register themselves as
    // `pending` and update telemetry — but can NEVER grant themselves
    // status/tier/expiry. Only admins can. Resellers (see below) never write
    // entitlement fields directly — that goes through the activateClient Cloud
    // Function (admin SDK) so credits are spent atomically.
    match /licenses/{installId} {
      // GET stays open: the unauthenticated TV reads its OWN doc by id (capability).
      allow get: if true;
      // LIST is scoped: the admin panel sees all; a reseller may only enumerate the
      // clients they own (query must filter resellerId == their uid). This also closes
      // the prior "anyone can enumerate every license" exposure.
      // §7 U7 adds the customer: they may enumerate the devices THEY claimed, and nothing
      // else. Widening only — no existing caller loses anything.
      allow list: if isAdmin() ||
        (isSignedIn() && resource.data.resellerId == request.auth.uid) ||
        (isSignedIn() && resource.data.ownerUid == request.auth.uid);

      // Device self-registration: must be pending + normal, no expiry, and the
      // trial anchor MUST be the server clock — a crafted client can no longer seed a
      // far-future createdAt to mint an unlimited "trial" (createdAt drives the 7-day
      // trial window). The app writes FieldValue.serverTimestamp(), which resolves to
      // request.time.
      // Security audit 2026-09-26: the unauthenticated fields below are rendered by the admin panel,
      // and they were unbounded — any string, any type. They are now shaped here as well as escaped
      // there (C2), and ownership/reseller keys can no longer be seeded on a self-created doc.
      allow create: if isAdmin() || (
        request.resource.data.status == 'pending' &&
        request.resource.data.tier == 'normal' &&
        !('expiresAt' in request.resource.data) &&
        request.resource.data.createdAt == request.time &&
        !request.resource.data.keys().hasAny(['ownerUid', 'resellerId', 'resellerEmail',
          'subscriptionId', 'planId', 'activatedAt', 'note', 'deviceName']) &&
        licenseTelemetryOk(request.resource.data, request.resource.data.keys())
      );

      // Device may only touch telemetry fields; entitlement fields are admin-only.
      // activationCode is write-once (H2): the app derives it from the doc id, so a legitimate
      // write never changes it, and letting anyone who knows an installId CHANGE it made that
      // device impossible to activate.
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastSeenAt', 'appVersionCode', 'appVersionName', 'activationCode']) &&
        licenseTelemetryOk(request.resource.data,
          request.resource.data.diff(resource.data).affectedKeys()) &&
        (!('activationCode' in resource.data) ||
          request.resource.data.activationCode == resource.data.activationCode)
      ) || (
        // §7 U7: the owning customer may rename their own TV — that key and no other. Naming a
        // device is the one thing here that is purely theirs; ownership itself is set by
        // claimDevice and can only be undone by staff (§7.8), so it is NOT in this list.
        isSignedIn() &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deviceName']) &&
        request.resource.data.deviceName is string &&
        request.resource.data.deviceName.size() <= 60
      );

      allow delete: if isAdmin();
    }

    // ── App config (licensing switch + update manifest) ────────────────
    match /app_config/{doc} {
      allow read: if true;          // devices must read enforce/version unauthenticated
      allow write: if isAdmin();
    }

    // ── Admin registry ──────────────────────────────────────────────────
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;        // console-only
    }

    // ── Companion config channel (legacy) ───────────────────────────────
    // §7/U8b, 2026-08-01: **this channel may no longer carry credentials.**
    //
    // It used to hold the customer's Xtream username and password, readable by anyone who
    // learned the device key — a key printed on the TV screen and handed to their provider.
    // That was the hole §7 was written to close. Configuration now flows through `playlists`,
    // which is owner-scoped.
    //
    // The ban is enforced HERE rather than only by deleting the client code, because a rule is
    // a property of the data: no future client, and no direct API call, can put credentials
    // back in. The doc itself stays writable so the TV can keep publishing its `waiting`
    // status, and readable because there is no longer anything in it worth reading.
    //
    // 2026-09-08 (audit finding F5): this was a DENYLIST of six field names, which does not
    // deliver the sentence above. It stopped `password` and stopped `iptv`, and let the same
    // credentials through under any other name - `config`, `xtream`, `creds`. A denylist can only
    // ever ban what somebody already thought of.
    //
    // The allowlist below is the whole legitimate write surface, verified against every writer
    // in the repository rather than guessed:
    //   LoginQrOverlayController.startListening  set({status, createdAt})       - full set
    //   CompanionConfigSync.start                set({status, createdAt}, merge) - only when absent
    // The web dashboard's config push was deleted in U8b and writes nothing today; the Cloud
    // Functions never touch this collection at all. So the resulting document, for both writers
    // and for a merge onto an existing doc, is exactly these two keys.
    //
    // Adding a field to this channel now means adding it here first, on purpose, with a reason -
    // which is the property the denylist never had.
    match /device_codes/{code} {
      allow get: if true;
      allow list: if false;
      allow create, update: if request.resource.data.keys()
        .hasOnly(['status', 'createdAt']);
      allow delete: if isAdmin();
    }

    // ── Resellers (multi-tenant reseller dashboard) ─────────────────────
    // A reseller signs up with email (Firebase Auth). They own their own doc but can
    // NEVER change their own credit balance or status — only an admin (owner top-up)
    // or the Cloud Functions (admin SDK, which bypasses rules) may. Activating/renewing
    // a client is done via the activateClient/renewClient Functions, which spend credits
    // atomically; resellers never write licence entitlement fields directly.
    match /resellers/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      // Self-signup: create own doc, starting at zero credits, active.
      allow create: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.credits == 0 &&
        request.resource.data.status == 'active';
      // Self-update: profile fields ONLY — credits/status are admin/function-only.
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'phone', 'country', 'contact'])
      );
      allow delete: if isAdmin();
    }

    // ── Plans (server-defined credit cost per tier/duration) ────────────
    // Read-all so the reseller UI can list them; only the owner defines cost.
    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Credit ledger (audit trail of top-ups + activation spends) ───────
    // Read your own entries (or admin reads all); writes come only from the Functions
    // (admin SDK) or admin — never from a reseller client directly.
    match /credit_ledger/{entryId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.resellerId == request.auth.uid);
      allow write: if isAdmin();
    }

    // ── Credit packages (what a reseller can BUY) ───────────────────────
    // Read-all so the Buy Credits page lists them; only the owner sets price/credits.
    match /credit_packages/{pkgId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Orders (credit purchases) ───────────────────────────────────────
    // A reseller reads their own orders. Orders are CREATED and marked paid only by
    // the checkout/webhook Cloud Functions (admin SDK) so the amount + credit grant
    // are server-validated — a client can never self-create a paid order.
    match /orders/{orderId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.resellerId == request.auth.uid);
      allow write: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════════
    // END-USER ACCOUNTS — §7 of docs/reports/ANTI_PIRACY_DECISION.md, phase U0.
    //
    // Nothing reads or writes these yet; this is the skeleton so later phases add
    // behaviour, not permissions. The point of the whole section is one shift: today
    // `device_codes` says "whoever knows the key may read the customer's IPTV password".
    // Here, access follows OWNERSHIP instead — which is the only version of this that
    // can actually be made safe.
    //
    // Entitlement is never client-writable. `subscriptions` and `device_auth` are
    // written exclusively by the callable Functions (admin SDK bypasses rules), because
    // device-slot counting cannot be expressed in rules — rules cannot count.
    // ════════════════════════════════════════════════════════════════════

    // The uid of the account that owns the DEVICE making this request, or null when the
    // caller is not a bound device. One document read; used to let a TV read its owner's
    // playlists without granting it anything else.
    function deviceOwnerUid() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/device_auth/$(request.auth.uid))
        ? get(/databases/$(database)/documents/device_auth/$(request.auth.uid)).data.ownerUid
        : null;
    }

    // ── End-user profiles ───────────────────────────────────────────────
    // Firebase Auth is the identity; this doc is just profile. Deliberately NOT where
    // entitlement lives — a user who can edit their own profile must never be one field
    // away from editing what they are entitled to.
    match /users/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'phone', 'country', 'contact'])
      );
      allow delete: if isAdmin();
    }

    // ── Subscriptions (entitlement truth, CONSUMER channel only) ────────
    // §7.0: resellers buy PER DEVICE and have no limit — they never touch this collection;
    // their path stays `plans` + activateClient. Subscriptions exist only for the direct
    // customer, and `deviceLimit` lives here rather than on a plan so that re-pricing a
    // product later cannot silently shrink a subscription somebody already paid for.
    //
    // Read-only to the customer; only Functions/admin may write. deviceLimit and expiresAt
    // decide what someone paid for, so a client write path here would make every other
    // control in this file decorative.
    match /subscriptions/{subId} {
      allow get, list: if isAdmin() ||
        (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow write: if isAdmin();
    }

    // ── Playlists (the customer's own IPTV credentials) ─────────────────
    // The owner has full CRUD. A bound device gets READ ONLY, and only for playlists
    // belonging to the account that owns it — this is what replaces the device_codes push
    // channel, and why an edit on the phone reaches the TV without anything being pushed.
    // Queries MUST filter on ownerUid or the list rule cannot be satisfied.
    match /playlists/{playlistId} {
      allow get, list: if isAdmin() ||
        (isSignedIn() && resource.data.ownerUid == request.auth.uid) ||
        (resource.data.ownerUid != null && resource.data.ownerUid == deviceOwnerUid());
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      // The ownerUid re-check pins an edit to its current owner — a playlist can never be handed to
      // another account by editing it.
      allow update: if isAdmin() ||
        (isSignedIn() && resource.data.ownerUid == request.auth.uid &&
         request.resource.data.ownerUid == resource.data.ownerUid);
      // Delete is SEPARATE and must not mention request.resource: on a delete there is no incoming
      // document, so `request.resource.data.ownerUid` is an error and the whole condition fails.
      // Sharing one rule with update silently made deletion impossible for the owner.
      allow delete: if isAdmin() ||
        (isSignedIn() && resource.data.ownerUid == request.auth.uid);
    }

    // ── Add-ons (the customer's own debrid links) ───────────────────────
    // D1: the same shape and the same access as `playlists`, for the same reason — these are the
    // customer's configuration, they belong to their account, and the device READS them rather
    // than being pushed to.
    //
    // They are separate documents rather than an array on the playlist because they are not the
    // playlist's: an add-on works whichever IPTV provider the device is running, and a customer
    // with three servers and one add-on should not have to enter it three times. `deviceId` empty
    // means every device, exactly as it does for a playlist.
    //
    // Rules are the playlists block verbatim, including the two lessons written into it: queries
    // MUST filter on ownerUid, and delete is a separate clause because `request.resource` does not
    // exist on a delete — sharing one rule with update silently makes deletion impossible.
    match /addons/{addonId} {
      allow get, list: if isAdmin() ||
        (isSignedIn() && resource.data.ownerUid == request.auth.uid) ||
        (resource.data.ownerUid != null && resource.data.ownerUid == deviceOwnerUid());
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin() ||
        (isSignedIn() && resource.data.ownerUid == request.auth.uid &&
         request.resource.data.ownerUid == resource.data.ownerUid);
      allow delete: if isAdmin() ||
        (isSignedIn() && resource.data.ownerUid == request.auth.uid);
    }

    // ── Device identity (U3) ────────────────────────────────────────────
    // A TV signs in anonymously and records "this anonymous uid is me" against its installId.
    //
    // This is a CLAIM OF IDENTITY, not a grant of access — nothing is readable because of it. The
    // authorisation decision happens in claimDevice (U4), which reads this with the admin SDK while
    // the account owner is standing in front of the television confirming it. That human step is
    // what stops a doc here from being worth attacking.
    //
    // The rule pins authUid to the authenticated caller, so a device can only ever register ITSELF;
    // it cannot nominate somebody else's identity. Overwrites are allowed by the same test, because
    // clearing app data mints a fresh anonymous uid and a customer must not need support to recover
    // from that.
    //
    // Security audit 2026-09-26 (H1): "a device can only register ITSELF" was not true. The installId
    // is not a secret (the activation screen prints it as the support id), so any anonymous caller
    // could overwrite this doc with THEIR uid, and the next claimDevice bound the attacker to the
    // customer's account - playlists and add-ons included.
    //
    // A write now has to carry `proof`: a value only the physical device can produce
    // (DeviceIdentity.proofFor - a hash of ANDROID_ID under a different salt from the installId, so
    // knowing the installId does not give it). The first write pins it; every later write, including
    // the fresh anonymous uid after a clear-data, must present the same proof. Nobody but the device
    // itself can read it back (get is limited to the doc's own authUid). A doc written before this
    // change has no proof and accepts the first one offered - staff can delete a doc to reset it.
    match /device_identity/{installId} {
      allow get: if isAdmin() ||
        (isSignedIn() && resource.data.authUid == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isAdmin() ||
        (isSignedIn() && request.resource.data.authUid == request.auth.uid &&
         identityShapeOk(request.resource.data));
      // The key allowlist is checked on the CHANGED keys here, not the merged document: a field some
      // other writer put on the doc must not lock the device out of refreshing its own identity.
      allow update: if isAdmin() ||
        (isSignedIn() && request.resource.data.authUid == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['authUid', 'proof', 'appVersionCode', 'updatedAt']) &&
         proofOk(request.resource.data) &&
         (!('proof' in resource.data) || request.resource.data.proof == resource.data.proof));
      allow delete: if isAdmin();
    }

    function identityShapeOk(d) {
      return d.keys().hasOnly(['authUid', 'proof', 'appVersionCode', 'updatedAt']) && proofOk(d);
    }

    function proofOk(d) {
      return d.proof is string && d.proof.matches('^[a-f0-9]{64}$');
    }

    // ── Device → account binding ────────────────────────────────────────
    // A device may READ its own binding (to learn which account it belongs to) and may
    // never write one. Self-binding would let any device claim any account, which is the
    // same class of hole as a client writing its own entitlement.
    match /device_auth/{authUid} {
      allow get: if isAdmin() || (isSignedIn() && request.auth.uid == authUid);
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // ── Learned release languages (Tier H5) ─────────────────────────────
    // Community knowledge: "release <infoHash> carries these audio languages",
    // learned by a device that actually PLAYED the file. Zero PII — the doc id is
    // a public torrent infoHash and the payload is language codes.
    //
    // TVs are unauthenticated (same posture as `licenses` create), so writes are
    // open but tightly shaped: 40-hex id, only the three known keys, languages a
    // small MAP of codes (set-union under merge — codes only widen), and
    // reports/updatedAt server-anchored types.
    // Poisoning is bounded by design: the app's LOCAL observations always outrank
    // shared rows, and a bad row can only mislabel chips until someone plays the
    // release.
    match /release_languages/{hash} {
      allow get, list: if true;
      allow create, update: if
        hash.matches('^[a-f0-9]{40}$') &&
        request.resource.data.keys().hasOnly(['languages', 'reports', 'updatedAt']) &&
        request.resource.data.languages is map &&
        request.resource.data.languages.keys().size() <= 12 &&
        request.resource.data.reports is int &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // Everything else: locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
