rules_version = '2';

// DebridXtream Firestore rules — licensing + admin panel + companion pairing.
// Deploy: Firebase console → Firestore → Rules → paste → Publish
// (or `firebase deploy --only firestore:rules`).
//
// Admin = any signed-in user whose UID has a doc in the `admins` collection.
// One-time setup: Firebase console → Firestore → create collection `admins` →
// add a doc whose ID is your Auth UID (Authentication tab shows it) → {role:"owner"}.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // ── Device licenses ────────────────────────────────────────────────
    // The TV app is UNAUTHENTICATED; its doc id is an unguessable install UUID
    // which acts as the capability. Devices may register themselves as
    // `pending` and update telemetry — but can NEVER grant themselves
    // status/tier/expiry. Only admins can. Resellers (see below) never write
    // entitlement fields directly — that goes through the activateClient Cloud
    // Function (admin SDK) so credits are spent atomically.
    match /licenses/{installId} {
      // GET stays open: the unauthenticated TV reads its OWN doc by id (capability).
      allow get: if true;
      // LIST is scoped: the admin panel sees all; a reseller may only enumerate the
      // clients they own (query must filter resellerId == their uid). This also closes
      // the prior "anyone can enumerate every license" exposure.
      // §7 U7 adds the customer: they may enumerate the devices THEY claimed, and nothing
      // else. Widening only — no existing caller loses anything.
      allow list: if isAdmin() ||
        (isSignedIn() && resource.data.resellerId == request.auth.uid) ||
        (isSignedIn() && resource.data.ownerUid == request.auth.uid);

      // Device self-registration: must be pending + normal, no expiry, and the
      // trial anchor MUST be the server clock — a crafted client can no longer seed a
      // far-future createdAt to mint an unlimited "trial" (createdAt drives the 7-day
      // trial window). The app writes FieldValue.serverTimestamp(), which resolves to
      // request.time.
      allow create: if isAdmin() || (
        request.resource.data.status == 'pending' &&
        request.resource.data.tier == 'normal' &&
        !('expiresAt' in request.resource.data) &&
        request.resource.data.createdAt == request.time
      );

      // Device may only touch telemetry fields; entitlement fields are admin-only.
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastSeenAt', 'appVersionCode', 'appVersionName', 'activationCode'])
      ) || (
        // §7 U7: the owning customer may rename their own TV — that key and no other. Naming a
        // device is the one thing here that is purely theirs; ownership itself is set by
        // claimDevice and can only be undone by staff (§7.8), so it is NOT in this list.
        isSignedIn() &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deviceName'])
      );

      allow delete: if isAdmin();
    }

    // ── App config (licensing switch + update manifest) ────────────────
    match /app_config/{doc} {
      allow read: if true;          // devices must read enforce/version unauthenticated
      allow write: if isAdmin();
    }

    // ── Admin registry ──────────────────────────────────────────────────
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;        // console-only
    }

    // ── Companion config channel (permanent device-key docs) ────────────
    // Unauthenticated by design: the TV and the phone page both address the doc
    // by the device key (capability). Docs carry pushed IPTV credentials, so
    // LIST is denied — you must know the exact key; enumeration is blocked.
    // DELETE is admin-only: nobody who merely knows a key should be able to wipe
    // another device's config (griefing). get/create/update stay open because the
    // unauthenticated phone page legitimately writes config by key.
    // RESIDUAL RISK (needs a bigger change, tracked separately): anyone who learns a
    // device's key can still READ its pushed IPTV credentials. Proper fix = short-lived
    // pairing tokens + not storing raw credentials at rest (encrypt with a device-held key).
    match /device_codes/{code} {
      allow get, create, update: if true;
      allow delete: if isAdmin();
      allow list: if false;
    }

    // ── Resellers (multi-tenant reseller dashboard) ─────────────────────
    // A reseller signs up with email (Firebase Auth). They own their own doc but can
    // NEVER change their own credit balance or status — only an admin (owner top-up)
    // or the Cloud Functions (admin SDK, which bypasses rules) may. Activating/renewing
    // a client is done via the activateClient/renewClient Functions, which spend credits
    // atomically; resellers never write licence entitlement fields directly.
    match /resellers/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      // Self-signup: create own doc, starting at zero credits, active.
      allow create: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.credits == 0 &&
        request.resource.data.status == 'active';
      // Self-update: profile fields ONLY — credits/status are admin/function-only.
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'phone', 'country', 'contact'])
      );
      allow delete: if isAdmin();
    }

    // ── Plans (server-defined credit cost per tier/duration) ────────────
    // Read-all so the reseller UI can list them; only the owner defines cost.
    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Credit ledger (audit trail of top-ups + activation spends) ───────
    // Read your own entries (or admin reads all); writes come only from the Functions
    // (admin SDK) or admin — never from a reseller client directly.
    match /credit_ledger/{entryId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.resellerId == request.auth.uid);
      allow write: if isAdmin();
    }

    // ── Credit packages (what a reseller can BUY) ───────────────────────
    // Read-all so the Buy Credits page lists them; only the owner sets price/credits.
    match /credit_packages/{pkgId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Orders (credit purchases) ───────────────────────────────────────
    // A reseller reads their own orders. Orders are CREATED and marked paid only by
    // the checkout/webhook Cloud Functions (admin SDK) so the amount + credit grant
    // are server-validated — a client can never self-create a paid order.
    match /orders/{orderId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.resellerId == request.auth.uid);
      allow write: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════════
    // END-USER ACCOUNTS — §7 of docs/reports/ANTI_PIRACY_DECISION.md, phase U0.
    //
    // Nothing reads or writes these yet; this is the skeleton so later phases add
    // behaviour, not permissions. The point of the whole section is one shift: today
    // `device_codes` says "whoever knows the key may read the customer's IPTV password".
    // Here, access follows OWNERSHIP instead — which is the only version of this that
    // can actually be made safe.
    //
    // Entitlement is never client-writable. `subscriptions` and `device_auth` are
    // written exclusively by the callable Functions (admin SDK bypasses rules), because
    // device-slot counting cannot be expressed in rules — rules cannot count.
    // ════════════════════════════════════════════════════════════════════

    // The uid of the account that owns the DEVICE making this request, or null when the
    // caller is not a bound device. One document read; used to let a TV read its owner's
    // playlists without granting it anything else.
    function deviceOwnerUid() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/device_auth/$(request.auth.uid))
        ? get(/databases/$(database)/documents/device_auth/$(request.auth.uid)).data.ownerUid
        : null;
    }

    // ── End-user profiles ───────────────────────────────────────────────
    // Firebase Auth is the identity; this doc is just profile. Deliberately NOT where
    // entitlement lives — a user who can edit their own profile must never be one field
    // away from editing what they are entitled to.
    match /users/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'phone', 'country', 'contact'])
      );
      allow delete: if isAdmin();
    }

    // ── Subscriptions (entitlement truth, CONSUMER channel only) ────────
    // §7.0: resellers buy PER DEVICE and have no limit — they never touch this collection;
    // their path stays `plans` + activateClient. Subscriptions exist only for the direct
    // customer, and `deviceLimit` lives here rather than on a plan so that re-pricing a
    // product later cannot silently shrink a subscription somebody already paid for.
    //
    // Read-only to the customer; only Functions/admin may write. deviceLimit and expiresAt
    // decide what someone paid for, so a client write path here would make every other
    // control in this file decorative.
    match /subscriptions/{subId} {
      allow get, list: if isAdmin() ||
        (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow write: if isAdmin();
    }

    // ── Playlists (the customer's own IPTV credentials) ─────────────────
    // The owner has full CRUD. A bound device gets READ ONLY, and only for playlists
    // belonging to the account that owns it — this is what replaces the device_codes push
    // channel, and why an edit on the phone reaches the TV without anything being pushed.
    // Queries MUST filter on ownerUid or the list rule cannot be satisfied.
    match /playlists/{playlistId} {
      allow get, list: if isAdmin() ||
        (isSignedIn() && resource.data.ownerUid == request.auth.uid) ||
        (resource.data.ownerUid != null && resource.data.ownerUid == deviceOwnerUid());
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      // The ownerUid re-check pins an edit to its current owner — a playlist can never be handed to
      // another account by editing it.
      allow update: if isAdmin() ||
        (isSignedIn() && resource.data.ownerUid == request.auth.uid &&
         request.resource.data.ownerUid == resource.data.ownerUid);
      // Delete is SEPARATE and must not mention request.resource: on a delete there is no incoming
      // document, so `request.resource.data.ownerUid` is an error and the whole condition fails.
      // Sharing one rule with update silently made deletion impossible for the owner.
      allow delete: if isAdmin() ||
        (isSignedIn() && resource.data.ownerUid == request.auth.uid);
    }

    // ── Device identity (U3) ────────────────────────────────────────────
    // A TV signs in anonymously and records "this anonymous uid is me" against its installId.
    //
    // This is a CLAIM OF IDENTITY, not a grant of access — nothing is readable because of it. The
    // authorisation decision happens in claimDevice (U4), which reads this with the admin SDK while
    // the account owner is standing in front of the television confirming it. That human step is
    // what stops a doc here from being worth attacking.
    //
    // The rule pins authUid to the authenticated caller, so a device can only ever register ITSELF;
    // it cannot nominate somebody else's identity. Overwrites are allowed by the same test, because
    // clearing app data mints a fresh anonymous uid and a customer must not need support to recover
    // from that.
    match /device_identity/{installId} {
      allow get: if isAdmin() ||
        (isSignedIn() && resource.data.authUid == request.auth.uid);
      allow list: if isAdmin();
      allow create, update: if isAdmin() ||
        (isSignedIn() && request.resource.data.authUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ── Device → account binding ────────────────────────────────────────
    // A device may READ its own binding (to learn which account it belongs to) and may
    // never write one. Self-binding would let any device claim any account, which is the
    // same class of hole as a client writing its own entitlement.
    match /device_auth/{authUid} {
      allow get: if isAdmin() || (isSignedIn() && request.auth.uid == authUid);
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Everything else: locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
