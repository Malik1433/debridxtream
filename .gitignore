# =====================================================================
# DebridXtreamIPTV — .gitignore
# =====================================================================

# ---------- Built application artifacts ----------
*.apk
*.aar
*.ap_
*.aab
*.dex
*.class

# ---------- Gradle / Android build outputs ----------
.gradle/
build/
**/build/
bin/
gen/
out/
release/
captures/
.navigation/
.externalNativeBuild
.cxx/

# ---------- Local config (machine-specific) ----------
local.properties
proguard/

# ---------- Logs (build, debug, ANR captures) ----------
*.log
*.hprof
build_*.log
build_*.txt

# Tracked logcat / device debug captures
# (these are committed historically — uncomment to stop tracking new ones)
# artifacts/
# logs/
# downloads/

# ---------- Bisect / temp working dirs ----------
_bisect_quarantine/
*.bisect/

# ---------- IDE: IntelliJ / Android Studio ----------
*.iml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/jarRepositories.xml
.idea/compiler.xml
.idea/misc.xml
.idea/vcs.xml
.idea/.name

# ---------- IDE: VS Code ----------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ---------- Signing material ----------
*.jks
*.keystore

# ---------- Firebase / Google services ----------
google-services.json

# ---------- OS files ----------
.DS_Store
Thumbs.db

# ---------- Editor backups ----------
*~
*.swp
*.bak
*.orig

# =====================================================================
# web-dashboard subproject (React + Vite + TypeScript)
# =====================================================================
web-dashboard/node_modules/
web-dashboard/dist/
web-dashboard/.vite/
web-dashboard/build_log*.txt

# =====================================================================
# Tooling caches that don't need to be tracked
# =====================================================================
# Generated reports / temp scan output
project-scan-report.json
build_log.txt
