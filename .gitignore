# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/
# ...but `release/` matches ANY directory of that name at any depth, and app/src/release is a
# Gradle SOURCE SET, not build output. It held a network_security_config that replaced main's in
# release builds and blocked all cleartext — invisible in the repo, absent from a fresh clone, so
# it could only ever break on the machine that cut the release. Source is not generated output.
!app/src/release/

# Gradle files
.gradle/
build/
**/build/
*/build/
app/build/
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/workspace.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/jarRepositories.xml
.idea/caches
.idea/modules.xml
.idea/.name
.idea/compiler.xml
.idea/misc.xml
.idea/vcs.xml

# Keystore files
*.jks
*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase)
google-services.json

# Version control
vcs.xml

# Android Profiling
*.hprof

# MacOS
.DS_Store

# Backup files
*~
*.swp
*.bak

# Build outputs
app/build/
**/build/

# Codex local configuration
.codex/

# Claude Flow runtime data
.claude-flow/data/
.claude-flow/logs/

# Environment variables
.env
.env.local
.env.*.local

# Firebase deploy cache
.firebase/

# Release signing + anti-repack (never commit the real one)
keystore.properties

# ─────────────────────────────────────────────────────────────────────────────
# Debug / QA scratch output — NEVER commit this.
# 2026-07-26: ~180MB of it had accumulated in the repo root and artifacts/ (build logs, logcat
# dumps, QA screenshots + uiautomator XML, local DBs, one-off scripts). Keep scratch work in the
# session scratchpad or docs/reports/ with a real name; anything matching the patterns below is
# assumed to be throwaway. `scripts/check_repo_hygiene.sh` fails the build if any reappear.
# ─────────────────────────────────────────────────────────────────────────────

# Build / compile / test console dumps
build_log*.txt
build_output*.txt
assemble-*.out.txt
compile-*.out.txt
compile-*.err.txt
compile_test_output*.txt
kapt_log*.txt
*-test.out.txt

# Device logs
logcat*.txt
*_logs.txt
*_logcat.txt
app_log*.txt
filtered_logcat*.txt

# Device QA captures (screenshots + uiautomator dumps)
qa*.png
qa*.xml
view_*.xml
window_*.xml
*_dump.xml
# ...but `view_*.xml` is also how this app names half its layouts, and these patterns match at
# ANY depth. A leftover layout-port/view_home_sidebar.xml was hidden by exactly this: present on
# disk, used by the build in portrait, invisible in review and absent from a fresh clone. QA
# captures never live under app/src, so nothing there may be swallowed by a capture pattern.
!app/src/**

# Local databases / agent runtime state
*.sqlite
*.db
agentdb.rvf*
ruvector.db

# One-off scratch scripts, patches and diffs
fix_*.py
fix2_*.xml
*.patch
*.diff

# Legacy evidence folder (kept in git history; do not re-add)
/artifacts/

# On-disk scratch twin of the session scratchpad. 52 QA captures were tracked here until
# 2026-09-02 because the hygiene check only matched at the repo root. Never committed again.
/scratch/

# Scratch / diagnostic working directories (kept in git history; do not re-add)
/temp_diagnostics/
/temp_qa/
/.codex-temp/
/logs/
/docs/reports/runtime-logs/

# Agent runtime state (config is tracked; state, metrics and pids are not)
/.swarm/
.claude-flow/metrics/
.claude-flow/swarm/
.claude-flow/system/
.claude-flow/security/
.claude-flow/daemon.pid
.claude-flow/daemon-state.json

# Pulled AudioTrack-watch captures (multi-MB logcat dumps; the watcher is scripts/audio_track_watch.sh)
/docs/reports/audio_track_watch/
.vercel
