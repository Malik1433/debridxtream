{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "rewrites": [
        {
            "source": "/admin",
            "destination": "https://debridxtream-new.web.app/"
        },
        {
            "source": "/admin/:path*",
            "destination": "https://debridxtream-new.web.app/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
